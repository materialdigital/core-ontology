@prefix : <https://w3id.org/pmd/co/test#> .
@prefix ex: <https://www.example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .   
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/pmd/co/test#> .

# Classes
@prefix process: <http://purl.obolibrary.org/obo/BFO_0000015>  . 
@prefix temporal_interval: <http://purl.obolibrary.org/obo/BFO_0000202> .
@prefix specification_datum: <https://w3id.org/pmd/co/PMD_0060009> .
@prefix plan_specification: <http://purl.obolibrary.org/obo/IAO_0000104> .
@prefix value_specification: <http://purl.obolibrary.org/obo/OBI_0001933> .
# A custom class for the specific process type whose duration should be specified. 
# Here we use the generic "process", but a more suitable subclass is recommended, 
# e.g. a specific segement of a heat treatment that should be hold for a specified duration.
ex:class_process_duration_specification a owl:Class ;
    rdfs:subClassOf value_specification: ;
    owl:equivalentClass [
        a owl:Restriction ;
        owl:onProperty is_about: ;
        owl:someValuesFrom [
            a owl:Class ;
            owl:intersectionOf (
                temporal_interval:
                [
                    a owl:Restriction ;
                    owl:onProperty during_which_exists: ;
                    owl:someValuesFrom process:
                ]
            )
        ]
    ] .

# ObjectProperties
@prefix has_value_specification: <http://purl.obolibrary.org/obo/OBI_0001938> .
@prefix has_measurement_unit_label: <http://purl.obolibrary.org/obo/IAO_0000003> .
@prefix has_part: <http://purl.obolibrary.org/obo/BFO_0000051> .
@prefix is_about: <http://purl.obolibrary.org/obo/IAO_0000136> .
@prefix during_which_exists: <http://purl.obolibrary.org/obo/BFO_0000157> .
@prefix is_subject_of: <https://w3id.org/pmd/co/PMD_0000004> .


# Data properties
@prefix has_specified_value: <http://purl.obolibrary.org/obo/OBI_0002135> .

# Individuals
@prefix minute: <http://purl.obolibrary.org/obo/UO_0000031> .

<https://w3id.org/pmd/co/test/shape/time_setpoint_duration> rdf:type owl:Ontology .

ex:plan_specification_1 a plan_specification: ;
    has_part: ex:specification_datum_1 .

ex:specification_datum_1 a specification_datum: ; 
    has_value_specification: ex:process_duration_value_specification_1 .

ex:process_duration_value_specification_1 a ex:class_process_duration_specification ;
    has_specified_value: "5.0"^^xsd:double ;
    has_measurement_unit_label: minute: .

# Optional: if we know the process, we can link to it 
ex:my_optional_process a process: ;
    is_subject_of: ex:process_duration_value_specification_1 .