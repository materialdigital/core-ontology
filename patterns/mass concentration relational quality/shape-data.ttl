@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix obo:   <http://purl.obolibrary.org/obo/> .
@prefix pmd:   <https://w3id.org/pmd/co/> .
@prefix ex:    <http://example.org/massconcentration#> .

# ── Ontology declaration ──────────────────────────────────────────────────────
<http://example.org/massconcentration> a owl:Ontology ;
    rdfs:label "Mass Concentration Relational Quality — example pattern" ;
    rdfs:comment "Load together with pmdco-full from branch 119-pattern-for-time-and-duration-representations for OWL reasoning. See pattern.md for design rationale." .

# ── Required: declare has_quality as inverse of quality_of ───────────────────
obo:RO_0000086 owl:inverseOf obo:RO_0000080 .

# ═══════════════════════════════════════════════════════════════════════════════
# TBOX — Axiom for mass concentration (PMD_0080101)
# ═══════════════════════════════════════════════════════════════════════════════

# ── Necessary condition (SubClassOf) — adopted ────────────────────────────────
#
# Key difference from mass proportion: the WHOLE bears a VOLUME quality,
# not a mass quality. This is the physical distinction mass/volume vs mass/mass.
#
# Manchester syntax:
#   'mass concentration' SubClassOf:
#       'physical relational quality'
#       and ('relational quality of' some
#           (entity
#            and ('has quality' some mass)
#            and ('part of' some
#                (entity
#                 and ('has quality' some volume)))))
#
# Because volume quality is not universally borne by all material entities
# (unlike mass), this is also safe as EquivalentTo — no false positives expected.
# Both SubClassOf and EquivalentTo variants are included below.

# Variant A: SubClassOf (conservative, same approach as mass proportion)
pmd:PMD_0080101 rdfs:subClassOf [
    a owl:Class ;
    owl:intersectionOf (
        pmd:PMD_0080069
        [
            a owl:Restriction ;
            owl:onProperty pmd:PMD_0025999 ;
            owl:someValuesFrom [
                a owl:Class ;
                owl:intersectionOf (
                    obo:BFO_0000004
                    [ a owl:Restriction ; owl:onProperty obo:RO_0000086 ; owl:someValuesFrom pmd:PMD_0020133 ]
                    [ a owl:Restriction ; owl:onProperty obo:BFO_0000050 ;
                      owl:someValuesFrom [
                          a owl:Class ;
                          owl:intersectionOf (
                              obo:BFO_0000004
                              [ a owl:Restriction ; owl:onProperty obo:RO_0000086 ; owl:someValuesFrom pmd:PMD_0020150 ]
                          ) ] ]
                )
            ]
        ]
    )
] .

# Variant B: EquivalentTo — potentially safe (volume quality not universal)
# Expected: massConcRQ classified ✓, moleFractionRQ NOT classified (whole lacks volume quality) ✓
ex:MassConcentrationRQ_Equiv a owl:Class ;
    rdfs:subClassOf pmd:PMD_0080069 ;
    rdfs:label "mass concentration (EquivalentTo — candidate safe design)" ;
    rdfs:comment "EquivalentTo variant: discriminated by volume quality on the whole. No mass proportion false positive because mass proportion whole bears mass quality, not volume quality." ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            pmd:PMD_0080069
            [
                a owl:Restriction ;
                owl:onProperty pmd:PMD_0025999 ;
                owl:someValuesFrom [
                    a owl:Class ;
                    owl:intersectionOf (
                        obo:BFO_0000004
                        [ a owl:Restriction ; owl:onProperty obo:RO_0000086 ; owl:someValuesFrom pmd:PMD_0020133 ]
                        [ a owl:Restriction ; owl:onProperty obo:BFO_0000050 ;
                          owl:someValuesFrom [
                              a owl:Class ;
                              owl:intersectionOf (
                                  obo:BFO_0000004
                                  [ a owl:Restriction ; owl:onProperty obo:RO_0000086 ; owl:someValuesFrom pmd:PMD_0020150 ]
                              ) ] ]
                    )
                ]
            ]
        )
    ] .

# ═══════════════════════════════════════════════════════════════════════════════
# ABOX — Two scenarios
# ═══════════════════════════════════════════════════════════════════════════════

# ── Scenario 1: NaCl in saline solution — correct mass concentration ──────────
#
#   naclPortion ──part_of──► salineSolution
#       │ has_quality              │ has_quality
#   massOfNaCl               volumeOfSolution        ← VOLUME, not mass
#       ▲ relational_quality_of
#   naclMassConcRQ (PMD_0080101)
#
# Inferred:
#   naclMassConcRQ relational_quality_of salineSolution  (via chain)
#   naclMassConcRQ rdf:type MassConcentrationRQ_Equiv    ✓
#   naclMassConcRQ rdf:type PMD_0080101 superclasses     ✓

ex:naclPortion    a owl:NamedIndividual, obo:BFO_0000004 ; rdfs:label "NaCl portion (part)" .
ex:salineSolution a owl:NamedIndividual, obo:BFO_0000004 ; rdfs:label "saline solution (whole)" .
ex:naclPortion obo:BFO_0000050 ex:salineSolution .

ex:massOfNaCl     a owl:NamedIndividual, pmd:PMD_0020133 ; rdfs:label "mass of NaCl" .
ex:naclPortion    obo:RO_0000086 ex:massOfNaCl .
ex:volumeOfSolution a owl:NamedIndividual, pmd:PMD_0020150 ; rdfs:label "volume of saline solution" .
ex:salineSolution obo:RO_0000086 ex:volumeOfSolution .

ex:naclMassConcRQ a owl:NamedIndividual, pmd:PMD_0080101 ;
    rdfs:label "NaCl mass concentration RQ (9 g/L — correct)" .
ex:naclMassConcRQ pmd:PMD_0025999 ex:naclPortion .

# ── Scenario 2: Sugar in solution — mass proportion (NOT mass concentration) ──
#
#   sugarPortion ──part_of──► sugarSolution
#       │ has_quality               │ has_quality
#   massOfSugar               massOfSolution      ← MASS, not volume
#       ▲ relational_quality_of
#   sugarMassFractionRQ (PMD_0020102)
#
# Expected:
#   sugarMassFractionRQ NOT classified as MassConcentrationRQ_Equiv ✓
#   (whole has mass quality, not volume → EquivalentTo does not fire)

ex:sugarPortion  a owl:NamedIndividual, obo:BFO_0000004 ; rdfs:label "sugar portion (part)" .
ex:sugarSolution a owl:NamedIndividual, obo:BFO_0000004 ; rdfs:label "sugar solution (whole)" .
ex:sugarPortion obo:BFO_0000050 ex:sugarSolution .

ex:massOfSugar    a owl:NamedIndividual, pmd:PMD_0020133 ; rdfs:label "mass of sugar" .
ex:sugarPortion   obo:RO_0000086 ex:massOfSugar .
ex:massOfSolution a owl:NamedIndividual, pmd:PMD_0020133 ; rdfs:label "mass of solution" .
ex:sugarSolution  obo:RO_0000086 ex:massOfSolution .

ex:sugarMassFractionRQ a owl:NamedIndividual, pmd:PMD_0020102 ;
    rdfs:label "sugar mass fraction RQ (NOT a mass concentration)" .
ex:sugarMassFractionRQ pmd:PMD_0025999 ex:sugarPortion .
