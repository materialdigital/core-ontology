@prefix : <https://w3id.org/pmd/co/test#> .
@prefix ex: <https://www.example.org/> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <https://w3id.org/pmd/co/test#> .

# Classes
@prefix process: <http://purl.obolibrary.org/obo/BFO_0000015>  . 
@prefix temporal_interval: <http://purl.obolibrary.org/obo/BFO_0000202> .
@prefix measurement_datum: <http://purl.obolibrary.org/obo/IAO_0000109> .

# ObjectProperties
@prefix occupies_temporal_region: <http://purl.obolibrary.org/obo/BFO_0000199> . 
@prefix has_duration: <http://www.w3.org/2006/time#hasDuration> .
@prefix duration: <https://w3id.org/pmd/co/PMD_0000143> .
@prefix is_specified_output_of: <http://purl.obolibrary.org/obo/OBI_0000312> .
@prefix has_value_specification: <http://purl.obolibrary.org/obo/OBI_0001938> .
@prefix has_measurement_unit_label: <http://purl.obolibrary.org/obo/IAO_0000003> .

# Data properties
@prefix has_specified_value: <http://purl.obolibrary.org/obo/OBI_0002135> .

# Individuals
@prefix minute: <http://purl.obolibrary.org/obo/UO_0000031> .

<https://w3id.org/pmd/co/test/shape/time_measured_duration> rdf:type owl:Ontology .

ex:process_one a process: .
ex:process_ones_temporal_interval a temporal_interval: .
ex:process_ones_temporal_interval_duration a duration: .
[] a measurement_datum: ;
    has_value_specification: ex:process_ones_temporal_interval_duration .


ex:process_one occupies_temporal_region: ex:process_ones_temporal_interval .
ex:process_ones_temporal_interval has_duration: ex:process_ones_temporal_interval_duration .
ex:process_ones_temporal_interval_duration has_specified_value: "5.0"^^xsd:double ;
    has_measurement_unit_label: minute: .

