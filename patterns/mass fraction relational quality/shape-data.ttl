@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix obo:   <http://purl.obolibrary.org/obo/> .
@prefix pmd:   <https://w3id.org/pmd/co/> .
@prefix ex:    <http://example.org/massfraction#> .

### Prefixes for readability ###
@prefix proportion:                   <https://w3id.org/pmd/co/PMD_0020101> .
@prefix mass_proportion:              <https://w3id.org/pmd/co/PMD_0020102> .
@prefix mass:                         <https://w3id.org/pmd/co/PMD_0020133> .
@prefix relational_quality_of:        <https://w3id.org/pmd/co/PMD_0025999> .
@prefix has_relational_quality:       <https://w3id.org/pmd/co/PMD_0025998> .
@prefix quality_of:                   <http://purl.obolibrary.org/obo/RO_0000080> .
@prefix has_quality:                  <http://purl.obolibrary.org/obo/RO_0000086> .
@prefix part_of:                      <http://purl.obolibrary.org/obo/BFO_0000050> .
@prefix independent_continuant:       <http://purl.obolibrary.org/obo/BFO_0000004> .
@prefix fraction_value_specification: <https://w3id.org/pmd/co/PMD_0025997> .
@prefix specified_by_value:           <https://w3id.org/pmd/co/PMD_0000077> .
@prefix has_numeric_value:            <http://purl.obolibrary.org/obo/OBI_0001937> .
@prefix has_unit:                     <http://purl.obolibrary.org/obo/IAO_0000039> .
@prefix mass_percentage:              <http://purl.obolibrary.org/obo/UO_0000163> .

# ── Ontology declaration ──────────────────────────────────────────────────────
<http://example.org/massfraction> a owl:Ontology ;
    rdfs:label "Mass Fraction Relational Quality — example pattern" ;
    rdfs:comment "Load together with pmdco (full or base) for OWL reasoning. See pattern.md for design rationale." .

# ── Required: declare has_quality as inverse of quality_of ───────────────────
obo:RO_0000086 owl:inverseOf obo:RO_0000080 .

# ═══════════════════════════════════════════════════════════════════════════════
# TBOX — Three axiom design variants as distinct OWL classes
# ═══════════════════════════════════════════════════════════════════════════════

# ── Variant A: NECESSARY condition only (SubClassOf) — ADOPTED ───────────────
# Safe: classifies PMD_0020102 instances correctly, no false positives.
# Classification of instances must be asserted by the modeller.
#
# Manchester syntax:
#   'mass proportion' SubClassOf:
#       'proportion'
#       and ('relational quality of' some
#           (entity and ('has quality' some mass)
#            and ('part of' some (entity and ('has quality' some mass)))))

pmd:PMD_0020102 rdfs:subClassOf [
    a owl:Class ;
    owl:intersectionOf (
        pmd:PMD_0020101
        [
            a owl:Restriction ;
            owl:onProperty pmd:PMD_0025999 ;
            owl:someValuesFrom [
                a owl:Class ;
                owl:intersectionOf (
                    obo:BFO_0000004
                    [ a owl:Restriction ; owl:onProperty obo:RO_0000086 ; owl:someValuesFrom pmd:PMD_0020133 ]
                    [ a owl:Restriction ; owl:onProperty obo:BFO_0000050 ;
                      owl:someValuesFrom [
                          a owl:Class ;
                          owl:intersectionOf (
                              obo:BFO_0000004
                              [ a owl:Restriction ; owl:onProperty obo:RO_0000086 ; owl:someValuesFrom pmd:PMD_0020133 ]
                          ) ] ]
                )
            ]
        ]
    )
] .

# ── Variant B: EquivalentTo entity-centric — DEMONSTRATES FALSE POSITIVES ────
# Infers mole/volume fraction RQs as mass proportion when bearer entities
# happen to have mass qualities. Included here to show the problem in the graph.
#
# Expected reasoning result:
#   ex:moleFractionRQ   rdf:type  ex:MassFractionRQ_EntityEquiv  ← FALSE POSITIVE
#   ex:volumeFractionRQ rdf:type  ex:MassFractionRQ_EntityEquiv  ← FALSE POSITIVE
#   ex:massFractionRQ   rdf:type  ex:MassFractionRQ_EntityEquiv  ✓ (correct)

ex:MassFractionRQ_EntityEquiv a owl:Class ;
    rdfs:subClassOf pmd:PMD_0020101 ;
    rdfs:label "mass proportion (entity-centric EquivalentTo — false positive design)" ;
    rdfs:comment "Design variant B from pattern.md. NOT a subClassOf PMD_0020102 — kept separate to isolate false positive propagation. Shows risk of EquivalentTo without value-spec discriminator." ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            pmd:PMD_0020101
            [
                a owl:Restriction ;
                owl:onProperty pmd:PMD_0025999 ;
                owl:someValuesFrom [
                    a owl:Class ;
                    owl:intersectionOf (
                        obo:BFO_0000004
                        [ a owl:Restriction ; owl:onProperty obo:RO_0000086 ; owl:someValuesFrom pmd:PMD_0020133 ]
                        [ a owl:Restriction ; owl:onProperty obo:BFO_0000050 ;
                          owl:someValuesFrom [
                              a owl:Class ;
                              owl:intersectionOf (
                                  obo:BFO_0000004
                                  [ a owl:Restriction ; owl:onProperty obo:RO_0000086 ; owl:someValuesFrom pmd:PMD_0020133 ]
                              ) ] ]
                    )
                ]
            ]
        )
    ] .

# ── Variant C: EquivalentTo with value specification — SAFE SUFFICIENT CONDITION
# Discriminates by unit: only mass/mass units qualify.
# No false positives — mole fraction and volume fraction carry different units.
#
# Expected reasoning result:
#   ex:massFractionRQ   rdf:type  ex:MassFractionRQ_ValueEquiv  ✓ (has mass% unit)
#   ex:moleFractionRQ   NOT classified (no value spec with mass unit)
#   ex:volumeFractionRQ NOT classified (no value spec with mass unit)

# Local unit class — replace with proper PMDCO/QUDT class once defined
ex:MassFractionUnit a owl:Class ;
    rdfs:label "mass fraction unit (local placeholder)" ;
    rdfs:comment "Covers units expressing mass-per-mass ratios. Pending a proper PMDCO/QUDT class." .
obo:UO_0000163 a owl:NamedIndividual, ex:MassFractionUnit ;
    rdfs:label "mass percentage (UO:0000163)" .

ex:MassFractionRQ_ValueEquiv a owl:Class ;
    rdfs:subClassOf pmd:PMD_0020101 ;
    rdfs:label "mass proportion (value-spec EquivalentTo — safe design)" ;
    rdfs:comment "Design variant C from pattern.md. Kept as separate class (subClassOf PMD_0020101, not PMD_0020102) so this pattern can be adopted into PMD_0020102 as an EquivalentTo once a mass fraction unit class exists in PMDCO." ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            pmd:PMD_0020101
            [
                a owl:Restriction ;
                owl:onProperty pmd:PMD_0025999 ;
                owl:someValuesFrom [
                    a owl:Class ;
                    owl:intersectionOf (
                        obo:BFO_0000004
                        [ a owl:Restriction ; owl:onProperty obo:RO_0000086 ; owl:someValuesFrom pmd:PMD_0020133 ]
                        [ a owl:Restriction ; owl:onProperty obo:BFO_0000050 ;
                          owl:someValuesFrom [
                              a owl:Class ;
                              owl:intersectionOf (
                                  obo:BFO_0000004
                                  [ a owl:Restriction ; owl:onProperty obo:RO_0000086 ; owl:someValuesFrom pmd:PMD_0020133 ]
                              ) ] ]
                    )
                ]
            ]
            [
                a owl:Restriction ;
                owl:onProperty pmd:PMD_0000077 ;
                owl:someValuesFrom [
                    a owl:Class ;
                    owl:intersectionOf (
                        pmd:PMD_0025997
                        [ a owl:Restriction ; owl:onProperty obo:IAO_0000039 ; owl:someValuesFrom ex:MassFractionUnit ]
                    )
                ]
            ]
        )
    ] .

# ═══════════════════════════════════════════════════════════════════════════════
# ABOX — Three scenarios, distinct entities
# ═══════════════════════════════════════════════════════════════════════════════

# ── Scenario 1: Sugar in solution — correct mass fraction ─────────────────────
#
#   sugarPortion ──part_of──► sugarSolution
#       │ has_quality              │ has_quality
#   massOfSugar               massOfSolution
#       ▲ relational_quality_of
#   massFractionRQ (PMD_0020102)
#       └── specified_by_value ──► sugarMassFractionSpec (20 mass%)
#
# Inferred:
#   massFractionRQ relational_quality_of sugarSolution  (via property chain)
#   massFractionRQ rdf:type MassFractionRQ_EntityEquiv  (variant B fires ✓)
#   massFractionRQ rdf:type MassFractionRQ_ValueEquiv   (variant C fires ✓)

ex:sugarPortion  a owl:NamedIndividual, obo:BFO_0000004 ; rdfs:label "sugar portion (part)" .
ex:sugarSolution a owl:NamedIndividual, obo:BFO_0000004 ; rdfs:label "sugar solution (whole)" .
ex:sugarPortion obo:BFO_0000050 ex:sugarSolution .

ex:massOfSugar    a owl:NamedIndividual, pmd:PMD_0020133 ; rdfs:label "mass of sugar" .
ex:sugarPortion   obo:RO_0000086 ex:massOfSugar .
ex:massOfSolution a owl:NamedIndividual, pmd:PMD_0020133 ; rdfs:label "mass of solution" .
ex:sugarSolution  obo:RO_0000086 ex:massOfSolution .

ex:massFractionRQ a owl:NamedIndividual, pmd:PMD_0020102 ;
    rdfs:label "mass fraction RQ — sugar in solution (correct)" .
ex:massFractionRQ pmd:PMD_0025999 ex:sugarPortion .
ex:massFractionRQ pmd:PMD_0000077 ex:sugarMassFractionSpec .

ex:sugarMassFractionSpec a owl:NamedIndividual, pmd:PMD_0025997 ;
    rdfs:label "sugar mass fraction value spec (20 mass%)" .
ex:sugarMassFractionSpec obo:OBI_0001937 "20.0"^^xsd:float .
ex:sugarMassFractionSpec obo:IAO_0000039 obo:UO_0000163 .

# ── Scenario 2: Iron in steel — mole fraction (false positive for variant B) ──
#
#   ironPortion ──part_of──► steelBlock
#       │ has_quality              │ has_quality
#   massOfIron                massOfSteel
#       ▲ relational_quality_of
#   moleFractionRQ (PMD_0020101 only — NOT a mass proportion)
#   (no value spec → variant C does NOT fire)
#
# Inferred:
#   moleFractionRQ relational_quality_of steelBlock  (via property chain)
#   moleFractionRQ rdf:type MassFractionRQ_EntityEquiv  ← FALSE POSITIVE (variant B)
#   moleFractionRQ NOT rdf:type MassFractionRQ_ValueEquiv (variant C safe ✓)

ex:ironPortion a owl:NamedIndividual, obo:BFO_0000004 ; rdfs:label "iron portion (part of steel)" .
ex:steelBlock  a owl:NamedIndividual, obo:BFO_0000004 ; rdfs:label "steel block (whole)" .
ex:ironPortion obo:BFO_0000050 ex:steelBlock .

ex:massOfIron  a owl:NamedIndividual, pmd:PMD_0020133 ; rdfs:label "mass of iron portion" .
ex:ironPortion obo:RO_0000086 ex:massOfIron .
ex:massOfSteel a owl:NamedIndividual, pmd:PMD_0020133 ; rdfs:label "mass of steel block" .
ex:steelBlock  obo:RO_0000086 ex:massOfSteel .

ex:moleFractionRQ a owl:NamedIndividual, pmd:PMD_0020101 ;
    rdfs:label "mole fraction RQ — iron in steel (NOT a mass proportion)" .
ex:moleFractionRQ pmd:PMD_0025999 ex:ironPortion .

# ── Scenario 3: Carbon fibre in composite — volume fraction (false positive B) ─
#
#   fibrePortion ──part_of──► compositePanel
#       │ has_quality                │ has_quality
#   massOfFibre               massOfPanel
#       ▲ relational_quality_of
#   volumeFractionRQ (PMD_0020101 only — NOT a mass proportion)
#   (no value spec → variant C does NOT fire)
#
# Inferred:
#   volumeFractionRQ relational_quality_of compositePanel  (via property chain)
#   volumeFractionRQ rdf:type MassFractionRQ_EntityEquiv  ← FALSE POSITIVE (variant B)
#   volumeFractionRQ NOT rdf:type MassFractionRQ_ValueEquiv (variant C safe ✓)

ex:fibrePortion   a owl:NamedIndividual, obo:BFO_0000004 ; rdfs:label "carbon fibre bundle (part)" .
ex:compositePanel a owl:NamedIndividual, obo:BFO_0000004 ; rdfs:label "composite panel (whole)" .
ex:fibrePortion obo:BFO_0000050 ex:compositePanel .

ex:massOfFibre  a owl:NamedIndividual, pmd:PMD_0020133 ; rdfs:label "mass of fibre bundle" .
ex:fibrePortion obo:RO_0000086 ex:massOfFibre .
ex:massOfPanel  a owl:NamedIndividual, pmd:PMD_0020133 ; rdfs:label "mass of composite panel" .
ex:compositePanel obo:RO_0000086 ex:massOfPanel .

ex:volumeFractionRQ a owl:NamedIndividual, pmd:PMD_0020101 ;
    rdfs:label "volume fraction RQ — fibre in composite (NOT a mass proportion)" .
ex:volumeFractionRQ pmd:PMD_0025999 ex:fibrePortion .
