@prefix rdf:   <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs:  <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:   <http://www.w3.org/2002/07/owl#> .
@prefix xsd:   <http://www.w3.org/2001/XMLSchema#> .
@prefix obo:   <http://purl.obolibrary.org/obo/> .
@prefix pmd:   <https://w3id.org/pmd/co/> .
@prefix ex:    <http://example.org/massfraction#> .

### Prefixes for readability ###
@prefix proportion:             <https://w3id.org/pmd/co/PMD_0020101> .
@prefix mass_proportion:        <https://w3id.org/pmd/co/PMD_0020102> .
@prefix mass:                   <https://w3id.org/pmd/co/PMD_0020133> .
@prefix relational_quality_of:  <https://w3id.org/pmd/co/PMD_0025999> .
@prefix has_relational_quality: <https://w3id.org/pmd/co/PMD_0025998> .
@prefix quality_of:             <http://purl.obolibrary.org/obo/RO_0000080> .
@prefix has_quality:            <http://purl.obolibrary.org/obo/RO_0000086> .
@prefix part_of:                <http://purl.obolibrary.org/obo/BFO_0000050> .
@prefix independent_continuant: <http://purl.obolibrary.org/obo/BFO_0000004> .

# ── Ontology declaration ──────────────────────────────────────────────────────
<http://example.org/massfraction> a owl:Ontology ;
    rdfs:label "Mass Fraction Relational Quality — example pattern" ;
    rdfs:comment "Demonstrates the mass proportion (PMD_0020102) pattern. Load together with pmdco (full or base) for OWL reasoning." .

# ── Needed: declare has_quality as inverse of quality_of ─────────────────────
# pmdco-base.ttl declares RO_0000086 only as owl:ObjectProperty without inverseOf.
# This inverse is needed for the reasoner to infer  entity has_quality massQ
# from  massQ quality_of entity.
obo:RO_0000086 owl:inverseOf obo:RO_0000080 .

# ── TBox: NECESSARY condition on mass proportion (PMD_0020102) ────────────────
#
# Design decision: SubClassOf (necessary condition), NOT EquivalentTo.
# See pattern.md for the full rationale.
#
# Manchester syntax:
#   'mass proportion' SubClassOf:
#       'proportion'
#       and ('relational quality of' some
#           (entity
#            and ('has quality' some mass)
#            and ('part of' some
#                (entity
#                 and ('has quality' some mass)))))
#
# The RQ attaches to the PART entity (an independent continuant), not to
# the mass quality.  The second bearer (the whole entity) is reached via
# the PMDCO property chain:
#   relational_quality_of o part_of → relational_quality_of
# so asserting  massFractionRQ relational_quality_of sugarPortion  +
#               sugarPortion part_of sugarSolution
# entails       massFractionRQ relational_quality_of sugarSolution.

pmd:PMD_0020102 rdfs:subClassOf [
    a owl:Class ;
    owl:intersectionOf (
        pmd:PMD_0020101
        [
            a owl:Restriction ;
            owl:onProperty pmd:PMD_0025999 ;
            owl:someValuesFrom [
                a owl:Class ;
                owl:intersectionOf (
                    obo:BFO_0000004
                    [
                        a owl:Restriction ;
                        owl:onProperty obo:RO_0000086 ;
                        owl:someValuesFrom pmd:PMD_0020133
                    ]
                    [
                        a owl:Restriction ;
                        owl:onProperty obo:BFO_0000050 ;
                        owl:someValuesFrom [
                            a owl:Class ;
                            owl:intersectionOf (
                                obo:BFO_0000004
                                [
                                    a owl:Restriction ;
                                    owl:onProperty obo:RO_0000086 ;
                                    owl:someValuesFrom pmd:PMD_0020133
                                ]
                            )
                        ]
                    ]
                )
            ]
        ]
    )
] .

# ── ABox: sugar-in-solution example ──────────────────────────────────────────
#
# Structure:
#
#   sugarPortion ──part_of──► sugarSolution
#        │                          │
#   has_quality (RO:0000086)   has_quality (RO:0000086)
#        │                          │
#   massOfSugar               massOfSolution   (mass qualities)
#        ▲
#        │  relational_quality_of (PMD_0025999)
#        │  (connects RQ to the PART ENTITY, not the quality)
#        │
#   massFractionRQ
#        asserted type: mass proportion (PMD_0020102)  ← explicit, not inferred
#        consistency check: satisfies the SubClassOf necessary conditions above
#
# By the PMDCO property chain  relational_quality_of o part_of → relational_quality_of
# the reasoner also infers:
#   massFractionRQ relational_quality_of sugarSolution   (second bearer)

# Independent continuants (entities / objects)
ex:sugarPortion a owl:NamedIndividual, obo:BFO_0000004 ;
    rdfs:label "sugar portion (the part)" .

ex:sugarSolution a owl:NamedIndividual, obo:BFO_0000004 ;
    rdfs:label "sugar solution (the whole)" .

ex:sugarPortion obo:BFO_0000050 ex:sugarSolution .   # part of

# Mass quality of the part
ex:massOfSugar a owl:NamedIndividual, pmd:PMD_0020133 ;
    rdfs:label "mass of sugar (part)" .
ex:sugarPortion obo:RO_0000086 ex:massOfSugar .      # has quality

# Mass quality of the whole
ex:massOfSolution a owl:NamedIndividual, pmd:PMD_0020133 ;
    rdfs:label "mass of solution (whole)" .
ex:sugarSolution obo:RO_0000086 ex:massOfSolution .  # has quality

# The relational quality — asserted as mass proportion (PMD_0020102)
# The type is ASSERTED here; the SubClassOf axiom lets the reasoner
# verify that the necessary conditions are satisfied.
ex:massFractionRQ a owl:NamedIndividual, pmd:PMD_0020102 ;
    rdfs:label "mass fraction relational quality (sugar in solution)" .
ex:massFractionRQ pmd:PMD_0025999 ex:sugarPortion .  # relational quality of PART ENTITY

# ── Counterexample A: mole fraction — same part-whole pair ────────────────────
# Shows why EquivalentTo would produce a false positive:
# ironPortion and steelBlock both have mass AND amount-of-substance,
# so entity-centric EquivalentTo would classify moleFractionRQ as mass proportion.
# With SubClassOf, this is only a consistency risk if moleFractionRQ were
# explicitly typed as PMD_0020102 (it is not here).

ex:ironPortion a owl:NamedIndividual, obo:BFO_0000004 ;
    rdfs:label "iron portion (part of steel block)" .

ex:steelBlock a owl:NamedIndividual, obo:BFO_0000004 ;
    rdfs:label "steel block (whole)" .

ex:ironPortion obo:BFO_0000050 ex:steelBlock .       # part of

ex:massOfIron a owl:NamedIndividual, pmd:PMD_0020133 ;
    rdfs:label "mass of iron portion" .
ex:ironPortion obo:RO_0000086 ex:massOfIron .

ex:massOfSteel a owl:NamedIndividual, pmd:PMD_0020133 ;
    rdfs:label "mass of steel block" .
ex:steelBlock obo:RO_0000086 ex:massOfSteel .

# A mole fraction between the same entities — NOT a mass proportion
# (not typed as PMD_0020102; only typed as proportion PMD_0020101)
ex:moleFractionRQ a owl:NamedIndividual, pmd:PMD_0020101 ;
    rdfs:label "mole fraction relational quality (iron in steel) — NOT a mass proportion" .
ex:moleFractionRQ pmd:PMD_0025999 ex:ironPortion .

# ── Counterexample B: volume fraction — different entities, same issue ────────
# A carbon-fibre bundle in a composite panel. Both have mass.
# The RQ here is a volume fraction — should not be a mass proportion.

ex:fibrePortion a owl:NamedIndividual, obo:BFO_0000004 ;
    rdfs:label "carbon fibre bundle (part)" .

ex:compositePanel a owl:NamedIndividual, obo:BFO_0000004 ;
    rdfs:label "composite panel (whole)" .

ex:fibrePortion obo:BFO_0000050 ex:compositePanel .  # part of

ex:massOfFibre a owl:NamedIndividual, pmd:PMD_0020133 ;
    rdfs:label "mass of fibre bundle" .
ex:fibrePortion obo:RO_0000086 ex:massOfFibre .

ex:massOfPanel a owl:NamedIndividual, pmd:PMD_0020133 ;
    rdfs:label "mass of composite panel" .
ex:compositePanel obo:RO_0000086 ex:massOfPanel .

# Volume fraction RQ — NOT a mass proportion
ex:volumeFractionRQ a owl:NamedIndividual, pmd:PMD_0020101 ;
    rdfs:label "volume fraction relational quality (fibre in composite) — NOT a mass proportion" .
ex:volumeFractionRQ pmd:PMD_0025999 ex:fibrePortion .
