# PMDco Issue #394 — review-ready ceramic pellet example.
# Based on PR #426; revised 2026-10-27 to distinguish populations from grains.
# All numeric values are genuine RDF typed literals, not additional RDF individuals.
@prefix ex:   <https://w3id.org/pmd/co/pattern/different_qualities_in_object_matter_microstructure/example/> .
@prefix pmd:  <https://w3id.org/pmd/co/> .
@prefix obo:  <http://purl.obolibrary.org/obo/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ONE physical pellet, with object and ceramic-material classifications.
# Global properties are asserted only for this individual; they are NOT copied
# onto the bulk, surface, or grains.
ex:Object_pellet_O_and_portion_of_Ceramic_C
    a obo:BFO_0000030, pmd:PMD_0000546 ;
    rdfs:label "Ceramic pellet O (object and ceramic material)"@en ;
    obo:BFO_0000051 ex:O_bulk, ex:O_surface ;
    obo:RO_0000086 ex:mass_of_pellet, ex:composition_of_ceramic_C ;
    obo:RO_0000091 ex:ceramic_C_property .

ex:mass_of_pellet a pmd:PMD_0020133 ;
    rdfs:label "Mass of pellet"@en .
ex:composition_of_ceramic_C a pmd:PMD_0000551 ;
    rdfs:label "Chemical composition of ceramic pellet"@en .
ex:ceramic_C_property a pmd:PMD_0000848 ;
    rdfs:label "Ceramic mechanical property"@en ;
    obo:BFO_0000054 ex:loadingprocess .

# Distinct spatially localized material parts (existing PMDco terms).
ex:O_bulk a pmd:PMD_0000538, pmd:PMD_0000546 ;
    rdfs:label "Bulk of pellet O"@en ;
    obo:BFO_0000051 ex:B_crystallite_population_in_bulk ;
    obo:RO_0000086 ex:volume_of_bulk ;
    obo:RO_0000091 ex:softer_bulk_property .
ex:O_surface a pmd:PMD_0000965, pmd:PMD_0000546 ;
    rdfs:label "Surface layer of pellet O"@en ;
    obo:BFO_0000051 ex:B_crystallite_population_in_surface ;
    obo:RO_0000086 ex:volume_of_surface ;
    obo:RO_0000091 ex:harder_surface_property .

# B-grain populations, rather than ONE grain representing 5% / 80%.
# BFO object aggregate is a conservative existing category for multiple grains;
# the materials-science phase identity (B) is described at example level.
ex:B_crystallite_population_in_bulk a obo:BFO_0000027 ;
    rdfs:label "B-crystallite population in bulk"@en ;
    obo:BFO_0000050 ex:O_bulk ;
    obo:RO_0002351 ex:B_crystal_form_in_bulk ;
    obo:RO_0000086 ex:volume_of_B_population_in_bulk .
ex:B_crystallite_population_in_surface a obo:BFO_0000027 ;
    rdfs:label "B-crystallite population in surface"@en ;
    obo:BFO_0000050 ex:O_surface ;
    obo:RO_0002351 ex:B_crystal_form_in_surface ;
    obo:RO_0000086 ex:volume_of_B_population_in_surface .

# Representative grains (members of each population), NOT fraction numerators.
ex:B_crystal_form_in_bulk a pmd:PMD_0000663 ;
    rdfs:label "Representative B-crystallite in bulk"@en ;
    obo:RO_0000086 ex:some_qual5 ;
    obo:RO_0000091 ex:property_of_B_crystal_for_bulk .
ex:B_crystal_form_in_surface a pmd:PMD_0000663 ;
    rdfs:label "Representative B-crystallite in surface"@en ;
    obo:RO_0000086 ex:some_qual6 ;
    obo:RO_0000091 ex:property_of_B_crystal_for_surface .
ex:some_qual5 a obo:BFO_0000019 .
ex:some_qual6 a obo:BFO_0000019 .

# Explicit volume quality bearers for the numerator and denominator of each
# volume fraction (see current PMDco PMD_0020104 equivalence axiom).
ex:volume_of_bulk a pmd:PMD_0020150 ; rdfs:label "Volume of bulk"@en .
ex:volume_of_surface a pmd:PMD_0020150 ; rdfs:label "Volume of surface"@en .
ex:volume_of_B_population_in_bulk a pmd:PMD_0020150 ;
    rdfs:label "Total B-grain volume in bulk"@en .
ex:volume_of_B_population_in_surface a pmd:PMD_0020150 ;
    rdfs:label "Total B-grain volume in surface"@en .

# TWO relational volume fractions. Each relates the population to its host
# region and has exactly one explicit numerator and denominator bearer.
ex:volume_proportion_of_B_crystal_in_bulk a pmd:PMD_0020104 ;
    rdfs:label "B-grain volume fraction of bulk"@en ;
    pmd:PMD_0025999 ex:B_crystallite_population_in_bulk, ex:O_bulk ;
    pmd:PMD_0020256 ex:B_crystallite_population_in_bulk ; # has numerator
    pmd:PMD_0020257 ex:O_bulk .                         # has denominator
ex:volume_proportion_of_B_crystal_in_surface a pmd:PMD_0020104 ;
    rdfs:label "B-grain volume fraction of surface"@en ;
    pmd:PMD_0025999 ex:B_crystallite_population_in_surface, ex:O_surface ;
    pmd:PMD_0020256 ex:B_crystallite_population_in_surface ;
    pmd:PMD_0020257 ex:O_surface .

# Value specifications are INFORMATION entities. The actual numbers ARE typed
# RDF literals (5.0 and 80.0), intentionally visible in these static labels.
# Unit UO_0000165 = volume-volume percentage; do NOT use decimal or mass/volume.
ex:B_Crys_Vol_fraction_in_bulk a pmd:PMD_0025997 ;
    rdfs:label "B-grain volume fraction in bulk — 5 vol%"@en ;
    obo:OBI_0001927 ex:volume_proportion_of_B_crystal_in_bulk ;
    obo:OBI_0001937 "5.0"^^xsd:double ;
    obo:IAO_0000039 obo:UO_0000165 .
ex:B_Crys_Vol_fraction_in_surface a pmd:PMD_0025997 ;
    rdfs:label "B-grain volume fraction in surface — 80 vol%"@en ;
    obo:OBI_0001927 ex:volume_proportion_of_B_crystal_in_surface ;
    obo:OBI_0001937 "80.0"^^xsd:double ;
    obo:IAO_0000039 obo:UO_0000165 .

# Illustrative mechanical dispositions. The 'harder' vs 'softer' ordering and
# any CAUSAL relationship to B-phase fraction are NOT axiomatized.
ex:softer_bulk_property a pmd:PMD_0000773 ;
    rdfs:label "Bulk hardness (qualitatively softer)"@en ;
    obo:BFO_0000054 ex:some_proc4 .
ex:harder_surface_property a pmd:PMD_0000773 ;
    rdfs:label "Surface hardness (qualitatively harder)"@en ;
    obo:BFO_0000054 ex:some_proc3 .
ex:property_of_B_crystal_for_bulk a pmd:PMD_0000848 ;
    rdfs:label "Mechanical property of a representative bulk B-grain"@en ;
    obo:BFO_0000054 ex:some_proc5 .
ex:property_of_B_crystal_for_surface a pmd:PMD_0000848 ;
    rdfs:label "Mechanical property of a representative surface B-grain"@en ;
    obo:BFO_0000054 ex:some_proc1 .

# Typed placeholder processes make realization targets explicit (synthetic).
ex:loadingprocess a obo:BFO_0000015 .
ex:some_proc1 a obo:BFO_0000015 .
ex:some_proc3 a obo:BFO_0000015 .
ex:some_proc4 a obo:BFO_0000015 .
ex:some_proc5 a obo:BFO_0000015 .
