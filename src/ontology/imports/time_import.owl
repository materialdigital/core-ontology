Prefix(:=<https://w3id.org/pmd/co/imports/time_import.owl#>)
Prefix(owl:=<http://www.w3.org/2002/07/owl#>)
Prefix(rdf:=<http://www.w3.org/1999/02/22-rdf-syntax-ns#>)
Prefix(xml:=<http://www.w3.org/XML/1998/namespace>)
Prefix(xsd:=<http://www.w3.org/2001/XMLSchema#>)
Prefix(rdfs:=<http://www.w3.org/2000/01/rdf-schema#>)


Ontology(<https://w3id.org/pmd/co/imports/time_import.owl>
<https://w3id.org/pmd/co/releases/2026-09-29/imports/time_import.owl>
Annotation(<http://purl.org/dc/elements/1.1/source> <http://www.w3.org/2006/time#2016>)
Annotation(owl:versionInfo "2026-09-29")

Declaration(ObjectProperty(<http://www.w3.org/2006/time#hasDuration>))
Declaration(DataProperty(<http://www.w3.org/2006/time#inXSDDateTime>))
Declaration(DataProperty(<http://www.w3.org/2006/time#inXSDDateTimeStamp>))
Declaration(AnnotationProperty(<http://purl.org/dc/elements/1.1/source>))
Declaration(AnnotationProperty(<http://purl.org/dc/terms/contributor>))
Declaration(AnnotationProperty(<http://purl.org/dc/terms/created>))
Declaration(AnnotationProperty(<http://purl.org/dc/terms/creator>))
Declaration(AnnotationProperty(<http://purl.org/dc/terms/license>))
Declaration(AnnotationProperty(<http://www.w3.org/2004/02/skos/core#definition>))
Declaration(AnnotationProperty(<http://www.w3.org/2004/02/skos/core#example>))
Declaration(Datatype(xsd:date))

############################
#   Object Properties
############################

# Object Property: <http://www.w3.org/2006/time#hasDuration> (tiene duración)

AnnotationAssertion(rdfs:label <http://www.w3.org/2006/time#hasDuration> "has duration"@en)
AnnotationAssertion(rdfs:label <http://www.w3.org/2006/time#hasDuration> "tiene duración"@es)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.w3.org/2006/time#hasDuration> "Duración de una entidad temporal, evento o actividad, o cosa, expresada como un valor escalado."@es)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.w3.org/2006/time#hasDuration> "Duration of a temporal entity, event or activity, or thing, expressed as a scaled value"@en)


############################
#   Data Properties
############################

# Data Property: <http://www.w3.org/2006/time#inXSDDateTime> (DEPRECATED en fecha-tiempo XSD)

AnnotationAssertion(rdfs:label <http://www.w3.org/2006/time#inXSDDateTime> "DEPRECATED en fecha-tiempo XSD"@es)
AnnotationAssertion(rdfs:label <http://www.w3.org/2006/time#inXSDDateTime> "DEPRECATED in XSD Date-Time"@en)
AnnotationAssertion(rdfs:seeAlso <http://www.w3.org/2006/time#inXSDDateTime> <http://www.w3.org/2006/time#inXSDDateTimeStamp>)
AnnotationAssertion(owl:deprecated <http://www.w3.org/2006/time#inXSDDateTime> "true"^^xsd:boolean)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.w3.org/2006/time#inXSDDateTime> "DEPRECATED Posición de un instante, expresado utilizando xsd:dateTime."@es)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.w3.org/2006/time#inXSDDateTime> "DEPRECATED Position of an instant, expressed using xsd:dateTime"@en)

# Data Property: <http://www.w3.org/2006/time#inXSDDateTimeStamp> (en fecha-sello de tiempo XSD)

AnnotationAssertion(rdfs:label <http://www.w3.org/2006/time#inXSDDateTimeStamp> "en fecha-sello de tiempo XSD"@es)
AnnotationAssertion(rdfs:label <http://www.w3.org/2006/time#inXSDDateTimeStamp> "in XSD Date-Time-Stamp"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.w3.org/2006/time#inXSDDateTimeStamp> "Posición de un instante, expresado utilizando xsd:dateTimeStamp."@es)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.w3.org/2006/time#inXSDDateTimeStamp> "Position of an instant, expressed using xsd:dateTimeStamp"@en)

# Data Property: <http://www.w3.org/2006/time#inXSDDateTimeStamp> (en fecha-sello de tiempo XSD)

AnnotationAssertion(rdfs:label <http://www.w3.org/2006/time#inXSDDateTimeStamp> "en fecha-sello de tiempo XSD"@es)
AnnotationAssertion(rdfs:label <http://www.w3.org/2006/time#inXSDDateTimeStamp> "in XSD Date-Time-Stamp"@en)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.w3.org/2006/time#inXSDDateTimeStamp> "Posición de un instante, expresado utilizando xsd:dateTimeStamp."@es)
AnnotationAssertion(<http://www.w3.org/2004/02/skos/core#definition> <http://www.w3.org/2006/time#inXSDDateTimeStamp> "Position of an instant, expressed using xsd:dateTimeStamp"@en)



)