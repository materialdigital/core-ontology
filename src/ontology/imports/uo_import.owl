# Class: <http://purl.obolibrary.org/obo/UO_0000000> (unit)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Wikipedia") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UO_0000000> "A unit of measurement is a standardized quantity of a physical quality.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_0000000> "unit")

# Class: <http://purl.obolibrary.org/obo/UO_0000003> (time unit)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Wikipedia") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UO_0000003> "A unit which is a standard measure of the dimension in which events occur in sequence.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UO_0000003> "time derived unit")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_0000003> "time unit")
SubClassOf(<http://purl.obolibrary.org/obo/UO_0000003> <http://purl.obolibrary.org/obo/UO_0000000>)

# Class: <http://purl.obolibrary.org/obo/UO_0000051> (concentration unit)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UOC:GVG") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UO_0000051> "A unit which represents a standard measurement of how much of a given substance there is mixed with another substance.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_0000051> "concentration unit")
SubClassOf(<http://purl.obolibrary.org/obo/UO_0000051> <http://purl.obolibrary.org/obo/UO_0000000>)

# Class: <http://purl.obolibrary.org/obo/UO_0000061> (unit of molarity)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UOC:GVG") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UO_0000061> "A concentration unit which is a standard measure of the number of moles of a given substance per liter of solution.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_0000061> "unit of molarity")
SubClassOf(<http://purl.obolibrary.org/obo/UO_0000061> <http://purl.obolibrary.org/obo/UO_0000051>)

# Class: <http://purl.obolibrary.org/obo/UO_0000067> (unit of molality)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UOC:GVG") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UO_0000067> "A concentration unit which is a standard measure of the number of moles of a given substance per kilogram of solvent.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_0000067> "unit of molality")
SubClassOf(<http://purl.obolibrary.org/obo/UO_0000067> <http://purl.obolibrary.org/obo/UO_0000051>)

# Class: <http://purl.obolibrary.org/obo/UO_0000076> (mole fraction)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Wikipedia") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UO_0000076> "A concentration unit which denotes the number of moles of solute as a proportion of the total number of moles in a solution.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UO_0000076> "(x)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UO_0000076> "chi")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_0000076> "mole fraction")
SubClassOf(<http://purl.obolibrary.org/obo/UO_0000076> <http://purl.obolibrary.org/obo/UO_1000076>)

# Class: <http://purl.obolibrary.org/obo/UO_0000163> (mass percentage)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Wikipedia") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UO_0000163> "A dimensionless concentration unit which denotes the mass of a substance in a mixture as a percentage of the mass of the entire mixture.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UO_0000163> "w/w")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UO_0000163> "weight-weight percentage")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_0000163> "mass percentage")
SubClassOf(<http://purl.obolibrary.org/obo/UO_0000163> <http://purl.obolibrary.org/obo/UO_1000163>)

# Class: <http://purl.obolibrary.org/obo/UO_0000164> (mass volume percentage)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UOC:GVG") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UO_0000164> "A dimensionless concentration unit which denotes the mass of the substance in a mixture as a percentage of the volume of the entire mixture.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UO_0000164> "(w/v)")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UO_0000164> "weight-volume percentage")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_0000164> "mass volume percentage")
SubClassOf(<http://purl.obolibrary.org/obo/UO_0000164> <http://purl.obolibrary.org/obo/UO_1000164>)

# Class: <http://purl.obolibrary.org/obo/UO_0000169> (parts per million)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "UOC:GVG") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UO_0000169> "A dimensionless concentration notation which denotes the amount of a given substance in a total amount of 1,000,000 regardless of the units of measure used as long as they are the same or 1 part in 10^[6].")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UO_0000169> "10^[-6]")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UO_0000169> "ppm")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_0000169> "parts per million")
SubClassOf(<http://purl.obolibrary.org/obo/UO_0000169> <http://purl.obolibrary.org/obo/UO_1000169>)

# Class: <http://purl.obolibrary.org/obo/UO_0000187> (percent)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Wikipedia") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UO_0000187> "A dimensionless ratio unit which denotes numbers as fractions of 100.")
AnnotationAssertion(<http://www.geneontology.org/formats/oboInOwl#hasExactSynonym> <http://purl.obolibrary.org/obo/UO_0000187> "%")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_0000187> "percent")
SubClassOf(<http://purl.obolibrary.org/obo/UO_0000187> <http://purl.obolibrary.org/obo/UO_0000000>)

# Class: <http://purl.obolibrary.org/obo/UO_0000191> (fraction)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "Wikipedia:Wikipedia") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UO_0000191> "A dimensionless ratio unit which relates the part (the numerator) to the whole (the denominator).")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_0000191> "fraction")
SubClassOf(<http://purl.obolibrary.org/obo/UO_0000191> <http://purl.obolibrary.org/obo/UO_0000000>)

# Class: <http://purl.obolibrary.org/obo/UO_0000205> (volume per unit volume)

AnnotationAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "NIST:NIST") <http://purl.obolibrary.org/obo/IAO_0000115> <http://purl.obolibrary.org/obo/UO_0000205> "A dimensionless concentration unit which denotes the given volume of the solute in the total volume of the resulting solution.")
AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_0000205> "volume per unit volume")
SubClassOf(<http://purl.obolibrary.org/obo/UO_0000205> <http://purl.obolibrary.org/obo/UO_0000051>)

# Class: <http://purl.obolibrary.org/obo/UO_1000076> (mole fraction based unit)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_1000076> "mole fraction based unit")
SubClassOf(<http://purl.obolibrary.org/obo/UO_1000076> <http://purl.obolibrary.org/obo/UO_0000051>)
SubClassOf(<http://purl.obolibrary.org/obo/UO_1000076> <http://purl.obolibrary.org/obo/UO_0000191>)

