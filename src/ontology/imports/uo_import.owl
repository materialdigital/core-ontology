AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_1000164> "mass volume percentage based unit")
SubClassOf(<http://purl.obolibrary.org/obo/UO_1000164> <http://purl.obolibrary.org/obo/UO_0000051>)
SubClassOf(<http://purl.obolibrary.org/obo/UO_1000164> <http://purl.obolibrary.org/obo/UO_0000187>)

# Class: <http://purl.obolibrary.org/obo/UO_1000169> (parts per million based unit)

AnnotationAssertion(rdfs:label <http://purl.obolibrary.org/obo/UO_1000169> "parts per million based unit")
SubClassOf(<http://purl.obolibrary.org/obo/UO_1000169> <http://purl.obolibrary.org/obo/UO_0000000>)

# Class: <http://purl.obolibrary.org/obo/UO_1000180> (mass per unit volume based unit)

