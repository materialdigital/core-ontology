SubClassOf(pmd:PMD_0080134 ObjectSomeValuesFrom(obo:RO_0000092 ObjectIntersectionOf(pmd:PMD_0000000 ObjectSomeValuesFrom(obo:RO_0000056 pmd:PMD_0020263))))

