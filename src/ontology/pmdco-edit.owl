AnnotationAssertion(rdfs:label pmd:PMD_0020271 "volume per mass"@en)
AnnotationAssertion(skos:definition pmd:PMD_0020271 "a relational quality expressing the volume of a part in relation to the mass of the whole"@en)
AnnotationAssertion(skos:example pmd:PMD_0020271 "the resin volume is 300 l per ton of fiber reinforced composite"@en)
EquivalentClasses(pmd:PMD_0020271 ObjectIntersectionOf(pmd:PMD_0020101 ObjectSomeValuesFrom(pmd:PMD_0020256 ObjectIntersectionOf(obo:BFO_0000001 ObjectSomeValuesFrom(obo:RO_0000086 ObjectIntersectionOf(pmd:PMD_0020150 ObjectSomeValuesFrom(pmd:PMD_0000077 obo:OBI_0001931))))) ObjectSomeValuesFrom(pmd:PMD_0020257 ObjectIntersectionOf(obo:BFO_0000001 ObjectSomeValuesFrom(obo:RO_0000086 ObjectIntersectionOf(pmd:PMD_0020133 ObjectSomeValuesFrom(pmd:PMD_0000077 obo:OBI_0001931)))))))

