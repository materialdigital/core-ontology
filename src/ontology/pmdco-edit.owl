AnnotationAssertion(obo:IAO_0000116 pmd:PMD_0020270 "it is not possible to formulate the equivalent axiom in OWL 2"@en)
AnnotationAssertion(rdfs:label pmd:PMD_0020270 "part-whole property"@en)
AnnotationAssertion(skos:definition pmd:PMD_0020270 "a relational property between the whole and a part of the whole"@en)
AnnotationAssertion(skos:example pmd:PMD_0020270 "the mass fraction of the neutrons of an atom"@en)
SubClassOf(pmd:PMD_0020270 pmd:PMD_0020108)
SubClassOf(pmd:PMD_0020270 ObjectSomeValuesFrom(pmd:PMD_0025999 ObjectIntersectionOf(obo:BFO_0000001 ObjectSomeValuesFrom(obo:BFO_0000050 obo:BFO_0000001))))
SubClassOf(pmd:PMD_0020270 ObjectSomeValuesFrom(pmd:PMD_0025999 ObjectIntersectionOf(obo:BFO_0000001 ObjectSomeValuesFrom(obo:BFO_0000051 obo:BFO_0000001))))

