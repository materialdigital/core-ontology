AnnotationAssertion(rdfs:label pmd:PMD_0020269 "count per mass"@en)
AnnotationAssertion(skos:definition pmd:PMD_0020269 "a relational quality expressing a count of a part in relation to the the mass of the whole"@en)
AnnotationAssertion(skos:example pmd:PMD_0020269 "10e14 fibers in 1 ton of fiber reinforced resin"@en)
EquivalentClasses(pmd:PMD_0020269 ObjectIntersectionOf(pmd:PMD_0020101 ObjectSomeValuesFrom(pmd:PMD_0020256 ObjectIntersectionOf(obo:BFO_0000001 ObjectSomeValuesFrom(obo:RO_0000086 ObjectIntersectionOf(pmd:PMD_0020367 ObjectSomeValuesFrom(pmd:PMD_0000077 obo:OBI_0001931))))) ObjectSomeValuesFrom(pmd:PMD_0020257 ObjectIntersectionOf(obo:BFO_0000001 ObjectSomeValuesFrom(obo:RO_0000086 ObjectIntersectionOf(pmd:PMD_0020133 ObjectSomeValuesFrom(pmd:PMD_0000077 obo:OBI_0001931)))))))

