# Run on merged.owl for asserted answers; no inference is needed for these paths.
# Conditions and plan settings use the same patterns as computational-modelling-data-violation.sparql.
PREFIX ex: <https://example.org/pmdco/computational-test/>
PREFIX pmd: <https://w3id.org/pmd/co/>
PREFIX obo: <http://purl.obolibrary.org/obo/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
SELECT DISTINCT ?kind ?source ?target WHERE {
{ ?source pmd:PMD_0200013 ?target . BIND("model" AS ?kind) }
 UNION
{ ?source obo:BFO_0000051 ?target . ?target a pmd:PMD_0200010 . BIND("method" AS ?kind) }
 UNION
{ ?source a pmd:PMD_0200009; obo:IAO_0000136 ?target . BIND("represented" AS ?kind) }
 UNION
{ ?source a pmd:PMD_0200009 . ?target obo:IAO_0000136 ?source; obo:OBI_0001938 ?value . BIND("model parameter" AS ?kind) }
 UNION
{ ?source a pmd:PMD_0200010 . ?target obo:IAO_0000136 ?source; obo:OBI_0001938 ?value . BIND("numerical setting" AS ?kind) }
 UNION
{ ?source a pmd:PMD_0200009 . ?spec obo:OBI_0001927 ?source; a pmd:PMD_0200012; obo:IAO_0000219 ?target . BIND("granularity" AS ?kind) }
 UNION
{ ?source obo:OBI_0000293 ?target . ?target obo:IAO_0000136 ?represented . FILTER NOT EXISTS { ?target a pmd:PMD_0200009 } BIND("system input" AS ?kind) }
 UNION
{ ?source a pmd:PMD_0200011; obo:BFO_0000051 ?target . ?target a obo:IAO_0000027; obo:IAO_0000136 ?about; obo:OBI_0001938 ?value . ?run obo:STATO_0000102 ?source; obo:OBI_0000293 ?about . FILTER NOT EXISTS { ?target obo:IAO_0000136 ?procedure . ?procedure a pmd:PMD_0200010 } BIND("condition" AS ?kind) }
 UNION
{ ?source a pmd:PMD_0200011; obo:BFO_0000051 ?target . ?target a obo:IAO_0000027; obo:IAO_0000136 ?procedure; obo:OBI_0001938 ?value . ?procedure a pmd:PMD_0200010 . ?source obo:BFO_0000051 ?procedure . BIND("plan setting" AS ?kind) }
} ORDER BY ?kind ?source ?target
