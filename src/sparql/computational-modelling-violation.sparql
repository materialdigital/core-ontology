# Run on the reasoned isolated fixture, not on release data.
PREFIX ex: <https://example.org/pmdco/computational-test/>
PREFIX rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#>
PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
SELECT ?entity ?type ?issue WHERE {
  {
    ?entity ex:expectedType ?type .
    FILTER NOT EXISTS { ?entity rdf:type/rdfs:subClassOf* ?type }
    BIND("missing expected type" AS ?issue)
  } UNION {
    ?entity ex:forbiddenType ?type ; rdf:type/rdfs:subClassOf* ?type .
    BIND("unintended inferred type" AS ?issue)
  }
}
