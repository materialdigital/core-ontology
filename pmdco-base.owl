        <rdfs:label xml:lang="en">non-clay ceramic</rdfs:label>
        <skos:definition xml:lang="en">natural ceramic that is formed from raw materials other than clay</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050050 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050050">
