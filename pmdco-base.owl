                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000967"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020150"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020151"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080050"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">Gibbs energy</rdfs:label>
        <skos:definition xml:lang="en">G = U + pV - TS
U - inner energy of system
T - absolute temperature
S - entropy
p - pressure
V - volume</skos:definition>
    </owl:Class>
    


