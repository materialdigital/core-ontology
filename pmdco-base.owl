        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020235"/>
        <rdfs:label xml:lang="en">mixed dislocation</rdfs:label>
        <skos:definition xml:lang="en">a dislocation that spans edge dislocation as well as screw dislocation</skos:definition>
    </owl:Class>
    


