        <rdfs:label xml:lang="en">zirconia matrix composite</rdfs:label>
        <skos:definition xml:lang="en">oxide-oxide composite that uses zirconia as the primary matrix reinforced by additional oxide phases</skos:definition>
    </owl:Class>
    


