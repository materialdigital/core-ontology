    <!-- https://w3id.org/pmd/co/PMD_0020098 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020098">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000031"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Naturkonstante</rdfs:label>
        <rdfs:label xml:lang="en">nature constant</rdfs:label>
        <skos:definition xml:lang="en">A nature constant is a generically dependent continuant whose value, maginitude or configuration is determined by nature including physics and mathematics.</skos:definition>
        <skos:definition xml:lang="de">Eine Naturkonstante ist ein generisch abhängiger Kontinuant, dessen Wert, Größe oder Konfiguration durch die Natur, einschließlich Physik und Mathematik, bestimmt wird.</skos:definition>
        <skos:example xml:lang="en">Examples of nature constants are the speed of light, pi, etc.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020099 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020099">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">TODO: possibly extend for 2D (Graphene etc)

More elaborate crystal descriptions may be found in http://emmo.info/domain-crystallography/crystallography or https://purls.helmholtz-metadaten.de/disos/cso</rdfs:comment>
        <rdfs:label xml:lang="de">Bravais-Gitter (3D)</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice (3D)</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">Das Bravais-Gitter ist eine kategoriale Wertspezifikation, die den Wert der Kristallstrukturqualität angibt. Es beschreibt die mögliche geometrische Anordnung von Gitterpunkten in einem Kristall. Der vorliegende Deskriptor beschränkt sich auf die 14 möglichen dreidimensionalen Anordnungen.</skos:definition>
        <skos:definition xml:lang="en">The bravais lattice is a categorical value specification that specifies value of the crystal structure quality. It describes the possible geometric arrangement of lattice points in a crystal. The present descriptor is limited to the 14 possible three-dimensional arrangements.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020101 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020101">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Anteil</rdfs:label>
        <rdfs:label xml:lang="en">proportion</rdfs:label>
        <skos:definition xml:lang="en">A proportion is a relational quality between two entities (the whole and the part) which quantifies the relation between the whole and its part.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020102 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020102">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080069"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;mass ratio&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;material composition&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Massenverhältnis</rdfs:label>
        <rdfs:label xml:lang="en">mass ratio</rdfs:label>
        <skos:definition xml:lang="de">Das Massenverhältnis bezeichnet eine relationale Qualität, die einen Massenwert im Verhältnis zu einem anderen ausdrückt und typischerweise eine dimensionslose Zahl ergibt</skos:definition>
        <skos:definition xml:lang="en">Mass ratio denotes a relational quality expressing one mass value relative to another, typically producing a dimensionless number</skos:definition>
        <skos:example xml:lang="en">A fiber-reinforced composite has a fiber-to-matrix mass ratio of 60:40</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020103 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020103">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080069"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Molverhältnis</rdfs:label>
        <rdfs:label xml:lang="en">molar ratio</rdfs:label>
        <skos:altLabel xml:lang="en">molar proportion</skos:altLabel>
        <skos:definition xml:lang="de">Der Molanteil ist der Anteil, der die Anzahl der Einheiten des Teils im Verhältnis zur Anzahl der Einheiten des Ganzen quantifiziert.</skos:definition>
        <skos:definition xml:lang="en">Molar proportion is the proportion which quantifies the entities count of the part in relation to the entities count of the whole.</skos:definition>
        <skos:example xml:lang="en">The molar ratio of hydrogen gas H2 molecules to water H2O molecules is 1/1 in the oxyhydrogen reaction. The molar ratio of oxygen molecules O2 to water molecules is 2/1.
The molar ratio of carbon dioxide to average atmosphere air is 420 ppm as of 2022 AD.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020104 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020104">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080069"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;volume ratio&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;material composition&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Volumenverhältnis</rdfs:label>
        <rdfs:label xml:lang="en">volume ratio</rdfs:label>
        <skos:definition xml:lang="en">Volume ratio represents a relational quality expressing one volume value relative to another, typically resulting in a dimensionless number</skos:definition>
        <skos:definition xml:lang="de">Volumenverhältnis stellt eine relationale Qualität dar, die einen Volumenwert im Verhältnis zu einem anderen ausdrückt, typischerweise resultierend in einer dimensionslosen Zahl</skos:definition>
        <skos:example xml:lang="en">A foam material has a pore-to-solid volume ratio of 4:1, indicating 80 % porosity</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020105 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020105">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000127"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000110"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000127"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000110"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">geogenic mineral</rdfs:label>
        <skos:definition xml:lang="en">material that is formed through geological processes</skos:definition>
        <skos:example>such as Quartz (Silicates) or calcite (Carbonate) or Feldspar (Aluminosilicate)</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020106 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020106">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000890"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000663"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">polycrystal</rdfs:label>
        <skos:altLabel xml:lang="en">Polycrystalline structure</skos:altLabel>
        <skos:definition xml:lang="en">A polycrystal is a connected material entity aggregate that consists of multiple crystal grains joined through crystallographic interfaces.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020112 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020112">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <obo:IAO_0100001 rdf:resource="http://purl.obolibrary.org/obo/STATO_0000225"/>
        <rdfs:label xml:lang="de">Korngrößenverteilung</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE grain size distribution</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">An intensive quality describing the lower length scale object aggregate (grains) that is part of the material.</skos:definition>
        <skos:definition xml:lang="de">Eine intensive Qualität, die das Objektaggregat (Körner) auf niedrigerer Längenskala beschreibt, das Teil des Materials ist.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020113 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020113">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020289"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020290"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">fluid (object)</rdfs:label>
        <skos:definition xml:lang="en">Fluid (object) is an object that consists of some portion of matter which bears an aggregate state that concretizes a liquid or gaseous aggregate state.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020114 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020114">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020254"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">medium role</rdfs:label>
        <skos:definition xml:lang="en">Medium role is a role beared by an object which implies that the object serves as an intermediary for the transmission of something else, like energy, force, or information.</skos:definition>
        <skos:example xml:lang="en">Air in the air cooling process, N2 atmosphere in a furnace cooling process, oil in a quenching process, crystal lattice in a solid state diffusion</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020115 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020115">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000891"/>
        <rdfs:label xml:lang="en">aerosol</rdfs:label>
        <skos:definition xml:lang="en">An aerosol is a disconnected material entity aggregate which:
1. consists of some portion of matter whose aggregate state quality concretizes gaseous and 
2. consists of some portion of matter whose aggregate state quality concretises solid or liquid (TODO: express that this portion is also a disconnected material entity aggregate)</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020116 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020116">
        <rdfs:comment>Make entity member of subclass of &apos;portion of matter in aggregate state&apos;</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED aggregate state value</rdfs:label>
        <rdfs:label xml:lang="de">DEPRECATED aggregierter Zustandswert</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">DEPRECATED Der Aggregatzustandswert ist eine kategoriale Wertspezifikation, die den Wert der Aggregatzustandsqualität angibt.</skos:definition>
        <skos:definition xml:lang="en">DEPRECATED The aggregate state value is a categorical value specification that specifies value of the aggregate state quality.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020126 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020126">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000890"/>
        <obo:IAO_0000119>old defintion: A foam is a material entity aggregate that is also a composite material c. 
The parts of c that have the filler role are vacuum-filled or gas filled pores. 
The parts of c that have the matrix role consist of a material that is bearer of solid or liquid aggregate state. 
One pore with its surrounding matrix is called &apos;cell&apos;. 
Depending on the interconnectedness of the pores the foam is open- or closed-cell.</obo:IAO_0000119>
        <rdfs:label xml:lang="en">foam</rdfs:label>
        <skos:definition xml:lang="en">A foam is a connected material entity aggregate that consists of a solid or liquid matrix containing gas-filled or vacuum-filled pores forming cellular structures.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020128 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020128">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">thermodynamic system</rdfs:label>
        <skos:definition xml:lang="en">A thermodynamic system is a material entity whose parts are bearer of thermodynamic properties. A thermodynamic system environs a thermodynamic process by which the thermodynamic properties of the objects of the thermodynamic system change over time.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020129 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">reversible process</rdfs:label>
        <rdfs:label xml:lang="de">reversibler Prozess</rdfs:label>
        <skos:definition xml:lang="en">A reversible process is a process whose participants form a thermodynamic system with an entropy S and S remains constant during the process.</skos:definition>
        <skos:definition xml:lang="de">Ein reversibler Prozess ist ein Prozess, dessen Teilnehmer ein thermodynamisches System mit einer Entropie S bilden und S während des Prozesses konstant bleibt.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020130 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020130">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020128"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000553"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">thermodynamic driving force</rdfs:label>
        <skos:definition>The driving force for a phase transformation or mass transfer is proportional to the difference in chemical potential between phases

Δμ=μα−μβ, with chemical potential μ and phases α and β</skos:definition>
        <skos:example>For α → β: ΔG = G_β − G_α. If ΔG &lt; 0, the transformation is thermodynamically favorable; many report the driving force as F = −ΔG &gt; 0</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020131 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020131">
        <rdfs:label xml:lang="en">DEPRECATED intensive quality</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/pmd/co/PMD_0020318"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">DEPRECATED An intensive quality is a quality that inheres in only portion of matter and thus is independent of the bearers (system-) size.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020132 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020132">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000019"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000024"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000029"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000140"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">spatial extend</rdfs:label>
        <skos:definition xml:lang="en">Dimension quality is a quality of a material entity that pertains to its measurable spatial extent, such as length, area, or volume</skos:definition>
        <skos:example xml:lang="en">the wall thickness of a steel pipe is a dimension quality functionally related to its pressure resistance</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020133 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020133">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000024"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Masse</rdfs:label>
        <rdfs:label xml:lang="en">mass</rdfs:label>
        <skos:definition xml:lang="en">Mass is fundamental extensive quality.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020134 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020134">
        <rdfs:comment>Will deal with causality later</rdfs:comment>
        <rdfs:label xml:lang="de">DEPRECATED Reizrolle</rdfs:label>
        <rdfs:label xml:lang="en">DEPRECATED stimulus role</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">DEPRECATED Die Reizrolle ist eine Rolle, die ein Objekt in einem Prozess spielt, wenn es ein anderes Objekt, das im selben Prozess eine Stimulationszielrolle spielt, kausal beeinflusst. „Rolle“ impliziert hier, dass die „tragende“ Zuordnung von der Absicht abhängt.</skos:definition>
        <skos:definition xml:lang="en">DEPRECATED The stimulus role is a role that an object bears in a process when causally influencing another object  that bears a stimulation target role in the same process. &apos;Role&apos; implies here, that the &apos;bearing&apos; assignment depends on the intent.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020135 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020135">
        <rdfs:comment>Will deal with causality later</rdfs:comment>
        <rdfs:label xml:lang="de">DEPRECATED Stimulationszielrolle</rdfs:label>
        <rdfs:label xml:lang="en">DEPRECATED stimulation target role</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">DEPRECATED See &apos;Stimulus role&apos;</skos:definition>
        <skos:definition xml:lang="de">DEPRECATED Siehe „Stimulusrolle“</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020136 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020136">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">The number of phases involved can vary as well as the mechanisms involved can be different.</rdfs:comment>
        <rdfs:label xml:lang="en">phase transformation</rdfs:label>
        <skos:definition xml:lang="en">A thermodynamic phase transformation is a process in/of a thermodynamic system, that involves the transformation of phases of the system to other phases.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020137 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020137">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020000"/>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0020149"/>
        <rdfs:comment xml:lang="en">See metastable phase</rdfs:comment>
        <rdfs:label xml:lang="en">stable phase</rdfs:label>
        <skos:definition xml:lang="en">A stable phase is a phase that does not have a &quot;pmd:disposition of a phase to transform&quot; in the &quot;pmd:phase transformation&quot; it participates.</skos:definition>
        <skos:example xml:lang="en">A phase that participates in a phase transformation pt and pt that is not a metastable phase.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020138 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020138">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <rdfs:label xml:lang="en">lot</rdfs:label>
        <skos:definition xml:lang="en">A lot is an object aggregate whose parts are output of the same production process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020139 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020139">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020113"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020290"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="de">Schmelze</rdfs:label>
        <rdfs:label xml:lang="en">melt</rdfs:label>
        <skos:definition xml:lang="en">is a fluid (object) with a disposition to realize a blank role in a manufacturing process</skos:definition>
        <skos:example xml:lang="en">molten PLA in a 3D printing process</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020140 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020140">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/CHEBI_60003"/>
        <rdfs:label xml:lang="en">portion of pure chemical element</rdfs:label>
        <skos:definition xml:lang="en">A portion of pure chemical element is a pure substance composed of multiple atoms, which are all of the same kind.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020141 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020141">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Fatigue is typically of interest when the change of the material affects the objects ability to fulfill its function.</rdfs:comment>
        <rdfs:label xml:lang="en">fatigue (reaction to repetitive loading)</rdfs:label>
        <skos:definition xml:lang="en">fatigue is a process that affects an material entities integrity by nucleation and growing cracks.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020142 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000024"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="http://openenergy-platform.org/ontology/oeo/OEO_00000150"/>
        <rdfs:label xml:lang="de">Energie</rdfs:label>
        <rdfs:label xml:lang="en">energy</rdfs:label>
        <skos:definition xml:lang="en">an extensive quality of material entities which manifests as a capacity to perform work (such as causing motion or the interaction of molecules)</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020143 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">process chain</rdfs:label>
        <skos:definition xml:lang="en">A process chain is a process that &apos;has continuant part&apos; subprocesses S1...Sn where S1...Sn precede each other and where some object or object aggregate that are output of Sn are then input to Sn+1.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020144 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020144">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020259"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000869"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_59999"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">product (chemical reaction)</rdfs:label>
        <skos:definition xml:lang="en">Product is the role of a material entity that is output of a chemical reaction and is created or transformed during the reaction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020145 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020145">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020259"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000869"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_59999"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">educt</rdfs:label>
        <skos:definition xml:lang="en">Educt is the role of a material entity that is input of a chemical reaction and is consumed or transformed during the reaction</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020146 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020146">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000869"/>
                            <owl:Class>
                                <owl:complementOf>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025013"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0025001"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                                                        <owl:hasSelf rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:hasSelf>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:complementOf>
                            </owl:Class>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000092"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_59999"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">catalytic disposition</rdfs:label>
        <skos:definition xml:lang="en">Catalyst is the role of a participant in a chemical reaction that does not alter its qualities/realizable entities  after the chemical reaction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020147 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020147">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020136"/>
        <rdfs:comment xml:lang="en">It is defined on the phase diagram at fixed composition and typically proceeds by diffusion‑controlled nucleation and growth (e.g., γ → α + Fe3C producing pearlite in steels).</rdfs:comment>
        <rdfs:label xml:lang="en">eutectoid phase transformation</rdfs:label>
        <skos:definition xml:lang="en">A eutectoid phase transformation is a phase transformation in which a solid parent phase of eutectoid composition decomposes into two distinct solid daughter phases at constant temperature and pressure.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020148 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020148">
        <rdfs:label xml:lang="en">DEPRECATED extensive quality</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://w3id.org/pmd/co/PMD_0020319"/>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">DEPRECATED An extensive quality is a quality that inheres in only object or object aggregate or fiat object part or chemical entity and is dependent on the bearers (system-) size.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020149 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020149">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020000"/>
        <rdfs:comment xml:lang="en">The stability of a phase can only be evaluated in the context of a (possibly unknown) phase transformation process.</rdfs:comment>
        <rdfs:label xml:lang="en">metastable phase</rdfs:label>
        <skos:definition xml:lang="en">A metastable phase phase_trans is a phase that has a &quot;pmd:disposition of a phase to transform&quot; disp_trans and disp_trans is realized in a &quot;pmd:phase transformation&quot; proc_trans and proc_trans has participant sys_trans and sys_trans has part phase_trans.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020150 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020150">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023000"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;volume&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;DimensionQuality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000918.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Volumen</rdfs:label>
        <rdfs:label xml:lang="en">volume</rdfs:label>
        <skos:definition xml:lang="en">Volume is a three dimensional size.</skos:definition>
        <skos:definition xml:lang="de">Volumen ist eine dreidimensionale Größe.</skos:definition>
        <skos:example xml:lang="en">A cylindrical billet has a volume of 0.002 m3, determined from its radius and height</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020151 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020151">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020142"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023000"/>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0020155"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">innere Energie</rdfs:label>
        <rdfs:label xml:lang="en">internal energy</rdfs:label>
        <skos:definition xml:lang="de">Innere Energie ist eine universelle umfassende Qualität, die das Potenzial des Trägers zur Arbeit festlegt.</skos:definition>
        <skos:definition xml:lang="en">Internal energy is a universal extensive quality that specifies the bearers potential to do work.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020152 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020152">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <rdfs:label xml:lang="en">component</rdfs:label>
        <skos:definition xml:lang="en">A component is an object aggregate that bears a function in a technical system.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020153 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020153">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000833"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">technical system</rdfs:label>
        <skos:definition xml:lang="en">A technical system is an object aggregate: 
1. that is output of a manufacturing process, 
2. that has some function,
3. whose continuant parts are some components.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020154 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020154">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020136"/>
        <rdfs:comment xml:lang="en">It proceeds by nucleation and growth.</rdfs:comment>
        <rdfs:label xml:lang="en">precipitation (phase)</rdfs:label>
        <skos:definition xml:lang="en">Precipitation from a supersaturated solid solution is a phase transformation process in which a single supersaturated parent phase decomposes into a solute‑depleted matrix and dispersed, compositionally distinct precipitate phases.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020155 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020155">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020142"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">interatomare Wechselwirkungsenergie</rdfs:label>
        <rdfs:label xml:lang="en">interatomic interaction energy</rdfs:label>
        <skos:definition xml:lang="de">Interatomare Wechselwirkungsenergie wird dem Atomaggregat hinzugefügt/entfernt, wenn ein Atom unendlich vom Rest des Aggregats entfernt wird.</skos:definition>
        <skos:definition xml:lang="en">Interatomic interaction energy is added/removed from the atom aggregate if one atom is moved infinitely away from the rest of the aggregate.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020156 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020156">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020136"/>
        <rdfs:comment xml:lang="en">It is marked on phase diagrams by a peritectic point and proceeds by an interfacial, diffusion‑controlled reaction that is often kinetically sluggish, leading to incomplete transformation or complex microstructures during solidification.</rdfs:comment>
        <rdfs:label xml:lang="en">peritectic phase transformation</rdfs:label>
        <skos:definition xml:lang="en">A peritectic phase transformation is a phase transformation in which a liquid parent phase and an existing solid phase react on cooling to form a different solid phase (L + α → β).</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020157 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020157">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020136"/>
        <rdfs:comment xml:lang="en">Unlike nucleation and growth transformations, it has no nucleation barrier and proceeds by uphill diffusion and wavelength‑selective amplification of composition modulations, producing an interconnected, compositionally modulated microstructure that coarsens over time.</rdfs:comment>
        <rdfs:label xml:lang="en">spinodal decomposition</rdfs:label>
        <skos:definition xml:lang="en">Spinodal decomposition is a diffusion‑controlled  continuous phase transformation in which a single homogeneous solution spontaneously separates into two compositionally distinct phases by amplification of infinitesimal concentration fluctuations.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020158 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0020159"/>
        <rdfs:label xml:lang="en">parent phase role</rdfs:label>
        <skos:definition xml:lang="en">The parent phase role is the role of a phase that dissolves during the phase transformation process. As such, the bearer is a metastable phase.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020159 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020159">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">daughter phase role</rdfs:label>
        <skos:definition xml:lang="en">The daughter phase role is the role of a phase that forms during the phase transformation process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020160 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020160">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
        <rdfs:comment xml:lang="en">In metallography the term phase is sometimes used to denote microconstituents. To avoid confusion, the term phase should only be used for thermodynamic phases.</rdfs:comment>
        <rdfs:label xml:lang="en">microconstituent (phase mixture)</rdfs:label>
        <skos:definition xml:lang="en">A portion of matter that has one or more thermodynamic phases arranged in a characteristic spatial configuration (morphology) as parts.</skos:definition>
        <skos:example xml:lang="en">Pearlite is a microconstituent that has as parts the thermodynamic phases ferrite (α-Fe) and cementite (Fe3C) as parts. The characteristic spatial arrangement is in that case the lamellar orientation of the phases.

Martensite is a microconstituent that has as part the thermodynamic ferrite phase with characteristic morphologies and chemistry. Its presence and amount is governed by the processing path and kinetics.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020161 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020161">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_60003"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020227"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002350"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020229"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <obo:IAO_0000119>old defintion: 
Activity (a_X) is a relational property between a chemical species X and a non-ideal solution. a_X is a measure of the effective concentration of a chemical species X in the non-ideal solution, accounting for interactions between particles. It is defined as the product of the concentration and an activity coefficient, where the activity coefficient corrects for non-ideal behavior.</obo:IAO_0000119>
        <rdfs:label xml:lang="en">activity (thermodynamic)</rdfs:label>
        <rdfs:label xml:lang="de">thermodynamische Aktivität</rdfs:label>
        <skos:definition xml:lang="en">Thermodynamic activity is a relational quality that inheres between a chemical species and a non-ideal solution and represents the effective concentration of the species accounting for particle interactions.</skos:definition>
        <skos:definition xml:lang="de">Thermodynamische Aktivität ist eine Beziehungsqualität, die zwischen einer chemischen Spezies und einer nicht idealen Lösung innewohnt und die effektive Konzentration der Spezies darstellt, die für Partikelwechselwirkungen verantwortlich ist.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020162 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020162">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:label xml:lang="de">Aktivierungsenergie</rdfs:label>
        <rdfs:label xml:lang="en">activation energy</rdfs:label>
        <skos:definition xml:lang="en">Activation energy (E_a) a process attribute characterizing the minimum amount of energy required to initiate a reaction, allowing educts to overcome an energy barrier to transform into products.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020163 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020163">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020136"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">eutectic phase transformation</rdfs:label>
        <rdfs:label xml:lang="de">eutektische Phasenumwandlung</rdfs:label>
        <skos:definition xml:lang="en">A eutectic phase transformation is a phase transformation in which a liquid parent phase decomposes into two distinct solid daughter phases at constant temperature and pressure.</skos:definition>
        <skos:definition xml:lang="de">Eine eutektische Phasenumwandlung ist eine Phasenumwandlung, bei der eine flüssige Mutterphase bei konstanter Temperatur und konstantem Druck in zwei verschiedene feste Tochterphasen zerfällt.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020164 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020164">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000882"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Zustandsgrenze der Materie</rdfs:label>
        <rdfs:label xml:lang="en">state of matter boundary</rdfs:label>
        <skos:definition xml:lang="en">A state of matter boundary is a phase boundary that is realized by the transition from one aggregate state to another aggregate state.</skos:definition>
        <skos:definition xml:lang="de">Eine Zustandsgrenze ist eine Phasengrenze, die durch den Übergang von einem Aggregatzustand in einen anderen Aggregatzustand realisiert wird.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020165 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000092"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020000"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0080116"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020000"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">The disposition is grounded in the phases activity in the thermodynamic system in question.</rdfs:comment>
        <rdfs:label xml:lang="en">disposition of a phase to transform</rdfs:label>
        <skos:definition xml:lang="en">disposition of a phase to transform into another phase in a phase transformation process</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020166 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020166">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020139"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000534"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001001"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000852"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">heat (metallurgy)</rdfs:label>
        <skos:definition xml:lang="en">A heat is a fixed amount of metallic alloy that may be input to some manufacturing process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020167 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020167">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000882"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">structural boundary</rdfs:label>
        <rdfs:label xml:lang="de">strukturelle Grenze</rdfs:label>
        <skos:definition xml:lang="en">Structural phase boundary is a phase boundary that is realized in the transition from one structure to another structure.</skos:definition>
        <skos:definition xml:lang="de">Strukturelle Phasengrenze ist eine Phasengrenze, die beim Übergang von einer Struktur zu einer anderen Struktur realisiert wird.</skos:definition>
        <skos:example xml:lang="en">ɑ-Ɣ transformation in iron at 910 °C</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020168 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020168">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000882"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">magnetic boundary</rdfs:label>
        <rdfs:label xml:lang="de">magnetische Grenze</rdfs:label>
        <skos:definition xml:lang="en">A magnetic boundary is a phase boundary that is realized by the transition from one magnetic ordering to another magnetic ordering.</skos:definition>
        <skos:definition xml:lang="de">Eine magnetische Grenze ist eine Phasengrenze, die durch den Übergang von einer magnetischen Ordnung zu einer anderen magnetischen Ordnung realisiert wird.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020169 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020169">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000882"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Mischungsgrenze</rdfs:label>
        <rdfs:label xml:lang="en">mixture boundary</rdfs:label>
        <skos:definition xml:lang="en">A mixture boundary is a phase boundary that is realized by the transition from one phase to another phase in a system involving also chemical variations.</skos:definition>
        <skos:definition xml:lang="de">Eine Gemischgrenze ist eine Phasengrenze, die durch den Übergang von einer Phase in eine andere Phase in einem System realisiert wird, das auch chemische Variationen beinhaltet.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020170 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020170">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:comment xml:lang="en">The ingot may be hot rolled after casting...</rdfs:comment>
        <rdfs:label xml:lang="de">Bramme</rdfs:label>
        <rdfs:label xml:lang="en">ingot</rdfs:label>
        <skos:definition xml:lang="en">An ingot is an object that has a thick section and may bear a semi finished product role and that is the specified output of a casting process. At the same time it is a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020171 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020171">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000146"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Should it have exactly two phases as member parts?</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Phasengrenze (räumlich)</rdfs:label>
        <rdfs:label xml:lang="en">phase boundary (spatial)</rdfs:label>
        <skos:definition xml:lang="en">A fiat surface separating one phase from another phase.</skos:definition>
        <skos:definition xml:lang="de">Eine flache Oberfläche, die eine Phase von einer anderen trennt.</skos:definition>
        <skos:example xml:lang="en">The phase boundary between liquid and the gaseous phase in a tank. 
The phase boundary between Fe3C and Fe of a pearlite lamellae.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020172 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020172">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:label xml:lang="en">sheet</rdfs:label>
        <skos:definition xml:lang="en">A plate is a thin rectangular object that may bear a semi finished product role. At the same time it is a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020173 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020173">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:label xml:lang="en">billet</rdfs:label>
        <skos:definition xml:lang="en">A billet is a relatively compact object that may bear a semi finished product role. At the same time it is a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020174 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020174">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:label xml:lang="en">foil</rdfs:label>
        <skos:definition xml:lang="en">A plate is a very thin rectangular object that may bear a semi finished product role. At the same time it may be a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020175 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:comment xml:lang="en">Coils may have several sheets that are joined together.</rdfs:comment>
        <rdfs:label xml:lang="en">coil (coiled sheet)</rdfs:label>
        <skos:definition xml:lang="en">A coil is an object that has part some sheets or foils. At the same time it may be a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020176 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:label xml:lang="en">plate</rdfs:label>
        <skos:definition xml:lang="en">A plate is a thick rectangular object that may bear a semi finished product role. At the same time it may be a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020177 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020177">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:label xml:lang="en">bar</rdfs:label>
        <skos:definition xml:lang="en">A bar is a long object with rectangular section that may bear a semi finished product role. At the same time it may be a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020178 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020178">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:label xml:lang="en">rod</rdfs:label>
        <skos:definition xml:lang="en">A rod is a long object with oval or round section that may bear a semi finished product role. At the same time it may be a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020179 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020179">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:comment xml:lang="en">This class does not include cables or other compound structures.</rdfs:comment>
        <rdfs:label xml:lang="en">wire (semi finished product)</rdfs:label>
        <skos:definition xml:lang="en">A wire is a long and somewhat flexible object that may bear a semi finished product role. At the same time it is a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020180 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020180">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:label xml:lang="en">tube</rdfs:label>
        <skos:definition xml:lang="en">A tube is a long object with a hollow section and moderate wall thickness that may bear a semi finished product role. At the same time it may be a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020181 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020181">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:label xml:lang="en">pipe</rdfs:label>
        <skos:definition xml:lang="en">A tube is a long object with a hollow section and pronounced wall thickness that may bear a semi finished product role. At the same time it may be a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020182 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:label xml:lang="en">profile (semi finished product)</rdfs:label>
        <skos:definition xml:lang="en">A profile is a long object with determined section shape that may bear a semi finished product role. At the same time it may be a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020183 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020183">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000648"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Recker</rdfs:label>
        <rdfs:label xml:lang="en">stretch straightener machine</rdfs:label>
        <skos:definition xml:lang="en">A strech straightener machine is a forming machine that is used in a &quot;forming under tensile conditions&quot; process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020184 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020184">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Walzwerk</rdfs:label>
        <rdfs:label xml:lang="en">rolling mill</rdfs:label>
        <skos:definition xml:lang="en">A rolling mill is a device that has part some rolling stand and whose specified input participates in some forming process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020185 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020185">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">rolling stand</rdfs:label>
        <skos:definition xml:lang="en">A rolling stand is a device that is part of a rolling mill, has some work rolls and participates in a rolling pass.</skos:definition>
        <skos:definition xml:lang="de">Ein Walzstock ist ein Teil eines Walzwerks, hat als Teil Arbeitswalzen und nimmt Teil an einen Walzstich.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020186 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020186">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0010007"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020071"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">aluminium alloy</rdfs:label>
        <skos:definition xml:lang="en">non-ferrous metal consisting primarily of aluminium mixed with other elements</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020187 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020187">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0010007"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020054"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">copper alloy</rdfs:label>
        <skos:definition xml:lang="en">non-ferrous metal consisting primarily of copper combined with other elements</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020188 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020188">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0010007"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020051"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">nickel alloy</rdfs:label>
        <skos:definition xml:lang="en">non-ferrous metal consisting primarily of nickel combined with other elements</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020189 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020189">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0010007"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020095"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">titanium alloy</rdfs:label>
        <skos:definition xml:lang="en">non-ferrous metal consisting primarily of titanium combined with other elements</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020190 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020190">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000965"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">metallografischer Schnitt (Oberfläche)</rdfs:label>
        <rdfs:label xml:lang="en">metallographic section (surface)</rdfs:label>
        <skos:definition xml:lang="en">A surface layer (fiat object part) of an object which at the same time is a metal and the object is specified output of a planned process which describes the preparation of the surface.</skos:definition>
        <skos:definition xml:lang="de">Eine Oberflächenschicht (Fiat-Objektteil) eines Objekts, die gleichzeitig ein Metall ist und das Objekt ist das spezifizierte Ergebnis eines geplanten Prozesses, der die Vorbereitung der Oberfläche beschreibt.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020191 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020191">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:comment xml:lang="en">Typical dimensions of the round mountings are a diameter of 20-50 mm and a thickness of 10-20 mm.</rdfs:comment>
        <rdfs:label xml:lang="en">metallographic section (embedded sample)</rdfs:label>
        <skos:definition xml:lang="en">A metallographic section (embedded sample) is an object that has two parts: a metallic object that has a metallographic section (surface) as part and the mounting which is produced during a hot embedding or cold embedding process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020192 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020192">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020190"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Makroschliff (Metallographie)</rdfs:label>
        <rdfs:label xml:lang="en">macrosection (metallography)</rdfs:label>
        <skos:definition xml:lang="en">A macrosection (metallography) is a metallographic section (surface) that is produced directly on an object. The object may be cut in order to make accessible a section (fiat surface) of interest.</skos:definition>
        <skos:definition xml:lang="de">Ein Makroschliff (Metallografie) ist ein metallografischer Schnitt (Oberfläche), der direkt an einem Objekt angefertigt wird. Das Objekt kann geschnitten werden, um einen interessierenden Abschnitt (flache Oberfläche) zugänglich zu machen.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020193 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020193">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">tensile testpiece</rdfs:label>
        <skos:definition xml:lang="en">A tensile testpiece is a longitudinal object that has two parts which were designed for gripping (gripping section) at its ends and a part between the gripping sections that has been designed to observe the materials or the objects reaction to tensile loading.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020194 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020194">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:comment xml:lang="en">often used to describe mass transport from regions of high concentration to regions of low concentration</rdfs:comment>
        <rdfs:label xml:lang="en">diffusion</rdfs:label>
        <skos:definition xml:lang="en">process by which material entities spread or move due to random thermal motion</skos:definition>
        <skos:example>diffusion of a gas in different gas</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020195 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020195">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">crystallization</rdfs:label>
        <skos:definition xml:lang="en">process by which a solid with long-range order forms</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020196 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020196">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">recrystallization</rdfs:label>
        <skos:definition xml:lang="en">process in which a new, defect-free grain structure forms in a material from an existing deformed grain structure.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020197 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000147"/>
        <rdfs:label xml:lang="en">lattice point</rdfs:label>
        <skos:definition xml:lang="en">A lattice point is a fiat point that represents a position in a crystal lattice at which structural entities are regularly arranged.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020198 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020198">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <rdfs:label xml:lang="en">interstitial site</rdfs:label>
        <skos:definition xml:lang="en">An interstitial site is a site that is located between regular lattice points in a crystal structure.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020199 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020199">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000146"/>
        <rdfs:label xml:lang="en">slip plane</rdfs:label>
        <skos:definition xml:lang="en">A slip plane is a fiat surface that corresponds to a crystallographic plane of a 3D crystal along which dislocations can glide</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020200 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020200">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020311"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <obo:IAO_0000119>Old definition: Force is a reciprocal relation realized between two objects where the other object exerts the same force with opposite sign onto the first. Force may be responsible for changes in velocity and/or deformation of objects.</obo:IAO_0000119>
        <rdfs:label xml:lang="en">force</rdfs:label>
        <skos:definition xml:lang="en">A force is an entity that consists of a reciprocal interaction between two objects and is realized as equal and opposite influences capable of changing motion or causing deformation.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020201 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020201">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000146"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Abschnitt</rdfs:label>
        <rdfs:label xml:lang="en">section</rdfs:label>
        <skos:definition xml:lang="de">Ein Abschnitt ist eine ebene, flache Oberfläche, die das Objekt durchschneidet</skos:definition>
        <skos:definition xml:lang="en">Section is a planar fiat surface cutting across the object</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020202 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020202">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Riss</rdfs:label>
        <rdfs:label xml:lang="en">crack</rdfs:label>
        <skos:definition xml:lang="en">A crack is a site that consists of a physical separation within a material entity occurring at the level of atomic bonds.</skos:definition>
        <skos:definition xml:lang="de">Ein Riss ist eine Stelle, die aus einer physikalischen Trennung innerhalb einer Materialeinheit besteht, die auf der Ebene atomarer Bindungen erfolgt.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020203 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020203">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Kerbe</rdfs:label>
        <rdfs:label xml:lang="en">notch</rdfs:label>
        <skos:definition xml:lang="en">A notch is a site that consists of a geometric surface feature of an object characterized by a strong local change in shape or cross-section.</skos:definition>
        <skos:definition xml:lang="de">Eine Kerbe ist eine Stelle, die aus einem geometrischen Oberflächenmerkmal eines Objekts besteht, das durch eine starke lokale Änderung der Form oder des Querschnitts gekennzeichnet ist.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020204 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020204">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000029"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Pore</rdfs:label>
        <rdfs:label xml:lang="en">pore</rdfs:label>
        <skos:definition xml:lang="en">A pore is a site that consists of a cavity located within the bulk of a material entity.</skos:definition>
        <skos:definition xml:lang="de">Eine Pore ist eine Stelle, die aus einem Hohlraum besteht, der sich innerhalb der Masse eines Materialgebildes befindet.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020205 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020205">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000635"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Defektrolle</rdfs:label>
        <rdfs:label xml:lang="en">defect role</rdfs:label>
        <skos:definition xml:lang="en">A defect role is a role of an independent continuant C indicating that C may affect a material entity E&apos;s ability to realize a function. C is continuant part of E.</skos:definition>
        <skos:definition xml:lang="de">Eine Defektrolle ist eine Rolle eines unabhängigen Kontinuums C, die darauf hinweist, dass C die Fähigkeit einer materiellen Entität E, eine Funktion zu realisieren, beeinträchtigen kann. C ist fortlaufender Teil von E.</skos:definition>
        <skos:example xml:lang="en">A crack in an structural member may affect its ability to carry a load.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020206 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020206">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000141"/>
        <obo:IAO_0000116>--&gt; will soon be moved to CryO</obo:IAO_0000116>
        <obo:IAO_0000119>https://www.physics-in-a-nutshell.com/article/5/unit-cell-primitive-cell-and-wigner-seitz-cell</obo:IAO_0000119>
        <rdfs:label xml:lang="en">unit cell</rdfs:label>
        <skos:definition xml:lang="en">Unit cell is a immaterial entity that represents the a smallest volume element a repetitive arrangement of which can build  up the whole crystal lattice without overplaps or gaps, and there is no further partition of the unit cell that could itself be used as a unit cell.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020207 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020207">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020103"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Stoffmenge</rdfs:label>
        <rdfs:label xml:lang="en">amount of substance</rdfs:label>
        <skos:definition xml:lang="en">Amount of substance n is a molar proportion when the whole is an object aggregate N, which has avogadro number objects (of same type) as parts (n = N/N_A).</skos:definition>
        <skos:definition xml:lang="de">Die Menge der Substanz n ist ein molarer Anteil, wenn das Ganze ein Objektaggregat N ist, das Avogadro-Anzahlobjekte (gleicher Art) als Teile hat (n = N/N_A).</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020208 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000142"/>
        <rdfs:label xml:lang="en">slip direction</rdfs:label>
        <skos:definition xml:lang="en">A slip direction is a fiat line that corresponds to the crystallographic direction along which dislocations glide os a slip plane.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020209 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020209">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001930"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">TODO: Indiviuals for the possible values need to be created, similar to the values of the Bravais lattice value individuals.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Is determined by the Bravais lattice.</rdfs:comment>
        <rdfs:label xml:lang="de">Slipsystem (3D)</rdfs:label>
        <rdfs:label xml:lang="en">slip system (3D)</rdfs:label>
        <skos:definition xml:lang="de">Gibt den Wert der Kristallgleitebene zusammen mit der Gleitrichtung an.</skos:definition>
        <skos:definition xml:lang="en">specifies the value of the crystal slip plane together with the slip direction.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020210 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020210">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/pmd/co/PMD_0020140"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">elemental crystal</rdfs:label>
        <skos:definition xml:lang="en">a crystal that consists of exactly one atomic species</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020211 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020211">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020212"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">different structures of a crystal could be linked by a relational property &apos;allotrope of&apos;</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Allotropie eines Elementarkristalls</rdfs:label>
        <rdfs:label xml:lang="en">allotropy of an elemental crystal</rdfs:label>
        <skos:definition xml:lang="en">a disposition of an elemental crystal to change its crystal structure</skos:definition>
        <skos:definition xml:lang="de">eine Neigung eines Elementarkristalls, seine Kristallstruktur zu ändern</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020212 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020212">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">stable structure depends on pressure and temperature</rdfs:comment>
        <rdfs:label xml:lang="de">Polymorphismus des Kristalls</rdfs:label>
        <rdfs:label xml:lang="en">polymorphism of crystal</rdfs:label>
        <skos:definition xml:lang="de">Neigung eines Kristalls, seine Kristallstruktur zu verändern</skos:definition>
        <skos:definition xml:lang="en">disposition of a crystal to change its crystal structure</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020213 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020213">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000146"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002350"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:qualifiedCardinality>
                <owl:onClass>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020003"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025998"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020241"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:onClass>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000116 xml:lang="en">the part of a grain that is close to the grain boundary and possibly characterized by disorder is a fiat object part (grain surface layer)</obo:IAO_0000116>
        <rdfs:label xml:lang="en">grain boundary</rdfs:label>
        <skos:definition xml:lang="en">A grain boundary is a fiat surface that separates adjacent grains in a polycrystalline material and is characterized by structural discontinuity.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020214 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020214">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">diffraction</rdfs:label>
        <skos:definition xml:lang="en">is a process of interference of waves which, scattered by a material’s periodic features, produce characteristic patterns</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020215 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020215">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002020"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020142"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">may propagate through a medium or vacuum
characterized by frequency, wavelength, and speed</rdfs:comment>
        <rdfs:label xml:lang="en">wave</rdfs:label>
        <skos:definition xml:lang="en">is a process of a propagating of disturbance that transports energy and momentum</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020216 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020216">
        <rdfs:comment>Use appropriate class from crystall ontology instead</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED order scale value</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">DEPRECATED Mögliche Werte der charakteristischen Länge, über die strukturelle Zusammenhänge in einem Material bestehen bleiben</skos:definition>
        <skos:definition xml:lang="en">DEPRECATED possible values of characteristic length over which structural correlations persist in a material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020220 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020220">
        <rdfs:comment>Use appropriate class from crystall ontology instead</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED order scale</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">DEPRECATED characteristic length over which structural correlations persist in a material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020221 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020221">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020194"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_60003"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020003"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">self-diffusion in crystaline solid</rdfs:label>
        <skos:definition xml:lang="en">diffusion of entites of a single type in a crystal that consists of entites of this same type</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020222 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020222">
