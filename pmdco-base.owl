        <skos:definition xml:lang="en">potential due to hydrostatic elastic strain</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020376 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020376">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020381"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020352"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020379"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">uniaxial strain potential</rdfs:label>
        <skos:definition xml:lang="en">potential due to uniaxial elastic strain</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020377 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020377">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020378"/>
        <rdfs:label xml:lang="en">uniaxial stress</rdfs:label>
        <skos:definition xml:lang="en">a multiaxial stress where only stress in one direction is non-zero</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020378 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020378">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080108"/>
        <rdfs:label xml:lang="en">multiaxial stress</rdfs:label>
        <skos:definition xml:lang="en">a stress in multiple dimensions</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020379 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020379">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020380"/>
        <rdfs:label xml:lang="en">uniaxial strain</rdfs:label>
        <skos:definition xml:lang="en">a multiaxial strain with non-zero components only in one direction</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020380 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020380">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080029"/>
        <rdfs:label xml:lang="en">multiaxial strain</rdfs:label>
        <skos:definition xml:lang="en">the 3D strain as represented by a tensor</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020381 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020381">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080116"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020352"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020380"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">multiaxial strain potential</rdfs:label>
        <skos:definition xml:lang="en">potential due to multiaxial elastic strain</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000116 xml:lang="en">TODO: system requires further precision</obo:IAO_0000116>
        <rdfs:label xml:lang="en">fundamental quality of system</rdfs:label>
        <skos:definition xml:lang="en">a quality that is quality of every system made of demarcated materail entites</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023002"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">normalized property</rdfs:label>
        <skos:definition xml:lang="en">a facetted property that subsumes quotient classes</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020265"/>
        <rdfs:label xml:lang="en">facetted property</rdfs:label>
        <skos:definition xml:lang="en">an specifically dependent continuant that is giving more detail to an other property or about its bearer</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023003 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023002"/>
        <rdfs:label xml:lang="en">property by bearer</rdfs:label>
        <skos:definition>is a facetted property that indicates the type of its bearer</skos:definition>
        <skos:example>a fluid property is only applicable to fluids.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023004 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023004">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023003"/>
        <rdfs:label xml:lang="en">a portions property</rdfs:label>
        <skos:definition xml:lang="en">a &apos;property by bearer&apos; that indicates that its bearer is a portion of matter</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023007 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023007">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023003"/>
        <rdfs:label xml:lang="en">an object aggregates property</rdfs:label>
        <skos:definition xml:lang="en">a &apos;property by bearer&apos; that indicates that its bearer is an object aggregate</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023009 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023009">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023002"/>
        <obo:IAO_0000116 xml:lang="en">Currently the subclasses are primitive classes because length values in terms of value ranges numeric types are not yet expressed. 
In future versions we may provide equivalent class axioms.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">length scale property</rdfs:label>
        <skos:definition xml:lang="en">a facetted property that indicates the length scale where a property may exist</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023010 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023010">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023009"/>
        <rdfs:label xml:lang="en">nanoscale property</rdfs:label>
        <skos:definition xml:lang="en">a length scale property indicating that the property is applicable to the length scale of nm</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023011 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023011">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023009"/>
        <rdfs:label xml:lang="en">microscale property</rdfs:label>
        <skos:definition xml:lang="en">a length scale property indicating that the property is applicable to the length scale of micrometers</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023012 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023012">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023009"/>
        <rdfs:label xml:lang="en">mesoscale property</rdfs:label>
        <skos:definition xml:lang="en">a length scale property indicating that the property is applicable to the length scale from micrometers to cm</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023013 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023013">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023009"/>
        <rdfs:label xml:lang="en">macroscale property</rdfs:label>
        <skos:definition xml:lang="en">a length scale property indicating that the property is applicable to the macro scale from cm to m</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023014 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023014">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023009"/>
        <rdfs:label xml:lang="en">continuum property</rdfs:label>
        <skos:definition xml:lang="en">a length scale property indicating that the property is not applicable to a specific length scale but to a continuum</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023015 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023015">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023002"/>
        <rdfs:label xml:lang="en">symmetry property</rdfs:label>
        <skos:definition xml:lang="en">a facetted property that indicates the that a spatial symmetry of a property may exist</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023016 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023016">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023015"/>
        <rdfs:label xml:lang="en">isotropic property</rdfs:label>
        <skos:definition xml:lang="en">a symmetry property indicating that values of a property are equal in different spatial directions</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023017 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023017">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023015"/>
        <rdfs:label xml:lang="en">anisotropic property</rdfs:label>
        <skos:definition xml:lang="en">a symmetry property indicating that values of a property are different in different spatial directions</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023018 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023018">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023017"/>
        <rdfs:label xml:lang="en">cubic property</rdfs:label>
        <skos:definition xml:lang="en">a symmetry property indicating that values of a property are equal along three perpendicular axes</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023019 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023019">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023017"/>
        <rdfs:label xml:lang="en">transversely isotropic property</rdfs:label>
        <skos:definition xml:lang="en">a symmetry property indicating that values of a property are equal in one plane</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023020 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023020">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023017"/>
        <rdfs:label xml:lang="en">orthotropic property</rdfs:label>
        <skos:definition xml:lang="en">a symmetry property indicating that values of a property are different along three perpendicular axes</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023021 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023021">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023017"/>
        <rdfs:label xml:lang="en">monoclinic property</rdfs:label>
        <skos:definition xml:lang="en">a symmetry property indicating that values of a property are equal in one plane</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023022 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023022">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023017"/>
        <rdfs:label xml:lang="en">triclinic property</rdfs:label>
        <skos:definition xml:lang="en">a symmetry property indicating that no symmetry exists</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023023 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023023">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020113"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020113"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023003"/>
        <rdfs:label xml:lang="en">fluid property</rdfs:label>
        <skos:definition xml:lang="en">a &apos;property by bearer&apos; that indicates that its bearer is a fluid</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023024 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023024">
        <owl:equivalentClass>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020113"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080174"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020113"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080174"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023023"/>
        <rdfs:label xml:lang="en">viscous fluid property</rdfs:label>
        <skos:definition xml:lang="en">&apos;fluid property&apos; that indicates that its bearer is a viscous fluid</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023026 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000009"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020162"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000009"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0023027"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000116 xml:lang="en">disjoint with &apos;biological process&apos; http://purl.obolibrary.org/obo/GO_0008150&apos;</obo:IAO_0000116>
        <rdfs:label xml:lang="en">spontaneous process</rdfs:label>
        <skos:altLabel xml:lang="en">naturally occuring process</skos:altLabel>
        <skos:definition xml:lang="en">a process that occurs due to favorable driving force and overcomming of activatgion energy of the participants</skos:definition>
        <skos:example xml:lang="en">Rusting of iron in moist air</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023027 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023027">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025006"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000015"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080116"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">driving force</rdfs:label>
        <skos:definition xml:lang="en">a process attribute expressed as a potential difference between participants that causes the participants to evolve (by changing their SDCs) towards an equilibrium</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023035 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023035">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023002"/>
        <obo:IAO_0000116 xml:lang="en">the axioms do not allow for differentiation of the subclasses, see comment in &apos;functionally related to&apos;</obo:IAO_0000116>
        <rdfs:label xml:lang="en">aggregated property</rdfs:label>
        <skos:definition xml:lang="en">a facetted property that aggregates/condenses multiple values of members of an object aggregate</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0023036 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0023036">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                                                        <owl:someValuesFrom>
                                                            <owl:Class>
                                                                <owl:intersectionOf rdf:parseType="Collection">
