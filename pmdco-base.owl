        <skos:definition xml:lang="en">Growth rate is a process attribute which describes the increase of size of some of the participant in a process over time.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025025 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000001"/>
                                </owl:intersectionOf>
                            </owl:Class>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000116>At the current state, it is not possible to add axioms on the subclasses</obo:IAO_0000116>
        <rdfs:label xml:lang="en">range order</rdfs:label>
        <skos:definition xml:lang="en">range order is a facetted property that defines the range of ordering of members in a object aggregate</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025026 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025026">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020263"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_59999"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">lubricant role</rdfs:label>
        <skos:definition xml:lang="en">Lubricant role is a role of an object in a process, where the object aims to reduce friction between at least two other participants in the process.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025027 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025027">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0025032"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">crystalline material</rdfs:label>
        <skos:comment>old axiom (material and (&apos;has quality&apos; some (&apos;order scale&apos; and &apos;specified by value&apos; value &apos;long range order&apos;)))</skos:comment>
        <skos:definition xml:lang="en">A crystalline material is a material that has a long-range atomic order</skos:definition>
        <skos:example>Most metals, except for amorphous metals, ceramics</skos:example>
        <PMD_0001032>https://github.com/materialdigital/core-ontology/issues/458</PMD_0001032>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025028 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025028">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000833"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020166"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                        <owl:someValuesFrom>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0025029"/>
                            </owl:Restriction>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">smelting</rdfs:label>
        <skos:definition xml:lang="en">smelting is a manufacturing process which utilizes chemical reducing agent to remove non-metalic elements from the ore and has heat as a specified output</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025029 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025029">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000869"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0025028"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">reducing agent role</rdfs:label>
        <skos:definition xml:lang="en">an object or a portion of matter with reducing agent role is oxidized,  i.e., gives up electrons, thus leading to metal reduction, i.e., gain of electrons, in a chemical reaction.</skos:definition>
        <skos:example>Carbon in a smelting of an ore</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025030 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025030">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0025031"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">amorphous material</rdfs:label>
        <skos:comment>old axiom (material and (&apos;has quality&apos; some (&apos;order scale&apos; and &apos;specified by value&apos; value &apos;short range order&apos;)))</skos:comment>
        <skos:definition xml:lang="en">An amorphous material is a material that has a short-range atomic order</skos:definition>
        <skos:example>Glass</skos:example>
        <PMD_0001032>https://github.com/materialdigital/core-ontology/issues/458</PMD_0001032>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025031 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025031">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025025"/>
        <rdfs:label xml:lang="en">short-range order</rdfs:label>
        <skos:definition xml:lang="en">short-range order is a range order characterized by structural organization of members of an object aggregate strictly confined to the nearest neighbours and immediate chemical bonds</skos:definition>
        <skos:example xml:lang="en">Ordering of atoms in amorphous materials</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025032 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025032">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025025"/>
        <rdfs:label xml:lang="en">long-range order</rdfs:label>
        <skos:definition xml:lang="en">long-range order is a range order characterized by repeating periodicity across macroscopic distances in an object aggregate</skos:definition>
        <skos:example xml:lang="en">ordering of atoms in a crystalline material</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025033 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025033">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025025"/>
        <rdfs:label xml:lang="en">medium-range order</rdfs:label>
        <skos:definition xml:lang="en">medium-range order is a range order that characterizes structural organization of members of an object aggregate where small atomic groups link into localized patterns that do not repeat across the whole material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025997 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025997">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001931"/>
        <rdfs:subClassOf>
            <owl:Restriction>
