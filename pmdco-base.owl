        <skos:definition xml:lang="en">ceramic matrix composite that consists entirely of oxide ceramic phases for both the matrix and reinforcement</skos:definition>
        <skos:example>aluminum oxide composites</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050076 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050076">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050075"/>
        <rdfs:label xml:lang="en">alumina matrix composite</rdfs:label>
        <skos:definition xml:lang="en">oxide-oxide composite that uses alumina as the primary matrix reinforced by secondary oxide phases</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050077 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050077">
