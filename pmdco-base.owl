        <rdfs:label xml:lang="en">glass-ceramic</rdfs:label>
        <skos:definition xml:lang="en">material that is inorganic, non‑metallic and prepared by controlled crystallization of glasses via different processing methods; they contain at least one type of functional crystalline phase and a residual glass, and the crystallized volume fraction may vary from ppm to almost 100%</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050051 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050051">
