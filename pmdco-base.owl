                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: PMDco Team</obo:IAO_0000117>
        <rdfs:label xml:lang="en">average lamella thickness</rdfs:label>
        <skos:definition xml:lang="en">average lamella thickness is a quality of lamellae object aggregate which defines the average thickness across all indivudual lamella(s) of a sinlge phase in a microconstituent</skos:definition>
        <skos:example xml:lang="en">average thickness of ferrite lamellae in perlite microscontituent</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0027004 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0027004">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020000"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020003"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: PMDco Team</obo:IAO_0000117>
        <rdfs:label xml:lang="en">lath</rdfs:label>
        <skos:comment xml:lang="en">A lath is a crystal of a single phase. e.g., cementite in a crystallite of bainite microcontituent.</skos:comment>
        <skos:definition xml:lang="en">Lath is an elongated object and at the same time a crystal and a thermodynamic phase</skos:definition>
        <skos:example xml:lang="en">lath of cementite embedded in ferrite matix in bainite microconstituent</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0027005 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0027005">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0027004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: PMDco Team</obo:IAO_0000117>
        <rdfs:label xml:lang="en">laths</rdfs:label>
        <skos:definition xml:lang="en">an object aggregate of multiple lath objects</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0040001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0040001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;length&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;DimensionQuality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000122.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Lars Vogt</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Length is a size that describes the spatial extent of its bearer in one dimension.</rdfs:comment>
        <rdfs:label xml:lang="de">Länge</rdfs:label>
        <rdfs:label xml:lang="en">length</rdfs:label>
        <skos:altLabel xml:lang="en">dimension</skos:altLabel>
        <skos:definition xml:lang="de">Die Länge ist eine eindimensionale Größe.</skos:definition>
        <skos:definition xml:lang="en">Length is a one dimensional size.</skos:definition>
        <skos:example xml:lang="en">A steel rod measures 250 mm in length between its two end faces</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050000">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33250"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Bindung</rdfs:label>
        <rdfs:label xml:lang="en">atomic bond</rdfs:label>
        <skos:definition xml:lang="en">A bond is a relational quality describing the force interaction between atoms.</skos:definition>
        <skos:definition xml:lang="de">Eine Bindung ist eine relationale Qualität, die die Kraftwechselwirkung zwischen Atomen beschreibt.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050000"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://sciencenotes.org/types-of-chemical-bonds/"/>
        <rdfs:label xml:lang="en">covalent bond</rdfs:label>
        <rdfs:label xml:lang="de">kovalente Bindung</rdfs:label>
        <skos:definition xml:lang="en">A covalent bond is a bond that forms when nonmetal atoms share electrons to achieve a stable electron configuration.</skos:definition>
        <skos:definition xml:lang="de">Eine kovalente Bindung ist eine Bindung, die entsteht, wenn Nichtmetallatome Elektronen teilen, um eine stabile Elektronenkonfiguration zu erreichen.</skos:definition>
        <skos:example xml:lang="en">In a water molecule (H₂O), the hydrogen and oxygen atoms share electrons.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050000"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://www.thoughtco.com/metallic-bond-definition-properties-and-examples-4117948"/>
        <rdfs:label xml:lang="en">metallic bond</rdfs:label>
        <rdfs:label xml:lang="de">metallische Bindung</rdfs:label>
        <skos:definition xml:lang="en">A metallic bond is a bond that forms between metal atoms, where electrons are shared in a &quot;sea&quot; of electrons that move freely around the metal ions. This type of bonding gives metals their characteristic properties such as conductivity and malleability.</skos:definition>
        <skos:definition xml:lang="de">Eine Metallbindung ist eine Bindung, die zwischen Metallatomen entsteht, wobei Elektronen in einem „Meer“ von Elektronen geteilt werden, die sich frei um die Metallionen bewegen. Diese Art der Bindung verleiht Metallen ihre charakteristischen Eigenschaften wie Leitfähigkeit und Formbarkeit.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050003 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050000"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://sciencenotes.org/types-of-chemical-bonds/"/>
        <rdfs:label xml:lang="de">Ionenbindung</rdfs:label>
        <rdfs:label xml:lang="en">ionic bond</rdfs:label>
        <skos:definition xml:lang="en">An ionic bond is a bond that occurs when one atom donates an electron to another atom, resulting in oppositely charged ions that attract each other.</skos:definition>
        <skos:definition xml:lang="de">Eine Ionenbindung ist eine Bindung, die entsteht, wenn ein Atom ein Elektron an ein anderes Atom abgibt, wodurch entgegengesetzt geladene Ionen entstehen, die sich gegenseitig anziehen.</skos:definition>
        <skos:example xml:lang="en">An example is the interaction between the atoms of sodium chloride (NaCl), where the sodium atom donates an electron to a chlorine atom.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050004 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050004">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000888"/>
        <rdfs:label xml:lang="en">thermoplastic polymer</rdfs:label>
        <skos:definition xml:lang="en">polymer that becomes moldable when heated and solidifies upon cooling</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050005 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050005">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0010033"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002233"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_29362"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_74236"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">polyethylene</rdfs:label>
        <skos:definition xml:lang="en">poylethylen is a thermoplastic polymer produced by polymerization of the monomer ethylene including further crosslinking and modifications using other comonomers; it excludes ultra hight molecular polyethylen</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050006 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050006">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050005"/>
        <rdfs:label xml:lang="en">low-density polyethylene</rdfs:label>
        <skos:definition xml:lang="en">polyethylene that is characterized by a branched molecular structure and low density</skos:definition>
        <PMD_0050117>PE-LD</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050007 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050007">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050005"/>
        <rdfs:label xml:lang="en">high-density polyethylene</rdfs:label>
        <skos:definition xml:lang="en">polyethylene that is characterized by a linear molecular structure and high density</skos:definition>
        <PMD_0050117>PE-HD</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050008 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050008">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050005"/>
        <rdfs:label xml:lang="en">linear low-density polyethylene</rdfs:label>
        <skos:definition xml:lang="en">polyethylene that is distinguished by its linear backbone with short-chain branching</skos:definition>
        <PMD_0050117>PE_LLD</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050009 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050009">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050004"/>
        <rdfs:label xml:lang="en">polypropylene</rdfs:label>
        <skos:altLabel>polyethene</skos:altLabel>
        <skos:comment>this excludes ultra hight molecular polyethylen because very high molecular weight polyethylene is not thermoplastic anymore</skos:comment>
        <skos:definition xml:lang="en">thermoplastic polymer produced by polymerization of the monomer propylene including further crosslinking and modifications using other comonomers</skos:definition>
        <PMD_0050117>PP</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050010 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050010">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050009"/>
        <rdfs:label xml:lang="en">isotactic polypropylene</rdfs:label>
        <skos:definition xml:lang="en">polypropylene in which all the methyl groups are aligned on the same side of the polymer chain</skos:definition>
        <PMD_0050117>iPP</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050011 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050011">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050009"/>
        <rdfs:label xml:lang="en">syndiotactic polypropylene</rdfs:label>
        <skos:definition xml:lang="en">polypropylene in which the methyl groups alternate regularly along the polymer chain</skos:definition>
        <PMD_0050117>sPP</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050012 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050012">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050009"/>
        <rdfs:label xml:lang="en">atactic polypropylene</rdfs:label>
        <skos:definition xml:lang="en">polypropylene in which the methyl groups are randomly distributed along the polymer chain</skos:definition>
        <PMD_0050117>aPP</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050013 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050013">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050004"/>
        <rdfs:label xml:lang="en">polyvinyl chloride</rdfs:label>
        <skos:altLabel>vinyl or polyvinyl</skos:altLabel>
        <skos:comment>they are usualy hard or soft and flexible with incrased use of plasticisers.</skos:comment>
        <skos:definition xml:lang="en">thermoplastic polymer produced by polymerization of the monomer vinyl chloride</skos:definition>
        <PMD_0050117>PVC</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050014 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050014">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050013"/>
        <rdfs:label xml:lang="en">rigid polyvinyl chloride</rdfs:label>
        <skos:definition xml:lang="en">polyvinyl chloride that is characterized by its stiffness and durability</skos:definition>
        <PMD_0050117>uPVC</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050015 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050015">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050013"/>
        <rdfs:label xml:lang="en">flexible polyvinyl chloride</rdfs:label>
        <skos:definition xml:lang="en">polyvinyl chloride that has been modified with plasticizers to impart flexibility</skos:definition>
        <PMD_0050117>fPVC</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050016 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050016">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050004"/>
        <rdfs:label xml:lang="en">polystyrene</rdfs:label>
        <skos:definition xml:lang="en">thermoplastic polymer produced by polymerization of the aromatic hydrocarbon styrene</skos:definition>
        <PMD_0050117>PS</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050017 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050017">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050016"/>
        <rdfs:label xml:lang="en">general purpose polystyrene</rdfs:label>
        <skos:definition xml:lang="en">polystyrene that is valued for its clarity and ease of processing</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050018 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050018">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050016"/>
        <rdfs:label xml:lang="en">high impact polystyrene</rdfs:label>
        <skos:definition xml:lang="en">polystyrene that is modified with rubber to improve its impact resistance</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050019 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050019">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050004"/>
        <rdfs:label xml:lang="en">polyethylene terephthalate</rdfs:label>
        <skos:comment>it is the dominant polyester utilized in global packaging and fiber applications</skos:comment>
        <skos:definition xml:lang="en">thermoplastic polymer produced by polycondensation of ethylene glycol and terephthalate precursors</skos:definition>
        <PMD_0050117>PET</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050020 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050020">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050019"/>
        <rdfs:label xml:lang="en">amorphous polyethylene terephthalate</rdfs:label>
        <skos:definition xml:lang="en">polyethylene terephthalate that is characterized by a non-crystalline structure</skos:definition>
        <PMD_0050117>APET</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050021 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050021">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050019"/>
        <rdfs:label xml:lang="en">crystalline polyethylene terephthalate</rdfs:label>
        <skos:definition xml:lang="en">polyethylene terephthalate that is distinguished by its ordered, crystalline structure</skos:definition>
        <PMD_0050117>CPET</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050022 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050022">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000888"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0010034"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">thermosetting polymer</rdfs:label>
        <skos:definition xml:lang="en">polymer that, once cured, irreversibly sets into a permanent shape</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050023 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050023">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050022"/>
        <rdfs:label xml:lang="en">epoxy resin</rdfs:label>
        <skos:altLabel>epoxy or polyepoxide</skos:altLabel>
        <skos:comment>they are utilized for high-performance structural adhesives, composite matrices, and protective coatings.</skos:comment>
        <skos:definition xml:lang="en">thermosetting polymer that is a epoxide-functional oligomer curing via ring-opening into crosslinked networks used as precursors to thermosetting polymers</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050024 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050024">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050023"/>
        <rdfs:label xml:lang="en">bisphenol a epoxy</rdfs:label>
        <skos:definition xml:lang="en">epoxy resin that is formulated using bisphenol a to enhance its mechanical properties</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050025 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050025">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050023"/>
        <rdfs:label xml:lang="en">novolac epoxy</rdfs:label>
        <skos:definition xml:lang="en">epoxy resin that is based on novolac resins to provide improved thermal and chemical resistance</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050026 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050026">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050022"/>
        <rdfs:label xml:lang="en">phenolic resin</rdfs:label>
        <skos:altLabel>phenol-formaldehyde</skos:altLabel>
        <skos:comment>they are utilized for flame-resistant adhesives, friction materials, and molded components</skos:comment>
        <skos:comment>they form rigid, char-forming crosslinked networks</skos:comment>
        <skos:definition xml:lang="en">thermosetting polymer synthesized via condensation of phenol and formaldehyde</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050027 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050027">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050026"/>
        <rdfs:label xml:lang="en">phenol-formaldehyde resin</rdfs:label>
        <skos:definition xml:lang="en">phenolic resin that is synthesized from phenol and formaldehyde</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050028 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050028">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050022"/>
        <rdfs:label xml:lang="en">melamine formaldehyde</rdfs:label>
        <skos:altLabel>melamine-formaldehyde</skos:altLabel>
        <skos:comment>they are widely used in decorative laminates, kitchenware, and coating crosslinkers.</skos:comment>
        <skos:comment>they form hard, durable crosslinked networks.</skos:comment>
        <skos:definition xml:lang="en">thermosetting aminoplast polymer synthesized via condensation</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050029 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050029">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050022"/>
        <rdfs:label xml:lang="en">urea formaldehyde</rdfs:label>
        <skos:definition xml:lang="en">thermosetting polymer formed from urea and formaldehyde, commonly used in adhesives and molding compounds.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050030 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050030">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000888"/>
        <rdfs:label xml:lang="en">elastomer</rdfs:label>
        <skos:definition xml:lang="en">polymer that exhibits elasticity by returning to its original shape after deformation</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050031 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050031">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050030"/>
        <rdfs:label xml:lang="en">natural rubber</rdfs:label>
        <skos:comment>they are predominantly cis-1,4-polyisoprene,</skos:comment>
        <skos:comment>they are used widely in Heavy-duty truck tires</skos:comment>
        <skos:definition xml:lang="en">elastomer polymer, and a biopolymer harvested as plant latex; consisting of cis-1,4-polyisoprene chains; typically sulfur-vulcanized to create crosslinks between chains</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050032 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050032">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050030"/>
        <rdfs:label xml:lang="en">synthetic rubber</rdfs:label>
        <skos:definition xml:lang="en">elastomer that is produced through chemical synthesis to mimic natural rubber’s properties</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050033 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050033">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050032"/>
        <rdfs:label xml:lang="en">styrene-butadiene rubber</rdfs:label>
        <skos:comment>used widely for its good abrasion resistance and tunable hardness, for instance in tire treads.</skos:comment>
        <skos:definition xml:lang="en">synthetic rubber and belongs to a family of synthetic random copolymer elastomers of styrene and butadiene, made by emulsion or solution polymerization and typically vulcanized</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050034 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050034">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050032"/>
        <rdfs:label xml:lang="en">nitrile butadiene rubber</rdfs:label>
        <skos:altLabel>Nitrile </skos:altLabel>
        <skos:comment>Oil resistance, Fuel resistance</skos:comment>
        <skos:comment>it can have tunable polarity and oil/fuel resistance</skos:comment>
        <skos:definition xml:lang="en">synthetic rubber that belongs to a family of synthetic acrylonitrile–butadiene copolymer elastomers</skos:definition>
        <skos:example> it is widely used in oil/fuel resistance applicaitons such as seals, fuel hoses, and protective gloves</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050035 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050035">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050032"/>
        <rdfs:label xml:lang="en">ethylene propylene diene monomer</rdfs:label>
        <skos:comment>it offers excellent weather resistance</skos:comment>
        <skos:definition xml:lang="en">synthetic rubber produced from ethylene, propylene, and a diene monomer</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050036 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050036">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000888"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000091"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0200001"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000888"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000091"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0200001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">biodegradable polymers</rdfs:label>
        <skos:definition xml:lang="en">polymeric material that possesses the disposition to undergo decomposition through the metabolic activity of biological organisms, resulting in conversion into environmentally benign substances—such as carbon dioxide, methane, mineral salts, and biomass—within a timescale that does not cause harmful accumulation in the environment</skos:definition>
        <PMD_0001032>https://github.com/materialdigital/core-ontology/issues/126</PMD_0001032>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050037 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050037">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050004"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050036"/>
        <rdfs:label xml:lang="en">polylactic acid</rdfs:label>
        <skos:definition xml:lang="en">biodegradable thermoplastic polymer produced from renewable resources such as corn starch</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050038 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050038">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000888"/>
        <rdfs:label xml:lang="en">polyhydroxyalkanoates</rdfs:label>
        <skos:definition xml:lang="en">polyhydroxyalkanoates are biodegradable polymers that are biosynthesized by microorganisms from sugars or lipids</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050039 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050039">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050004"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050036"/>
        <rdfs:label xml:lang="en">polybutylene succinate</rdfs:label>
        <skos:definition xml:lang="en">biodegradable thermoplastic polymer polyester that is synthesized via the polycondensation of succinic acid and 1,4-butanediol</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050040 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050040">
