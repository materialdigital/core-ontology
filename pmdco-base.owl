        <rdfs:label xml:lang="en">lead zirconate titanate ceramic</rdfs:label>
        <skos:definition xml:lang="en">oxide ceramic that is dielectric and composed of lead, zirconium, and titanium, renowned for its piezoelectric behavior</skos:definition>
        <PMD_0050117>PZT</PMD_0050117>
    </owl:Class>
    


