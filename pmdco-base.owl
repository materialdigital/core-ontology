                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">interstitial diffusion</rdfs:label>
        <skos:definition xml:lang="en">diffusion process in which material entities move from interstitial sites to adjacent interstitial sites</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020226 -->

