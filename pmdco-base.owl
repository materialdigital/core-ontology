    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0020356 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0020356">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">has subtrahend</rdfs:label>
        <skos:definition xml:lang="en">points to the subtrahend of a difference</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0020357 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0020357">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">has addend</rdfs:label>
        <skos:definition xml:lang="en">points to an addend of a sum</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0020358 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0020358">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">has factor</rdfs:label>
        <skos:definition xml:lang="en">points to a factor of a product (multiplication)</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0025006 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0025006">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Kamilla Zaripova</obo:IAO_0000117>
        <rdfs:label xml:lang="en">process attribute of</rdfs:label>
        <skos:definition xml:lang="en">A relation between a process attribute and a process, which &quot;bears&quot; the attribute.</skos:definition>
        <skos:example xml:lang="en">Tensile rate is a process attribute of tensile test</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0025013 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0025013">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Kamilla Zaripova</obo:IAO_0000117>
        <rdfs:label xml:lang="en">changes quality</rdfs:label>
        <rdfs:label xml:lang="de">verändert die Qualität</rdfs:label>
        <skos:definition xml:lang="en">indicates that a process changes a quality</skos:definition>
        <skos:definition xml:lang="de">zeigt an, dass ein Prozess eine Qualität verändert</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0025998 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0025998">
        <owl:inverseOf rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000145"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000051"/>
            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0025998"/>
        </owl:propertyChainAxiom>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Kamilla Zaripova</obo:IAO_0000117>
        <rdfs:label xml:lang="en">has relational quality</rdfs:label>
        <rdfs:label xml:lang="de">hat relationale Qualität</rdfs:label>
        <skos:definition xml:lang="en">a relation between an independent continuant (the bearer) and a relational quality, in which the quality specifically depends on the bearer for its existence</skos:definition>
        <skos:definition xml:lang="de">eine Beziehung zwischen einem unabhängigen Kontinuum (dem Träger) und einer relationalen Qualität, bei der die Qualität in ihrer Existenz speziell vom Träger abhängt</skos:definition>
        <skos:example xml:lang="en">material has relational quality mass proportion m, and portion of iron has the same relational quality mass proportion m</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0025999 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0025999">
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0025999"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000050"/>
        </owl:propertyChainAxiom>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">The &apos;relational quality of&apos; is more strict that &apos;quality of&apos; from RO, since domain is &apos;relational quality&apos;. The motivtion to introduce an object property for relational qualities is the following:
RO&apos;s &apos;quality of&apos; is functional i.e., a-&gt;b, a-&gt;c =&gt; b=c. The functionality is relevant for most of the SDC -&gt; IC triples, expect for relational qualities, which per definiton can be simultaneously inherited in &gt;=2 ICs. Thus,  &apos;relational quality of&apos;  has the same intention to connect SDC to IC, however, without cardinality constraints.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Kamilla Zaripova</obo:IAO_0000117>
        <rdfs:label xml:lang="en">relational quality of</rdfs:label>
        <rdfs:label xml:lang="de">relationale Qualität von</rdfs:label>
        <skos:definition xml:lang="en">a relation between a relational quality and an independent continuant (the bearer), in which the quality specifically depends on the bearer for its existence</skos:definition>
        <skos:definition xml:lang="de">eine Beziehung zwischen einer relationalen Qualität und einem unabhängigen Kontinuum (dem Träger), bei der die Existenz der Qualität speziell vom Träger abhängt</skos:definition>
        <skos:example xml:lang="en">mass proportion m is relational qualitiy of material, and the same mass proportion m is relational qualitiy of portion of iron</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0060001 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0060001">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
        <owl:inverseOf rdf:resource="https://w3id.org/pmd/co/PMD_0060002"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <rdfs:range>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000020"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000008"/>
                </owl:unionOf>
            </owl:Class>
        </rdfs:range>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Hossein Beygi Nasrabadi</obo:IAO_0000117>
        <obo:IAO_0000233>https://github.com/materialdigital/core-ontology/issues/105</obo:IAO_0000233>
        <rdfs:label xml:lang="en">represents value of</rdfs:label>
        <skos:definition>A relation between an information content entity and an specifically dependent continuant or process attribute which the representation is about.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0060002 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0060002">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/co/PMD_0000004"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Hossein Beygi Nasrabadi</obo:IAO_0000117>
        <rdfs:label xml:lang="en">represented by value</rdfs:label>
        <skos:definition>A relation between a specifically dependent continuant or process attribute and an information content entity which is about.</skos:definition>
    </owl:ObjectProperty>
    


