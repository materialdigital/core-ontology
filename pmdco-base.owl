        <rdfs:label xml:lang="en">porcelain</rdfs:label>
        <skos:comment>a glass binder with ceramic filler produced from ceramics</skos:comment>
        <skos:definition xml:lang="en">natural ceramic that is clay-bsed, distinguished by its translucency, strength, and refined appearance</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050046 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050046">
