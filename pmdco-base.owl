        <rdfs:label xml:lang="en">fritted ceramic</rdfs:label>
        <skos:definition xml:lang="en">non-clay ceramic that is manufactured by fusing and subsequently grinding glass materials</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050054 -->

