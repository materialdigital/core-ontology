        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">doc string</rdfs:label>
        <skos:definition xml:lang="en">A doc string is a textual entity that describes an associated section of some source code</skos:definition>
        <PMD_0001032>https://github.com/materialdigital/core-ontology/issues/270</PMD_0001032>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000124 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000124">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
