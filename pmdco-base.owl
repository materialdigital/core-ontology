        <rdfs:label xml:lang="en">clay-based ceramic</rdfs:label>
        <skos:definition xml:lang="en">silicate ceramics that are formed from natural clays</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050043 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050043">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050040"/>
        <rdfs:label xml:lang="en">earthenware</rdfs:label>
        <skos:definition xml:lang="en">natural ceramic that is clay-based, formed at relatively low temperatures, resulting in a porous, rustic material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050044 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050044">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050040"/>
        <rdfs:label xml:lang="en">stoneware</rdfs:label>
        <skos:definition xml:lang="en">natural ceramic that is clay-based, fired at higher temperatures than earthenware to yield a denser, more durable material</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050045 -->

