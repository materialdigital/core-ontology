                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002350"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Kamilla Zaripova</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Angabe des Bruchwerts</rdfs:label>
        <rdfs:label xml:lang="en">fraction value specification</rdfs:label>
        <skos:definition xml:lang="de">Bei der Bruchwertspezifikation handelt es sich um eine Wertspezifikation, die Informationen über den quantitativen Anteil eines Teils im Verhältnis zu einem angegebenen Ganzen enthält.</skos:definition>
        <skos:definition xml:lang="en">Fraction value specification is a value specification that contains information about quantitative share of a part relative to a specified whole.</skos:definition>
        <skos:example xml:lang="en">2.05 wt.% of carbon in steel, 4 vol.% of nitric acid in a solution</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0027001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0027001">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020000"/>
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020003"/>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0027004"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: PMDco Team</obo:IAO_0000117>
        <rdfs:label xml:lang="en">lamella</rdfs:label>
        <skos:comment>It may part of a lamellae object oggregate</skos:comment>
        <skos:definition xml:lang="en">lamella is an object that represents a thin, flat, plate-like layer or flake within microstructure.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0027002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0027002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0027001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000112 xml:lang="en">perlite microconstituent has part ferrite lamellae and has part cementite lamellae. Ferrite lamellae has part ferrite lamella</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: PMDco Team</obo:IAO_0000117>
        <rdfs:label xml:lang="en">lamellae</rdfs:label>
        <skos:definition xml:lang="en">lamellae is an object aggregate that is part of some microconstituent and at the same time a single thermodynamic phase</skos:definition>
        <skos:example xml:lang="en">ferrite lamellae in perlite microcontituent</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0027003 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0027003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
