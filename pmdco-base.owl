        <rdfs:label xml:lang="en">cooling rate</rdfs:label>
        <skos:definition xml:lang="en">Cooling rate is a process attribute which describes the descreate of temperature of some of the participant in a process over time.</skos:definition>
        <skos:example xml:lang="en">10 K/s</skos:example>
    </owl:Class>
    


