        <skos:example>Silicon Carbide (SiC) Matrix Composite; Carbon-Carbon (C/C) Composite</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050079 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050079">
