        <rdfs:label xml:lang="en">aluminosilicate ceramic</rdfs:label>
        <skos:definition xml:lang="en">silicate ceramics that consist of aluminum and silicon oxides</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050047 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050047">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050046"/>
        <rdfs:label xml:lang="en">mullite ceramic</rdfs:label>
        <skos:definition xml:lang="en">aluminosilicate ceramic known for its excellent high-temperature stability</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050048 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050048">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050046"/>
        <rdfs:label xml:lang="en">kaolinite ceramic</rdfs:label>
        <skos:definition xml:lang="en">aluminosilicate ceramic based on the mineral kaolinite, valued for its fine particle size and plasticity</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050049 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050049">
