                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0027002"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                        <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0027002"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
