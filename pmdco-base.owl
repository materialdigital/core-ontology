            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">boride ceramic</rdfs:label>
        <skos:definition xml:lang="en">non-oxide ceramic consisting of a boron and another element</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050072 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050072">
