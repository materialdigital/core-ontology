            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">silicate ceramic</rdfs:label>
        <skos:definition xml:lang="en">oxide ceramic consisting primarily of silicon oxide</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050042 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050042">
