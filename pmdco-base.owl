    <!-- https://w3id.org/pmd/co/PMD_0000103 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000103">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000833"/>
        <rdfs:label xml:lang="en">hardening</rdfs:label>
        <skos:altLabel>toughening</skos:altLabel>
        <skos:definition xml:lang="en">A manufacturing process that increases the strength and hardness of a material.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000104 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000104">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000103"/>
        <rdfs:label xml:lang="en">ion-exchange hardening</rdfs:label>
        <skos:definition xml:lang="en">Hardening process used in glass manufacturing where ions in the glass are replaced by larger ions from a solution which create compressive stress and increased hardness.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000107 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000107">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000877"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">nonlinear optical property</rdfs:label>
        <skos:altLabel xml:lang="en">optical non-linearity</skos:altLabel>
        <skos:definition xml:lang="en">Optical property that is dependent on the intensity of the input light.</skos:definition>
        <skos:definition xml:lang="de">Optische Eigenschaft, die von der Intensität des einfallenden Lichts abhängt.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000110 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000110">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">geological process</rdfs:label>
        <rdfs:seeAlso>https://terminology.tib.eu/ts/ontologies/gemet/terms?iri=http%3A%2F%2Fwww.eionet.europa.eu%2Fgemet%2Fconcept%2F3648&amp;obsoletes=false&amp;lang=en</rdfs:seeAlso>
        <skos:definition xml:lang="en">A natural process that operates within the Earth system to transform, transport, or deform Earth materials, thereby changing Earth structures and landforms</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000111 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000111">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000620"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">superconductivity</rdfs:label>
        <skos:definition>The disposition of a material to conduct electricity without electrical resistance or infinite electrical conductance respectively.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000112 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000112">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">dielectric disposition</rdfs:label>
        <skos:definition xml:lang="en">disposition of an electric insulator to be polarized when subjected to an electric field</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000113 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000035"/>
        <rdfs:label xml:lang="en">conventional ceramics manufacturing</rdfs:label>
        <skos:definition xml:lang="en">A process that relies on traditional and manual methods to produce ceramics.</skos:definition>
        <skos:example xml:lang="en">forming green bodies by hand
using a bonfire, pit or kiln for firing/sintering</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000114 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000114">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
