            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">natural ceramic</rdfs:label>
        <skos:definition xml:lang="en">ceramic that is produced using conventional methods with natural raw materials such as clay and silica</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050041 -->

