                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">laminated composite</rdfs:label>
        <skos:definition xml:lang="en">A structural composite composed of two-dimensional sheets or panels (plies or laminae) bonded to one another, where each ply possesses a preferred high-strength direction</skos:definition>
    </owl:Class>
    


