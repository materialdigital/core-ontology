        <rdfs:label xml:lang="en">dislocation</rdfs:label>
        <skos:definition xml:lang="en">a linear site in a cystal that interrupts the cystal ordering</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020234 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020234">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020233"/>
        <rdfs:label xml:lang="en">screw dislocation</rdfs:label>
        <skos:definition xml:lang="en">a dislocation characterized by shearing the chrystal by one plane</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020235 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020235">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020233"/>
        <rdfs:label xml:lang="en">edge dislocation</rdfs:label>
        <skos:definition xml:lang="en">a dislocation characterized by adding one extra half plane into the crystal lattice</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020236 -->

