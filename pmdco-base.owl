        <rdfs:label xml:lang="en">beryllia ceramic</rdfs:label>
        <skos:definition xml:lang="en">oxide ceramic that is an advanced ceramic composed of beryllium oxide, valued for its high thermal conductivity and electrical insulation</skos:definition>
        <PMD_0050117>BeO</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050062 -->

