        <rdfs:comment xml:lang="en">A Portion Of Matter that consists of only tellurium atoms.</rdfs:comment>
        <rdfs:label xml:lang="en">portion of tellurium</rdfs:label>
        <skos:definition xml:lang="en">A &apos;portion of tellurium&apos; is a &apos;portion of pure chemical element&apos; that &apos;consists of&apos; only chebi:tellurium atom.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010022 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010022">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000117>PERSON: Bernd Bayerlein</obo:IAO_0000117>
        <rdfs:label xml:lang="en">containing magnetic species</rdfs:label>
        <skos:definition xml:lang="en">material property that inheres in a material entity in virtue of the presence of one or more magnetic species (e.g. ferromagnetic, paramagnetic, or diamagnetic particles or atoms), and that manifests under appropriate conditions as a magnetic response or influence in a magnetic field</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010023 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010023">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000092"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_59999"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Bernd Bayerlein</obo:IAO_0000117>
        <rdfs:label xml:lang="en">bioactive</rdfs:label>
        <rdfs:label xml:lang="de">bioaktiv</rdfs:label>
        <skos:definition xml:lang="de">Disposition, die einer materiellen Einheit innewohnt und in einem Organismuskontext als spezifische Interaktion mit einem oder mehreren biologischen Systemen verwirklicht wird und eine messbare biologische Wirkung hervorruft, beispielsweise eine therapeutische, toxische oder signalisierende Wirkung</skos:definition>
        <skos:definition xml:lang="en">disposition that inheres in a material entity and is realized in an organismal context as a specific interaction with one or more biological systems, producing a measurable biological effect such as therapeutic, toxic, or signaling outcome</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010024 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/GO_0008150"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000092"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_59999"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Bernd Bayerlein</obo:IAO_0000117>
        <rdfs:label xml:lang="de">bioinert</rdfs:label>
        <rdfs:label xml:lang="en">bioinert</rdfs:label>
        <skos:definition xml:lang="en">a disposition to elicit minimal or no biological response when in contact with tissue or implanted</skos:definition>
        <skos:definition xml:lang="de">eine Neigung, bei Kontakt mit Gewebe oder einer Implantation nur eine minimale oder keine biologische Reaktion hervorzurufen</skos:definition>
        <skos:example>non-toxic and non-immunogenic, with little or no bonding or integration with the body.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010025 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010025">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020251"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Bernd Bayerlein</obo:IAO_0000117>
        <rdfs:label xml:lang="en">bioresorbable</rdfs:label>
        <rdfs:label xml:lang="de">bioresorbierbar</rdfs:label>
        <skos:comment>being absorbed or excreted as it performs its function, often eliminating the need for removal.</skos:comment>
        <skos:definition xml:lang="en">biocompatibe and degrading and being resorbed by the body over time</skos:definition>
        <skos:definition xml:lang="de">biokompatibel und im Laufe der Zeit vom Körper abgebaut und resorbiert</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010026 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010026">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000117>PERSON: Bernd Bayerlein</obo:IAO_0000117>
        <rdfs:label xml:lang="en">organic composition</rdfs:label>
        <rdfs:label xml:lang="de">organische Zusammensetzung</rdfs:label>
        <skos:definition xml:lang="en">A composition characterized by a primary molecular structure of carbon atoms covalently bonded to hydrogen (C-H bonds), typically forming linear, branched, or networked chains.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010027 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010027">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025001"/>
        <obo:IAO_0000117>PERSON: Bernd Bayerlein</obo:IAO_0000117>
        <rdfs:label xml:lang="de">anorganische Zusammensetzung</rdfs:label>
        <rdfs:label xml:lang="en">inorganic composition</rdfs:label>
        <skos:definition xml:lang="en">material composition based on chemical elements other than those defining organic compounds, typically characterized by ionic or metallic bonding and the absence of a carbon-hydrogen ($C-H$) framework</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010029 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010029">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000952"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0023002"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080154"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Bernd Bayerlein</obo:IAO_0000117>
        <rdfs:label xml:lang="en">specific strength</rdfs:label>
        <rdfs:label xml:lang="de">spezifische Festigkeit</rdfs:label>
        <skos:comment>SI unit for specific strength is Pa⋅m3/kg, or N⋅m/kg, which is dimensionally equivalent to m2/s2, In fiber or textile applications, tenacity is the usual measure of specific strength
</skos:comment>
        <skos:definition xml:lang="en">Specific strength is a quality that inheres in a material entity and is defined as the ratio of its tensile strength to its density.</skos:definition>
        <skos:definition xml:lang="de">Spezifische Festigkeit ist eine Eigenschaft, die einem Material innewohnt und als das Verhältnis seiner Zugfestigkeit zu seiner Dichte definiert wird.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010033 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">polymerization</rdfs:label>
        <skos:definition xml:lang="en">The chemical process of reacting monomers, oligomers, or reactive precursors together to form longer macromolecular chains or three-dimensional networks</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010034 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010034">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">curing</rdfs:label>
        <skos:comment>Curing may be induced by thermal energy, radiation, atmospheric exposure, or chemical additives. It applies broadly to material systems including polymer resins, concrete, vulcanized rubbers, drying oils, and coatings.</skos:comment>
        <skos:definition xml:lang="en">A curing process is a material processing process in which a material entity undergoes physical or chemical transformation to reach a hardened, set, or macroscopically stabilized state.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010099 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010099">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0010112"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">biomedical material</rdfs:label>
        <skos:altLabel>biomaterial</skos:altLabel>
        <skos:comment>related to the use of a material.   it is part of objects which participates some medical processes</skos:comment>
        <skos:definition xml:lang="en">non-living material intended to interface with biological systems to evaluate, treat, augment, or replace any tissue, organ, or function of the body</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010100 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010100">
        <owl:equivalentClass>
