        <skos:definition xml:lang="en">oxide ceramic consisting primarily of zirconium oxide</skos:definition>
        <PMD_0050117>ZrO₂</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050058 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050058">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050057"/>
        <rdfs:label xml:lang="en">yttria-stabilized zirconia ceramic</rdfs:label>
        <skos:definition xml:lang="en">zirconia ceramic stabilized with yttria to enhance its thermal and mechanical performance</skos:definition>
        <PMD_0050117>YSZ</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050059 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050059">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050057"/>
        <rdfs:label xml:lang="en">magnesia-stabilized zirconia ceramic</rdfs:label>
        <skos:definition xml:lang="en">zirconia ceramic stabilized with magnesia to improve its thermal stability</skos:definition>
        <PMD_0050117>MSZ</PMD_0050117>
    </owl:Class>
    


