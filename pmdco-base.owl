    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0001026 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0001026">
        <rdfs:subPropertyOf rdf:resource="https://w3id.org/pmd/co/PMD_0000004"/>
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">complies with</rdfs:label>
        <rdfs:label xml:lang="de">entspricht</rdfs:label>
        <skos:definition xml:lang="en">complies with is a relation between an independent continuant and an information content entity (e.g., specification or objective) that it conforms to.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0001028 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0001028">
        <owl:inverseOf rdf:resource="https://w3id.org/pmd/co/PMD_0001029"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">als Antwort auf</rdfs:label>
        <rdfs:label xml:lang="en">in response to</rdfs:label>
        <skos:definition xml:lang="de">Umkehrung von antwortet mit</skos:definition>
        <skos:definition xml:lang="en">inverse of responds with</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0001029 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0001029">
        <rdfs:domain rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">antwortet mit</rdfs:label>
        <rdfs:label xml:lang="en">responds with</rdfs:label>
        <skos:definition xml:lang="de">Die realisierbare Entität muss durch einen Reiz „stimuliert“ werden, um mit der Reaktion zu reagieren. Der Träger der realisierbaren Entität muss sowohl an der Stimulation als auch an der Reaktion teilnehmen.</skos:definition>
        <skos:definition xml:lang="en">The realizable entity must be &quot;stimulated&quot; by some Stimulus in order to respond with the Response. The bearer of the realizable entity must participate in Stimulation as well as in Response.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0020020 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0020020">
        <rdfs:comment>Overlaps with http://purl.obolibrary.org/obo/RO_0002434</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED interacts with</rdfs:label>
        <rdfs:label xml:lang="de">DEPRECATED interagiert mit</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">DEPRECATED A relation between participants of a process indicating that some of the participants SDCs are affected during the process due to the interaction of the participants.</skos:definition>
        <skos:definition xml:lang="de">DEPRECATED Eine Beziehung zwischen Teilnehmern eines Prozesses, die darauf hinweist, dass einige SDCs der Teilnehmer während des Prozesses aufgrund der Interaktion der Teilnehmer betroffen sind.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0020021 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0020021">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment>Overlapping with http://purl.obolibrary.org/obo/RO_0002566</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED causally influences</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">DEPRECATED An entity (that is bearer of some stimulation role) causally influences another entity (that is bearer of the stimulation target role) in a process iff  the target objects qualites (and/or realizable entities?) are altered in a manner that is significant in the given context/domain of discourse..</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0020127 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0020127">
        <rdfs:domain rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Despite has characteristic from RO does not have any domain constraints, it is still not possible to directly connect an instance of a process with an instance of a SDC. 

First, SDC is dependent on a IC. As RO does not have &quot;bearer of&quot; object property, the &quot;has characteristic&quot; implies that the domain should be an IC. 

Second, characteristic of is a functional property. Thus, two triples SDC_1 characteristc of IC_1 and SDC_2  characteristc of Process_1 (where IC_1 participates in Process_1), cannot exist simultaneously. 
An example of such case can be &quot;Temperature of during the annealing process was 1000°C&quot;. Temperature is an SDC of some participant of the annealing, however it is not clear whether it is an SDC of an oven or of a sample in the oven. If we assert triple Annealing--&gt; has characteristic --&gt; Temperature 1000°C, then the correct triple connecting temperature SDC with either oven or specimen cannot exist.</rdfs:comment>
        <rdfs:label xml:lang="en">refers to</rdfs:label>
        <skos:definition xml:lang="en">a relation between a process attribute and an SDC of some participant in a process</skos:definition>
        <skos:example xml:lang="en">a relation to between a process attribute an a SDC of some participant in a process.</skos:example>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0020256 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0020256">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">has numerator</rdfs:label>
        <skos:definition xml:lang="en">points to a numerator of a quotient</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0020257 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0020257">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">has denominator</rdfs:label>
        <skos:definition xml:lang="en">points to a denominator of a quotient</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0020321 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0020321">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/pmd/co/PMD_0000068"/>
        <rdfs:range rdf:resource="https://w3id.org/pmd/co/PMD_0000068"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Similar to derives from, except that it is about TQC rather that &quot;fully&quot; independent continuants.
May be seen as a chain &apos;is state of&apos; o &apos;has state&apos; in combination with some reference to time of existance.</rdfs:comment>
        <rdfs:label xml:lang="en">is transformed from state</rdfs:label>
        <skos:definition xml:lang="en">a relation of a TQC to another TQC from which it has derived. Both TQC are states of the same IC.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0020322 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0020322">
        <rdfs:subPropertyOf rdf:resource="http://www.w3.org/2002/07/owl#topObjectProperty"/>
        <rdfs:domain rdf:resource="https://w3id.org/pmd/co/PMD_0000068"/>
        <rdfs:range rdf:resource="https://w3id.org/pmd/co/PMD_0000068"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">transforms into state</rdfs:label>
        <skos:comment xml:lang="en">see &apos;is transformation of state&apos;</skos:comment>
        <skos:definition xml:lang="en">a relation of a TQC to another TQC into which it derives.</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0020324 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0020324">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">has differential numerator</rdfs:label>
        <skos:definition xml:lang="en">points to a differential numerator of a differential</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0020327 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0020327">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">TODO: candidate for causality?</rdfs:comment>
        <rdfs:label xml:lang="en">has differential denominator</rdfs:label>
        <skos:definition xml:lang="en">points to a denominator of a differential</skos:definition>
    </owl:ObjectProperty>
    


    <!-- https://w3id.org/pmd/co/PMD_0020355 -->

    <owl:ObjectProperty rdf:about="https://w3id.org/pmd/co/PMD_0020355">
        <rdfs:subPropertyOf rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">has minuend</rdfs:label>
