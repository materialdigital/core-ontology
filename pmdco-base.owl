            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">vacancy diffusion</rdfs:label>
        <skos:definition xml:lang="en">diffusion process in which crystal forming entities move from lattice points to vacant adjacent lattice points</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020224 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020224">
