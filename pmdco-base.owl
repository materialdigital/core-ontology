            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000116 xml:lang="en">TODO: replace topObjectProperty with occupies spatial region</obo:IAO_0000116>
        <rdfs:label xml:lang="en">vacancy (crystal)</rdfs:label>
        <skos:definition xml:lang="en">site at lattice point at which the crystal forming entity is missing</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020225 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020225">
