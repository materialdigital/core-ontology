                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020003"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">inter-diffusion in crystalline solid</rdfs:label>
        <skos:definition xml:lang="en">diffusion of entites of some type in a crystal that consists mostly of entites of a different type</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020223 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020223">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020194"/>
