            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">chromium steel</rdfs:label>
        <skos:definition xml:lang="en">steels containing chromium as an intentional alloying element, characterized by mechanical strength and hardness suitable for engineering applications such as bearings, tools, drills, and utensils, but lacking the corrosion resistance required to qualify as stainless steel</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010007 -->

