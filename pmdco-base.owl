                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000546"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000091"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0010023"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0010024"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0010025"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">bioceramic</rdfs:label>
        <skos:definition xml:lang="en">ceramic that is engineered to be compatible with biological systems</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050092 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050092">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000546"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000091"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0010024"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050091"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000091"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0010024"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">bioinert ceramic</rdfs:label>
        <skos:definition xml:lang="en">ceramic that is designed to remain inert in biological environments to minimize adverse reactions</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050095 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050095">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000546"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000091"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0010023"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050091"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000091"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0010023"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">bioactive ceramic</rdfs:label>
        <skos:definition xml:lang="en">ceramic that interacts with biological tissues to promote bonding or regeneration</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050096 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050096">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050055"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050095"/>
        <rdfs:label xml:lang="en">hydroxyapatite ceramic</rdfs:label>
        <skos:definition xml:lang="en">oxide ceramic that is bioactive and composed of calcium phosphate and closely resembles the mineral component of bone</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050098 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050098">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000546"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000091"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0010025"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050095"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000091"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0010025"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">bioresorbable ceramic</rdfs:label>
        <skos:definition xml:lang="en">ceramic that is designed to gradually be resorbed and replaced by natural tissue</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050101 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050101">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000661"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_30563"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">silicate glass</rdfs:label>
        <skos:definition xml:lang="en">glass whose network is based primarily on silica (SiO₂)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050102 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050102">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050101"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_31344"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_32145"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">soda-lime glass</rdfs:label>
        <skos:comment>soda (Na₂O) acting as a flux and lime (CaO) acting as a stabilizer</skos:comment>
        <skos:definition xml:lang="en">silicate glass that is composed of about 70% silica (SiO₂) with soda (Na₂O) and lime (CaO)</skos:definition>
        <skos:example>widely used as common window and container glass.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050106 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050106">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050101"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_30163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">borosilicate glass</rdfs:label>
        <skos:comment>characteristically low thermal expansion and high thermal/chemical resistance compared with soda‑lime glass.</skos:comment>
        <skos:definition xml:lang="en">silicate glass that uses boron trioxide (B₂O₃) as a major additional glass‑forming constituent</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050107 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050107">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050106"/>
        <rdfs:label xml:lang="en">pyrex-type glass</rdfs:label>
        <skos:definition xml:lang="en">borosilicate glass that is renowned for its high resistance to thermal shock.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050108 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050108">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050101"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_30187"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">aluminosilicate glass</rdfs:label>
        <skos:comment>typically higher transformation/softening temperatures and improved mechanical/chemical performance compared with many common silicates</skos:comment>
        <skos:definition xml:lang="en">silicate glass in which SiO₂ and Al₂O₃ are key structural units</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050109 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050109">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050101"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_81045"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">lead glass</rdfs:label>
        <skos:comment>increased refractive index and modified working properties relative to ordinary silicate glasses</skos:comment>
        <skos:definition xml:lang="en">silicate glass in which lead(II) oxide (PbO) is incorporated in significant amounts</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050110 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050110">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050109"/>
        <rdfs:label xml:lang="en">potash lead glass</rdfs:label>
        <skos:definition xml:lang="en">lead glass that utilizes potash as a flux in addition to lead oxide</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050111 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050111">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050109"/>
        <rdfs:label xml:lang="en">barium glass</rdfs:label>
        <skos:definition xml:lang="en">Barium glass is a form of lead glass that is modified with barium oxide to alter its optical properties</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050112 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050112">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050108"/>
        <rdfs:label xml:lang="en">high-temperature resistant glass</rdfs:label>
        <skos:definition xml:lang="en">aluminosilicate glass that is engineered to maintain stability at elevated temperatures</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050113 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050113">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000661"/>
        <rdfs:label xml:lang="en">non-silicate glass</rdfs:label>
        <skos:comment>Based on other glass formers or non‑oxide systems (e.g., phosphate (P₂O₅)-based, fluoride-based, or chalcogenide (S/Se/Te)-based compositions).</skos:comment>
        <skos:definition xml:lang="en">glass whose primary glass‑forming network is not based on SiO₂</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050114 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050114">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050113"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_37376"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">phosphate glass</rdfs:label>
        <skos:comment> (P₂O₅) as the glass former (i.e., replacing SiO₂ as the network basis).</skos:comment>
        <skos:definition xml:lang="en">non‑silicate glass based primarily on phosphorus pentoxide (P₂O₅)</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050115 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050115">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050113"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_30163"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">borate glass</rdfs:label>
        <skos:comment>It is distinct from borosilicate glass because B₂O₃ is the primary network former here rather than an added co‑former in a silica‑based network.</skos:comment>
        <skos:definition xml:lang="en">non‑silicate glass based primarily on boron oxide (B₂O₃) as the glass‑forming network</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050116 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050116">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050113"/>
        <rdfs:label xml:lang="en">germanate glass</rdfs:label>
        <skos:definition xml:lang="en">non-silicate glass that is composed primarily of germanium oxide, noted for its infrared transmission</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050118 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050118">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000661"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000877"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000661"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000790"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">optical glass</rdfs:label>
        <skos:comment>composition and processing chosen to achieve specified optical/mechanical parameters such as refractive index and dispersion.</skos:comment>
        <skos:definition xml:lang="en">glass manufactured for optical components</skos:definition>
        <skos:example>e.g., lenses, prisms, mirrors</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050119 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050119">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050101"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050118"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0025011"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000877"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">fused silica glass</rdfs:label>
        <skos:comment>obtained by melting silica and cooling fast enough to avoid crystallization.</skos:comment>
        <skos:definition xml:lang="en">silicate glass that is essentially pure, amorphous SiO₂</skos:definition>
        <skos:example>often called fused quartz or vitreous silica</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050120 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050120">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050118"/>
        <rdfs:label xml:lang="en">crown glass</rdfs:label>
        <skos:definition xml:lang="en">optical glass that is characterized by its low dispersion and high clarity</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050121 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050121">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050118"/>
        <rdfs:label xml:lang="en">flint glass</rdfs:label>
        <skos:definition xml:lang="en">optical glass that is distinguished by its high refractive index and dispersion</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050122 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050122">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000661"/>
        <rdfs:label xml:lang="en">specialty glass</rdfs:label>
        <skos:definition xml:lang="en">glass that is engineered primarily for a targeted functional performance profile</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050123 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050123">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050126"/>
        <rdfs:label xml:lang="en">chemically strengthened glass</rdfs:label>
        <skos:definition xml:lang="en">glass that is treated via chemical processes to enhance its strength</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050124 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050124">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000661"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000104"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050126"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000104"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">ion-exchanged glass</rdfs:label>
        <skos:definition xml:lang="en">glass that is chemically strengthened and produced by exchanging ions to improve durability</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050125 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050125">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050108"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050126"/>
        <rdfs:label xml:lang="en">aluminosilicate gorilla glass</rdfs:label>
        <skos:definition xml:lang="en">glass that is chemically strengthened</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050126 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050126">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000661"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000103"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000002"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000661"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000103"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">toughened (tempered) glass</rdfs:label>
        <skos:definition xml:lang="en">glass that is mechanically treated to increase its strength and safety</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050127 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050127">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000661"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000118"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">laminated glass</rdfs:label>
        <skos:definition xml:lang="en">glass that is composed of multiple bonded layers to improve safety and acoustic performance</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050128 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050128">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050133"/>
        <rdfs:label xml:lang="en">electrochromic glass</rdfs:label>
        <skos:definition xml:lang="en">functional glass that can reversibly change its light transmission properties when an electrical voltage is applied</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050129 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050129">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050133"/>
        <rdfs:label xml:lang="en">photochromic glass</rdfs:label>
        <skos:definition xml:lang="en">functional glass that alters its optical properties in response to exposure to light</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050130 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050130">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050133"/>
        <rdfs:label xml:lang="en">thermochromic glass</rdfs:label>
        <skos:definition xml:lang="en">functional glass that changes its optical properties as a function of temperature</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050131 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050131">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050050"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020043"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020060"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">lithium disilicate glass-ceramic</rdfs:label>
        <skos:comment>Provides transparent attenuation of X‑rays (and, depending on design, gamma radiation).</skos:comment>
        <skos:definition xml:lang="en">glass-ceramics that contain lithium disilicate crystals to provide high strength and aesthetic appeal</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050132 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050132">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050050"/>
        <rdfs:label xml:lang="en">transparent glass-ceramic</rdfs:label>
        <skos:definition xml:lang="en">glass-ceramics that are engineered to maintain optical transparency despite partial crystallization</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050133 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050133">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000661"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
