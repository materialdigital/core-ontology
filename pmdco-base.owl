            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">clay</rdfs:label>
        <skos:definition xml:lang="en">material that is naturally occurring, fine-grained earthy and composed primarily of hydrous aluminum silicates and other minerals, formed by the geological processes</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000117 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000117">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000577"/>
        <rdfs:label xml:lang="en">structural composite</rdfs:label>
        <skos:definition xml:lang="en">composite of material that is multi-layered and normally low-density, engineered for applications requiring structural integrity through high tensile, compressive, and torsional strengths and stiffnesses</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000118 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000118">
