        <rdfs:label xml:lang="en">laminate ply role</rdfs:label>
        <skos:definition xml:lang="en">role inherent in a single two-dimensional sheet that provides a specific high-strength orientation within a multi-layered stack</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000123 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000123">
