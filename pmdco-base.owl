        <skos:definition>a disposition to gain a greatly increased hardness at the surface or entire volume by the process of hardening</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010014 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010014">
