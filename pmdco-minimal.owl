    <!-- https://w3id.org/pmd/co/PMD_0050137 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050137">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000661"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020312"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000661"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020312"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">magnetic glass</rdfs:label>
        <skos:comment>Its composition and/or microstructure contains a significant population of magnetic species - typically transition‑metal or rare‑earth ions and/or magnetic nanophases - so that magnetic susceptibility/permeability/magnetization is a designed functional property of the glass.</skos:comment>
        <skos:definition xml:lang="en">glass that exhibits intrinsic bulk magnetic behavior|Magnetic glass is functional glass that is modified to exhibit magnetic properties</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0060006 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0060006">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Hossein Beygi Nasrabadi</obo:IAO_0000117>
        <rdfs:label xml:lang="en">device specification</rdfs:label>
        <skos:definition xml:lang="en">A directive information entity that outlines the technical requirements, features, constraints, and performance criteria of a specific device, guiding its design, manufacturing, operation, or maintenance.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0060007 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0060007">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <rdfs:label xml:lang="en">material specification</rdfs:label>
        <skos:definition xml:lang="en">A directive information entity that defines the composition, properties, performance criteria, and acceptable standards for a material, guiding its selection, processing, and application in a specific context.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0060009 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0060009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000033"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Hossein Beygi Nasrabadi</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">The intent of the specification datum is to express the &quot;Sollwert&quot; of some qualitiy or behavioral material property. Then, the specification datum can be further specified by  some value specification.</rdfs:comment>
        <rdfs:label xml:lang="en">specification datum</rdfs:label>
        <skos:definition xml:lang="en">A directive information entity that provides information of a setpoint of some value, i.e., it is an intended value.</skos:definition>
        <skos:example xml:lang="en">The setpoint value of a ultimate tensile strength of some steel material</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080007 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080007">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;radiologic quality&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">radiologic disposition</rdfs:label>
        <rdfs:label xml:lang="de">radiologische Eigenschaft</rdfs:label>
        <skos:definition xml:lang="en">Radiologic disposition pertains to properties or characteristics related to an entity&apos;s interaction with radiant energy</skos:definition>
        <skos:definition xml:lang="de">Radiologische Qualität bezieht sich auf die Eigenschaften oder Merkmale im Zusammenhang mit der Wechselwirkung einer Entität mit Strahlungsenergie</skos:definition>
        <skos:example xml:lang="en">The dose equivalent a patient receives from a chest X-ray is a radiologic quality of the examination</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080010 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080010">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000145"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;spatial relational quality&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;BFO_0000145&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">räumliche Relationsqualität</rdfs:label>
        <rdfs:label xml:lang="en">spatial relational quality</rdfs:label>
        <skos:definition xml:lang="de">Räumliche Beziehungsqualität ist eine Qualität, die einer materiellen Entität aufgrund ihrer räumlichen Beziehung zu einer oder mehreren anderen Entitäten, wie z. B. Position, Ausrichtung oder Entfernung, innewohnt</skos:definition>
        <skos:definition xml:lang="en">Spatial relational quality is a quality that inheres in a material entity by virtue of its spatial relationship to one or more other entities, such as position, orientation, or distance</skos:definition>
        <skos:example xml:lang="en">the distance between a bolt and the nearest edge of a steel plate is a spatial relational quality of the bolt</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080011 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080011">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;speed&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical process characteristic&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://simple.wikipedia.org/wiki/Speed.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://simple.wikipedia.org/wiki/Speed"/>
        <rdfs:label xml:lang="de">Geschwindigkeit</rdfs:label>
        <rdfs:label xml:lang="en">speed</rdfs:label>
        <skos:definition xml:lang="de">Geschwindigkeit beschreibt die Entfernung, die ein Objekt in einer bestimmten Zeit zurücklegt, immer positiv</skos:definition>
        <skos:definition xml:lang="en">process attribute that describes the distance an object moves in a given amount of time, always positive</skos:definition>
        <skos:example xml:lang="en">If a train takes 1 hour to travel 100 kilometers, it has a speed of 100 kilometers per hour (62 mph)</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080012 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080012">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;electric current&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical process characteristic&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">electric current</rdfs:label>
        <rdfs:label xml:lang="de">elektrischer Strom</rdfs:label>
        <skos:altLabel xml:lang="en">electric current</skos:altLabel>
        <skos:definition xml:lang="de">Elektrischer Strom ist der Fluss elektrischer Ladung pro Zeiteinheit</skos:definition>
        <skos:definition xml:lang="en">process attribute that represents the flow of electric charge per unit time</skos:definition>
        <skos:example xml:lang="en">A 100 W incandescent bulb draws an electric current of about 0.43 A at 230 V</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080013 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080013">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;force rate&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical process characteristic&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Kraftrate</rdfs:label>
        <rdfs:label xml:lang="en">force rate</rdfs:label>
        <skos:altLabel xml:lang="de">Ruck</skos:altLabel>
        <skos:altLabel xml:lang="en">yank</skos:altLabel>
        <skos:definition xml:lang="de">In der Physik wird der Begriff &quot;Ruck&quot; manchmal verwendet, um die Ableitung der Kraft in Bezug auf die Zeit oder die mit dem Ruck multiplizierte Masse zu bezeichnen. In der relativistischen Physik wird dieser Begriff als die zweite Ableitung des Impulses in Bezug auf die Zeit ausgedrückt, da die Masse geschwindigkeitsabhängig ist. Obwohl nicht allgemein als offizieller Begriff für diese Größe anerkannt, wird der Begriff &quot;Ruck&quot; häufig von Physikbegeisterten verwendet</skos:definition>
        <skos:definition xml:lang="en">In physics, yank is sometimes used to denote the derivative of force with respect to time or mass multiplied by jerk. In relativistic physics, it is expressed as the second derivative of momentum with respect to time, because the mass is velocity-dependent. Though not universally accepted as an official term for this quantity, the term &quot;yank&quot; is commonly used among physics enthusiasts</skos:definition>
        <skos:example xml:lang="en">During impact testing, the force rate on the specimen rises to 10 kN/ms within the first microsecond</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080014 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080014">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;mass flow rate&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical process characteristic&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Mass_flow_rate.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Mass_flow_rate"/>
        <rdfs:label xml:lang="de">Massendurchsatz</rdfs:label>
        <rdfs:label xml:lang="en">mass flow rate</rdfs:label>
        <skos:definition xml:lang="de">Der Massendurchfluss quantifiziert die pro Zeiteinheit fließende Masse und wird üblicherweise in Kilogramm pro Sekunde oder Pfund pro Sekunde gemessen</skos:definition>
        <skos:definition xml:lang="en">process attribute that quantifies the mass passing per unit time, commonly measured in kilograms per second or pounds per second</skos:definition>
        <skos:example xml:lang="en">A coolant pump delivers a mass flow rate of 2 kg/s of water through a heat exchanger</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080015 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080015">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;mechanical impulse&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical process characteristic&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Impulse_(physics).</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Impulse_(physics)"/>
        <rdfs:label xml:lang="en">mechanical impulse</rdfs:label>
        <rdfs:label xml:lang="de">mechanischer Impuls</rdfs:label>
        <skos:definition xml:lang="de">Unter mechanischem Impuls versteht man die Änderung des Impulses eines Objekts, wenn es im Laufe der Zeit einer Kraft ausgesetzt wird</skos:definition>
        <skos:definition xml:lang="en">process attribute that signifies the change in momentum of an object when subjected to a force over time</skos:definition>
        <skos:example xml:lang="en">A drop weight imparts a mechanical impulse of 50 N·s to the Charpy specimen during impact</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080016 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080016">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;radiant energy flux&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical process characteristic&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Radiant_energy.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Radiant_energy"/>
        <rdfs:label xml:lang="de">Strahlungsfluss</rdfs:label>
        <rdfs:label xml:lang="en">radiant energy flux</rdfs:label>
        <skos:definition xml:lang="de">Strahlungsfluss beschreibt die Strahlungsenergie, die pro Zeiteinheit emittiert, reflektiert, übertragen oder empfangen wird</skos:definition>
        <skos:definition xml:lang="en">process attribute that represents the radiant energy emitted, reflected, transmitted, or received per unit time</skos:definition>
        <skos:example xml:lang="en">A solar panel receives a radiant energy flux of 1000 W/m2 under standard test conditions</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080017 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080017">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;temperature profile&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical process characteristic&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Temperaturprofil</rdfs:label>
        <rdfs:label xml:lang="en">temperature profile</rdfs:label>
        <skos:definition xml:lang="de">Temperatur Profil beschreibt Änderungen der Temperatur eines materiellen Wesens oder Raums über die Zeit</skos:definition>
        <skos:definition xml:lang="en">process attribute that describes changes in the temperature of a material entity or space over time</skos:definition>
        <skos:example xml:lang="en">The temperature profile along a quenched steel bar varies from 850 C at the surface to 200 C at the core</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080019 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080019">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;area&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;DimensionQuality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0001323.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001323"/>
        <rdfs:label xml:lang="de">Fläche</rdfs:label>
        <rdfs:label xml:lang="en">area</rdfs:label>
        <skos:definition xml:lang="en">Area signifies a 2-D extent quality inhering by virtue of the bearer&apos;s two-dimensional extent</skos:definition>
        <skos:definition xml:lang="de">Fläche bedeutet eine zweidimensionale Ausdehnungsqualität, die aufgrund der zweidimensionalen Ausdehnung des Trägers inhärent ist</skos:definition>
        <skos:example xml:lang="en">The cross-sectional area of a tensile specimen at the gauge section is 50 mm2</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080021 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080021">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020309"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000506"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000146"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000146"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000517"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;sound reflection coefficient&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;acoustic quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Schallreflexionsgrad</rdfs:label>
        <rdfs:label xml:lang="en">sound reflection coefficient</rdfs:label>
        <skos:definition xml:lang="de">Schallreflexionsgrad quantifiziert den Anteil der Schallenergie, die von einer Oberfläche reflektiert wird</skos:definition>
        <skos:definition xml:lang="en">Sound reflection coefficient quantifies the proportion of sound energy reflected by a surface</skos:definition>
        <skos:example xml:lang="en">A concrete wall has a sound reflection coefficient near 0.99 at 500 Hz, acting nearly as a perfect reflector</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080022 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020312"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">electric charge</rdfs:label>
        <rdfs:label xml:lang="de">elektrische Ladung</rdfs:label>
        <skos:definition xml:lang="en">Electric charge refers to the physical property of matter causing it to experience a force when placed in an electromagnetic field</skos:definition>
        <skos:example xml:lang="en">A capacitor stores 10 µC of electric charge at a voltage of 5 V</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080023 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080023">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;electric field strength&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;electrical quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.britannica.com/science/electric-field.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://www.britannica.com/science/electric-field"/>
        <rdfs:label xml:lang="en">electric field strength</rdfs:label>
        <rdfs:label xml:lang="de">elektrische Feldstärke</rdfs:label>
        <skos:definition xml:lang="de">Die Stärke oder Intensität des elektrischen Feldes bezieht sich auf die Stärke und Richtung des elektrischen Feldes an einem Punkt und ist entscheidend für die Bestimmung der Auswirkungen auf elektrische Ladungen in der Nähe dieses Punktes</skos:definition>
        <skos:definition xml:lang="en">Electric field strength, or intensity, refers to the magnitude and direction of the electric field at a point, crucial for determining effects on electric charges near that point</skos:definition>
        <skos:example xml:lang="en">Between parallel capacitor plates separated by 1 mm at 100 V, the electric field strength is 1e5 V/m</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080024 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080024">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020353"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;dielectric strength&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;electrical quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Durchschlagsfestigkeit</rdfs:label>
        <rdfs:label xml:lang="en">dielectric strength</rdfs:label>
        <skos:altLabel xml:lang="de">Dielektrische Festigkeit</skos:altLabel>
        <skos:altLabel xml:lang="en">E_ds</skos:altLabel>
        <skos:definition xml:lang="en">Dielectric strength is an electrical quality of an insulating material that specifies the maximum electric field intensity the material can sustain without undergoing electrical breakdown</skos:definition>
        <skos:definition xml:lang="de">Durchschlagsfestigkeit ist eine elektrische Qualität eines Isoliermaterials, die die maximale elektrische Feldstärke angibt, die das Material aushalten kann, ohne einen elektrischen Durchschlag zu erleiden</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080025 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080025">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;magnetic flux&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;magnetic quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">magnetic flux</rdfs:label>
        <rdfs:label xml:lang="de">magnetischer Fluss</rdfs:label>
        <skos:altLabel xml:lang="de">Magnetfeld</skos:altLabel>
        <skos:altLabel xml:lang="en">magnetic field</skos:altLabel>
        <skos:altLabel xml:lang="en">magnetic flux</skos:altLabel>
        <skos:altLabel xml:lang="de">magnetischer Fluss</skos:altLabel>
        <skos:definition xml:lang="de">Magnetischer Fluss ist die Gesamtanzahl der Magnetfeldlinien, die durch eine bestimmte Fläche verlaufen</skos:definition>
        <skos:definition xml:lang="en">magnetic quality that represents the total number of magnetic field lines passing through a given area</skos:definition>
        <skos:example xml:lang="en">A transformer core carries a magnetic flux of 1 mWb through its cross-section at rated voltage</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080026 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080026">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;magnetic permeability&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;magnetic quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">magnetic permeability</rdfs:label>
        <rdfs:label xml:lang="de">magnetische Permeabilität</rdfs:label>
        <skos:altLabel xml:lang="de">Permeabilität</skos:altLabel>
        <skos:altLabel xml:lang="en">permeability</skos:altLabel>
        <skos:altLabel xml:lang="en">μ</skos:altLabel>
        <skos:definition xml:lang="en">Magnetic permeability is a magnetic quality of a material that quantifies its ability to support the formation of a magnetic field within itself, expressed as the ratio of magnetic flux density to the applied magnetic field intensity</skos:definition>
        <skos:definition xml:lang="de">Magnetische Permeabilität ist eine magnetische Qualität eines Materials, die seine Fähigkeit quantifiziert, ein Magnetfeld in seinem Inneren zu unterstützen, ausgedrückt als Verhältnis der magnetischen Flussdichte zur aufgebrachten magnetischen Feldstärke</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080027 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080027">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;coercivity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;magnetic quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Koerzitivfeldstärke</rdfs:label>
        <rdfs:label xml:lang="en">coercivity</rdfs:label>
        <skos:altLabel xml:lang="en">H_c</skos:altLabel>
        <skos:altLabel xml:lang="de">Koerzitivkraft</skos:altLabel>
        <skos:altLabel xml:lang="en">coercive field</skos:altLabel>
        <skos:altLabel xml:lang="en">coercive force</skos:altLabel>
        <skos:definition xml:lang="en">Coercivity is a magnetic quality of a ferromagnetic material that specifies the magnitude of the applied magnetic field required to reduce its magnetization to zero after it has been fully magnetised</skos:definition>
        <skos:definition xml:lang="de">Koerzitivfeldstärke ist eine magnetische Qualität eines ferromagnetischen Materials, die die Stärke des aufzubringenden Magnetfelds angibt, das erforderlich ist, um seine Magnetisierung nach vollständiger Magnetisierung auf null zu reduzieren</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080029 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080029">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020311"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Dehnung</rdfs:label>
        <rdfs:label xml:lang="en">strain</rdfs:label>
        <skos:definition xml:lang="en">Strain is defined as relative deformation, compared to a reference position configuration</skos:definition>
        <skos:example xml:lang="en">Under a tensile load, a polymer film exhibits a strain of 2 % before yielding</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080030 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080030">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080029"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;engineering strain&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;strain&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Strain_(mechanics).</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Strain_(mechanics)"/>
        <rdfs:label xml:lang="en">engineering strain</rdfs:label>
        <rdfs:label xml:lang="de">technische Dehnung</rdfs:label>
        <skos:altLabel xml:lang="en">Cauchy strain</skos:altLabel>
        <skos:altLabel xml:lang="en">technical strain</skos:altLabel>
        <skos:definition xml:lang="de">Die technische Dehnung oder Cauchy-Dehnung drückt die Gesamtverformung relativ zur ursprünglichen Abmessung des Materials unter Last aus und spiegelt die Dehnung bei axialer Belastung wider</skos:definition>
        <skos:definition xml:lang="en">Engineering strain, or Cauchy strain, expresses total deformation relative to the initial dimension of the material under load, reflecting elongation in axial loading</skos:definition>
        <skos:example xml:lang="en">A tensile specimen elongates from 50 mm to 55 mm gauge length, giving an engineering strain of 10 %</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080032 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080032">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080029"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;true strain&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;strain&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Strain_(mechanics).</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Strain_(mechanics)"/>
        <rdfs:label xml:lang="en">true strain</rdfs:label>
        <rdfs:label xml:lang="de">wahre Dehnung</rdfs:label>
        <skos:altLabel xml:lang="en">Hencky strain</skos:altLabel>
        <skos:altLabel xml:lang="en">logarithmic strain</skos:altLabel>
        <skos:definition xml:lang="en">True strain, or logarithmic strain, integrates incrementally over deformation; related to engineering strain as ε=ln(1+e)</skos:definition>
        <skos:definition xml:lang="de">Wahre Dehnung, auch als logarithmische Dehnung bekannt, integriert sich schrittweise über die Verformung; in Beziehung zum technischen Dehnungsmaß als ε=ln(1+e)</skos:definition>
        <skos:example xml:lang="en">At a cross-section reduction of 50 %, the true strain is ln(2) = 0.693</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080033 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020339"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">StrainAtBreak(x) ↔ Strain(x) ∧ ∃b∃p∃i(obo:BFO_0000040(b) ∧ MeasurementProcess(p) ∧ MeasurementInformationContentEntity(i) ∧ bearerOf(b, x) ∧ describes(i, x) ∧ isOutputOf(i, p) ∧ ∃t(TimeOfBreak(t) ∧ occupiesTemporalRegion(p, t)))</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Bruchdehnung</rdfs:label>
        <rdfs:label xml:lang="en">strain at break</rdfs:label>
        <skos:altLabel xml:lang="en">elongation at break</skos:altLabel>
        <skos:definition xml:lang="de">Bruchdehnung ist die Dehnung einer Probe im Moment des Bruchs, bestimmt unter Zugbelastung gemäß anwendbaren Prüfnormen</skos:definition>
        <skos:definition xml:lang="en">Strain at break is the strain of a specimen at the moment of fracture, determined under tensile load according to applicable test standards</skos:definition>
        <skos:example xml:lang="en">Strain at break of a thermoplastic polyurethane specimen measured as 450% under ISO 527 test conditions.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080034 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080034">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080029"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;elastic strain&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;strain&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Plasticity_(physics).</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Plasticity_(physics)"/>
        <rdfs:label xml:lang="en">elastic strain</rdfs:label>
        <rdfs:label xml:lang="de">elastische Deformation</rdfs:label>
        <skos:altLabel xml:lang="en">elastic deformation</skos:altLabel>
        <skos:altLabel xml:lang="de">elastische Verformung</skos:altLabel>
        <skos:definition xml:lang="de">Bei der elastischen Dehnung handelt es sich um eine Dehnungsqualität eines Materialgebildes, die durch eine reversible Verformung gekennzeichnet ist, die bei Wegnahme der aufgebrachten Last verschwindet</skos:definition>
        <skos:definition xml:lang="en">Elastic strain is a strain quality of a material entity characterized by reversible deformation that disappears upon removal of the applied load</skos:definition>
        <skos:example xml:lang="en">Steel loaded to 200 MPa exhibits an elastic strain of about 0.001, fully recovered upon unloading</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080035 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080035">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080029"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;plastic strain&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;strain&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Plasticity_(physics).</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Plasticity_(physics)"/>
        <rdfs:label xml:lang="en">plastic strain</rdfs:label>
        <rdfs:label xml:lang="de">plastische Deformation</rdfs:label>
        <skos:altLabel xml:lang="en">plastic deformation</skos:altLabel>
        <skos:altLabel xml:lang="de">plastische Verformung</skos:altLabel>
        <skos:definition xml:lang="en">Plastic strain describes permanent deformation occurring when a material is subjected to stress beyond its elastic limit</skos:definition>
        <skos:definition xml:lang="de">Plastische Deformation beschreibt die dauerhafte Verformung, die auftritt, wenn ein Material einer Belastung ausgesetzt wird, die über seine elastische Grenze hinausgeht</skos:definition>
        <skos:example xml:lang="en">After exceeding yield strength, a steel rod undergoes 5 % plastic strain that remains after unloading</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080036 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080036">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;luminous intensity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;optical quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Lichtstärke in cd gemessen</rdfs:label>
        <rdfs:label xml:lang="en">luminous intensity</rdfs:label>
        <skos:altLabel xml:lang="de">Leuchtintensität</skos:altLabel>
        <skos:altLabel xml:lang="de">Lichtintensität</skos:altLabel>
        <skos:altLabel xml:lang="en">luminous intensity</skos:altLabel>
        <skos:definition xml:lang="de">Lichtstärke ist die Menge des sichtbaren Lichts, das pro Einheitswinkel in eine bestimmte Richtung von einer Quelle abgestrahlt wird, gemessen in Candela (cd)</skos:definition>
        <skos:definition xml:lang="en">Luminous intensity quantifies the visible light emitted per unit solid angle in a particular direction from a source, measured in candela (cd)</skos:definition>
        <skos:example xml:lang="en">A standard LED lamp emits a luminous intensity of 800 cd in the forward direction</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080037 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080037">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000143"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;exposure&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;optical quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Exposure_(photography).</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Exposure_(photography)"/>
        <rdfs:label xml:lang="de">Belichtungszeit</rdfs:label>
        <rdfs:label xml:lang="en">light exposure</rdfs:label>
        <skos:definition xml:lang="en">Exposure in photography refers to the amount of light per unit area reaching film or sensor, determined by shutter speed, lens F-number, and scene luminance</skos:definition>
        <skos:definition xml:lang="de">Unter Belichtung versteht man in der Fotografie die Lichtmenge pro Flächeneinheit, die den Film oder Sensor erreicht, bestimmt durch Verschlusszeit, Blendenzahl des Objektivs und Helligkeit der Szene</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080038 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080038">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;Curie temperature&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermo dynamic quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">Curie temperature</rdfs:label>
        <rdfs:label xml:lang="de">Curie-Temperatur</rdfs:label>
        <skos:altLabel xml:lang="en">Curie point</skos:altLabel>
        <skos:altLabel xml:lang="de">Curie-Punkt</skos:altLabel>
        <skos:altLabel xml:lang="en">T_C</skos:altLabel>
        <skos:definition xml:lang="en">Curie temperature is a thermodynamic quality of a ferromagnetic material that specifies the temperature above which it loses its permanent magnetic ordering and becomes paramagnetic</skos:definition>
        <skos:definition xml:lang="de">Curie-Temperatur ist eine thermodynamische Qualität eines ferromagnetischen Materials, die die Temperatur angibt, oberhalb derer das Material seine permanente magnetische Ordnung verliert und paramagnetisch wird</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080039 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080039">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;specific heat capacity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermo dynamic quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">specific heat capacity</rdfs:label>
        <rdfs:label xml:lang="de">spezifische Wärmekapazität</rdfs:label>
        <skos:definition xml:lang="en">Specific heat capacity is the heat capacity of a sample divided by its mass, representing the heat required to raise temperature by one unit</skos:definition>
        <skos:definition xml:lang="de">Spezifische Wärmekapazität ist die Wärmekapazität einer Probe geteilt durch ihre Masse und repräsentiert die erforderliche Wärme, um die Temperatur um eine Einheit zu erhöhen</skos:definition>
        <skos:example xml:lang="en">Water has a specific heat capacity of 4182 J/(kg·K), making it an effective coolant</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080040 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080040">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020164"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;eutectic point&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermo dynamic quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">eutectic point</rdfs:label>
        <rdfs:label xml:lang="de">eutektischer Punkt</rdfs:label>
        <skos:altLabel xml:lang="en">eutectic temperature</skos:altLabel>
        <skos:altLabel xml:lang="de">eutektische Temperatur</skos:altLabel>
        <skos:definition xml:lang="en">Eutectic point is a thermodynamic quality of a multi-component material system that specifies the composition and temperature at which all components simultaneously solidify from a liquid mixture at the lowest possible melting temperature</skos:definition>
        <skos:definition xml:lang="de">Eutektischer Punkt ist eine thermodynamische Qualität eines Mehrkomponentenmaterialsystems, die die Zusammensetzung und Temperatur angibt, bei der alle Komponenten gleichzeitig aus einer flüssigen Mischung bei der niedrigstmöglichen Schmelztemperatur erstarren</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080041 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080041">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;critical pressure&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermo dynamic quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">critical pressure</rdfs:label>
        <rdfs:label xml:lang="de">kritischer Druck</rdfs:label>
        <skos:altLabel xml:lang="en">p_c</skos:altLabel>
        <skos:definition xml:lang="en">Critical pressure is a thermodynamic quality of a pure substance that specifies the minimum pressure required to liquefy the substance at its critical temperature</skos:definition>
        <skos:definition xml:lang="de">Kritischer Druck ist eine thermodynamische Qualität einer reinen Substanz, die den Mindestdruck angibt, der erforderlich ist, um die Substanz bei ihrer kritischen Temperatur zu verflüssigen</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080042 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080042">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;critical temperature&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermo dynamic quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">critical temperature</rdfs:label>
        <rdfs:label xml:lang="de">kritische Temperatur</rdfs:label>
        <skos:altLabel xml:lang="en">T_c</skos:altLabel>
        <skos:definition xml:lang="en">Critical temperature is a thermodynamic quality of a pure substance that specifies the temperature above which the substance cannot exist as a liquid regardless of applied pressure</skos:definition>
        <skos:definition xml:lang="de">Kritische Temperatur ist eine thermodynamische Qualität einer reinen Substanz, die die Temperatur angibt, oberhalb derer die Substanz unabhängig vom aufgebrachten Druck nicht als Flüssigkeit existieren kann</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080045 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080045">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;environmental temperature&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;temperature&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Umgebungstemperatur</rdfs:label>
        <rdfs:label xml:lang="en">environmental temperature</rdfs:label>
        <skos:definition xml:lang="en">Environmental temperature describes the observed temperature surrounding a tangible object, including room temperature and temperatures measured in test chambers</skos:definition>
        <skos:definition xml:lang="de">Umgebungstemperatur ist die Eigenschaft, die die beobachtete Temperatur in der Umgebung eines betrachteten materiellen Objekts beschreibt. Dazu gehören Raumtemperatur und die in Prüfkammern gemessenen Temperaturen</skos:definition>
        <skos:example xml:lang="en">A circuit board operates at an environmental temperature of 85 C in a high-reliability application</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080046 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080046">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;vapor pressure&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermo dynamic quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Dampfdruck</rdfs:label>
        <rdfs:label xml:lang="en">vapor pressure</rdfs:label>
        <skos:altLabel xml:lang="en">p*</skos:altLabel>
        <skos:definition xml:lang="de">Dampfdruck ist eine thermodynamische Qualität eines Stoffes, die den Druck angibt, den sein Dampf ausübt, wenn er sich bei einer gegebenen Temperatur im thermodynamischen Gleichgewicht mit seiner kondensierten Phase befindet</skos:definition>
        <skos:definition xml:lang="en">Vapor pressure is a thermodynamic quality of a substance that specifies the pressure exerted by its vapor when in thermodynamic equilibrium with its condensed phase at a given temperature</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080047 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080047">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;flash point&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermo dynamic quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Flammpunkt</rdfs:label>
        <rdfs:label xml:lang="en">flash point</rdfs:label>
        <skos:definition xml:lang="de">Flammpunkt ist eine thermodynamische Qualität eines flüchtigen Materials, die die niedrigste Temperatur angibt, bei der sein Dampf an der Materialoberfläche ein zündfähiges Gemisch mit Luft bildet</skos:definition>
        <skos:definition xml:lang="en">Flash point is a thermodynamic quality of a volatile material that specifies the lowest temperature at which its vapour forms an ignitable mixture with air near the surface of the material</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080048 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080048">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;ductile-brittle transition temperature&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermo dynamic quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Duktil-Spröd-Übergangstemperatur</rdfs:label>
        <rdfs:label xml:lang="en">ductile-brittle transition temperature</rdfs:label>
        <skos:altLabel xml:lang="de">Nullduktilitäts-Übergangstemperatur</skos:altLabel>
        <skos:altLabel xml:lang="en">T_DBTT</skos:altLabel>
        <skos:altLabel xml:lang="en">nil ductility transition temperature</skos:altLabel>
        <skos:definition xml:lang="en">Ductile-brittle transition temperature is a thermodynamic quality of a material that specifies the temperature below which the material exhibits brittle fracture behaviour rather than ductile deformation under impact loading</skos:definition>
        <skos:definition xml:lang="de">Duktil-Spröd-Übergangstemperatur ist eine thermodynamische Qualität eines Materials, die die Temperatur angibt, unterhalb derer das Material unter Schlagbelastung ein sprödes Bruchverhalten anstelle einer duktilen Verformung zeigt</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080049 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080049">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080048"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;glass transition temperature&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;ductile-brittle transition temperature&apos; specific to amorphous and semi-crystalline materials. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Glass_transition.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Glass_transition"/>
        <rdfs:label xml:lang="de">Glasübergangstemperatur</rdfs:label>
        <rdfs:label xml:lang="en">glass transition temperature</rdfs:label>
        <skos:altLabel xml:lang="en">Tg</skos:altLabel>
        <skos:definition xml:lang="en">Glass transition temperature is a ductile-brittle transition temperature of an amorphous or semi-crystalline material that specifies the temperature at which the material transitions from a hard, glassy state to a soft, rubbery state upon heating</skos:definition>
        <skos:definition xml:lang="de">Glasübergangstemperatur ist eine Duktil-Spröd-Übergangstemperatur eines amorphen oder teilkristallinen Materials, die die Temperatur beschreibt, bei der das Material beim Erwärmen von einem harten, glasartigen in einen weichen, gummiartigen Zustand übergeht</skos:definition>
        <skos:example xml:lang="en">Glass transition temperature of polycarbonate measured at approximately 147 °C, above which the material softens and loses rigidity, determined according to ISO 11357-2.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080050 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080050">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020142"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020128"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000117>Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">SI unit: joules per kelvin (J/K)

Statistical definition (Boltzmann):
S=k_B ln(W)
where k_B​ is the Boltzmann constant and W is the number of microstates.</rdfs:comment>
        <rdfs:label xml:lang="en">entropy</rdfs:label>
        <skos:definition xml:lang="en">Entropy is a measure of the disorder or randomness of a system — more precisely, the number of microscopic arrangements (microstates) consistent with the system&apos;s macroscopic state.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080052 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080052">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020142"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000896"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020150"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020151"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">enthalpy</rdfs:label>
        <skos:definition xml:lang="en">enthalpy H is the sum of internal energy and the product of pressure and volume</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080053 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080053">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080052"/>
        <rdfs:label xml:lang="en">melting enthalpy</rdfs:label>
        <skos:definition xml:lang="en">the amount of energy required to convert an entity from solid to liquid aggregtate state at constant temperature and pressure</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080055 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080055">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;auto-ignition temperature&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermo dynamic quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Selbstzündungstemperatur</rdfs:label>
        <rdfs:label xml:lang="en">auto-ignition temperature</rdfs:label>
        <skos:altLabel xml:lang="en">T_AIT</skos:altLabel>
        <skos:altLabel xml:lang="de">Zündtemperatur</skos:altLabel>
        <skos:altLabel xml:lang="en">spontaneous ignition temperature</skos:altLabel>
        <skos:definition xml:lang="en">Auto-ignition temperature is a thermodynamic quality of a substance that specifies the lowest temperature at which it spontaneously ignites in a normal atmosphere without an external ignition source</skos:definition>
        <skos:definition xml:lang="de">Selbstzündungstemperatur ist eine thermodynamische Qualität eines Stoffes, die die niedrigste Temperatur angibt, bei der er sich in normaler Atmosphäre ohne externe Zündquelle selbst entzündet</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080056 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080056">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020316"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Might be a process attribute of a viscous fluid flowing (in a channel)</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;Reynolds number&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;FluidDynamicQuality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Reynolds_number.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Reynolds_number"/>
        <rdfs:label xml:lang="en">Reynolds number</rdfs:label>
        <rdfs:label xml:lang="de">Reynolds-Zahl</rdfs:label>
        <skos:definition xml:lang="en">Reynolds number is a dimensionless quantity predicting fluid flow patterns, measuring the ratio between inertial and viscous forces</skos:definition>
        <skos:definition xml:lang="de">Reynolds-Zahl ist eine dimensionslose Größe zur Vorhersage von Strömungsmustern in Flüssigkeiten, die das Verhältnis zwischen Trägheits- und Viskosekräften misst</skos:definition>
        <skos:example xml:lang="en">Flow in a 25 mm pipe at 2 m/s has a Reynolds number of about 50000, indicating turbulent regime</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080057 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080057">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;odor&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;olfactoric quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000058.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="http://purl.obolibrary.org/obo/PATO_0000058"/>
        <rdfs:label xml:lang="de">Geruch</rdfs:label>
        <rdfs:label xml:lang="en">odor</rdfs:label>
        <skos:definition xml:lang="de">Geruch ist eine morphologische Eigenschaft, die einem Träger innewohnt, dessen Moleküle von einem Geruchsrezeptor verteilt und wahrgenommen werden</skos:definition>
        <skos:definition xml:lang="en">Odor is a morphologic quality inhering in a bearer whose molecules are dispersed and perceived by an odorant receptor</skos:definition>
        <skos:example xml:lang="en">The characteristic odor of acetic acid is detectable in dilute vinegar solutions</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080061 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080061">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0040001"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;radius&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;length&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0002390.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="http://purl.obolibrary.org/obo/PATO_0002390"/>
        <rdfs:label xml:lang="de">Radius</rdfs:label>
        <rdfs:label xml:lang="en">radius</rdfs:label>
        <skos:definition xml:lang="en">Radius is a length quality equal to the distance from the center of a circle to any endpoint on the circular boundary</skos:definition>
        <skos:definition xml:lang="de">Radius ist eine Längeneigenschaft, die gleich der Entfernung vom Mittelpunkt eines Kreises zu einem beliebigen Endpunkt auf der Kreisgrenze ist</skos:definition>
        <skos:example xml:lang="en">A cylindrical specimen has a radius of 5 mm, giving a cross-sectional area of 78.5 mm2</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080065 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080065">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;wavelength&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;length&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.oxfordreference.com/display/10.1093/oi/authority.20110803121421585.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://www.oxfordreference.com/display/10.1093/oi/authority.20110803121421585"/>
        <rdfs:label xml:lang="de">Wellenlänge</rdfs:label>
        <rdfs:label xml:lang="en">wavelength</rdfs:label>
        <skos:definition xml:lang="en">Wavelength is the distance between successive peaks or troughs of a wave, equal to wave speed divided by frequency</skos:definition>
        <skos:definition xml:lang="de">Wellenlänge ist die Entfernung zwischen aufeinanderfolgenden Gipfeln oder Tälern einer Welle, gleich der Wellenbewegungsgeschwindigkeit geteilt durch die Frequenz</skos:definition>
        <skos:example xml:lang="en">A green laser pointer emits light at a wavelength of 532 nm</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080066 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080066">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0040001"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;height&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;length&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000119.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="http://purl.obolibrary.org/obo/PATO_0000119"/>
        <rdfs:label xml:lang="de">Höhe</rdfs:label>
        <rdfs:label xml:lang="en">height</rdfs:label>
        <skos:definition xml:lang="de">Die Höhe ist eine eindimensionale Ausdehnungsqualität, die die vertikale Abmessung eines Objekts oder Raums beschreibt, gemessen von der Basis bis zur Spitze</skos:definition>
        <skos:definition xml:lang="en">Height is a 1-D extent quality describing the vertical dimension of an object or space, measured from the base to the top</skos:definition>
        <skos:example xml:lang="en">A steel column has a height of 3.6 m between floor and ceiling connections</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080067 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080067">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0040001"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;perimeter&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;length&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0001711.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001711"/>
        <rdfs:label xml:lang="de">Umfang</rdfs:label>
        <rdfs:label xml:lang="en">perimeter</rdfs:label>
        <skos:definition xml:lang="de">Der Umfang misst eine eindimensionale Ausdehnung, die einem zweidimensionalen Träger innewohnt und die Entfernung um ihn herum darstellt</skos:definition>
        <skos:definition xml:lang="en">Perimeter measures a 1-D extent inhering in a two-dimensional bearer, representing the distance around it</skos:definition>
        <skos:example xml:lang="en">The perimeter of a square cross-section beam of 50 mm side length is 200 mm</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080068 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080068">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080067"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;circumference&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;perimeter&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0001648.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="http://purl.obolibrary.org/obo/PATO_0001648"/>
        <rdfs:label xml:lang="de">Kreisumfang</rdfs:label>
        <rdfs:label xml:lang="en">circumference</rdfs:label>
        <skos:definition xml:lang="en">Circumference characterizes a 1-D extent equal to the length of the closed curve of a circle</skos:definition>
        <skos:definition xml:lang="de">Der Umfang charakterisiert eine eindimensionale Ausdehnung, die der Länge der geschlossenen Kurve eines Kreises entspricht</skos:definition>
        <skos:example xml:lang="en">A wire of 2 mm diameter has a circumference of 6.28 mm</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080069 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080069">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;physical relational quality&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;BFO_0000145&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">physical relational quality</rdfs:label>
        <rdfs:label xml:lang="de">physisch relative Qualität</rdfs:label>
        <skos:definition xml:lang="de">Die physische Beziehungsqualität bezieht sich auf Eigenschaften oder Merkmale einer Entität, die von ihrer Beziehung zu anderen Entitäten abhängig sind</skos:definition>
        <skos:definition xml:lang="en">Physical relational quality pertains to properties or characteristics of an entity dependent on its relation to other entities</skos:definition>
        <skos:example xml:lang="en">The coefficient of friction between two surfaces is a physical relational quality inhering in both contacting materials</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080070 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080070">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080069"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;physical rate quality&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical relational quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Rate =(def.) a measure, quantity, or frequency, typically one measured against some other quantity or measure</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">physical rate quality</rdfs:label>
        <rdfs:label xml:lang="de">physische Geschwindigkeitsqualität</rdfs:label>
        <skos:definition xml:lang="de">Die physikalische Geschwindigkeitsqualität bezeichnet den Quotienten zweier physikalischer Größen in unterschiedlichen Einheiten, der die Änderungsrate einer Größe im Verhältnis zu einer anderen darstellt</skos:definition>
        <skos:definition xml:lang="en">Physical rate quality denotes the quotient of two physical quantities in different units, representing one quantity&apos;s rate of change in relation to another</skos:definition>
        <skos:example xml:lang="en">The rate of thermal expansion of a metal rod during quenching is a physical rate quality</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080071 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080071">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;emissivity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical rate quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Emissionsgrad</rdfs:label>
        <rdfs:label xml:lang="en">emissivity</rdfs:label>
        <skos:altLabel xml:lang="de">Emissivität</skos:altLabel>
        <skos:altLabel xml:lang="en">ε</skos:altLabel>
        <skos:definition xml:lang="de">Emissionsgrad ist eine physikalische Ratenqualität einer Materialoberfläche, die das Verhältnis der von der Oberfläche emittierten Wärmestrahlung zu der eines idealen schwarzen Körpers bei gleicher Temperatur ausdrückt</skos:definition>
        <skos:definition xml:lang="en">Emissivity is a physical rate quality of a material surface that expresses the ratio of thermal radiation emitted by the surface to that emitted by a perfect blackbody at the same temperature</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080072 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080072">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;relative isotopic mass&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical rate quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Atomic_mass.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Atomic_mass"/>
        <rdfs:label xml:lang="de">relative Isotopenmasse</rdfs:label>
        <rdfs:label xml:lang="en">relative isotopic mass</rdfs:label>
        <skos:definition xml:lang="de">Relative Isotopenmasse bezieht sich auf die Masse eines einzelnen Isotops im Vergleich zu 1/12 der Masse eines Kohlenstoff-12-Atoms</skos:definition>
        <skos:definition xml:lang="en">Relative isotopic mass refers to the mass of a single isotope compared to 1/12 of the mass of a carbon-12 atom</skos:definition>
        <skos:example xml:lang="en">The relative isotopic mass of carbon-13 is 13.003 u, slightly heavier than carbon-12</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080073 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080073">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;luminous efficacy&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical rate quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Luminous_efficacy.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Luminous_efficacy"/>
        <rdfs:label xml:lang="de">Lichtausbeute</rdfs:label>
        <rdfs:label xml:lang="en">luminous efficacy</rdfs:label>
        <skos:definition xml:lang="de">Die Lichtausbeute misst, wie gut eine Lichtquelle sichtbares Licht erzeugt, berechnet als Lichtstrom geteilt durch Leistung, ausgedrückt in Lumen pro Watt</skos:definition>
        <skos:definition xml:lang="en">Luminous efficacy measures how well a light source produces visible light, calculated as luminous flux divided by power, expressed in lumens per watt</skos:definition>
        <skos:example xml:lang="en">A modern LED achieves a luminous efficacy of 200 lm/W, far exceeding incandescent bulbs</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080074 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080074">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;optical absorptance&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical rate quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">optical absorptance</rdfs:label>
        <rdfs:label xml:lang="de">optische Absorption</rdfs:label>
        <skos:definition xml:lang="de">Die optische Absorption definiert das Verhältnis der absorbierten Strahlungsleistung zur einfallenden Strahlungsleistung und gibt Aufschluss über die Absorptionsfähigkeit eines Mediums</skos:definition>
        <skos:definition xml:lang="en">Optical absorptance defines the ratio of absorbed radiant power to incident radiant power, indicating a medium&apos;s absorption capability</skos:definition>
        <skos:example xml:lang="en">A solar absorber coating has an optical absorptance of 0.96, converting most sunlight to heat</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080075 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080075">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;optical transmittance&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical rate quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">optical transmittance</rdfs:label>
        <rdfs:label xml:lang="de">optische Transmittance</rdfs:label>
        <skos:definition xml:lang="de">Die optische Durchlässigkeit wird durch das Verhältnis der übertragenen Strahlungsleistung zur einfallenden Strahlungsleistung definiert und dient der Beurteilung der Übertragungseffizienz</skos:definition>
        <skos:definition xml:lang="en">Optical transmittance is defined by the ratio of transmitted radiant power to incident radiant power, assessing transmission efficiency</skos:definition>
        <skos:example xml:lang="en">A 3 mm thick soda-lime glass pane has an optical transmittance of 90 % in the visible range</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080076 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080076">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;mass diffusivity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical rate quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Massendiffusivität</rdfs:label>
        <rdfs:label xml:lang="en">mass diffusivity</rdfs:label>
        <skos:altLabel xml:lang="en">D</skos:altLabel>
        <skos:altLabel xml:lang="de">Diffusionskoeffizient</skos:altLabel>
        <skos:altLabel xml:lang="en">diffusion coefficient</skos:altLabel>
        <skos:definition xml:lang="en">Mass diffusivity is a physical rate quality of a material that quantifies the rate at which a diffusing substance moves through it per unit concentration gradient, as described by Fick&apos;s first law</skos:definition>
        <skos:definition xml:lang="de">Massendiffusivität ist eine physikalische Ratenqualität eines Materials, die die Geschwindigkeit beschreibt, mit der eine diffundierende Substanz pro Konzentrationsgradienten durch das Material transportiert wird, gemäß dem ersten Fickschen Gesetz</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080077 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080077">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;optical reflectance&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical rate quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">optical reflectance</rdfs:label>
        <rdfs:label xml:lang="de">optische Reflexion</rdfs:label>
        <skos:definition xml:lang="de">Der optische Reflexionsgrad wird durch das Verhältnis der reflektierten Strahlungsleistung zur einfallenden Strahlungsleistung definiert und bewertet die Reflexionsfähigkeit</skos:definition>
        <skos:definition xml:lang="en">Optical reflectance is defined by the ratio of reflected radiant power to incident radiant power, assessing reflective capacity</skos:definition>
        <skos:example xml:lang="en">A silver mirror has an optical reflectance of 98 % at 600 nm wavelength</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080078 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080078">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;electromotive force&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical rate quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Electromotive_force.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Electromotive_force"/>
        <rdfs:label xml:lang="de">Quellenspannung</rdfs:label>
        <rdfs:label xml:lang="en">electromotive force</rdfs:label>
        <skos:altLabel xml:lang="en">EMP</skos:altLabel>
        <skos:definition xml:lang="en">Electromotive force refers to energy transferred to an electric circuit per unit charge, measured in volts, produced by transducers converting forms of energy to electrical energy</skos:definition>
        <skos:definition xml:lang="de">Unter elektromotorischer Kraft versteht man die Energie, die pro Ladungseinheit auf einen Stromkreis übertragen wird. Sie wird in Volt gemessen und von Wandlern erzeugt, die Energieformen in elektrische Energie umwandeln</skos:definition>
        <skos:example xml:lang="en">A standard zinc-copper galvanic cell produces an electromotive force of 1.1 V</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080079 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080079">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;humidity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical rate quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Feuchtigkeit</rdfs:label>
        <rdfs:label xml:lang="en">humidity</rdfs:label>
        <skos:definition xml:lang="de">Die Luftfeuchtigkeit charakterisiert den Partialdruck der Luft, der durch den Wasserdampfgehalt entsteht, definiert als das Verhältnis von Wassermasse zu Volumen des Medium-Wasser-Gemisches</skos:definition>
        <skos:definition xml:lang="en">Humidity characterizes air&apos;s partial pressure exerted by water vapor content, defined as the mass of water to volume of the medium-water mixture</skos:definition>
        <skos:example xml:lang="en">A drying oven maintains relative humidity below 5 % to prevent moisture absorption in polymer samples</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080080 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080080">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;thermal diffusivity&apos; have not yet been formalized. Although thermal diffusivity is defined as a ratio of thermal conductivity to the product of density and specific heat capacity, a co-inherence axiom cannot uniquely identify this quality among all rate qualities of the same bearer. The term is defined as a specific subtype of &apos;physical rate quality&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Temperaturleitfähigkeit</rdfs:label>
        <rdfs:label xml:lang="en">thermal diffusivity</rdfs:label>
        <skos:altLabel xml:lang="de">Thermische Diffusivität</skos:altLabel>
        <skos:altLabel xml:lang="en">α</skos:altLabel>
        <skos:definition xml:lang="de">Temperaturleitfähigkeit ist eine physikalische Ratenqualität eines Materials, die die Geschwindigkeit beschreibt, mit der Wärmeenergie im Verhältnis zur Wärmespeicherkapazität geleitet wird, ausgedrückt als Verhältnis der Wärmeleitfähigkeit zum Produkt aus Dichte und spezifischer Wärmekapazität</skos:definition>
        <skos:definition xml:lang="en">Thermal diffusivity is a physical rate quality of a material that quantifies the rate at which thermal energy is conducted relative to its capacity to store heat, expressed as the ratio of thermal conductivity to the product of density and specific heat capacity</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080081 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080081">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;work hardening coefficient&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical rate quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Verfestigungsexponent</rdfs:label>
        <rdfs:label xml:lang="en">work hardening coefficient</rdfs:label>
        <skos:altLabel xml:lang="de">Kaltverfestigungsexponent</skos:altLabel>
        <skos:altLabel xml:lang="en">n</skos:altLabel>
        <skos:altLabel xml:lang="en">strain hardening exponent</skos:altLabel>
        <skos:definition xml:lang="de">Verfestigungsexponent ist eine physikalische Ratenqualität eines Materials, die die Geschwindigkeit beschreibt, mit der die Fließspannung bei plastischer Verformung während der Kaltumformung zunimmt, ausgedrückt als Exponent n in der Hollomon-Potenzgesetzbeziehung</skos:definition>
        <skos:definition xml:lang="en">Work hardening coefficient is a physical rate quality of a material that quantifies the rate at which flow stress increases with plastic strain during cold working, expressed as the exponent n in the Hollomon power-law relation</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080082 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080082">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020309"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020311"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000146"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002000"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020293"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;coefficient of friction&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical relational quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Reibungskoeffizient</rdfs:label>
        <rdfs:label xml:lang="en">coefficient of friction</rdfs:label>
        <skos:altLabel xml:lang="de">Reibwert</skos:altLabel>
        <skos:altLabel xml:lang="en">friction coefficient</skos:altLabel>
        <skos:altLabel xml:lang="en">μ</skos:altLabel>
        <skos:definition xml:lang="en">Coefficient of friction is a dimensionless scalar quality of a pair of surfaces in contact that expresses the ratio of the friction force between them to the normal force pressing them together</skos:definition>
        <skos:definition xml:lang="de">Der Reibungskoeffizient ist eine dimensionslose skalare Qualität eines Paars in Kontakt stehender Oberflächen, die das Verhältnis der Reibungskraft zwischen ihnen zur Normalkraft ausdrückt, die sie zusammendrückt</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080083 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080083">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;inductance&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical relational quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Inductance.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Inductance"/>
        <rdfs:label xml:lang="de">Induktion</rdfs:label>
        <rdfs:label xml:lang="en">inductance</rdfs:label>
        <skos:definition xml:lang="en">Inductance is the tendency of an electrical conductor to oppose a change in electric current through electromagnetic induction, creating back electromotive force</skos:definition>
        <skos:definition xml:lang="de">Induktivität ist die Tendenz eines elektrischen Leiters, einer Änderung des elektrischen Stroms durch elektromagnetische Induktion entgegenzuwirken und so eine elektromotorische Gegenkraft zu erzeugen</skos:definition>
        <skos:example xml:lang="en">A solenoid coil of 100 turns has an inductance of 1 mH, opposing rapid current changes</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080087 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080087">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;thrust&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;force&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Thrust.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Thrust"/>
        <rdfs:label xml:lang="de">Schubkraft</rdfs:label>
        <rdfs:label xml:lang="en">thrust</rdfs:label>
        <skos:definition xml:lang="de">Schubkraft ist eine von Newtons drittem Gesetz beschriebene Kraft, bei der Massenbeschleunigung in eine Richtung eine gleich große Kraft in die entgegengesetzte Richtung verursacht</skos:definition>
        <skos:definition xml:lang="en">Thrust is a force described by Newton&apos;s third law, where mass expulsion in one direction causes an equal force in the opposite direction</skos:definition>
        <skos:example xml:lang="en">A jet engine produces 150 kN of thrust at takeoff conditions</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080088 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080088">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;dose equivalent&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical relational quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.nrc.gov/reading-rm/basic-ref/glossary/dose-equivalent.html.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://www.nrc.gov/reading-rm/basic-ref/glossary/dose-equivalent.html"/>
        <rdfs:label xml:lang="en">dose equivalent</rdfs:label>
        <rdfs:label xml:lang="de">Äquivalentdosis</rdfs:label>
        <skos:definition xml:lang="de">Das Dosisäquivalent misst die biologische Schädigung lebenden Gewebes durch Strahlenexposition, berechnet als absorbierte Dosis multipliziert mit einem Qualitätsfaktor und ausgedrückt in Rems oder Sievert</skos:definition>
        <skos:definition xml:lang="en">Dose equivalent measures biological damage to living tissue from radiation exposure, calculated as absorbed dose multiplied by a quality factor, and expressed in rems or sieverts</skos:definition>
        <skos:example xml:lang="en">A radiation worker receives a dose equivalent of 2 mSv per year from occupational exposure</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080089 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080089">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;radiant energy density&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;density&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Radiant_energy.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Radiant_energy"/>
        <rdfs:label xml:lang="de">Strahlungsenergiedichte</rdfs:label>
        <rdfs:label xml:lang="en">radiant energy density</rdfs:label>
        <skos:definition xml:lang="en">Radiant energy density quantifies radiant energy per unit volume</skos:definition>
        <skos:definition xml:lang="de">Strahlungsenergiedichte misst die Strahlungsenergie pro Volumeneinheit</skos:definition>
        <skos:example xml:lang="en">The radiant energy density at the focal spot of a laser is 1 GJ/m3 during material processing</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080091 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080091">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;pixel density&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;number density&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Pixeldichte</rdfs:label>
        <rdfs:label xml:lang="en">pixel density</rdfs:label>
        <skos:definition xml:lang="en">Pixel density describes the relationship between the number of pixels and the area they occupy on a related entity</skos:definition>
        <skos:definition xml:lang="de">Pixeldichte beschreibt das Verhältnis zwischen der Anzahl der Pixel und der Fläche, die sie auf einer verwandten Entität einnehmen</skos:definition>
        <skos:example xml:lang="en">A 4K display panel has a pixel density of 210 ppi, providing sharp text rendering</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080092 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080092">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;electric flux density&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;density&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.britannica.com/science/electric-flux.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://www.britannica.com/science/electric-flux"/>
        <rdfs:label xml:lang="en">electric flux density</rdfs:label>
        <rdfs:label xml:lang="de">elektrische Flussdichte</rdfs:label>
        <skos:definition xml:lang="de">Die elektrische Flussdichte misst die Gesamtzahl der elektrischen Kraftlinien, die ein bestimmtes Gebiet schneiden, von positiven Ladungen ausgehen und bei negativen Ladungen enden</skos:definition>
        <skos:definition xml:lang="en">Electric flux density measures the total number of electric lines of force intersecting a given area, originating on positive charges and terminating on negative charges</skos:definition>
        <skos:example xml:lang="en">Near a charged plate, the electric flux density is 8.85e-12 C/m2 per V/m of field strength</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080093 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080093">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;birefringence&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical relational quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Doppelbrechung</rdfs:label>
        <rdfs:label xml:lang="en">birefringence</rdfs:label>
        <skos:altLabel xml:lang="de">Zweistrahl-Brechung</skos:altLabel>
        <skos:altLabel xml:lang="en">double refraction</skos:altLabel>
        <skos:altLabel xml:lang="en">Δn</skos:altLabel>
        <skos:definition xml:lang="en">Birefringence is a physical relational quality of an optically anisotropic material that specifies the difference in refractive indices along two principal optical axes, causing incident light to split into two rays with different velocities</skos:definition>
        <skos:definition xml:lang="de">Doppelbrechung ist eine physikalische relationale Qualität eines optisch anisotropen Materials, die die Differenz der Brechungsindizes entlang zweier optischer Hauptachsen angibt und bewirkt, dass einfallendes Licht in zwei Strahlen mit unterschiedlichen Geschwindigkeiten aufgespalten wird</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080094 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080094">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0023046"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080108"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;stress relaxation&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical relational quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Spannungsrelaxation</rdfs:label>
        <rdfs:label xml:lang="en">stress relaxation</rdfs:label>
        <skos:altLabel xml:lang="de">Relaxationsgrad</skos:altLabel>
        <skos:altLabel xml:lang="en">relaxation ratio</skos:altLabel>
        <skos:definition xml:lang="en">Stress relaxation is a physical relational quality of a material that expresses the ratio of residual stress to initial applied stress after a defined time interval under constant strain, quantifying the material&apos;s tendency to internally redistribute stress over time</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080095 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080095">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020309"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000146"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002000"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020290"/>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002000"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020293"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;contact angle&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical relational quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Kontaktwinkel</rdfs:label>
        <rdfs:label xml:lang="en">contact angle</rdfs:label>
        <skos:altLabel xml:lang="de">Benetzungswinkel</skos:altLabel>
        <skos:altLabel xml:lang="en">wetting angle</skos:altLabel>
        <skos:altLabel xml:lang="en">θ</skos:altLabel>
        <skos:definition xml:lang="en">Contact angle is a physical relational quality of a solid surface that quantifies the angle formed at the three-phase contact line between a liquid droplet, the solid surface, and the surrounding gas phase, characterizing the wettability of the surface by the liquid</skos:definition>
        <skos:definition xml:lang="de">Kontaktwinkel ist eine physikalische relationale Qualität einer festen Oberfläche, die den Winkel an der Dreiphasengrenzlinie zwischen einem Flüssigkeitstropfen, der festen Oberfläche und der umgebenden Gasphase beschreibt und die Benetzbarkeit der Oberfläche durch die Flüssigkeit charakterisiert</skos:definition>
        <skos:example xml:lang="en">A hydrophobic polymer coating shows a water contact angle of 110 degrees, indicating poor wettability</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080098 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080098">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;mass mix ratio&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;mass ratio&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Massenverh%C3%A4ltnis.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://de.wikipedia.org/wiki/Massenverh%C3%A4ltnis"/>
        <rdfs:label xml:lang="de">Massenmischungsverhältnis</rdfs:label>
        <rdfs:label xml:lang="en">mass mix ratio</rdfs:label>
        <skos:definition xml:lang="de">Das Massenmischungsverhältnis stellt das Verhältnis der Massen zweier Mischungskomponenten dar und liefert eine quantitative Beschreibung der Zusammensetzung</skos:definition>
        <skos:definition xml:lang="en">mass ratio that represents the ratio of masses of two mixture components, providing a quantitative composition description</skos:definition>
        <skos:example xml:lang="en">A concrete mix uses a mass mix ratio of cement to aggregate of 1:4 for standard structural applications</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080099 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080099">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;dry mass&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;mass ratio&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Trockenmasse</rdfs:label>
        <rdfs:label xml:lang="en">dry mass</rdfs:label>
        <skos:definition xml:lang="de">Trockenmasse bezeichnet die Masse, nachdem einem Objekt die gesamte Feuchtigkeit entzogen wurde, typischerweise durch geeignete Erhitzungsmethoden in einem Ofen</skos:definition>
        <skos:definition xml:lang="en">mass ratio that represents the mass after removing all humidity from an object, typically using qualified heating methods in an oven</skos:definition>
        <skos:example xml:lang="en">A fiber composite sample has a dry mass of 48.5 g after 24 hours in a drying oven at 80 C</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080100 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080100">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020102"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;mass fraction&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;mass ratio&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Massenanteil.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://de.wikipedia.org/wiki/Massenanteil"/>
        <rdfs:label xml:lang="de">Massenanteil</rdfs:label>
        <rdfs:label xml:lang="en">mass fraction</rdfs:label>
        <skos:definition xml:lang="de">Der Massenanteil beschreibt den relativen Anteil einer Masse an der Gesamtmasse einer Mischung, ein gängiges quantitatives Maß</skos:definition>
        <skos:definition xml:lang="en">mass ratio that describes the relative proportion of a mass to the total mass of a mixture, a common quantitative measure</skos:definition>
        <skos:example xml:lang="en">A binary Al-4 wt% Cu alloy has a copper mass fraction of 0.04</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080101 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080101">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080069"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;mass concentration&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;material composition&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Massenkonzentration.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://de.wikipedia.org/wiki/Massenkonzentration"/>
        <rdfs:label xml:lang="de">Massenkonzentration</rdfs:label>
        <rdfs:label xml:lang="en">mass concentration</rdfs:label>
        <skos:definition xml:lang="de">Die Massenkonzentration verknüpft die Masse einer Mischungskomponente mit dem Gesamtvolumen in einer quantitativen Beschreibung, die häufig in Lösungen verwendet wird</skos:definition>
        <skos:definition xml:lang="en">Mass concentration links mass of a mixture component to the total volume in quantitative description, frequently used in solutions</skos:definition>
        <skos:example xml:lang="en">A saline infusion solution has a NaCl mass concentration of 9 g/L</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080103 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080103">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020104"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;volume concentration&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;volume ratio&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Volumenkonzentration.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://de.wikipedia.org/wiki/Volumenkonzentration"/>
        <rdfs:label xml:lang="de">Volumenkonzentration</rdfs:label>
        <rdfs:label xml:lang="en">volume concentration</rdfs:label>
        <skos:definition xml:lang="en">Volume concentration links the volume of a mixture component to the total volume, crucial for quantitative composition description</skos:definition>
        <skos:definition xml:lang="de">Volumenkonzentration verbindet das Volumen eines Mischbestandteils mit dem Gesamtvolumen, entscheidend für die quantitative Zusammensetzungsbeschreibung</skos:definition>
        <skos:example xml:lang="en">A paint pigment dispersion has a TiO2 volume concentration of 20 %</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080104 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080104">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020104"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;volume fraction&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;volume ratio&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Volumenkonzentration.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://de.wikipedia.org/wiki/Volumenkonzentration"/>
        <rdfs:label xml:lang="de">Volumenanteil</rdfs:label>
        <rdfs:label xml:lang="en">volume fraction</rdfs:label>
        <skos:definition xml:lang="en">Volume fraction describes the volume of a mixture component relative to the sum of all components&apos; volumes</skos:definition>
        <skos:definition xml:lang="de">Volumenanteil beschreibt das Volumen eines Mischbestandteils im Verhältnis zur Summe der Volumina aller Bestandteile</skos:definition>
        <skos:example xml:lang="en">A dual-phase steel contains a martensite volume fraction of 20 %, controlling its strength-ductility balance</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080105 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080105">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020104"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;volume mix ratio&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;volume ratio&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Volumenverh%C3%A4ltnis.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://de.wikipedia.org/wiki/Volumenverh%C3%A4ltnis"/>
        <rdfs:label xml:lang="de">Mischengehaltverhältnis</rdfs:label>
        <rdfs:label xml:lang="en">volume mix ratio</rdfs:label>
        <skos:definition xml:lang="de">Mischengehaltverhältnis definiert das Verhältnis der Volumina von zwei Mischbestandteilen zueinander</skos:definition>
        <skos:definition xml:lang="en">Volume mix ratio defines the ratio of volumes of two mixture components to each other</skos:definition>
        <skos:example xml:lang="en">An epoxy adhesive is mixed in a volume mix ratio of 2:1 resin to hardener</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080106 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080106">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;piezoelectric coefficient&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical relational quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">piezoelectric coefficient</rdfs:label>
        <rdfs:label xml:lang="de">piezoelektrischer Koeffizient</rdfs:label>
        <skos:altLabel xml:lang="en">d</skos:altLabel>
        <skos:altLabel xml:lang="en">piezoelectric constant</skos:altLabel>
        <skos:altLabel xml:lang="de">piezoelektrische Konstante</skos:altLabel>
        <skos:definition xml:lang="en">Piezoelectric coefficient is a physical relational quality of a material that quantifies the coupling between mechanical stress and electric polarization, expressed as the ratio of electric displacement to applied mechanical stress or the ratio of strain to applied electric field</skos:definition>
        <skos:definition xml:lang="de">Piezoelektrischer Koeffizient ist eine physikalische relationale Qualität eines Materials, die die Kopplung zwischen mechanischer Spannung und elektrischer Polarisation quantifiziert, ausgedrückt als Verhältnis der elektrischen Verschiebung zur angelegten mechanischen Spannung oder des Dehnungsanteils zum angelegten elektrischen Feld</skos:definition>
        <skos:example xml:lang="en">The d33 piezoelectric coefficient of PZT ceramics is about 400 pC/N, enabling sensitive force sensing</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080107 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080107">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;clamping pressure&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;pressure&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Klemmdruck</rdfs:label>
        <rdfs:label xml:lang="en">clamping pressure</rdfs:label>
        <skos:definition xml:lang="en">Clamping pressure describes the force per area used during the mounting process of a sample, typically involving grips or similar tools</skos:definition>
        <skos:definition xml:lang="de">Klemmdruck ist die Eigenschaft, die als quantitativer Wert die Kraft pro Fläche beschreibt, die beim Einbau einer Probe, eines Prüfkörpers oder eines Prüfstücks aufgebracht wird, typischerweise verbunden mit einer Art von Klemm- oder Spannzubehör</skos:definition>
        <skos:example xml:lang="en">A hydraulic fixture applies a clamping pressure of 5 MPa to hold a workpiece during machining</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080108 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080108">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020311"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf rdf:nodeID="genid1139"/>
        <rdfs:subClassOf rdf:nodeID="genid1145"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Spannung</rdfs:label>
        <rdfs:label xml:lang="en">stress</rdfs:label>
        <skos:definition xml:lang="en">Stress is the internal force per unit area a material experiences under external load, commonly described in tensile, compressive, or shear forms</skos:definition>
        <skos:example xml:lang="en">A cross-section of a loaded steel column bears a compressive stress of 150 MPa</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    <owl:Class rdf:nodeID="genid1139">
        <owl:intersectionOf rdf:parseType="Collection">
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020200"/>
            </owl:Restriction>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080019"/>
            </owl:Restriction>
        </owl:intersectionOf>
    </owl:Class>
    <owl:Class rdf:nodeID="genid1145">
        <owl:intersectionOf rdf:parseType="Collection">
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020352"/>
            </owl:Restriction>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020380"/>
            </owl:Restriction>
        </owl:intersectionOf>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/pmd/co/PMD_0080108"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid1139"/>
        <rdfs:comment xml:lang="en">Mechanical view on stress</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/pmd/co/PMD_0080108"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid1145"/>
        <rdfs:comment xml:lang="en">Thermodynamic view on stress</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://w3id.org/pmd/co/PMD_0080109 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080109">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080108"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;engineering stress&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;stress&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">engineering stress</rdfs:label>
        <rdfs:label xml:lang="de">technische Spannung</rdfs:label>
        <skos:definition xml:lang="en">Engineering stress quantifies the internal force per unit area a material experiences under load, assuming the area remains constant</skos:definition>
        <skos:definition xml:lang="de">Technische Spannung beschreibt die innere Kraft pro Fläche, die ein Material unter Last erfährt, unter der Annahme, dass die Fläche konstant bleibt</skos:definition>
        <skos:example xml:lang="en">At yield, a steel specimen with 50 mm2 cross-section under 12.5 kN shows engineering stress of 250 MPa</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/pmd/co/PMD_0080109"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:resource="https://w3id.org/pmd/co/PMD_0080108"/>
        <rdfs:comment xml:lang="en">Express that force and area are properties of the anchor/independent of &quot;TQC of the deformation process&quot;</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://w3id.org/pmd/co/PMD_0080110 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080110">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080108"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;true stress&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;stress&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">true stress</rdfs:label>
        <rdfs:label xml:lang="de">wahre Spannung</rdfs:label>
        <skos:definition xml:lang="en">True stress is defined using the cauchy stress tensor, relating stress to the current surface size of a volume element</skos:definition>
        <skos:definition xml:lang="de">Wahre Spannung wird unter Verwendung des Cauchy-Spannungstensors definiert und bezieht die Spannung auf die aktuelle Oberflächengröße eines Volumenelements</skos:definition>
        <skos:example xml:lang="en">At 10 % engineering strain in a tensile test, the true stress exceeds the engineering stress by the same factor</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/pmd/co/PMD_0080110"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:resource="https://w3id.org/pmd/co/PMD_0080108"/>
        <rdfs:comment xml:lang="en">Express that force and area are properties dependent of &quot;TQC of the deformation process&quot;</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://w3id.org/pmd/co/PMD_0080112 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080112">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;adhesion&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;pressure&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Adhäsion</rdfs:label>
        <rdfs:label xml:lang="en">adhesion</rdfs:label>
        <skos:definition xml:lang="en">Adhesion describes the ability of substances to bind to each other, involving attractive force between two bodies of different substances in contact and influencing material performance in scientific and industrial contexts</skos:definition>
        <skos:definition xml:lang="de">Adhäsion beschreibt die Fähigkeit von Substanzen, sich aneinander zu binden. Dabei handelt es sich um eine Anziehungskraft zwischen zwei in Kontakt stehenden Körpern unterschiedlicher Substanzen, die die Materialleistung in wissenschaftlichen und industriellen Kontexten beeinflusst</skos:definition>
        <skos:example xml:lang="en">The adhesion between a paint film and a steel substrate determines its resistance to delamination</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080113 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080113">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023045"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;surface tension&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;adhesion&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Oberflächenspannung</rdfs:label>
        <rdfs:label xml:lang="en">surface tension</rdfs:label>
        <skos:altLabel xml:lang="de">Oberflächenspannung</skos:altLabel>
        <skos:altLabel xml:lang="en">surface stress</skos:altLabel>
        <skos:altLabel xml:lang="en">surface tension</skos:altLabel>
        <skos:definition xml:lang="de">Oberflächenspannung bezeichnet den Effekt innerhalb der Oberflächenschicht einer Flüssigkeit, der durch Wechselwirkungskräfte zwischen ihren Molekülen verursacht wird</skos:definition>
        <skos:definition xml:lang="en">Surface tension refers to the effect within the surface layer of a liquid/gas interface, caused by intermolecular forces between its molecules</skos:definition>
        <skos:example xml:lang="en">Water has a surface tension of 72.8 mN/m at 20 C, enabling capillary rise in fine tubes</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080114 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080114">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080115"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;refractive index&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical relational quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Refractive_index#Complex_index_of_refraction_and_absorption.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Refractive_index#Complex_index_of_refraction_and_absorption"/>
        <rdfs:label xml:lang="de">Brechzahl</rdfs:label>
        <rdfs:label xml:lang="en">refractive index</rdfs:label>
        <skos:definition xml:lang="de">Brechzahl gibt die Lichtbrechungsfähigkeit eines optischen Mediums an; umfasst einen realen und einen imaginären Teil, der als Extinktionskoeffizient bekannt ist</skos:definition>
        <skos:definition xml:lang="en">Refractive index indicates an optical medium&apos;s light bending ability; encompassing a real and imaginary part known as the extinction coefficient</skos:definition>
        <skos:example xml:lang="en">Optical glass BK7 has a refractive index of 1.52 at 589 nm, bending light in lenses</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080115 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080115">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;extinction coefficient&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;refractive index&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Refractive_index#Complex_index_of_refraction_and_absorption.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Refractive_index#Complex_index_of_refraction_and_absorption"/>
        <rdfs:label xml:lang="de">Extinktionskoeffizient</rdfs:label>
        <rdfs:label xml:lang="en">extinction coefficient</rdfs:label>
        <skos:definition xml:lang="de">Der Extinktionskoeffizient, die imaginäre Komponente des komplexen Brechungsindex, gibt die Dämpfung elektromagnetischer Wellen durch ein Material an</skos:definition>
        <skos:definition xml:lang="en">Extinction coefficient, the imaginary component of the complex refractive index, indicates attenuation of electromagnetic waves through a material</skos:definition>
        <skos:example xml:lang="en">The extinction coefficient of gold at 500 nm wavelength is 1.87, characterizing strong optical absorption</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080116 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:nodeID="genid1155"/>
        <obo:IAO_0000117>Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Every potential in physics is the same mathematical object — a partial derivative of energy with respect to its conjugate extensive quantity. The differences are only in which extensive quality you&apos;re considering.</rdfs:comment>
        <rdfs:label xml:lang="en">potential</rdfs:label>
        <skos:definition xml:lang="en">a partial derivative of energy with respect to its conjugate extensive quantity</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    <owl:Class rdf:nodeID="genid1155">
        <owl:intersectionOf rdf:parseType="Collection">
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020142"/>
            </owl:Restriction>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020319"/>
            </owl:Restriction>
        </owl:intersectionOf>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/pmd/co/PMD_0080116"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid1155"/>
        <rdfs:comment xml:lang="en">In field theories (e.g., gravity, electrostatics), the potential becomes a field ϕ(r⃗), and the force is recovered via:
F=−∇ϕ(r⃗)F
This is the spatial analogue: instead of asking &quot;how does energy change per unit carrier added?&quot;, you ask &quot;how does energy change per unit carrier moved in space?&quot;</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://w3id.org/pmd/co/PMD_0080119 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080119">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020309"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000146"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;heat transfer coefficient&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical relational quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Heat_transfer_coefficient.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Heat_transfer_coefficient"/>
        <rdfs:label xml:lang="de">Wärmeübergangskoeffizient</rdfs:label>
        <rdfs:label xml:lang="en">heat transfer coefficient</rdfs:label>
        <skos:definition xml:lang="de">Der Wärmeübertragungskoeffizient stellt die Proportionalitätskonstante zwischen dem Wärmefluss und der thermodynamischen Antriebskraft für den Wärmefluss dar und wird zur Berechnung der Wärmeübertragung, typischerweise durch Konvektion, verwendet</skos:definition>
        <skos:definition xml:lang="en">Heat transfer coefficient represents the proportionality constant between heat flux and the thermodynamic driving force for heat flow, used in calculating heat transfer, typically by convection</skos:definition>
        <skos:example xml:lang="en">A forced convection air-cooled heat sink has a heat transfer coefficient of 100 W/(m2·K)</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080120 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080120">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;magnetic susceptibility&apos; have not yet been formalized. Although χ = M/H is a well-defined ratio, a formal equivalence axiom would incorrectly classify any dimensionless relational quality of a magnetic bearer as magnetic susceptibility. Defined as a primitive subtype of &apos;physical relational quality&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">magnetic susceptibility</rdfs:label>
        <rdfs:label xml:lang="de">magnetische Suszeptibilität</rdfs:label>
        <skos:altLabel xml:lang="en">χ</skos:altLabel>
        <skos:definition xml:lang="en">Magnetic susceptibility is a physical relational quality of a material that quantifies the degree to which it becomes magnetized in response to an applied magnetic field, expressed as the dimensionless ratio of magnetization to applied field intensity</skos:definition>
        <skos:definition xml:lang="de">Magnetische Suszeptibilität ist eine physikalische relationale Qualität eines Materials, die den Grad angibt, in dem es sich als Reaktion auf ein angelegtes Magnetfeld magnetisiert, ausgedrückt als dimensionsloses Verhältnis der Magnetisierung zur angelegten Feldstärke</skos:definition>
        <skos:example xml:lang="en">Paramagnetic oxygen gas has a positive magnetic susceptibility of 3.73e-6 m3/mol at 20 C</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080121 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080121">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;fluid permeability&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical relational quality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Fluiddurchlässigkeit</rdfs:label>
        <rdfs:label xml:lang="en">fluid permeability</rdfs:label>
        <skos:altLabel xml:lang="en">Darcy permeability</skos:altLabel>
        <skos:altLabel xml:lang="de">Durchlässigkeit</skos:altLabel>
        <skos:altLabel xml:lang="en">hydraulic permeability</skos:altLabel>
        <skos:altLabel xml:lang="en">k</skos:altLabel>
        <skos:definition xml:lang="en">Fluid permeability is a physical relational quality of a porous material that quantifies its capacity to allow fluid flow through its pore network under an applied pressure gradient, defined by Darcy&apos;s law as the ratio of fluid flux to the pressure gradient normalized by fluid viscosity</skos:definition>
        <skos:definition xml:lang="de">Fluiddurchlässigkeit ist eine physikalische relationale Qualität eines porösen Materials, die seine Fähigkeit quantifiziert, Fluidfluss durch sein Porennetzwerk unter einem angelegten Druckgradienten zu ermöglichen, definiert durch das Darcy-Gesetz als Verhältnis des Fluidflusses zum Druckgradienten normiert durch die Viskosität des Fluids</skos:definition>
        <skos:example xml:lang="en">Sandstone with a Darcy permeability of 100 mD allows significant fluid flow under pressure gradients</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080122 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080122">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080011"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;phase velocity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;speed&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Phasengeschwindigkeit</rdfs:label>
        <rdfs:label xml:lang="en">phase velocity</rdfs:label>
        <skos:definition xml:lang="de">Die Phasengeschwindigkeit bezieht sich auf die Geschwindigkeit, mit der sich die Phase einer Welle ausbreitet, definiert als Wellenlänge geteilt durch die Zeitperiode</skos:definition>
        <skos:definition xml:lang="en">Phase velocity refers to the rate at which the phase of a wave propagates, defined as wavelength divided by time period</skos:definition>
        <skos:example xml:lang="en">The phase velocity of a longitudinal ultrasonic wave in steel is approximately 5900 m/s</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080123 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080123">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080011"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;deformation speed&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;speed&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Strain_rate.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Strain_rate"/>
        <rdfs:label xml:lang="de">Deformationsgeschwindigkeit</rdfs:label>
        <rdfs:label xml:lang="en">deformation speed</rdfs:label>
        <skos:altLabel xml:lang="de">Dehnrate</skos:altLabel>
        <skos:altLabel xml:lang="en">strain rate</skos:altLabel>
        <skos:definition xml:lang="en">Deformation speed measures the rate at which distances of adjacent material parcels change with time near a specific point, including expansion and shear rates</skos:definition>
        <skos:definition xml:lang="de">Die Verformungsgeschwindigkeit misst die Geschwindigkeit, mit der sich die Abstände benachbarter Materialpakete in der Nähe eines bestimmten Punktes im Laufe der Zeit ändern, einschließlich Expansions- und Schergeschwindigkeiten</skos:definition>
        <skos:example xml:lang="en">During high-rate forming, the deformation speed of the punch reaches 10 m/s</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080125 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080125">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000506"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;sound insulation index&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;acoustic capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Schalldämmmaß</rdfs:label>
        <rdfs:label xml:lang="en">sound insulation index</rdfs:label>
        <skos:definition xml:lang="de">Schalldämmmaß quantifiziert die Fähigkeit eines Materials, die Schallübertragung zu reduzieren</skos:definition>
        <skos:definition xml:lang="en">Sound insulation index quantifies the ability of a material to reduce sound transmission</skos:definition>
        <skos:example xml:lang="en">A 200 mm concrete wall achieves a sound insulation index of 52 dB, blocking most airborne noise</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080127 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080127">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020312"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;electrical capacitance&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;electrical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">electrical capacitance</rdfs:label>
        <rdfs:label xml:lang="de">elektrische Kapazität</rdfs:label>
        <skos:altLabel xml:lang="en">electrical capacitance</skos:altLabel>
        <skos:altLabel xml:lang="en">electrical capacity</skos:altLabel>
        <skos:altLabel xml:lang="de">elektrische Kapazität</skos:altLabel>
        <skos:definition xml:lang="de">Die elektrische Kapazität bezieht sich auf die Fähigkeit eines Wesens, elektrische Ladung zu speichern, ausgedrückt als die Menge an elektrischer Ladung, die pro gegebenem elektrischem Potenzial gespeichert wird</skos:definition>
        <skos:definition xml:lang="en">Electrical capacitance refers to an entity&apos;s ability to store electric charge, expressed as the amount of electric charge stored per given electric potential</skos:definition>
        <skos:example xml:lang="en">A ceramic capacitor has an electrical capacitance of 100 nF, storing charge in an electronic circuit</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080128 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080128">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020312"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;electrical resistance&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;electrical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.britannica.com/technology/resistance-electronics.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://www.britannica.com/technology/resistance-electronics"/>
        <rdfs:label xml:lang="en">electrical resistance</rdfs:label>
        <rdfs:label xml:lang="de">elektrischer Widerstand</rdfs:label>
        <skos:definition xml:lang="de">Der elektrische Widerstand bezieht sich auf die Fähigkeit eines Stromkreises, elektrische Energie in Wärmeenergie umzuwandeln, indem er elektrischem Strom durch Teilchenkollisionen entgegenwirkt, die für Widerstände, Lampen und Drähte charakteristisch sind</skos:definition>
        <skos:definition xml:lang="en">Electrical resistance pertains to a circuit&apos;s capability to transform electric energy into heat energy, opposing electric current through particle collisions, characteristic of resistors, lamps, and wires</skos:definition>
        <skos:example xml:lang="en">A nichrome heating element has an electrical resistance of 10 Ω at room temperature</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080129 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020312"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;electrical conductance&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;electrical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">electrical conductance</rdfs:label>
        <rdfs:label xml:lang="de">elektrischer Leitwert</rdfs:label>
        <skos:altLabel xml:lang="de">Stromleitwert</skos:altLabel>
        <skos:altLabel xml:lang="en">electrical conductance</skos:altLabel>
        <skos:altLabel xml:lang="de">elektrischer Leitwert</skos:altLabel>
        <skos:definition xml:lang="de">Der elektrische Leitwert stellt den Kehrwert des elektrischen Widerstands eines Leiters dar und misst seine Fähigkeit, elektrischen Strom zu leiten, angegeben in Siemens (S).</skos:definition>
        <skos:definition xml:lang="en">Electrical conductance represents the reciprocal of a conductor&apos;s electrical resistance, measuring its ability to conduct an electric current, denoted in siemens (S)</skos:definition>
        <skos:example xml:lang="en">A copper wire of 1 m length and 1 mm2 cross-section has an electrical conductance of about 59 S</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080131 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080131">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020312"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;saturation magnetization&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;magnetic capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Sättigungsmagnetisierung</rdfs:label>
        <rdfs:label xml:lang="en">saturation magnetization</rdfs:label>
        <skos:altLabel xml:lang="en">M_s</skos:altLabel>
        <skos:altLabel xml:lang="en">magnetic saturation</skos:altLabel>
        <skos:altLabel xml:lang="de">magnetische Sättigung</skos:altLabel>
        <skos:definition xml:lang="en">Saturation magnetization is a magnetic capability of a material that specifies the maximum magnetic moment per unit volume achieved when all magnetic domains are aligned with an applied external field</skos:definition>
        <skos:definition xml:lang="de">Sättigungsmagnetisierung ist eine magnetische Fähigkeit eines Materials, die das maximale magnetische Moment pro Volumeneinheit angibt, das erreicht wird, wenn alle magnetischen Domänen mit einem angelegten äußeren Feld ausgerichtet sind</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080133 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080133">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;durability&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;mechanical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Dauerhaftigkeit</rdfs:label>
        <rdfs:label xml:lang="en">durability</rdfs:label>
        <skos:altLabel xml:lang="de">Dauerhaftigkeit</skos:altLabel>
        <skos:altLabel xml:lang="de">Langlebigkeit</skos:altLabel>
        <skos:altLabel xml:lang="en">durability</skos:altLabel>
        <skos:altLabel xml:lang="en">longevity</skos:altLabel>
        <skos:definition xml:lang="de">Die Dauerhaftigkeit ist die Fähigkeit eines Materials, Abnutzung, Rissbildung und andere Arten von Schäden im Laufe der Zeit zu widerstehen</skos:definition>
        <skos:definition xml:lang="en">Durability is the ability of a material to resist wear, tear, and other types of damage over time</skos:definition>
        <skos:example xml:lang="en">Galvanized steel shows high durability in outdoor environments, resisting corrosion for over 50 years</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080134 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080134">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080133"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;wear resistance&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;durability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Verschleißfestigkeit</rdfs:label>
        <rdfs:label xml:lang="en">wear resistance</rdfs:label>
        <skos:altLabel xml:lang="de">Verschleißfestigkeit</skos:altLabel>
        <skos:altLabel xml:lang="en">resistance to wear</skos:altLabel>
        <skos:altLabel xml:lang="en">wear resistance</skos:altLabel>
        <skos:altLabel xml:lang="de">widerstand gegen Verschleiß</skos:altLabel>
        <skos:definition xml:lang="de">Verschleißfestigkeit ist die Fähigkeit eines Materials, mechanischen Aktionen wie Reiben, Kratzen oder Erosion zu widerstehen, die dazu tendieren, Material allmählich von seiner Oberfläche zu entfernen.</skos:definition>
        <skos:definition xml:lang="en">Wear resistance is the ability of a material to resist mechanical actions such as rubbing, scraping or erosion that tend to progressively remove material from its surface.</skos:definition>
        <skos:example xml:lang="en">Hardened tool steel has high wear resistance, maintaining a cutting edge through thousands of machining cycles</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080135 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080135">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080133"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;creep resistance&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;durability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Kriechfestigkeit</rdfs:label>
        <rdfs:label xml:lang="en">creep resistance</rdfs:label>
        <skos:altLabel xml:lang="en">Creep Resistance</skos:altLabel>
        <skos:altLabel xml:lang="en">Creep Resistant</skos:altLabel>
        <skos:altLabel xml:lang="de">Kriechfestig</skos:altLabel>
        <skos:altLabel xml:lang="de">Kriechfestigkeit</skos:altLabel>
        <skos:definition xml:lang="en">Creep resistance is the ability of a material to resist deformation under load over time</skos:definition>
        <skos:definition xml:lang="de">Die Kriechfestigkeit ist die Fähigkeit eines Materials, unter Last über einen bestimmten Zeitraum eine Deformation zu widerstehen</skos:definition>
        <skos:example xml:lang="en">Nickel superalloys have high creep resistance, maintaining shape under stress at 1000 C in turbine blades</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080136 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080136">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;poisson effect&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;mechanical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Poisson%27s_ratio.</obo:IAO_0000116>
        <obo:IAO_0000116>Was a subclass of &apos;Mechanical Quality&apos;</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Poisson%27s_ratio"/>
        <rdfs:label xml:lang="de">Querkontraktion</rdfs:label>
        <rdfs:label xml:lang="en">poisson effect</rdfs:label>
        <skos:definition xml:lang="en">Poisson effect describes deformation perpendicular to the direction of loading, named after Siméon Poisson</skos:definition>
        <skos:definition xml:lang="de">Querkontraktion beschreibt die Deformation senkrecht zur Belastungsrichtung, benannt nach Siméon Poisson</skos:definition>
        <skos:example xml:lang="en">A rubber cylinder loaded axially expands radially due to the Poisson effect, with a ratio of about 0.5</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080137 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080137">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf rdf:nodeID="genid1169"/>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Poissonzahl</rdfs:label>
        <rdfs:label xml:lang="en">poisson&apos;s ratio</rdfs:label>
        <skos:definition xml:lang="en">a classical mechanics property defining the strain in one direction, given the strain in a perpendicular direction.</skos:definition>
        <skos:example xml:lang="en">Rubber has a Poisson&apos;s ratio close to 0.5, indicating nearly incompressible behavior under loading</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    <owl:Class rdf:nodeID="genid1169">
        <owl:intersectionOf rdf:parseType="Collection">
            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020311"/>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
            </owl:Restriction>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080029"/>
            </owl:Restriction>
        </owl:intersectionOf>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/pmd/co/PMD_0080137"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid1169"/>
        <rdfs:comment xml:lang="en">The two strains should be perpendicular to each other</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://w3id.org/pmd/co/PMD_0080138 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080138">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;aterial fatigue&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;mechanical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Materialermüdung</rdfs:label>
        <rdfs:label xml:lang="en">material fatigue</rdfs:label>
        <skos:altLabel xml:lang="de">Ermüdung des Materials</skos:altLabel>
        <skos:altLabel xml:lang="de">Materialermüdung</skos:altLabel>
        <skos:altLabel xml:lang="en">fatigue of material</skos:altLabel>
        <skos:altLabel xml:lang="en">material fatigue</skos:altLabel>
        <skos:definition xml:lang="en">Material fatigue is the failure of a material caused by repeated or sustained loading below its ultimate strength.</skos:definition>
        <skos:definition xml:lang="de">Materialermüdung ist das Versagen von Werkstoffen infolge wiederholter oder dauernder Belastung unterhalb der Probenfestigkeit</skos:definition>
        <skos:example xml:lang="en">Repeated cyclic loading at 400 MPa induces material fatigue in a steel shaft, leading to crack initiation</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080139 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080139">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;impact energy&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;mechanical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Schlagenergie</rdfs:label>
        <rdfs:label xml:lang="en">impact energy</rdfs:label>
        <skos:altLabel xml:lang="en">Charpy impact energy</skos:altLabel>
        <skos:altLabel xml:lang="en">KV</skos:altLabel>
        <skos:altLabel xml:lang="de">Kerbschlagenergie</skos:altLabel>
        <skos:definition xml:lang="en">Impact energy is a mechanical capability of a material that characterises the total energy absorbed by a standardised notched specimen during fracture under a single impact blow, as measured in a Charpy or Izod test</skos:definition>
        <skos:definition xml:lang="de">Schlagenergie ist eine mechanische Fähigkeit eines Materials, die die gesamte Energie beschreibt, die eine standardisierte gekerbte Probe beim Bruch unter einem einzigen Schlagimpuls absorbiert, gemessen im Charpy- oder Izod-Versuch</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080143 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080143">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;viscoelasticity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;strength&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Viscoelastizität</rdfs:label>
        <rdfs:label xml:lang="en">viscoelasticity</rdfs:label>
        <skos:altLabel xml:lang="de">Viscoelastizität</skos:altLabel>
        <skos:altLabel xml:lang="de">Viskoelastizität</skos:altLabel>
        <skos:altLabel xml:lang="en">elasticity of viscosity</skos:altLabel>
        <skos:altLabel xml:lang="en">viscoelasticity</skos:altLabel>
        <skos:definition xml:lang="en">Viscoelasticity describes materials exhibiting both viscous and elastic characteristics during deformation</skos:definition>
        <skos:definition xml:lang="de">Viscoelastizität beschreibt Materialien, die sowohl viskose als auch elastische Eigenschaften während der Verformung zeigen</skos:definition>
        <skos:example xml:lang="en">Polymers exhibit viscoelasticity, showing both elastic recovery and creep under constant load</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080144 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080144">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;creep modulus&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;viscoelasticity&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Kriechmodul</rdfs:label>
        <rdfs:label xml:lang="en">creep modulus</rdfs:label>
        <skos:altLabel xml:lang="de">Kriechmodul</skos:altLabel>
        <skos:altLabel xml:lang="en">creep modulus</skos:altLabel>
        <skos:definition xml:lang="en">Creep modulus measures a material&apos;s viscoelasticity, indicating its ability to deform under stress over time</skos:definition>
        <skos:definition xml:lang="de">Der Kriechmodul ist ein Maß für die Viskoelastizität eines Materials, das seine Fähigkeit zur Verformung unter Belastung im Laufe der Zeit beschreibt</skos:definition>
        <skos:example xml:lang="en">The creep modulus of polyethylene at 50 C and 1 MPa after 1000 hours is 200 MPa</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080145 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080145">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;complex modulus&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;viscoelasticity&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Komplexmodul</rdfs:label>
        <rdfs:label xml:lang="en">complex modulus</rdfs:label>
        <skos:altLabel xml:lang="en">E*</skos:altLabel>
        <skos:definition xml:lang="en">Complex modulus is a viscoelastic quality of a material that represents the total stiffness response under oscillatory loading as a complex number, comprising the storage modulus as the real part and the loss modulus as the imaginary part</skos:definition>
        <skos:definition xml:lang="de">Komplexmodul ist eine viskoelastische Qualität eines Materials, die die gesamte Steifigkeitsantwort unter schwingender Belastung als komplexe Zahl darstellt, bestehend aus dem Speichermodul als Realteil und dem Verlustmodul als Imaginärteil</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080146 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080146">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080145"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;loss modulus&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;complex modulus&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Dynamic_modulus.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Dynamic_modulus"/>
        <rdfs:label xml:lang="de">Verlustmodul</rdfs:label>
        <rdfs:label xml:lang="en">loss modulus</rdfs:label>
        <skos:altLabel xml:lang="en">E&apos;&apos;</skos:altLabel>
        <skos:definition xml:lang="en">Loss modulus is the imaginary part of the complex modulus that measures the viscous portion of energy dissipated as heat per cycle in a viscoelastic material under oscillatory loading</skos:definition>
        <skos:definition xml:lang="de">Verlustmodul ist der Imaginärteil des Komplexmoduls und misst den viskosen Anteil der pro Zyklus als Wärme dissipierten Energie in einem viskoelastischen Material unter schwingender Belastung</skos:definition>
        <skos:example xml:lang="en">The loss modulus of a viscoelastic polymer at 1 Hz is 0.3 MPa, representing energy dissipation per cycle</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080147 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080147">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080145"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;dynamic modulus&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;complex modulus&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Dynamic_modulus.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Dynamic_modulus"/>
        <rdfs:label xml:lang="en">dynamic modulus</rdfs:label>
        <rdfs:label xml:lang="de">dynamischer Modul</rdfs:label>
        <skos:altLabel xml:lang="en">complex shear modulus</skos:altLabel>
        <skos:definition xml:lang="en">Dynamic modulus is the ratio of stress to strain under vibratory conditions, typically measured in shear, compression, or elongation tests, and characterizes viscoelastic materials</skos:definition>
        <skos:definition xml:lang="de">Dynamischer Modul ist das Verhältnis von Spannung zu Dehnung unter schwingenden Bedingungen, typischerweise gemessen in Scher-, Druck- oder Dehnungstests, und charakterisiert viskoelastische Materialien</skos:definition>
        <skos:example xml:lang="en">The dynamic modulus of a rubber compound at 10 Hz is 15 MPa, relevant for vibration isolation design</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080148 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080148">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080147"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;loss tangent&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;dynamic modulus&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Dynamic_modulus.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Dynamic_modulus"/>
        <rdfs:label xml:lang="de">Verlustwinkel</rdfs:label>
        <rdfs:label xml:lang="en">loss tangent</rdfs:label>
        <skos:definition xml:lang="de">Der Verlustfaktor, dargestellt als tan δ, ist das Verhältnis des Verlustmoduls zum Speichermodul in viskoelastischen Materialien und liefert ein Maß für die Dämpfung</skos:definition>
        <skos:definition xml:lang="en">Loss tangent, represented as tan δ, is the ratio of the loss modulus to storage modulus in viscoelastic materials, providing a measure of damping</skos:definition>
        <skos:example xml:lang="en">A PTFE cable insulator has a loss tangent of 0.0002 at 1 GHz, minimizing signal attenuation</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080149 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080149">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080145"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;storage modulus&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;complex modulus&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Dynamic_modulus.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Dynamic_modulus"/>
        <rdfs:label xml:lang="de">Speichermodul</rdfs:label>
        <rdfs:label xml:lang="en">storage modulus</rdfs:label>
        <skos:altLabel xml:lang="en">E&apos;</skos:altLabel>
        <skos:definition xml:lang="de">Speichermodul ist der Realteil des Komplexmoduls und misst den elastischen Anteil der gespeicherten und zurückgewonnenen Energie pro Zyklus in einem viskoelastischen Material unter schwingender Belastung</skos:definition>
        <skos:definition xml:lang="en">Storage modulus is the real part of the complex modulus that measures the elastic portion of energy stored and recovered per cycle in a viscoelastic material under oscillatory loading</skos:definition>
        <skos:example xml:lang="en">The storage modulus of a polyurethane foam at 1 Hz and 25 C is 0.5 MPa, reflecting its elastic stiffness</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080150 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080150">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;toughness&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;strength&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Zähigkeit</rdfs:label>
        <rdfs:label xml:lang="en">toughness</rdfs:label>
        <skos:altLabel xml:lang="de">Zähigkeit</skos:altLabel>
        <skos:altLabel xml:lang="en">toughness</skos:altLabel>
        <skos:definition xml:lang="en">Toughness describes the resistance of a material to fracture or crack propagation, determined by its ability to absorb mechanical energy during deformation</skos:definition>
        <skos:definition xml:lang="de">Zähigkeit beschreibt die Widerstandsfähigkeit eines Werkstoffs gegen Bruch oder Rissausbreitung, bestimmt durch die Fähigkeit zur Absorption von mechanischer Energie bei Verformung</skos:definition>
        <skos:example xml:lang="en">High-toughness tool steel absorbs 80 J before fracture in a Charpy V-notch test at room temperature</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080151 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080151">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080150"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;fracture toughness&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;toughness&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Bruchzähigkeit</rdfs:label>
        <rdfs:label xml:lang="en">fracture toughness</rdfs:label>
        <skos:altLabel xml:lang="en">K_Ic</skos:altLabel>
        <skos:altLabel xml:lang="en">critical stress intensity factor</skos:altLabel>
        <skos:definition xml:lang="de">Bruchzähigkeit ist eine Zähigkeitsqualität eines Materials, die die kritische Spannungsintensität beschreibt, bei der ein vorhandener Riss zu wachsen beginnt</skos:definition>
        <skos:definition xml:lang="en">Fracture toughness is a toughness quality of a material that specifies the critical stress intensity at which a pre-existing crack begins to propagate, expressed as the stress intensity factor at the onset of fracture</skos:definition>
        <skos:example xml:lang="en">Fracture toughness of a high-strength steel measured as 50 MPa·√m according to ISO 17281 test conditions.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080152 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080152">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080150"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;impact strength&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;toughness&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Schlagzähigkeit</rdfs:label>
        <rdfs:label xml:lang="en">impact strength</rdfs:label>
        <skos:altLabel xml:lang="de">Schlagfestigkeit</skos:altLabel>
        <skos:altLabel xml:lang="de">Schlagzähigkeit</skos:altLabel>
        <skos:altLabel xml:lang="en">impact strength</skos:altLabel>
        <skos:altLabel xml:lang="en">mpact strength</skos:altLabel>
        <skos:definition xml:lang="en">Impact strength is the ability of a material to absorb energy and plastically deform without fracturing under dynamic load</skos:definition>
        <skos:definition xml:lang="de">Schlagzähigkeit bezeichnet die Fähigkeit eines Materials, Energie zu absorbieren und bei Anwendung einer dynamischen Last plastisch zu verformen, ohne dass es bricht</skos:definition>
        <skos:example xml:lang="en">A Charpy impact test on notched steel gives an impact strength of 120 J, indicating good toughness</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080154 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080154">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000952"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020339"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020336"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Zugfestigkeit</rdfs:label>
        <rdfs:label xml:lang="en">ultimate tensile strength</rdfs:label>
        <skos:definition xml:lang="en">the maximum (normal) stress a material can withstand before rupturing</skos:definition>
        <skos:example xml:lang="en">A high-strength bolt grade 10.9 has a tensile strength of at least 1040 MPa</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080155 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080155">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000952"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020337"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Druckfestigkeit</rdfs:label>
        <rdfs:label xml:lang="en">ultimate compressive strength</rdfs:label>
        <skos:definition xml:lang="en">Compressive strength is the maximum stress a material can withstand under uniaxial compressive loading before failure</skos:definition>
        <skos:example xml:lang="en">Compressive strength of a concrete specimen measured as 30 MPa according to ISO 4012 test conditions.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080159 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080159">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;weathering resistance&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;operational strength&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">Was a subclass of &apos;Operational Strength&apos;;  But &apos;Operational Strength&apos; does not appear to be Quality.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Witterungsbeständigkeit</rdfs:label>
        <rdfs:label xml:lang="en">weathering resistance</rdfs:label>
        <skos:altLabel xml:lang="de">Witterungsbeständigkeit</skos:altLabel>
        <skos:altLabel xml:lang="en">weather resistant</skos:altLabel>
        <skos:altLabel xml:lang="en">weathering resistance</skos:altLabel>
        <skos:altLabel xml:lang="de">wetterbeständig</skos:altLabel>
        <skos:definition xml:lang="en">Ability of a material to resist the effects of weathering, such as wind, rain, and sunlight.</skos:definition>
        <skos:definition xml:lang="de">Fähigkeit eines Materials, den Auswirkungen von Witterungseinflüssen wie Wind, Regen und Sonnenlicht standzuhalten.</skos:definition>
        <skos:example xml:lang="en">HDPE pipes show high weathering resistance, retaining mechanical properties after years of UV exposure</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080164 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080164">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020311"/>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Elastizität</rdfs:label>
        <rdfs:label xml:lang="en">elasticity</rdfs:label>
        <skos:definition xml:lang="en">Elasticity is the disposition of a material to resume its initial shape after deformation</skos:definition>
        <skos:example xml:lang="en">Rubber exhibits high elasticity, recovering its original shape after 300 % elongation</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/pmd/co/PMD_0080164"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:resource="https://w3id.org/pmd/co/PMD_0020311"/>
        <rdfs:comment xml:lang="en">Should comprise reversibility/non-dissipative aspect in process</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://w3id.org/pmd/co/PMD_0080166 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080166">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020311"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020334"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080034"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Schubmodul</rdfs:label>
        <rdfs:label xml:lang="en">shear modulus</rdfs:label>
        <skos:definition xml:lang="en">Shear modulus is a measure of elastic shear stiffness, defined as the ratio of shear stress to shear strain</skos:definition>
        <skos:example xml:lang="en">The shear modulus of aluminum is 26 GPa, governing torsional deformation of shafts</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080167 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080167">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020311"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000618"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0023002"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000618"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;specific elastic modulus&apos; have not yet been formalized. Although specific elastic modulus is defined as a ratio of elastic modulus to density, a co-inherence axiom cannot uniquely identify this quality among all stiffness qualities of the same bearer. The term is defined as a specific subtype of &apos;stiffness&apos;.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">specific elastic modulus</rdfs:label>
        <rdfs:label xml:lang="de">spezifischer Elastizitätsmodul</rdfs:label>
        <skos:altLabel xml:lang="en">specific modulus</skos:altLabel>
        <skos:altLabel xml:lang="en">specific stiffness</skos:altLabel>
        <skos:altLabel xml:lang="de">spezifische Steifigkeit</skos:altLabel>
        <skos:altLabel xml:lang="de">spezifischer Modul</skos:altLabel>
        <skos:definition xml:lang="en">Specific elastic modulus is a stiffness quality of a material expressed as the ratio of its elastic modulus to its density, representing the material&apos;s elastic stiffness per unit mass</skos:definition>
        <skos:definition xml:lang="de">Spezifischer Elastizitätsmodul ist eine Steifigkeitsqualität eines Materials, ausgedrückt als Verhältnis seines Elastizitätsmoduls zu seiner Dichte und repräsentiert die elastische Steifigkeit des Materials je Masseneinheit</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080170 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080170">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;plasticity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;strength&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Plastizität</rdfs:label>
        <rdfs:label xml:lang="en">plasticity</rdfs:label>
        <skos:altLabel xml:lang="de">Plastizität</skos:altLabel>
        <skos:altLabel xml:lang="en">plasticity</skos:altLabel>
        <skos:definition xml:lang="en">Plasticity signifies a material&apos;s ability to undergo permanent deformation without breaking or cracking</skos:definition>
        <skos:definition xml:lang="de">Plastizität bezeichnet die Fähigkeit eines Materials, dauerhafte Verformungen ohne Bruch oder Riss zu erleiden</skos:definition>
        <skos:example xml:lang="en">Low-carbon steel exhibits high plasticity, allowing deep drawing without cracking</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080171 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080171">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000952"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000068"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080035"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">The amount of plastic strain typically gives more information about the yield stress. E.g. Rp02 has 0.2% plastic strain.</rdfs:comment>
        <rdfs:label xml:lang="de">Fließgrenze</rdfs:label>
        <rdfs:label xml:lang="en">yield stress</rdfs:label>
        <skos:altLabel xml:lang="en">yield strength</skos:altLabel>
        <skos:definition xml:lang="en">is the stress at which the material has a non-zero plastic strain.</skos:definition>
        <skos:example xml:lang="en">The yield strength of mild steel is approximately 250 MPa, beyond which permanent deformation begins</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080172 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080172">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080171"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;lower yield strength&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;yield strength&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Yield_(engineering).</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Yield_(engineering)"/>
        <rdfs:label xml:lang="en">lower yield strength</rdfs:label>
        <rdfs:label xml:lang="de">untere Streckgrenze</rdfs:label>
        <skos:altLabel xml:lang="en">lower yield stress</skos:altLabel>
        <skos:altLabel xml:lang="de">untere Fließspannung</skos:altLabel>
        <skos:definition xml:lang="en">Lower yield strength defines the stress at which a material exhibits plastic behavior after initial yielding</skos:definition>
        <skos:definition xml:lang="de">Untere Streckgrenze beschreibt die Spannung, bei der ein Material nach dem anfänglichen Fließen plastisches Verhalten zeigt</skos:definition>
        <skos:example xml:lang="en">The lower yield strength of mild steel is approximately 235 MPa, defining the onset of stable plastic flow</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080173 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080173">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080171"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;upper yield strength&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;yield strength&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Yield_(engineering).</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Yield_(engineering)"/>
        <rdfs:label xml:lang="de">obere Streckgrenze</rdfs:label>
        <rdfs:label xml:lang="en">upper yield strength</rdfs:label>
        <skos:altLabel xml:lang="de">obere Fließspannung</skos:altLabel>
        <skos:altLabel xml:lang="en">upper yield stress</skos:altLabel>
        <skos:definition xml:lang="de">Obere Streckgrenze charakterisiert die maximale Spannung, die vor dem plastischen Fließen eines Materials angewendet werden kann</skos:definition>
        <skos:definition xml:lang="en">Upper yield strength characterizes the maximum stress that can be applied before a material begins to yield plastically</skos:definition>
        <skos:example xml:lang="en">Mild steel exhibits an upper yield strength of about 300 MPa, followed by a yield drop to the lower yield point</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080174 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080174">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020316"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;viscosity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;plasticity&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Viskosität</rdfs:label>
        <rdfs:label xml:lang="en">viscosity</rdfs:label>
        <skos:altLabel xml:lang="de">Viskosität</skos:altLabel>
        <skos:altLabel xml:lang="en">viscosity</skos:altLabel>
        <skos:definition xml:lang="en">Viscosity measures a fluid&apos;s resistance to flow</skos:definition>
        <skos:definition xml:lang="de">Viskosität misst den Widerstand eines Fluids gegen den Fluss</skos:definition>
        <skos:example xml:lang="en">Honey at 25 C has a viscosity of about 10 Pa·s, flowing slowly under gravity</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080175 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080175">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080174"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;extentional viscosity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;viscosity&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Dehnviskosität</rdfs:label>
        <rdfs:label xml:lang="en">extentional viscosity</rdfs:label>
        <skos:definition xml:lang="de">Die Dehnviskosität ist die Messung des Widerstands einer Flüssigkeit gegen den Fluss bei Dehnspannung</skos:definition>
        <skos:definition xml:lang="en">Extentional viscosity measures a fluid&apos;s resistance to tension flow</skos:definition>
        <skos:example xml:lang="en">A polymer melt shows an extensional viscosity three times its shear viscosity at low strain rates</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080176 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080176">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080174"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;shear viscosity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;viscosity&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Scherviskosität</rdfs:label>
        <rdfs:label xml:lang="en">shear viscosity</rdfs:label>
        <skos:altLabel xml:lang="de">Scherviskosität</skos:altLabel>
        <skos:altLabel xml:lang="en">shear viscosity</skos:altLabel>
        <skos:definition xml:lang="de">Scherviskosität misst den Widerstand eines Fluids gegen Scherfluss</skos:definition>
        <skos:definition xml:lang="en">Shear viscosity measures a fluid&apos;s resistance to shear flow</skos:definition>
        <skos:example xml:lang="en">The shear viscosity of glycerol at 25 C is about 1.5 Pa·s, much higher than water</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080177 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080177">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080174"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;kinematic viscosity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;viscosity&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">kinematic viscosity</rdfs:label>
        <rdfs:label xml:lang="de">kinematische Viskosität</rdfs:label>
        <skos:altLabel xml:lang="en">kinematic viscosity</skos:altLabel>
        <skos:altLabel xml:lang="de">kinematische Viskosität</skos:altLabel>
        <skos:altLabel xml:lang="en">kinetic viscosity</skos:altLabel>
        <skos:altLabel xml:lang="de">kinetische Viskosität</skos:altLabel>
        <skos:definition xml:lang="de">Die kinematische Viskosität ist das Verhältnis der dynamischen Viskosität zur Dichte</skos:definition>
        <skos:definition xml:lang="en">Kinematic viscosity is the ratio of dynamic viscosity to density</skos:definition>
        <skos:example xml:lang="en">The kinematic viscosity of water at 20 C is about 1e-6 m2/s, used in pipe flow calculations</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080178 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080178">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080174"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;dynamic viscosity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;viscosity&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">dynamic viscosity</rdfs:label>
        <rdfs:label xml:lang="de">dynamische Viskosität</rdfs:label>
        <skos:altLabel xml:lang="en">dynamic viscosity</skos:altLabel>
        <skos:altLabel xml:lang="de">dynamische Viskosität</skos:altLabel>
        <skos:definition xml:lang="de">Die dynamische Viskosität ist ein Maß für den Widerstand eines Fluids gegen eine allmähliche Verformung durch Scher- oder Zugspannung. Es ist ein Maß für den inneren Widerstand des Fluids gegen den Fluss und kann als Maß für die Flüssigkeitsreibung betrachtet werden</skos:definition>
        <skos:definition xml:lang="en">Dynamic viscosity measures a fluid&apos;s resistance to gradual deformation by shear stress or tensile stress, indicative of the fluid&apos;s internal friction</skos:definition>
        <skos:example xml:lang="en">Motor oil at 40 C has a dynamic viscosity of about 100 mPa·s, resisting flow under shear</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080179 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080179">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080174"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;volume viscosity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;viscosity&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Volumenviskosität</rdfs:label>
        <rdfs:label xml:lang="en">volume viscosity</rdfs:label>
        <skos:definition xml:lang="en">Volume viscosity measures a fluid&apos;s resistance to volumetric stress</skos:definition>
        <skos:definition xml:lang="de">Volumenviskosität misst den Widerstand eines Fluids gegenüber volumetrischer Belastung</skos:definition>
        <skos:example xml:lang="en">Water has a volume viscosity of about 3 mPa·s at 25 C, relevant in acoustic wave propagation</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080180 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080180">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;brittleness&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;mechanical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Sprödigkeit</rdfs:label>
        <rdfs:label xml:lang="en">brittleness</rdfs:label>
        <skos:altLabel xml:lang="de">Sprödigkeit</skos:altLabel>
        <skos:altLabel xml:lang="de">Zerbrechlichkeit</skos:altLabel>
        <skos:altLabel xml:lang="en">brittleness</skos:altLabel>
        <skos:altLabel xml:lang="en">fragility</skos:altLabel>
        <skos:definition xml:lang="en">Opposite to toughness, brittleness is the property of being easily broken or damaged</skos:definition>
        <skos:definition xml:lang="de">Sprödigkeit ist die Eigenschaft, leicht zu brechen oder zu beschädigen</skos:definition>
        <skos:example xml:lang="en">Cast iron has high brittleness, fracturing without measurable plastic deformation under tensile loading</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080181 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080181">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;ductility&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;mechanical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Duktilität</rdfs:label>
        <rdfs:label xml:lang="en">ductility</rdfs:label>
        <skos:altLabel xml:lang="de">Biegsamkeit</skos:altLabel>
        <skos:altLabel xml:lang="de">Duktilität</skos:altLabel>
        <skos:altLabel xml:lang="en">ductility</skos:altLabel>
        <skos:altLabel xml:lang="en">flexibility</skos:altLabel>
        <skos:definition xml:lang="en">Ductility is the ability of a material to deform plastically without breaking</skos:definition>
        <skos:definition xml:lang="de">Duktilität ist die Fähigkeit eines Materials, plastisch zu verformen, ohne zu brechen</skos:definition>
        <skos:example xml:lang="en">Low-carbon steel has high ductility, with elongation at break exceeding 30 %</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080182 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080182">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080181"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;malleability&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;ductility&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Formbarkeit</rdfs:label>
        <rdfs:label xml:lang="en">malleability</rdfs:label>
        <skos:altLabel xml:lang="de">Formbarkeit</skos:altLabel>
        <skos:altLabel xml:lang="en">Malleability</skos:altLabel>
        <skos:altLabel xml:lang="en">Malleable</skos:altLabel>
        <skos:altLabel xml:lang="de">formbar</skos:altLabel>
        <skos:definition xml:lang="de">Formbarkeit beschreibt Materialien, die durch Hammern oder Walzen bearbeitet werden können und sich von Duktilität unterscheiden</skos:definition>
        <skos:definition xml:lang="en">Malleability refers to a material&apos;s amenability to forming by hammering or rolling, distinct from ductility</skos:definition>
        <skos:example xml:lang="en">Gold has high malleability, allowing it to be hammered into sheets less than 100 nm thick</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080184 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080184">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;resilience&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;mechanical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Resilienz</rdfs:label>
        <rdfs:label xml:lang="en">resilience</rdfs:label>
        <skos:altLabel xml:lang="de">Resilienzmodul</skos:altLabel>
        <skos:altLabel xml:lang="en">modulus of resilience</skos:altLabel>
        <skos:definition xml:lang="de">Elastizität ist die mechanische Fähigkeit eines Materials, bei elastischer Verformung Energie zu absorbieren und diese Energie bei Entlastung ohne bleibende Verformung abzugeben</skos:definition>
        <skos:definition xml:lang="en">Resilience is a mechanical capability of a material to absorb energy when elastically deformed and release that energy upon unloading without permanent deformation</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080186 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080186">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000877"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;radiation reflection capability&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;optical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Strahlungsreflexionsfähigkeiten</rdfs:label>
        <rdfs:label xml:lang="en">radiation reflection capability</rdfs:label>
        <skos:definition xml:lang="en">Radiation reflection capability characterizes an entity&apos;s ability to reflect electromagnetic radiation</skos:definition>
        <skos:definition xml:lang="de">Strahlungsreflexionsfähigkeit beschreibt die Fähigkeit einer Entität, elektromagnetische Strahlung zu reflektieren</skos:definition>
        <skos:example xml:lang="en">Polished aluminum foil has high radiation reflection capability, reflecting 90 % of infrared radiation</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080187 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080187">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000877"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;radiation absorption capability&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;optical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Strahlungsabsorptionsfähigkeit</rdfs:label>
        <rdfs:label xml:lang="en">radiation absorption capability</rdfs:label>
        <skos:definition xml:lang="en">Radiation absorption capability characterizes an entity&apos;s ability to absorb electromagnetic radiation</skos:definition>
        <skos:definition xml:lang="de">Strahlungsabsorptionsfähigkeit beschreibt die Fähigkeit einer Entität, elektromagnetische Strahlung zu absorbieren</skos:definition>
        <skos:example xml:lang="en">Carbon black pigment has high radiation absorption capability, absorbing over 99 % of incident visible light</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080188 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080188">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000877"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;radiation emission capability&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;optical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Strahlungsemitter</rdfs:label>
        <rdfs:label xml:lang="en">radiation emitter</rdfs:label>
        <skos:definition xml:lang="en">Radiation emission capability refers to an entity&apos;s ability to emit light of a defined spectrum and intensity</skos:definition>
        <skos:definition xml:lang="de">Strahlungsemitter beschreibt die Fähigkeit einer Entität, Licht eines definierten Spektrums und Intensität zu emittieren</skos:definition>
        <skos:example xml:lang="en">A cobalt-60 source is a radiation emitter used in industrial gamma-ray testing of welds</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080189 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080189">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000877"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;radiation transmission capability&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;optical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Strahlungsübertragungsfähigkeit</rdfs:label>
        <rdfs:label xml:lang="en">radiation transmission capability</rdfs:label>
        <skos:definition xml:lang="en">Radiation transmission capability describes an entity&apos;s ability to transmit electromagnetic radiation</skos:definition>
        <skos:definition xml:lang="de">Strahlungsübertragungsfähigkeit beschreibt die Fähigkeit einer Entität, elektromagnetische Strahlung zu übertragen</skos:definition>
        <skos:example xml:lang="en">A thin beryllium window has high radiation transmission capability for soft X-rays, passing over 90 % of flux</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080191 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080191">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;thermal capacity&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermal capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Heat_capacity.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Heat_capacity"/>
        <rdfs:label xml:lang="en">thermal capacity</rdfs:label>
        <rdfs:label xml:lang="de">thermische Kapazität</rdfs:label>
        <skos:altLabel xml:lang="de">Wärmekapazität</skos:altLabel>
        <skos:altLabel xml:lang="en">heat capacity</skos:altLabel>
        <skos:definition xml:lang="en">Thermal capacity, or heat capacity, is defined as the amount of heat required to produce a unit change in temperature of an object</skos:definition>
        <skos:definition xml:lang="de">Wärmekapazität, auch als thermische Kapazität bekannt, ist die Menge an Wärme, die erforderlich ist, um eine Änderung der Temperatur eines Objekts um eine Einheit zu erzeugen</skos:definition>
        <skos:example xml:lang="en">A steel block of 1 kg has a thermal capacity of 500 J/K, absorbing heat with moderate temperature rise</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080192 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080192">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;flammability&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermal capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Entflammbarkeit</rdfs:label>
        <rdfs:label xml:lang="en">flammability</rdfs:label>
        <skos:altLabel xml:lang="de">Brennbarkeit</skos:altLabel>
        <skos:altLabel xml:lang="en">combustibility</skos:altLabel>
        <skos:definition xml:lang="de">Entflammbarkeit ist eine thermische Fähigkeit eines Materials, die seine Fähigkeit beschreibt, bei Exposition gegenüber einer Flamme oder Wärmequelle unter festgelegten Bedingungen zu entzünden und die Verbrennung aufrechtzuerhalten</skos:definition>
        <skos:definition xml:lang="en">Flammability is a thermal capability of a material that characterises its ability to ignite and sustain combustion when exposed to a flame or heat source under specified conditions</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080194 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080194">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;thermal insulation&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermal capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Thermal_insulation.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Thermal_insulation"/>
        <rdfs:label xml:lang="en">thermal insulation</rdfs:label>
        <rdfs:label xml:lang="de">thermische Isolierung</rdfs:label>
        <skos:definition xml:lang="en">Thermal insulation reduces heat transfer between objects in thermal contact or radiative influence, achieved with engineered methods or material properties</skos:definition>
        <skos:definition xml:lang="de">Thermische Isolierung verringert den Wärmeaustausch zwischen Objekten, die in thermischem Kontakt oder Strahlungseinfluss stehen, realisiert durch spezielle Konstruktionsmethoden oder Materialien</skos:definition>
        <skos:example xml:lang="en">Glass wool with a thermal conductivity of 0.04 W/(m·K) provides effective thermal insulation in building walls</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080195 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080195">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020142"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;radiant energy&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermal capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Radiant_energy.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://en.wikipedia.org/wiki/Radiant_energy"/>
        <rdfs:label xml:lang="de">Strahlungsenergie</rdfs:label>
        <rdfs:label xml:lang="en">radiant energy</rdfs:label>
        <skos:definition xml:lang="en">Radiant energy refers to the energy of electromagnetic radiation, calculated by integrating radiant flux over time</skos:definition>
        <skos:definition xml:lang="de">Strahlungsenergie bezieht sich auf die Energie elektromagnetischer Strahlung, die durch Integration des Strahlungsflusses über die Zeit berechnet wird</skos:definition>
        <skos:example xml:lang="en">A pulsed laser delivers 1 mJ of radiant energy per pulse to the workpiece surface</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080196 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080196">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;thermal expansion coefficient&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermal capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">thermal expansion coefficient</rdfs:label>
        <rdfs:label xml:lang="de">thermischer Ausdehnungkoeffizient</rdfs:label>
        <skos:definition xml:lang="en">Thermal expansion coefficient quantifies the degree to which a material expands upon heating, representing fractional change per degree temperature increase</skos:definition>
        <skos:definition xml:lang="de">Thermischer Ausdehnungkoeffizient quantifiziert den Grad, in dem ein Material beim Erhitzen expandiert, und stellt die proportionale Änderung pro Temperaturanstieg dar</skos:definition>
        <skos:example xml:lang="en">The thermal expansion coefficient of borosilicate glass is 3.3e-6 per K, enabling thermal shock resistance</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080197 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080197">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080196"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;volumetric thermal expansion coefficient&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermal expansion coefficient&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">thermischer Volumenausdehnungskoeffizient</rdfs:label>
        <rdfs:label xml:lang="en">volumetric thermal expansion coefficient</rdfs:label>
        <skos:definition xml:lang="de">Der volumetrische Wärmeausdehnungskoeffizient quantifiziert den Grad, um den sich ein Material beim gleichzeitigen Erhitzen in alle drei axialen Richtungen ausdehnt</skos:definition>
        <skos:definition xml:lang="en">Volumetric thermal expansion coefficient quantifies the degree to which a material expands upon heating into all three axial directions simultaneously</skos:definition>
        <skos:example xml:lang="en">Liquid water near 4 C has a near-zero volumetric thermal expansion coefficient, giving maximum density</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080198 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080198">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080196"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;linear thermal expansion coefficient&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermal expansion coefficient&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">linear thermal expansion coefficient</rdfs:label>
        <rdfs:label xml:lang="de">linearer thermischer Ausdehnungkoeffizient</rdfs:label>
        <skos:definition xml:lang="de">Der lineare Wärmeausdehnungskoeffizient quantifiziert den Grad, um den sich ein Material beim Erhitzen in eine bestimmte axiale Richtung ausdehnt</skos:definition>
        <skos:definition xml:lang="en">Linear thermal expansion coefficient quantifies the degree to which a material expands upon heating into a specific axial direction</skos:definition>
        <skos:example xml:lang="en">Aluminum has a linear thermal expansion coefficient of 23.1e-6 per K, causing notable dimensional changes during heating</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080200 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080200">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;flame resistance&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermal capability&apos;, disjoint from &apos;flammability&apos; as the inverse capability. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Flammbeständigkeit</rdfs:label>
        <rdfs:label xml:lang="en">flame resistance</rdfs:label>
        <skos:altLabel xml:lang="de">Brandbeständigkeit</skos:altLabel>
        <skos:altLabel xml:lang="en">fire resistance</skos:altLabel>
        <skos:definition xml:lang="en">Flame resistance is a thermal capability of a material that characterises its ability to resist ignition and inhibit the spread of combustion when exposed to a flame or heat source</skos:definition>
        <skos:definition xml:lang="de">Flammbeständigkeit ist eine thermische Fähigkeit eines Materials, die seine Fähigkeit beschreibt, einer Entzündung zu widerstehen und die Ausbreitung der Verbrennung bei Exposition gegenüber einer Flamme oder Wärmequelle zu verhindern</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080201 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080201">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;thermal conductance&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermal capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="en">thermal conductance</rdfs:label>
        <rdfs:label xml:lang="de">thermische Leitfähigkeit</rdfs:label>
        <skos:definition xml:lang="en">Thermal conduction refers to the process by which heat is transferred from the hotter end to the colder end of an object, characterized by conductance</skos:definition>
        <skos:definition xml:lang="de">Thermische Leitung beschreibt den Prozess, bei dem Wärme vom heißeren zum kälteren Ende eines Objekts übertragen wird, gekennzeichnet durch Leitfähigkeit</skos:definition>
        <skos:example xml:lang="en">A copper heat spreader of 2 mm thickness has a high thermal conductance, efficiently dissipating chip heat</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080202 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080202">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;thermal shock resistance&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;thermal capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Thermoschockbeständigkeit</rdfs:label>
        <rdfs:label xml:lang="en">thermal shock resistance</rdfs:label>
        <skos:altLabel xml:lang="de">Temperaturwechselbeständigkeit</skos:altLabel>
        <skos:definition xml:lang="en">Thermal shock resistance is a thermal capability of a material that characterises its ability to withstand rapid and large changes in temperature without cracking, spalling, or loss of mechanical integrity</skos:definition>
        <skos:definition xml:lang="de">Thermoschockbeständigkeit ist eine thermische Fähigkeit eines Materials, die seine Fähigkeit beschreibt, schnelle und große Temperaturänderungen ohne Rissbildung, Abplatzungen oder Verlust der mechanischen Integrität zu überstehen</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080203 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080203">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080007"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;radiation emission capability&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Strahlungsemissionsfähigkeit</rdfs:label>
        <rdfs:label xml:lang="en">radiation emission capability</rdfs:label>
        <skos:definition xml:lang="de">Die Strahlungsemissionsfähigkeit ist die physikalische Fähigkeit eines materiellen Wesens, elektromagnetische Strahlung auszusenden, die in Prozessen realisiert wird, bei denen der Träger Energie in Form elektromagnetischer Wellen ausstrahlt</skos:definition>
        <skos:definition xml:lang="en">Radiation emission capability is a physical capability of a material entity to emit electromagnetic radiation, realized in processes where the bearer radiates energy in the form of electromagnetic waves</skos:definition>
        <skos:example xml:lang="en">A tungsten filament at 2800 K has significant radiation emission capability, producing visible white light</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0080204 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0080204">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;water absorption&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Thomas Hanke</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Wasseraufnahme</rdfs:label>
        <rdfs:label xml:lang="en">water absorption</rdfs:label>
        <skos:definition xml:lang="de">Wasseraufnahme ist eine physische Fähigkeit eines Materials, Wasser aufzunehmen, quantifiziert als Massenzunahme einer Probe im Verhältnis zur anfänglichen Trockenmasse</skos:definition>
        <skos:definition xml:lang="en">Water absorption is a physical capability of a material to take up water, quantified as the increase in mass of a specimen relative to its initial dry mass</skos:definition>
        <skos:example xml:lang="en">Water absorption of a nylon 6 specimen immersed for 24 hours expressed as 2.5% of its dry mass, measured according to ISO 62.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0090000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0090000">
        <owl:equivalentClass>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000091"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0090001"/>
            </owl:Restriction>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0090002"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000091"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0090001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">semiconductor</rdfs:label>
        <skos:definition xml:lang="en">A semiconductor is a material representing a class of materials characterized by an electrical conductivity between that of a conductor and an insulator. This is a result of a range of inexistent energy states in ther electron configuration between the valence and conduction band (bandgap).</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0090001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0090001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000620"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: thnlrd</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Halbleitfähigkeit</rdfs:label>
        <rdfs:label xml:lang="en">semiconductivity</rdfs:label>
        <skos:definition xml:lang="en">Semiconductivity is the disposition of a material to conduct electricity only when a certain level of excitation (via temperature, impurities, photonic excitation, electric field) elevates electrons from the valence band into the conduction band.</skos:definition>
        <skos:definition xml:lang="de">Unter Halbleiterfähigkeit versteht man die Eigenschaft eines Materials, Elektrizität nur dann zu leiten, wenn ein bestimmtes Maß an Anregung (durch Temperatur, Verunreinigungen, photonische Anregung, elektrisches Feld) Elektronen aus dem Valenzband in das Leitungsband hebt.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0090002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0090002">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020312"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020293"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: thnlrd</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Bandlücke</rdfs:label>
        <rdfs:label xml:lang="en">band gap</rdfs:label>
        <rdfs:seeAlso rdf:datatype="http://www.w3.org/2001/XMLSchema#anyURI">https://en.wikipedia.org/wiki/Valence_and_conduction_bands</rdfs:seeAlso>
        <skos:definition xml:lang="en">the energy difference between the valence band and the conduction band</skos:definition>
    </owl:Class>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Individuals
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://qudt.org/vocab/unit/PER-MOL -->

    <owl:NamedIndividual rdf:about="http://qudt.org/vocab/unit/PER-MOL">
        <rdf:type rdf:resource="http://qudt.org/schema/qudt/Unit"/>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020006 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020006">
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice triclinic primitive</rdfs:label>
        <rdfs:label xml:lang="de">Triklines Primitiv des Bravais-Gitters</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">triclinic Bravais lattice with primitive centering (aP), having no rotational symmetry and all three unit cell axes of unequal length meeting at oblique angles</skos:definition>
        <skos:definition xml:lang="de">triklines Bravais-Gitter mit primitiver Zentrierung (aP), keine Rotationssymmetrie und alle drei Elementarzellenachsen ungleicher Länge treffen sich in schrägen Winkeln</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020007 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020007">
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice monoclinic primitive</rdfs:label>
        <rdfs:label xml:lang="de">monoklines Grundelement des Bravais-Gitters</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">Monoklines Bravais-Gitter mit primitiver Zentrierung (mP) mit einer zweizähligen Rotationsachse mit einem schiefen Winkel und zwei rechten Winkeln zwischen den Achsen der Elementarzellen</skos:definition>
        <skos:definition xml:lang="en">monoclinic Bravais lattice with primitive centering (mP), having one 2-fold rotation axis with one oblique angle and two right angles between unit cell axes</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020008 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020008">
        <rdfs:label xml:lang="de">Bravais-Gitter monoklin basiszentriert</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice monoclinic base-centered</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">monoclinic Bravais lattice with base-centered centering (mC), having one 2-fold rotation axis and additional lattice points at the center of one pair of faces</skos:definition>
        <skos:definition xml:lang="de">monoklines Bravais-Gitter mit basiszentrierter Zentrierung (mC), einer zweizähligen Rotationsachse und zusätzlichen Gitterpunkten in der Mitte eines Flächenpaares</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020009 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020009">
        <rdfs:label xml:lang="de">Bravais-Gitter orthorombisches Grundelement</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice orthorombic primitive</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">orthorhombic Bravais lattice with primitive centering (oP), having three mutually perpendicular 2-fold rotation axes and one lattice point per unit cell</skos:definition>
        <skos:definition xml:lang="de">orthorhombisches Bravais-Gitter mit primitiver Zentrierung (oP), mit drei zueinander senkrechten zweizähligen Rotationsachsen und einem Gitterpunkt pro Elementarzelle</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020010 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020010">
        <rdfs:label xml:lang="de">Bravais-Gitter orthorhombisch basiszentriert</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice orthorhombic base-centered</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">orthorhombic Bravais lattice with base-centered centering (oC), having three perpendicular 2-fold axes and additional lattice points at the centers of one pair of faces</skos:definition>
        <skos:definition xml:lang="de">orthorhombisches Bravais-Gitter mit basiszentrierter Zentrierung (oC), mit drei senkrechten zweizähligen Achsen und zusätzlichen Gitterpunkten in den Mittelpunkten eines Flächenpaares</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020011 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020011">
        <rdfs:label xml:lang="de">Bravais-Gitter orthorhombisch körperzentriert</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice orthorhombic body-centered</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">orthorhombic Bravais lattice with body-centered centering (oI), having three perpendicular 2-fold axes and an additional lattice point at the center of the unit cell</skos:definition>
        <skos:definition xml:lang="de">orthorhombisches Bravais-Gitter mit körperzentrierter Zentrierung (oI), mit drei senkrechten zweizähligen Achsen und einem zusätzlichen Gitterpunkt in der Mitte der Elementarzelle</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020012 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020012">
        <rdfs:label xml:lang="de">Bravais-Gitter orthorhombisch flächenzentriert</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice orthorhombic face-centered</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">orthorhombic Bravais lattice with face-centered centering (oF), having three perpendicular 2-fold axes and additional lattice points at the centers of all faces</skos:definition>
        <skos:definition xml:lang="de">orthorhombisches Bravais-Gitter mit flächenzentrierter Zentrierung (oF), mit drei senkrechten zweizähligen Achsen und zusätzlichen Gitterpunkten in den Mittelpunkten aller Flächen</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020013 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020013">
        <rdfs:label xml:lang="de">Bravais-Gitter tetragonaler Grundkörper</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice tetragonal primitive</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">tetragonal Bravais lattice with primitive centering (tP), having one 4-fold rotation axis with two equal unit cell axes perpendicular to a third unequal axis</skos:definition>
        <skos:definition xml:lang="de">tetragonales Bravais-Gitter mit primitiver Zentrierung (tP), mit einer vierzähligen Rotationsachse mit zwei gleichen Elementarzellenachsen senkrecht zu einer dritten ungleichen Achse</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020014 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020014">
        <rdfs:label xml:lang="de">Bravais-Gitter tetragonal körperzentriert</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice tetragonal body-centered</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">tetragonal Bravais lattice with body-centered centering (tI), having one 4-fold rotation axis and an additional lattice point at the center of the unit cell</skos:definition>
        <skos:definition xml:lang="de">tetragonales Bravais-Gitter mit körperzentrierter Zentrierung (tI), einer 4-zähligen Rotationsachse und einem zusätzlichen Gitterpunkt im Zentrum der Elementarzelle</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020015 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020015">
        <rdfs:label xml:lang="de">Bravais-Gitter, sechseckiges, rhomboedrisches Grundelement</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice hexagonal rhombohedral primitive</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">trigonal Bravais lattice with rhombohedral centering (hR), having a 3-fold rotation axis and representable as a rhombohedron with equal axes and equal interaxial angles</skos:definition>
        <skos:definition xml:lang="de">trigonales Bravais-Gitter mit rhomboedrischer Zentrierung (hR), einer dreizähligen Rotationsachse und darstellbar als Rhomboeder mit gleichen Achsen und gleichen Zwischenachsenwinkeln</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020016 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020016">
        <rdfs:label xml:lang="de">Bravais-Gitter sechseckiges sechseckiges Grundelement</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice hexagonal hexagonal primitive</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">hexagonal Bravais lattice with primitive centering (hP), having one 6-fold rotation axis with two equal unit cell axes in the basal plane and one perpendicular axis</skos:definition>
        <skos:definition xml:lang="de">hexagonales Bravais-Gitter mit primitiver Zentrierung (hP), mit einer 6-fachen Rotationsachse mit zwei gleichen Elementarzellenachsen in der Basisebene und einer senkrechten Achse</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020017 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020017">
        <rdfs:label xml:lang="de">Bravais-Gitter, kubisches Grundelement</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice cubic primitive</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">Kubisches Bravais-Gitter mit primitiver Zentrierung (cP), mit vier dreizähligen Rotationsachsen, wobei alle Elementarzellenachsen gleich und zueinander senkrecht sind, und einem Gitterpunkt pro Elementarzelle</skos:definition>
        <skos:definition xml:lang="en">cubic Bravais lattice with primitive centering (cP), having four 3-fold rotation axes with all unit cell axes equal and mutually perpendicular and one lattice point per unit cell</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020018 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020018">
        <rdfs:label xml:lang="de">Bravais-Gitter kubisch raumzentriert</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice cubic body-centered</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">Kubisches Bravais-Gitter mit körperzentrierter Zentrierung (cI), mit vier dreizähligen Rotationsachsen und einem zusätzlichen Gitterpunkt in der Mitte der Elementarzelle</skos:definition>
        <skos:definition xml:lang="en">cubic Bravais lattice with body-centered centering (cI), having four 3-fold rotation axes and an additional lattice point at the center of the unit cell</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020019 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020019">
        <rdfs:label xml:lang="de">Bravais-Gitter kubisch flächenzentriert</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bravais lattice cubic face-centered</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">Kubisches Bravais-Gitter mit flächenzentrierter Zentrierung (cF), mit vier dreizähligen Rotationsachsen und zusätzlichen Gitterpunkten in den Mittelpunkten aller Flächen</skos:definition>
        <skos:definition xml:lang="en">cubic Bravais lattice with face-centered centering (cF), having four 3-fold rotation axes and additional lattice points at the centers of all faces</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020027 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020027">
        <rdfs:label xml:lang="de">Bainit</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE bainite</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">Eisen-Kohlenstoff-Mikrostruktur, die durch isotherme Umwandlung von Austenit bei Temperaturen zwischen dem Perlit- und Martensitbildungsbereich entsteht und aus Ferrit und fein verteiltem Zementit besteht</skos:definition>
        <skos:definition xml:lang="en">iron-carbon microstructure formed by isothermal transformation of austenite at temperatures between the pearlite and martensite formation ranges, consisting of ferrite and finely dispersed cementite</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020097 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020097">
        <rdfs:label xml:lang="de">Austenit</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE austenite</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">face-centered cubic phase of iron or an iron-based alloy, stable above the eutectoid temperature and capable of dissolving significant amounts of carbon in solid solution</skos:definition>
        <skos:definition xml:lang="de">flächenzentrierte kubische Phase aus Eisen oder einer Legierung auf Eisenbasis, die oberhalb der Eutektoidtemperatur stabil ist und in der Lage ist, erhebliche Mengen Kohlenstoff in fester Lösung aufzulösen</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020100 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020100">
        <rdfs:label xml:lang="de">Ferrit</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE ferrite</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">body-centered cubic phase of iron or an iron-based alloy with very low carbon solubility, stable at low temperatures and ferromagnetic below the Curie temperature</skos:definition>
        <skos:definition xml:lang="de">kubisch raumzentrierte Phase aus Eisen oder einer Eisenlegierung mit sehr geringer Kohlenstofflöslichkeit, stabil bei niedrigen Temperaturen und ferromagnetisch unterhalb der Curie-Temperatur</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020107 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020107">
        <rdfs:label xml:lang="de">Ledeburit</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE ledeburite</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">Eutektische Mikrostruktur von Austenit und Zementit, die sich in Eisen-Kohlenstoff-Legierungen mit einem Kohlenstoffgehalt über 2,14 Gew.-% bei der Erstarrung bei der eutektischen Temperatur von 1147 °C bildet</skos:definition>
        <skos:definition xml:lang="en">eutectic microstructure of austenite and cementite formed in iron-carbon alloys with carbon content above 2.14 wt% upon solidification at the eutectic temperature of 1147 °C</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020109 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020109">
        <rdfs:label xml:lang="en">OBSOLETE pearlite</rdfs:label>
        <rdfs:label xml:lang="de">Perlit</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">Lamellare eutektoide Mikrostruktur aus abwechselnden Ferrit- und Zementitschichten, die durch Zersetzung von Austenit bei der eutektoiden Temperatur von 723 °C entsteht</skos:definition>
        <skos:definition xml:lang="en">lamellar eutectoid microstructure of alternating ferrite and cementite layers formed by decomposition of austenite at the eutectoid temperature of 723 °C</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020111 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020111">
        <rdfs:label xml:lang="de">Martensit</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE martensite</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">hard, body-centered tetragonal phase formed by diffusionless shear transformation of austenite upon rapid quenching in iron-carbon alloys, with carbon atoms trapped in interstitial sites</skos:definition>
        <skos:definition xml:lang="de">harte, körperzentrierte tetragonale Phase, die durch diffusionslose Scherumwandlung von Austenit beim schnellen Abschrecken in Eisen-Kohlenstoff-Legierungen entsteht, wobei Kohlenstoffatome in Zwischengitterplätzen eingeschlossen sind</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020217 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020217">
        <rdf:type rdf:resource="https://w3id.org/pmd/co/PMD_0020216"/>
        <rdfs:comment>Use appropriate class from crystall ontology instead</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED short range order</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">DEPRECATED periodic arrangement of structural features up to a few entities</skos:definition>
        <skos:definition xml:lang="de">DEPRECATED periodische Anordnung von Strukturmerkmalen bis hin zu wenigen Einheiten</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020218 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020218">
        <rdf:type rdf:resource="https://w3id.org/pmd/co/PMD_0020216"/>
        <rdfs:comment>Use appropriate class from crystall ontology instead</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED medium range order</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">DEPRECATED periodic arrangement of structural features of many entities</skos:definition>
        <skos:definition xml:lang="de">DEPRECATED periodische Anordnung struktureller Merkmale vieler Entitäten</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020219 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020219">
        <rdf:type rdf:resource="https://w3id.org/pmd/co/PMD_0020216"/>
        <rdfs:comment>Use appropriate class from crystall ontology instead</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED long range order</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">DEPRECATED periodic arrangement of structural features of virtually all entities</skos:definition>
        <skos:definition xml:lang="de">DEPRECATED periodische Anordnung struktureller Merkmale praktisch aller Entitäten</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020242 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020242">
        <rdf:type rdf:resource="https://w3id.org/pmd/co/PMD_0020216"/>
        <rdfs:comment>Use appropriate class from crystall ontology instead</rdfs:comment>
        <rdfs:label xml:lang="en">DEPRECATED no range order</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">DEPRECATED keine periodische Anordnung struktureller Merkmale von Entitäten</skos:definition>
        <skos:definition xml:lang="en">DEPRECATED no periodic arrangement of structural features of entites</skos:definition>
    </owl:NamedIndividual>
    


    <!-- https://w3id.org/pmd/co/PMD_0020368 -->

    <owl:NamedIndividual rdf:about="https://w3id.org/pmd/co/PMD_0020368">
        <rdf:type rdf:resource="http://purl.obolibrary.org/obo/OBI_0001931"/>
        <obo:IAO_0000039 rdf:resource="http://qudt.org/vocab/unit/PER-MOL"/>
        <obo:OBI_0001937 rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">602214086000000000000000</obo:OBI_0001937>
        <rdfs:label xml:lang="en">avogadro number</rdfs:label>
        <skos:definition xml:lang="en">The Avogadro number</skos:definition>
    </owl:NamedIndividual>
    


