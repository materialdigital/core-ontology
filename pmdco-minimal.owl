    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000001"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">There&apos;s a dfference between composition and chemical compositon for the following reason: chemical compositon is relevant when the mass/volume/mole proportions of chemical elements(!) are identified, whlist composition includes proportions of molecules, other pure chemical substances, or even proptions of objects (in an object aggregate).</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Kamilla Zaripova</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Zusammensetzung</rdfs:label>
        <rdfs:label xml:lang="en">composition</rdfs:label>
        <skos:definition xml:lang="en">Composition is an intensive quality which defines types and proportions of compounds present in a material entity and is subject of some composition data item.</skos:definition>
        <skos:definition xml:lang="de">Zusammensetzung ist eine intensive Qualität, die Arten und Anteile von Verbindungen definiert, die in einer materiellen Einheit vorhanden sind, und Gegenstand einiger Zusammensetzungsdatenelemente ist.</skos:definition>
        <skos:example xml:lang="en">4 vol.% nitric acid solution, Styrene-Butadiene-Styrene (SBS) Block Copolymer with 50 vol.% of both styrene and butadiene</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
        <PMD_0000064 xml:lang="en">Composition is a collective property of a portion of matter, i.e., the triple portion of matter has quality composition holds. As &quot;has quality&quot; is an inverse  functional property, only one instance of portion of matter can have this specific composition. However, proportions describe the relation between the prortion of matter (the whole) and some compound (the part). Thus, the following triples hold: portion of matter has relational quality proportion; portion of matter has part some substance (or whatever is your part); substance has relational quality proportion. &quot;Has relational quality&quot; is not inverse functional, i.e., it can point to a single object from 2 distinct subjects.</PMD_0000064>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025002">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020004"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000551"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0025997"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Kamilla Zaripova</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Datenelement zur chemischen Zusammensetzung</rdfs:label>
        <rdfs:label xml:lang="en">chemical composition data item</rdfs:label>
        <skos:altLabel xml:lang="en">chemical composition specification</skos:altLabel>
        <skos:definition xml:lang="de">Bei einem Datenelement zur chemischen Zusammensetzung handelt es sich um eine Informationsinhaltseinheit, die sich auf die Zusammensetzung eines Stoffteils bezieht. Es verfügt über Bruchwertspezifikationen für Mitglieder, die Werte für Anteile von Anteilen (reiner) chemischer Elemente angeben, die Teile des Anteils der Materie sind.</skos:definition>
        <skos:definition xml:lang="en">Chemical composition data item is an information content entity that is about composition of a portion of matter. It has members fraction value specifications which specifiy values of propotions of portions of (pure) chemical elements, which are parts of the portion of matter.</skos:definition>
        <skos:example xml:lang="en">Steel has quality chemical composition , and the chemical composition data item is about the chemical composition .The chemical composition data item has members fraction specifications of iron and carbon. These fraction specifications specify value of portion of iron and portion of carbon respectively. Furthermore, these fraction specifications specify  values of relational qualities (mass) proportion of iron and (mass) proportion of carbon.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025015 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025015">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020140"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33336"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020140"/>
        <rdfs:comment xml:lang="en">&apos;portion of pure chemical element&apos; and &apos;has part&apos; only CHEBI:33336</rdfs:comment>
        <rdfs:label xml:lang="en">portion of lanthanum</rdfs:label>
        <skos:definition xml:lang="en">A portion of lanthanum is a portion of pure element that has parts only chebi:lanthanum atom.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0025997 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0025997">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001931"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001927"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020101"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002350"/>
                <owl:allValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020004"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Kamilla Zaripova</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Angabe des Bruchwerts</rdfs:label>
        <rdfs:label xml:lang="en">fraction value specification</rdfs:label>
        <skos:definition xml:lang="de">Bei der Bruchwertspezifikation handelt es sich um eine Wertspezifikation, die Informationen über den quantitativen Anteil eines Teils im Verhältnis zu einem angegebenen Ganzen enthält.</skos:definition>
        <skos:definition xml:lang="en">Fraction value specification is a value specification that contains information about quantitative share of a part relative to a specified whole.</skos:definition>
        <skos:example xml:lang="en">2.05 wt.% of carbon in steel, 4 vol.% of nitric acid in a solution</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0040001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0040001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;length&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;DimensionQuality&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000122.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Lars Vogt</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Length is a size that describes the spatial extent of its bearer in one dimension.</rdfs:comment>
        <rdfs:label xml:lang="de">Länge</rdfs:label>
        <rdfs:label xml:lang="en">length</rdfs:label>
        <skos:altLabel xml:lang="en">dimension</skos:altLabel>
        <skos:definition xml:lang="de">Die Länge ist eine eindimensionale Größe.</skos:definition>
        <skos:definition xml:lang="en">Length is a one dimensional size.</skos:definition>
        <skos:example xml:lang="en">A steel rod measures 250 mm in length between its two end faces</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050000">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025999"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33250"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Bindung</rdfs:label>
        <rdfs:label xml:lang="en">atomic bond</rdfs:label>
        <skos:definition xml:lang="en">A bond is a relational quality describing the force interaction between atoms.</skos:definition>
        <skos:definition xml:lang="de">Eine Bindung ist eine relationale Qualität, die die Kraftwechselwirkung zwischen Atomen beschreibt.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050000"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://sciencenotes.org/types-of-chemical-bonds/"/>
        <rdfs:label xml:lang="en">covalent bond</rdfs:label>
        <rdfs:label xml:lang="de">kovalente Bindung</rdfs:label>
        <skos:definition xml:lang="en">A covalent bond is a bond that forms when nonmetal atoms share electrons to achieve a stable electron configuration.</skos:definition>
        <skos:definition xml:lang="de">Eine kovalente Bindung ist eine Bindung, die entsteht, wenn Nichtmetallatome Elektronen teilen, um eine stabile Elektronenkonfiguration zu erreichen.</skos:definition>
        <skos:example xml:lang="en">In a water molecule (H₂O), the hydrogen and oxygen atoms share electrons.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050000"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://www.thoughtco.com/metallic-bond-definition-properties-and-examples-4117948"/>
        <rdfs:label xml:lang="en">metallic bond</rdfs:label>
        <rdfs:label xml:lang="de">metallische Bindung</rdfs:label>
        <skos:definition xml:lang="en">A metallic bond is a bond that forms between metal atoms, where electrons are shared in a &quot;sea&quot; of electrons that move freely around the metal ions. This type of bonding gives metals their characteristic properties such as conductivity and malleability.</skos:definition>
        <skos:definition xml:lang="de">Eine Metallbindung ist eine Bindung, die zwischen Metallatomen entsteht, wobei Elektronen in einem „Meer“ von Elektronen geteilt werden, die sich frei um die Metallionen bewegen. Diese Art der Bindung verleiht Metallen ihre charakteristischen Eigenschaften wie Leitfähigkeit und Formbarkeit.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050003 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050003">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050000"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Markus Schilling</obo:IAO_0000117>
        <obo:IAO_0000119 rdf:resource="https://sciencenotes.org/types-of-chemical-bonds/"/>
        <rdfs:label xml:lang="de">Ionenbindung</rdfs:label>
        <rdfs:label xml:lang="en">ionic bond</rdfs:label>
        <skos:definition xml:lang="en">An ionic bond is a bond that occurs when one atom donates an electron to another atom, resulting in oppositely charged ions that attract each other.</skos:definition>
        <skos:definition xml:lang="de">Eine Ionenbindung ist eine Bindung, die entsteht, wenn ein Atom ein Elektron an ein anderes Atom abgibt, wodurch entgegengesetzt geladene Ionen entstehen, die sich gegenseitig anziehen.</skos:definition>
        <skos:example xml:lang="en">An example is the interaction between the atoms of sodium chloride (NaCl), where the sodium atom donates an electron to a chlorine atom.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0050081 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0050081">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000546"/>
