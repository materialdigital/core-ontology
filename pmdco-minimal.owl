        <rdfs:label xml:lang="en">normal force</rdfs:label>
        <skos:definition xml:lang="en">a force that is acting perpendicular to some characteristic extend of one of the two involved objects</skos:definition>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/pmd/co/PMD_0020332"/>
