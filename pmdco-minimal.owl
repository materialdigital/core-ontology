    <!-- https://w3id.org/pmd/co/PMD_0020336 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020336">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020332"/>
