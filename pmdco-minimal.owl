                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000067"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000067"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000417"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000005"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0009006"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000019"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000005"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000112>Assay the wavelength of light emitted by excited Neon atoms. Count of geese flying over a house.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A planned process that has the objective to produce information about a material entity (the evaluant) by examining it.</obo:IAO_0000115>
        <obo:IAO_0000116>12/3/12: BP: the reference to the &apos;physical examination&apos; is included to point out that a prediction is not an assay, as that does not require physical examiniation.</obo:IAO_0000116>
        <obo:IAO_0000116>Discussion on OBI call 2023-05-01 resulted in an agreement to revise the textual definition of &apos;assay&apos;.  https://github.com/obi-ontology/obi/issues/1683.</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">PlanAndPlannedProcess Branch</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">OBI branch derived</obo:IAO_0000119>
        <rdfs:label xml:lang="en">assay</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000059"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000112>The plan of researcher X to perform an experiment according to a protocol.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000125"/>
        <obo:IAO_0000115 xml:lang="en">A plan is a realizable entity that is the inheres in a bearer who is committed to realizing it as a completely executed planned process.</obo:IAO_0000115>
        <obo:IAO_0000116>This class is included to make clear how the plan specification, the plan, and the planned process relate. OBI will however only subclass and work under the &apos;plan specification&apos;, and &apos;planned process&apos; class, as we want to avoid to get deep into discussions of &apos;intend&apos; etc.</obo:IAO_0000116>
        <obo:IAO_0000117 xml:lang="en">AR, BP, JM, MC, PRS</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">branch derived</obo:IAO_0000119>
        <rdfs:label xml:lang="en">plan</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0000379 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0000379">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">A mechanical function is a function that is realised via mechanical work (through an certain amount of energy transferred by some force).</obo:IAO_0000115>
        <obo:IAO_0000117>Bill Bug</obo:IAO_0000117>
        <obo:IAO_0000117>Daniel Schober</obo:IAO_0000117>
        <obo:IAO_0000117>Frank Gibson</obo:IAO_0000117>
        <obo:IAO_0000117>Melanie Courtot</obo:IAO_0000117>
        <obo:IAO_0000119 xml:lang="en">http://en.wikipedia.org/wiki/Mechanical_work</obo:IAO_0000119>
        <rdfs:label xml:lang="en">mechanical function</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001931 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0001937"/>
                <owl:minCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:minCardinality>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000123"/>
        <obo:IAO_0000115 xml:lang="en">A value specification that consists of two parts: a numeral and a unit label</obo:IAO_0000115>
        <obo:IAO_0000117>PERSON:Bjoern Peters</obo:IAO_0000117>
        <rdfs:label>scalar value specification</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/OBI_0001933 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/OBI_0001933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000030"/>
        <obo:IAO_0000112>The value of &apos;positive&apos; in a classification scheme of &quot;positive or negative&quot;; the value of &apos;20g&apos; on the quantitative scale of mass.</obo:IAO_0000112>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000115 xml:lang="en">An information content entity that specifies a value within a classification scheme or on a quantitative scale.</obo:IAO_0000115>
        <obo:IAO_0000116>This term is currently a descendant of &apos;information content entity&apos;, which requires that it &apos;is about&apos; something. A value specification of &apos;20g&apos; for a measurement data item of the mass of a particular mouse &apos;is about&apos; the mass of that mouse. However there are cases where a value specification is not clearly about any particular. In the future we may change &apos;value specification&apos; to remove the &apos;is about&apos; requirement.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON:Bjoern Peters</obo:IAO_0000117>
        <rdfs:label>value specification</rdfs:label>
    </owl:Class>
    


    <!-- http://qudt.org/schema/qudt/Unit -->

    <owl:Class rdf:about="http://qudt.org/schema/qudt/Unit">
        <rdfs:isDefinedBy rdf:resource="http://qudt.org/2.1/schema/qudt"/>
        <rdfs:label>Unit</rdfs:label>
        <skos:definition xml:lang="en">A unit of measure, or unit, is a particular quantity value that has been chosen as a scale for measuring other quantities the same kind (more generally of equivalent dimension). 
For example, the meter is a quantity of length that has been rigorously defined and standardized by the BIPM (International Board of Weights and Measures).  Any measurement of the length can be expressed as a number multiplied by the unit meter. 
More formally, the value of a physical quantity Q with respect to a unit (U) is expressed as the scalar multiple of a real number (n) and U, as  $Q = nU$.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000000">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000001"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Instances of Portions Of Matter whose shape is relevant for their dispostion to participate in a manufacturing process may be (subclasses of) objects that bear a &apos;blank role&apos; in the context of the manufacturing process.</rdfs:comment>
        <rdfs:comment xml:lang="en">Material is defined in terms of the three main perspectives that material specifications rely on: the structure of the material (&quot;intensive quality&quot;), the performance of the material (&quot;behavoiral material property&quot;) and the processing the material must have undergone (&quot;output of some process&quot;).

When defining specific materials/material taxonomies, these three aspects shall be taken into account in the aristotelian (&quot;per genus et differentiam&quot;) as differentiation.</rdfs:comment>
        <rdfs:comment xml:lang="en">The sum of portions of matter of the same type form a portion of matter of that type.</rdfs:comment>
        <rdfs:label xml:lang="de">Material</rdfs:label>
        <rdfs:label xml:lang="en">material</rdfs:label>
        <skos:altLabel xml:lang="en">Portion of Material</skos:altLabel>
        <skos:definition xml:lang="en">A material is a portion of matter that may participate in some manufacturing process and whose shape is not relevant for its participation in the manufacturing process.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000001">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">It is also representing a distinct physical or conceptual part of a material or substance.

The open energy ontology OEO defines portion of matter as a subclass of object aggregate, which implies countability. Our portion is not (precisely) countable and thus bearer of intensive properties.</rdfs:comment>
        <rdfs:comment xml:lang="en">Lome explanation for portion of matter: &quot;What is a molecule cluster at the cellular level? Contrary to the molecular level, at the cellular level of granularity the boundary of each molecule is outside of the level of granular focus. What forms a discontinuous cluster of countable individual molecules and thus bona fide objects at the molecular level, is a continuous and non-countable molecular substance at coarser levels of
granularity. At these coarser levels, the individual molecules cannot be differentiated and demarcated anymore and the cluster as a whole possesses only fiat inner boundaries.&quot;</rdfs:comment>
        <rdfs:label xml:lang="en">portion of matter</rdfs:label>
        <skos:definition xml:lang="en">A material entity that is not demarcated by any physical discontinuities. At some finer level of granularity it is an object aggregate, at some coarser level of granularity it is a fiat object part,but at this level of granularity it is neither.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000002">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000833"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000312"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000833"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">We recognize that some of the materials in the subclasses also occur naturally. However, these are not within the scope of our consideration for technical use.</rdfs:comment>
        <rdfs:label xml:lang="en">engineered material</rdfs:label>
        <skos:definition xml:lang="en">material that is output of a manufacturing process</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000005 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000005">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf rdf:nodeID="genid116"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">A property is a material trait in terms of the kind and magnitude of response to a specific imposed stimulus. Generally, definitions of properties are made independent of material shape and size.
(Callister, W.D., Rethwisch, D.G., Materials Science and Engineering, Wiley, 2014)

Technical materials are complex aggregates. Many properties that are determined for those aggregates are intrinsically associated with the methodologies employed in the measurement process. This is in contrast to typical &apos;physical&apos; properties, which like e.g. mass that can be determined to high accuracy independently of the measurement process. 
As a consequence, material properties in the ontology are differeciated according to their measurement method, e.g. Brinell hardness and Vickers hardness are different types of indentation hardness rather than different measures/quantification (GDC) of the materials property &apos;indentation hardness&apos;.
 The &apos;unit idenifieres&apos; of such properties (e.g. &quot;HV1&quot;, &quot;HV10&quot;, &quot;HBW&quot;) are strictly speaking not units but rather references to the measurement methodology used to determine a numeric value that quantifies the property.

Extensive properties that depend on the object being tested rather than on the portion of matter are (extensive) object- or system-properties.</rdfs:comment>
        <rdfs:label xml:lang="de">Materialeigenschaft</rdfs:label>
        <rdfs:label xml:lang="en">material performance property</rdfs:label>
        <skos:definition xml:lang="en">a disposition of a portion of matter that is realized in a compatible process and whose realization is grounded in the portions intensive qualities</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    <owl:Restriction rdf:nodeID="genid116">
        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
        <owl:someValuesFrom>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000001"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000056"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:someValuesFrom>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/pmd/co/PMD_0000005"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:nodeID="genid116"/>
        <rdfs:comment xml:lang="en">Due to the duality of object and portion of matter this axiom can not be an equivalent class axiom.</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://w3id.org/pmd/co/PMD_0000008 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000008">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000003"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025006"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116>an attribute of a process</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">Process attribute for a process has a similar application to specifically dependened continuant (SDC) for an independent continuant (IC). Furthermore, process attribute describes how SDCs of some participants, i.e., ICs, change in a process. 

Specific rates, e.g., tensile rate, cooling rate, etc. should be added as  subclasses of this class.</rdfs:comment>
        <rdfs:label xml:lang="en">process attribute</rdfs:label>
        <rdfs:seeAlso xml:lang="en">process attribute from OEO https://openenergyplatform.org/ontology/oeo/OEO_00030019</rdfs:seeAlso>
        <owl:versionInfo xml:lang="en">Renamed to avoid confusion with has characteristic object property</owl:versionInfo>
        <skos:altLabel xml:lang="en">process characteristic</skos:altLabel>
        <skos:definition xml:lang="en">a process attribute is a dependent occurrent that existentially depends on a process.</skos:definition>
        <skos:example xml:lang="en">Tensile rate in a tensile testing process. Cooling rate in a quenching process</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000054 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000054">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000969"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Heizfunktion</rdfs:label>
        <rdfs:label xml:lang="en">heating function</rdfs:label>
        <skos:definition xml:lang="en">A temperature change function that, when realized, enables a system or device to increase the thermal energy of a material, typically to reach temperatures required for processing, transformation, or reaction.</skos:definition>
        <skos:definition xml:lang="de">Eine Heizfunktion ist eine (realisierbare) Funktion, die ein System oder Gerät in die Lage versetzt, die Wärmeenergie eines Materials zu erhöhen, um die für die Verarbeitung, Umwandlung oder Reaktion erforderlichen Temperaturen zu erreichen.</skos:definition>
        <skos:example xml:lang="en">The function of a resistance heater in a vacuum furnace.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000055 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000055">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000969"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Kühlfunktion</rdfs:label>
        <rdfs:label xml:lang="en">cooling function</rdfs:label>
        <skos:definition xml:lang="en">A temperature change function that enables a system or device to lower the temperature of a material, often to control solidification or maintain a stable state below a desired thermal threshold.</skos:definition>
        <skos:definition xml:lang="de">Eine Kühlfunktion ist eine (realisierbare) Funktion, die es einem System oder Gerät ermöglicht, die Temperatur eines Materials zu senken, häufig um die Erstarrung zu steuern oder einen stabilen Zustand unterhalb eines gewünschten thermischen Schwellenwerts aufrechtzuerhalten.</skos:definition>
        <skos:example xml:lang="en">The function of a water-cooled mold to solidify molten metal in casting.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000068 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000068">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000004"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000108"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000008"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000070"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000004"/>
                                    <owl:Class>
                                        <owl:complementOf rdf:resource="https://w3id.org/pmd/co/PMD_0000068"/>
                                    </owl:Class>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000108"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000008"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0000070"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000004"/>
                            <owl:Class>
                                <owl:complementOf rdf:resource="https://w3id.org/pmd/co/PMD_0000068"/>
                            </owl:Class>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">For any temporally qualified continuant x@t, there exists a continuant y such that x@t has_state y, meaning that y is the anchor continuant of which x@t is a temporal phase existing at temporal regions t. The relation has_state is functional and signifies that all such temporally qualified continuants are uniquely associated with their basic anchor continuant.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">temporally qualified continuant</rdfs:label>
        <skos:definition xml:lang="en">A temporally qualified continuant is a continuant that, by reference to a determinate temporal region, is such as to possess its properties only for so long as that period obtains, being otherwise in its essentiality unchanged.</skos:definition>
        <PMD_0001032>https://github.com/materialdigital/core-ontology/issues/185</PMD_0001032>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000111 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000111">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000620"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">superconductivity</rdfs:label>
        <skos:definition>The disposition of a material to conduct electricity without electrical resistance or infinite electrical conductance respectively.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000112 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000112">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">dielectric disposition</rdfs:label>
        <skos:definition xml:lang="en">disposition of an electric insulator to be polarized when subjected to an electric field</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000143 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000143">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0001933"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">duration</rdfs:label>
        <skos:definition xml:lang="en">a value specification that represents the temporal extent of an occurrent, corresponding to the interval between its beginning and its end; specified in units of time.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000501 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000501">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">1D</rdfs:label>
        <skos:definition xml:lang="en">1D is a data item representing a one-dimensional structure or model representing a single linear dimension, often used in material science simulations or analysis.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000502 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000502">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000027"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">2D</rdfs:label>
        <skos:definition xml:lang="en">A two-dimensional data item is a representation or analysis, commonly applied in studying planar material properties or surface phenomena.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000503 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000503">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">TODO: axiom needs refinement</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">ASTM-Korngröße</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE ASTM grainsize</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">Die ASTM-Korngröße ist eine Qualität, die durch ein Verfahren gemessen wird, das dem ASTM-Standard folgt.</skos:definition>
        <skos:definition xml:lang="en">The ASTM grain size is a quality that is measured through a process that follows the ASTM standard.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000506 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000506">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020265"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:unionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000092"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000004"/>
                    </owl:Restriction>
                </owl:unionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">acoustic property</rdfs:label>
        <rdfs:label xml:lang="de">akustische Eigenschaft</rdfs:label>
        <skos:definition xml:lang="de">Eine akustische Eigenschaft ist eine Materialeigenschaft, die Eigenschaften eines Materials darstellt, die seine Wechselwirkung mit Schallwellen bestimmen, wie z. B. Absorption, Reflexion und Transmission.</skos:definition>
        <skos:definition xml:lang="en">a property that is commonly associated with the domain of acoustics</skos:definition>
        <skos:example xml:lang="en">A piezoelectric transducer has the acoustic capability to emit ultrasound at frequencies up to 10 MHz</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000517 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000517">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020215"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002020"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020351"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002020"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020352"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">acoustic wave</rdfs:label>
        <rdfs:label xml:lang="de">akustische Welle</rdfs:label>
        <skos:definition xml:lang="en">a mechanical wave of pressure disturbances that propagates through a medium by local compression and rarefaction</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000520 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000520">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Wärmefluss</rdfs:label>
        <rdfs:label xml:lang="en">heat flow</rdfs:label>
        <skos:definition xml:lang="en">is a process in which transfer of thermal energy between or within material entities occurs</skos:definition>
        <skos:definition xml:lang="de">ist ein Prozess, bei dem Wärmeenergie zwischen oder innerhalb materieller Einheiten übertragen wird</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000526 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000526">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Atombau</rdfs:label>
        <rdfs:label xml:lang="en">atomic structure</rdfs:label>
        <skos:definition xml:lang="de">Die Atomstruktur ist ein Objektaggregat, das die Anordnung und Zusammensetzung von Atomen in einem Material beschreibt und dessen physikalische und chemische Eigenschaften beeinflusst.</skos:definition>
        <skos:definition xml:lang="en">The atomic structure is an object aggregate that describes the arrangement and composition of atoms in a material, influencing its physical and chemical properties.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000535 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000535">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020164"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Siedepunkt</rdfs:label>
        <rdfs:label xml:lang="en">boiling point</rdfs:label>
        <skos:definition xml:lang="de">Der Siedepunkt ist eine Zustandsgrenze einer Materie, die durch den Übergang vom flüssigen in den gasförmigen Zustand (oder umgekehrt) entsteht.</skos:definition>
        <skos:definition xml:lang="en">The boiling point is a state of matter boundary realized by transition form the liquid state to the gaseous state (or vice versa).</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000536 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000536">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000537"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Brinell 2,5 62,5 ISO 6506</rdfs:label>
        <rdfs:label xml:lang="en">Brinell 2.5 62.5 ISO 6506</rdfs:label>
        <skos:definition xml:lang="en">A brinell hardness measured with 2.5mm diameter ball and a load of 62.5 kgf.</skos:definition>
        <skos:definition xml:lang="de">Eine Brinellhärte, gemessen mit einer Kugel mit 2,5 mm Durchmesser und einer Belastung von 62,5 kgf.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000537 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000537">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000789"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Brinellhärte</rdfs:label>
        <rdfs:label xml:lang="en">brinell hardness</rdfs:label>
        <skos:definition xml:lang="en">An indentation hardness scalar representing a measure of material hardness obtained by indenting the material with a steel or tungsten carbide ball under a specific load.</skos:definition>
        <skos:definition xml:lang="de">Ein Eindruckhärteskalar, der ein Maß für die Materialhärte darstellt, die durch das Eindrücken des Materials mit einer Stahl- oder Wolframkarbidkugel unter einer bestimmten Last erzielt wird.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000538 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000538">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000024"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0000965"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">bulk</rdfs:label>
        <skos:definition xml:lang="en">a fiat object part that describes the inner part of a somewhat homogenous object, often in contrast to its surface layer</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000539 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000539">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020311"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000896"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020150"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Kompressionsmodul</rdfs:label>
        <rdfs:label xml:lang="en">bulk modulus</rdfs:label>
        <skos:definition xml:lang="en">a measure of a material&apos;s stiffness under pressure</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000543 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000543">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000603"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Kalibrierungsgeräterolle</rdfs:label>
        <rdfs:label xml:lang="en">calibration device role</rdfs:label>
        <skos:definition xml:lang="en">A device role that is used for calibration of itself or another device, which has the &quot;Subject Of Calibration Role&quot;. The role is realized in a calibration process.</skos:definition>
        <skos:definition xml:lang="de">Rolle eines Geräts, das zum Kalibrieren sich selbst oder eines anderen Gerätes, das die &quot;Subject Of Calibration Role&quot; inne hat, verwendet wird. Die Rolle wird in einem Kalibrierungsprozess realisiert.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000546 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000546">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
        <obo:IAO_0000116 xml:lang="en">Classified by morphology.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">ceramic</rdfs:label>
        <skos:definition xml:lang="en">material described as non-metallic, inorganic materials characterized by high hardness, brittleness, and heat resistance, commonly used in engineering applications</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000547 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000547">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020136"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">change of aggregate state</rdfs:label>
        <rdfs:label xml:lang="de">Änderung des Aggregatzustandes</rdfs:label>
        <skos:definition xml:lang="en">a phase transformation (change of phase) involving the collective state of particles in portion of matter</skos:definition>
        <skos:definition xml:lang="de">eine Phasenumwandlung (Phasenänderung), die den kollektiven Zustand von Teilchen in einem Teil der Materie betrifft</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000549 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000549">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Temperaturänderung</rdfs:label>
        <rdfs:label xml:lang="en">change of temperature</rdfs:label>
        <skos:definition xml:lang="de">Temperaturänderung ist ein Prozess, bei dem ein Teilnehmer seine Temperatur ändert</skos:definition>
        <skos:definition xml:lang="en">change of temperature is a process in which a particpant changes its temperature</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000550 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000550">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000833"/>
        <obo:IAO_0000119 xml:lang="en">Official definition can be found in: DIN 8580:2003-9 Fertigungsverfahren, Page 5, 3.1.6 Stoffeigenschaften ändern - Definition</obo:IAO_0000119>
        <obo:IAO_0000119 xml:lang="de">Offizielle Definition findet man in: DIN 8580:2003-9 Fertigungsverfahren, Seite 5, 3.1.6 Stoffeigenschaften ändern - Definition</obo:IAO_0000119>
        <rdfs:label xml:lang="de">Stoffeigenschaft Ändern</rdfs:label>
        <rdfs:label xml:lang="en">changing properties of material</rdfs:label>
        <skos:altLabel xml:lang="en">Changing Of Material  Properties</skos:altLabel>
        <skos:altLabel xml:lang="en">Property Alteration</skos:altLabel>
        <skos:definition xml:lang="en">A manufacturing process that modifies the characteristics of the material from which a workpiece is made, including by processes at the submicroscopic or atomic scale, such as atomic diffusion, dislocation formation and movement in the atomic lattice or chemical reactions, whereby the resulting shape changes are not characteristic of these processes.</skos:definition>
        <skos:definition xml:lang="de">Ein Herstellungsprozess, der die Merkmale des Materials, aus dem ein Werkstück gefertigt ist, modifiziert, was unter anderem durch Vorgänge im submikroskopischen oder atomaren Bereich erfolgt, wie etwa durch Atomdiffusion, die Versetzungsentstehung und -bewegung im Atomgitter oder durch chemische Reaktionen, wobei die dabei auftretenden Formveränderungen nicht charakteristisch für diese Verfahren sind.</skos:definition>
        <skos:example xml:lang="en">Heat Treatment</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000551 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000551">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0025001"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020140"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">See the editor note of composition to understand the difference between composition and chemical composition.

See the pattern example of composition to underatand the difference between composition and proportion.</rdfs:comment>
        <rdfs:label xml:lang="en">chemical composition</rdfs:label>
        <rdfs:label xml:lang="de">chemische Zusammensetzung</rdfs:label>
        <skos:definition xml:lang="de">Die chemische Zusammensetzung ist eine intensive Eigenschaft eines Materieteils, die die Arten und Anteile reiner chemischer Elemente in dem Materieteil beschreibt, und ist Gegenstand einiger Datenelemente zur chemischen Zusammensetzung.</skos:definition>
        <skos:definition xml:lang="en">The chemical composition is an intensive quality of a portion of matter which describes the types and proportions of pure chemical elements in the portion of matter, and it is a subject of some chemical composition data item.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
        <PMD_0000064 xml:lang="en">Material has quality chemical composition. Chemical composition is a subject of chemical composition data item. Chemical composition data item has members fraction value specifications (which have a numeral and a unit). Material has part portion of carbon. Material has relational quality mass proportion. Portion of carbon  has relational quality mass proportion. Mass propotion is specified by value fraction value specification. Same approach for all chemical elements.</PMD_0000064>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000553 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000553">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080116"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">chemical potential</rdfs:label>
        <rdfs:label xml:lang="de">chemisches Potential</rdfs:label>
        <skos:definition xml:lang="en">a quality of a thermodynamic system describing the energy change associated with the addition of a small quantity of a substance to a system at constant temperature and pressure.</skos:definition>
        <skos:definition xml:lang="de">eine intensive Qualität eines thermodynamischen Systems, die die Energieänderung beschreibt, die mit der Zugabe einer kleinen Menge einer Substanz zu einem System bei konstanter Temperatur und konstantem Druck verbunden ist.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000555 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000555">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020255"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000556"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000079"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Chromatographiefunktion</rdfs:label>
        <rdfs:label xml:lang="en">chromatography function</rdfs:label>
        <skos:definition xml:lang="en">A function performed to separate compounds in a mixture based on their distribution between a stationary phase and a mobile phase.</skos:definition>
        <skos:definition xml:lang="de">Eine Funktion, die durchgeführt wird, um Verbindungen in einer Mischung basierend auf ihrer Verteilung zwischen einer stationären Phase und einer mobilen Phase zu trennen.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000556 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000556">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000957"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0009006"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020101"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0009006"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0025001"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Chromatographieverfahren</rdfs:label>
        <rdfs:label xml:lang="en">chromatography process</rdfs:label>
        <skos:definition xml:lang="en">A structural property analyzing process that enables the separation and analysis of compounds in a mixture by their distribution between a mobile and a stationary phase.</skos:definition>
        <skos:definition xml:lang="de">Ein Struktur Eigenschaften Analyseverfahren, das die Trennung und Analyse von Verbindungen in einem Gemisch durch ihre Verteilung zwischen einer mobilen und einer stationären Phase ermöglicht.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000563 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000563">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000833"/>
        <obo:IAO_0000119 xml:lang="en">Official definition can be found in: DIN 8580:2003-9 Fertigungsverfahren, Page 5, 3.1.5 Beschichten - Definition</obo:IAO_0000119>
        <obo:IAO_0000119 xml:lang="de">Offizielle Definition findet man in: DIN 8580:2003-9 Fertigungsverfahren, Seite 5, 3.1.5 Beschichten - Definition</obo:IAO_0000119>
        <rdfs:label xml:lang="de">Beschichten</rdfs:label>
        <rdfs:label xml:lang="en">coating</rdfs:label>
        <skos:definition xml:lang="en">A manufacturing process that aims to deposit a permanently adhering layer of a material without a form onto a workpiece, whereby the immediate state of the coating material directly before application is essential.</skos:definition>
        <skos:definition xml:lang="de">Ein Herstellungsprozess, der darauf abzielt, eine dauerhaft haftende Schicht aus einem Material ohne Form auf ein Werkstück aufzubringen, wobei der unmittelbare Zustand des Beschichtungsmaterials direkt vor dem Auftragen entscheidend ist.</skos:definition>
        <skos:example xml:lang="en">Chemical Vapour Deposition, Physical Vapour Deposition</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000564 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000564">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000575"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Beschichtungsanwendungsfunktion</rdfs:label>
        <rdfs:label xml:lang="en">coating application function</rdfs:label>
        <skos:definition xml:lang="en">A coating application function is a coating function that is realized in applying a coating to a surface.</skos:definition>
        <skos:definition xml:lang="de">Eine Unterfunktion der Beschichtung, die durchgeführt wird, um eine Beschichtung auf eine Oberfläche aufzutragen.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000567 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000567">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Beschichtungsgerät</rdfs:label>
        <rdfs:label xml:lang="en">coating device</rdfs:label>
        <skos:definition xml:lang="en">A device used for applying a coating or layer to materials to enhance their properties or appearance.</skos:definition>
        <skos:definition xml:lang="de">Ein Gerät zum Auftragen einer Beschichtung oder Schicht auf Materialien zur Verbesserung ihrer Eigenschaften oder ihres Aussehens.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000575 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000575">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020254"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000563"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000079"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000567"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Beschichtungsfunktion</rdfs:label>
        <rdfs:label xml:lang="en">coating function</rdfs:label>
        <skos:definition xml:lang="en">A function performed to apply a layer or coating to a surface to enhance its properties or appearance.</skos:definition>
        <skos:definition xml:lang="de">Eine Funktion, die ausgeführt wird, um eine Schicht oder Beschichtung auf eine Oberfläche aufzutragen, um deren Eigenschaften oder Aussehen zu verbessern.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000577 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000577">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000890"/>
        <rdfs:label xml:lang="en">composite</rdfs:label>
        <skos:definition xml:lang="en">An object aggregate that consists of two or more bonded materials with dissimilar physical or chemical properties which are used to complement each other where the parts remain seperate and distinct in the resulting object aggregate.</skos:definition>
        <skos:example>carbon fibre reinforced polymer
laminated glass
wood
hard metal composites for abrasive tools</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000585 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000585">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000931"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">continuous simulation</rdfs:label>
        <skos:definition xml:lang="en">A simulation method specification where changes in a system are modeled continuously over time.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000587 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000587">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000635"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Risswachstum</rdfs:label>
        <rdfs:label xml:lang="en">crack growth</rdfs:label>
        <skos:definition xml:lang="de">Das Risswachstum ist eine Schadensentwicklung, die die fortschreitende Ausdehnung eines Risses in einem Material unter Spannung beschreibt.</skos:definition>
        <skos:definition xml:lang="en">The crack growth is an evolution of damage describing the progressive extension of a crack in a material under stress.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000591 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000591">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116>will move to CryO</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <obo:IAO_0100001 xml:lang="en">Obsolete by Kamilla: replaced with defines crystal lattices with fancy axioms an SWRL rules in CryO https://github.com/materialdigital/crystallography-subdomain-ontology</obo:IAO_0100001>
        <rdfs:comment xml:lang="en">The finite set of periodic geometric arrangements is described e.g. by the 14 possible Bravais Lattices in three-dimensional space.</rdfs:comment>
        <rdfs:label xml:lang="de">Kristallstruktur</rdfs:label>
        <rdfs:label xml:lang="en">OBSOLETE crystal structure</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="en">an intensive quality of a crystal that embodies the periodic geometric arrangement of entities in a crystal lattice.</skos:definition>
        <skos:definition xml:lang="de">eine intensive Kristallqualität, die die periodische geometrische Anordnung von Einheiten in einem Kristallgitter verkörpert.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000592 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000592">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020339"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000079"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0001998"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Trennen Funktion</rdfs:label>
        <rdfs:label xml:lang="en">cut function</rdfs:label>
        <skos:altLabel xml:lang="de">Schneidfunktion</skos:altLabel>
        <skos:definition xml:lang="en">A function performed to separate or divide materials using cutting devices.</skos:definition>
        <skos:definition xml:lang="de">Eine Funktion, die ausgeführt wird, um Materialien mit Schneidgeräten zu trennen oder zu teilen.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000595 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000595">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Defektdichte</rdfs:label>
        <rdfs:label xml:lang="en">defect density</rdfs:label>
        <skos:definition xml:lang="en">an intensive quality describing the number of defects per unit volume or area in a material, which can affect its mechanical and electronic properties</skos:definition>
        <skos:definition xml:lang="de">eine intensive Qualität, die die Anzahl der Defekte pro Volumen- oder Flächeneinheit in einem Material beschreibt, die sich auf seine mechanischen und elektronischen Eigenschaften auswirken können</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000596 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000596">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000057"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000068"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000108"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000202"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000063"/>
                                                <owl:someValuesFrom>
                                                    <owl:Class>
                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000202"/>
                                                            <owl:Restriction>
                                                                <owl:onProperty>
                                                                    <rdf:Description>
                                                                        <owl:inverseOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000108"/>
                                                                    </rdf:Description>
                                                                </owl:onProperty>
                                                                <owl:someValuesFrom>
                                                                    <owl:Class>
                                                                        <owl:intersectionOf rdf:parseType="Collection">
                                                                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000068"/>
                                                                            <owl:Restriction>
                                                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                                                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
                                                                            </owl:Restriction>
                                                                        </owl:intersectionOf>
                                                                    </owl:Class>
                                                                </owl:someValuesFrom>
                                                            </owl:Restriction>
                                                        </owl:intersectionOf>
                                                    </owl:Class>
                                                </owl:someValuesFrom>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">According to the modelling pattern we use TQCs to represent the participants properties before and after the process</rdfs:comment>
        <rdfs:label xml:lang="de">Verformung</rdfs:label>
        <rdfs:label xml:lang="en">deformation</rdfs:label>
        <skos:definition xml:lang="en">a process that changes the &apos;dimension quality&apos; of a participant. It excludes translations and rotations.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="https://w3id.org/pmd/co/PMD_0000596"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/2000/01/rdf-schema#subClassOf"/>
        <owl:annotatedTarget rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:comment>simple form: 
process and (&apos;has participant&apos; some 
(&apos;temporally qualified continuant&apos; and (&apos;has quality&apos; some &apos;dimension quality&apos;)))</rdfs:comment>
    </owl:Axiom>
    


    <!-- https://w3id.org/pmd/co/PMD_0000597 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000597">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023043"/>
        <rdfs:label xml:lang="en">mass density</rdfs:label>
        <skos:definition xml:lang="en">fundamental property of matter representing the mass of a portion of matter per unit volume</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000601 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000601">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000931"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">deterministic simulation</rdfs:label>
        <skos:definition xml:lang="en">A simulation method specification where outcomes are precisely determined through known relationships without random variability.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000602 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000602">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Gerät</rdfs:label>
        <rdfs:label xml:lang="en">device</rdfs:label>
        <skos:definition xml:lang="en">A device is an object that is designed to perform a specific function or task involving measurement, manipulation, processing, or analysis.</skos:definition>
        <skos:definition xml:lang="de">Ein physisches oder virtuelles Objekt, das verwendet wird, um eine bestimmte Funktion oder Aufgabe auszuführen, häufig im Zusammenhang mit der Messung, Manipulation oder Analyse von Materialien.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000603 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000603">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020254"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Rolle eines Gerätes</rdfs:label>
        <rdfs:label xml:lang="en">device role</rdfs:label>
        <skos:definition xml:lang="de">Rolle, die ein Geräte inne haben kann.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000604 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000604">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020312"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0000620"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Dielektrizitätskonstante</rdfs:label>
        <rdfs:label xml:lang="en">dielectric constant</rdfs:label>
        <skos:definition xml:lang="de">Die Dielektrizitätskonstante ist eine elektrische Eigenschaft, die ein Maß für die Fähigkeit eines Materials darstellt, elektrische Energie in einem elektrischen Feld zu speichern.</skos:definition>
        <skos:definition xml:lang="en">The dielectric constant is an electrical property representing a measure of a material&apos;s ability to store electrical energy in an electric field.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000610 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000610">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000847"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Dimensionierungsfunktion</rdfs:label>
        <rdfs:label xml:lang="en">dimension measuring function</rdfs:label>
        <skos:definition xml:lang="en">A measuring function performed to determine the dimensions of an object or material.</skos:definition>
        <skos:definition xml:lang="de">Eine Messfunktion um die Abmessungen eines Objekts oder Materials zu bestimmen.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000613 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000613">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000931"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">discrete-event simulation</rdfs:label>
        <skos:definition xml:lang="en">A simulation method specification where events are processed at distinct points in time, commonly used for modeling systems with discrete state changes.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000618 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000618">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020311"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020331"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080034"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Elastizitätsmodul</rdfs:label>
        <rdfs:label xml:lang="en">elastic modulus</rdfs:label>
        <skos:definition xml:lang="en">represents a material&apos;s stiffness to loading in the normal direction, defined as the ratio of stress to strain in the elastic deformation region.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000619 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000619">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0080116"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080022"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">electric potential</rdfs:label>
        <skos:definition xml:lang="en">an extensvie quality describing the amount of work needed to move a unit charge from a reference point to a specific location in an electric field.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000620 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000620">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020312"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000092"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">electrical conductivity</rdfs:label>
        <rdfs:label xml:lang="de">elektrische Leitfähigkeit</rdfs:label>
        <skos:definition xml:lang="de">Die elektrische Leitfähigkeit ist eine elektrische Eigenschaft, die die Fähigkeit eines Materials beschreibt, elektrischen Strom zu leiten, beeinflusst von seiner Struktur und Zusammensetzung.</skos:definition>
        <skos:definition xml:lang="en">The electrical conductivity is an electrical property describing the ability of a material to conduct electric current, influenced by its structure and composition.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000628 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000628">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000629"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Emission von Korpuskularstrahlung</rdfs:label>
        <rdfs:label xml:lang="en">emission of corpuscular radiation</rdfs:label>
        <skos:definition xml:lang="de">Die Emission von Korpuskularstrahlung ist eine Strahlungsemission, die die Freisetzung partikelbasierter Strahlung, beispielsweise Alpha- oder Betateilchen, aus einem Material oder System beschreibt.</skos:definition>
        <skos:definition xml:lang="en">The emission of corpuscular radiation is an emission of radiation describing the release of particle-based radiation, such as alpha or beta particles, from a material or system.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000629 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000629">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Emission von Strahlung</rdfs:label>
        <rdfs:label xml:lang="en">emission of radiation</rdfs:label>
        <skos:definition xml:lang="de">Die Emissionsstrahlung ist ein Prozess, der die Freisetzung von Energie in Form elektromagnetischer Wellen oder Partikel aus einem Material beschreibt.</skos:definition>
        <skos:definition xml:lang="en">The emission radiation is a process describing the release of energy in the form of electromagnetic waves or particles from a material.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000630 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000630">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000629"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Emission von Wellenstrahlung</rdfs:label>
        <rdfs:label xml:lang="en">emission of wave radiation</rdfs:label>
        <skos:definition xml:lang="de">Die Emission von Wellenstrahlung ist eine Strahlungsemission, die die Freisetzung von Energie in Form von Wellen, beispielsweise elektromagnetischen oder akustischen Wellen, durch ein Material oder System beschreibt.</skos:definition>
        <skos:definition xml:lang="en">The emission of wave radioation is an emission of radiation describing the release of energy in the form of waves, such as electromagnetic or acoustic waves, by a material or system.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000635 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Schadensentwicklung</rdfs:label>
        <rdfs:label xml:lang="en">evolution of damage</rdfs:label>
        <skos:definition xml:lang="en">An evolution of damage is a process representing the progression of material degradation under mechanical, thermal, or chemical stresses.</skos:definition>
        <skos:definition xml:lang="de">Eine Schadensentwicklung ist ein Prozess, der das Fortschreiten der Materialdegradation unter mechanischer, thermischer oder chemischer Belastung darstellt.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000644 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000644">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000847"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Kraftmessfunktion</rdfs:label>
        <rdfs:label xml:lang="en">force measuring function</rdfs:label>
        <skos:definition xml:lang="en">A measuring function performed to determine the force applied to or by an object.</skos:definition>
        <skos:definition xml:lang="de">Eine Messfunktion um die auf ein Objekt ausgeübte oder von ihm ausgeübte Kraft zu bestimmen.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000645 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000645">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Bildung von Kerben oder Kratzern</rdfs:label>
        <rdfs:label xml:lang="en">formation of notch or scratch</rdfs:label>
        <skos:definition xml:lang="de">Die Bildung einer Kerbe oder eines Kratzers ist ein Prozess, der die Entstehung kleiner Oberflächenfehler beschreibt, die die mechanischen Eigenschaften eines Materials beeinflussen können.</skos:definition>
        <skos:definition xml:lang="en">The formation of (a) notch or (a) scratch is a process that describes the creation of small surface imperfections, which can influence a material&apos;s mechanical properties.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000654 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000654">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000116 xml:lang="en">Classified by the role in a system.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">functional material</rdfs:label>
        <skos:definition xml:lang="en">A functional material F is a material which has the function to be used for an object O (O consists of F) and O&apos;s function is other/more than mechanical load carrying.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000661 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000661">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
        <obo:IAO_0000116 xml:lang="en">Classified by morphology.</obo:IAO_0000116>
        <rdfs:comment xml:lang="en">It is often composed of silica-based compounds.</rdfs:comment>
        <rdfs:label xml:lang="en">glass</rdfs:label>
        <skos:definition xml:lang="en">material present as an amorphous solid typically formed by rapid cooling of a melt</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000663 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000663">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020003"/>
        <rdfs:label xml:lang="en">crystallite</rdfs:label>
        <rdfs:label xml:lang="de">kristallit</rdfs:label>
        <skos:altLabel xml:lang="de">Korn</skos:altLabel>
        <skos:altLabel xml:lang="en">grain</skos:altLabel>
        <skos:definition xml:lang="en">A crystal grain is a crystal that is part of a polycrystal.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000768 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000768">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000008"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Halbwertszeit</rdfs:label>
        <rdfs:label xml:lang="en">half-life</rdfs:label>
        <skos:definition xml:lang="de">Die Halbwertszeit ist ein Prozessmerkmal, das die Zeit beschreibt, die ein Material oder eine Qualität eines Materiales benötigt, um seinen Anfangswert auf die Hälfte zu reduzieren</skos:definition>
        <skos:definition xml:lang="en">The half-life is a process attribute describing the time it takes for a material entity or a quality of a material entity to reduce its initial value to a half</skos:definition>
        <skos:example xml:lang="en">radioactive decay, material degradation</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000773 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000773">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020335"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020293"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Härte</rdfs:label>
        <rdfs:label xml:lang="en">hardness</rdfs:label>
        <skos:definition xml:lang="en">The hardness is a mechanical property used as a measure of a material&apos;s resistance to localized plastic deformation, often tested by indentation or scratch methods.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000777 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000777">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000520"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0000978"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Wärmekapazität</rdfs:label>
        <rdfs:label xml:lang="en">heat capacity</rdfs:label>
        <skos:definition xml:lang="de">Die Wärmekapazität ist eine thermische Eigenschaft, die die Menge an Wärmeenergie beschreibt, die erforderlich ist, um die Temperatur einer Entität um einen bestimmten Betrag zu erhöhen.</skos:definition>
        <skos:definition xml:lang="en">The heat capacity is a thermal property describing the amount of heat energy required to raise the temperature of an entity by a given amount.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000779 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000779">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000550"/>
        <obo:IAO_0000119 xml:lang="en">Official definition can be found in: DIN EN ISO 4885:2018 Wärmebehandlung Page 21, 3.108 Wärmebehandlung - Definition</obo:IAO_0000119>
        <obo:IAO_0000119 xml:lang="de">Offizielle Definition findet man in: DIN EN ISO 4885:2018 Wärmebehandlung Seite 21, 3.108 Wärmebehandlung - Definition</obo:IAO_0000119>
        <rdfs:label xml:lang="de">Wärmebehandlung</rdfs:label>
        <rdfs:label xml:lang="en">heat treatment</rdfs:label>
        <skos:altLabel xml:lang="de">Wärmebehandeln</skos:altLabel>
        <skos:definition xml:lang="en">A changing properties of material process in which a solid (ferrous) product is fully or partially exposed to specific time-temperature sequences through a series of process steps with the aim of modifying its properties and/or its internal structure.</skos:definition>
        <skos:definition xml:lang="de">Ein Stoffeigenschaft Ändern Prozess, bei dem durch eine Reihe von Verfahrensschritten ein festes (Eisen-)Produkt ganz oder teilweise bestimmten Zeit-Temperatur-Abfolgen ausgesetzt wird, mit dem Ziel, seine Eigenschaften und/oder seine innere Struktur zu modifizieren.</skos:definition>
        <skos:example xml:lang="en">Annealing, Ageing, Hardening</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000780 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000780">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000602"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000054"/>
                                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000055"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000054"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000055"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Wärmebehandlungsgerät</rdfs:label>
        <rdfs:label xml:lang="en">heat treatment device</rdfs:label>
        <skos:definition xml:lang="en">A device used for treating materials through heating and cooling processes to alter their properties.</skos:definition>
        <skos:definition xml:lang="de">Ein Gerät zur Behandlung von Materialien durch Erwärmungs- und Abkühlungsprozesse zur Veränderung ihrer Eigenschaften.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000781 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000781">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000779"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000079"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000780"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Wärmebehandlungsfunktion</rdfs:label>
        <rdfs:label xml:lang="en">heat treatment function</rdfs:label>
        <skos:definition xml:lang="en">A function performed to alter the properties of materials through controlled heating and cooling processes.</skos:definition>
        <skos:definition xml:lang="de">Eine Funktion, die durchgeführt wird, um die Eigenschaften von Materialien durch kontrollierte Wärme- und Abkühlungsprozesse zu verändern.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000786 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000786">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000931"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">hybrid simulation</rdfs:label>
        <skos:definition xml:lang="en">A simulation method specification that combines physical and computational models to analyze material behavior.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000789 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000789">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000773"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Indentationshärte</rdfs:label>
        <rdfs:label xml:lang="en">indentation hardness</rdfs:label>
        <skos:definition xml:lang="de">Die Eindruckhärte ist eine Härte, die den Widerstand eines Materials gegenüber der Verformung durch einen Eindringkörper angibt und zur Beurteilung der Oberflächenhärte verwendet wird.</skos:definition>
        <skos:definition xml:lang="en">The indentation hardness is a hardness representing the resistance of a material to deformation from an indenter, used to assess surface hardness.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000790 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000790">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000877"/>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0000911"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">e.g., air into glass</rdfs:comment>
        <rdfs:label xml:lang="de">Brechung</rdfs:label>
        <rdfs:label xml:lang="en">optical refraction</rdfs:label>
        <skos:definition xml:lang="en">Optical property which describes the bending of light as it passes from one medium into another due to a change in the light’s speed.</skos:definition>
        <skos:definition xml:lang="de">Optische Eigenschaft, die die Ablenkung des Lichts beim Übergang von einem Medium in ein anderes aufgrund einer Änderung der Lichtgeschwindigkeit beschreibt.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000801 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000801">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000550"/>
        <rdfs:label xml:lang="de">Bestrahlen</rdfs:label>
        <rdfs:label xml:lang="en">irradiating</rdfs:label>
        <skos:definition xml:lang="en">A changing properties of material process that employs radiation exposure, to alter and enhance a material&apos;s physical or chemical attributes.</skos:definition>
        <skos:definition xml:lang="de">Ein Stoffeigenschaft Ändern Prozess, bei dem die physikalischen oder chemischen Eigenschaften eines Materials durch Bestrahlung verändert und verbessert werden.</skos:definition>
        <skos:example xml:lang="en">Polymer Curing</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000803 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000803">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Irradiationsgerät</rdfs:label>
        <rdfs:label xml:lang="en">irradiation device</rdfs:label>
        <skos:definition xml:lang="en">A device used for exposing materials to radiation to induce changes in their properties.</skos:definition>
        <skos:definition xml:lang="de">Ein Gerät zum Aussetzen von Materialien gegenüber Strahlung zur Induktion von Veränderungen ihrer Eigenschaften.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000805 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000805">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000801"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000079"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000803"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Irradiationsfunktion</rdfs:label>
        <rdfs:label xml:lang="en">irradiation function</rdfs:label>
        <skos:definition xml:lang="en">A function performed to expose materials to radiation for altering their properties.</skos:definition>
        <skos:definition xml:lang="de">Eine Funktion, die durchgeführt wird, um Materialien Strahlung auszusetzen, um deren Eigenschaften zu verändern.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000811 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000811">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Verbindungsgerät</rdfs:label>
        <rdfs:label xml:lang="en">joining device</rdfs:label>
        <skos:definition xml:lang="en">A general device used for joining materials through various methods, including welding and soldering.</skos:definition>
        <skos:definition xml:lang="de">Ein allgemeines Gerät zum Verbinden von Materialien durch verschiedene Methoden, einschließlich Schweißen und Löten.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000812 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000812">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020254"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020338"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000079"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000811"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Verbindungsfunktion</rdfs:label>
        <rdfs:label xml:lang="en">joining function</rdfs:label>
        <skos:definition xml:lang="en">A function performed to connect or bond materials together through various methods such as welding or soldering.</skos:definition>
        <skos:definition xml:lang="de">Eine Funktion, die ausgeführt wird, um Materialien durch verschiedene Methoden wie Schweißen oder Löten zu verbinden.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000826 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000826">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000550"/>
        <obo:IAO_0000119 xml:lang="de">https://industrylist.com/glossar/stoffeigenschaften-aendern/magnetisieren/</obo:IAO_0000119>
        <rdfs:label xml:lang="de">Magnetisieren</rdfs:label>
        <rdfs:label xml:lang="en">magnetizing</rdfs:label>
        <skos:definition xml:lang="en">A changing properties of material process in which ferromagnetic materials are exposed to an external magnetic field, causing the material to take on magnetic properties.</skos:definition>
        <skos:definition xml:lang="de">Ein Stoffeigenschaft Ändern Prozess, bei dem ferromagnetische Stoffe einem äußeren Magnetfeld ausgesetzt werden wodurch der Stoff magnetische Eigenschaften übernimmt.</skos:definition>
        <skos:example xml:lang="en">Static Magnetization, Pulse Magnetization.</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000827 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000827">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Magnetisierungsgerät</rdfs:label>
        <rdfs:label xml:lang="en">magnetizing device</rdfs:label>
        <skos:definition xml:lang="en">A device used for inducing a magnetic field in materials to alter their magnetic properties.</skos:definition>
        <skos:definition xml:lang="de">Ein Gerät zur Induktion eines Magnetfelds in Materialien, um deren magnetische Eigenschaften zu verändern.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000828 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000828">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000826"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000079"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000827"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Magnetisierungsfunktion</rdfs:label>
        <rdfs:label xml:lang="en">magnetizing function</rdfs:label>
        <skos:definition xml:lang="en">A function performed to induce a magnetic field in materials to modify their magnetic properties.</skos:definition>
        <skos:definition xml:lang="de">Eine Funktion, die durchgeführt wird, um ein Magnetfeld in Materialien zu induzieren, um deren magnetische Eigenschaften zu verändern.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000832 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000832">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000833"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Fertigungsfunktion</rdfs:label>
        <rdfs:label xml:lang="en">manufacturing function</rdfs:label>
        <skos:definition xml:lang="en">A function that inheres in devices or processes that are used to produce or assemble goods or components.</skos:definition>
        <skos:definition xml:lang="de">Eine Funktion, die in Geräten oder Prozessen besteht, die zur Herstellung oder Montage von Waren oder Komponenten verwendet werden.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000833 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000833">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/COB_0000035"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:unionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                                </owl:unionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/COB_0000035"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000293"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/OBI_0000299"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:comment xml:lang="en">Manufacturing processes alternate qualities of materials, i.e., a value specification of some quality of a material entity, which is a specified input to the process, cannot be the same as a value specification of the same quality of another material entity, which is a specified output of the process. 

Unfortunately it is not possible to write down such axiom based on OWL. Semi-working solution are the temporally qualified continuants + SPARQL constrains.</rdfs:comment>
        <rdfs:label xml:lang="de">Herstellungsprozess</rdfs:label>
        <rdfs:label xml:lang="en">manufacturing process</rdfs:label>
        <skos:definition xml:lang="en">A planned process that is driven by the primary intent to transform objects
A manufacturing process is always a transformative process.</skos:definition>
        <skos:definition xml:lang="de">Ein geplannter Prozess, der von der primären Absicht angetrieben wird, Objekte zu transformieren. Ein Herstellungsprozess ist immer ein Transformationsprozess.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000834 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000834">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000502"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">map</rdfs:label>
        <skos:definition xml:lang="en">A map is a 2D information content entity describing a representation of spatial data or relationships, often used in material science for visualizing properties or distributions.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000845 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000845">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0020001"/>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0020002"/>
        <rdfs:label xml:lang="en">matrix role</rdfs:label>
        <skos:definition xml:lang="en">Matrix is the role of a &apos;PortionOfConnectedMatter&apos; that implies to host the Filler.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000847 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000847">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020254"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Messfunktion</rdfs:label>
        <rdfs:label xml:lang="en">measuring function</rdfs:label>
        <skos:definition xml:lang="en">A function performed to determine the magnitude, quantity, or extent of a physical property or condition.</skos:definition>
        <skos:definition xml:lang="de">Eine Funktion, die durchgeführt wird, um das Ausmaß, die Menge oder den Zustand einer physikalischen Eigenschaft zu bestimmen.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000851 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000851">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020164"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Schmelzpunkt</rdfs:label>
        <rdfs:label xml:lang="en">melting point</rdfs:label>
        <skos:definition xml:lang="de">Der Schmelzpunkt ist eine Zustandsgrenze einer Materie, die durch den Übergang vom festen in den flüssigen Zustand (oder umgekehrt) entsteht.</skos:definition>
        <skos:definition xml:lang="en">The melting point is a state of matter boundary realized by transition form the solid state to the liquid state (or vice versa).</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000852 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000852">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000663"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                                        <owl:someValuesFrom>
                                            <owl:Class>
                                                <owl:intersectionOf rdf:parseType="Collection">
                                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/CHEBI_33521"/>
                                                    <owl:Restriction>
                                                        <owl:onProperty rdf:resource="https://w3id.org/pmd/co/PMD_0025998"/>
                                                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0050002"/>
                                                    </owl:Restriction>
                                                </owl:intersectionOf>
                                            </owl:Class>
                                        </owl:someValuesFrom>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000116 xml:lang="en">Classified by morphology.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">metal</rdfs:label>
        <skos:definition xml:lang="en">material characterized by high electrical and thermal conductivity, ductility, and metallic bonding</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000853 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000853">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023007"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020106"/>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">typically observed through crystallographic analysis</rdfs:comment>
        <rdfs:label xml:lang="en">crystallographic texture</rdfs:label>
        <rdfs:label xml:lang="de">kristallographische Textur</rdfs:label>
        <skos:definition xml:lang="en">an intensive quality describing the arrangement and orientation of grains in a polychrystal</skos:definition>
        <skos:definition xml:lang="de">eine intensive Qualität, die die Anordnung und Ausrichtung der Körner in einem Polykristall beschreibt</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000857 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000857">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
        <rdfs:comment xml:lang="en">The focus of interest when looking at an object through the microstructure perspective is often its morphology.</rdfs:comment>
        <rdfs:label xml:lang="en">microstructure</rdfs:label>
        <skos:definition xml:lang="en">A microstructure is a portion of matter that represents the small-scale structure of a material, including grains, phases, and defects, visible under a microscope.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000861 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000861">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000924"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">Mohs hardness</rdfs:label>
        <rdfs:label xml:lang="de">Mohshärte</rdfs:label>
        <skos:definition xml:lang="en">Scalar scratch hardness scale used to rank materials based on their ability to scratch one another.</skos:definition>
        <skos:definition xml:lang="de">Skalare Kratzhärteskala, mit der Materialien nach ihrer Fähigkeit, sich gegenseitig zu zerkratzen, eingestuft werden.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000877 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000877">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020265"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">optical property</rdfs:label>
        <rdfs:label xml:lang="de">optische Eigenschaft</rdfs:label>
        <skos:definition xml:lang="en">a property that is commonly associated with the domain of optics</skos:definition>
        <skos:example xml:lang="en">A camera lens has an optical capability of resolving 100 line pairs per mm at the image plane</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000882 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000882">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020313"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020136"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Phasengrenze (Realisierung)</rdfs:label>
        <rdfs:label xml:lang="en">phase boundary (realization)</rdfs:label>
        <skos:definition xml:lang="en">A phase boundary is a realizable entity that is realized by the transition between distinct phases.</skos:definition>
        <skos:definition xml:lang="de">Eine Phasengrenze ist eine realisierbare Einheit, die durch den Übergang zwischen verschiedenen Phasen realisiert wird.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000884 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000884">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000931"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">physical simulation</rdfs:label>
        <skos:definition xml:lang="en">A simulation method specification describing the use of computational or experimental methods to replicate physical behaviors or processes under defined conditions.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000885 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000885">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000834"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000853"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">pole figure</rdfs:label>
        <skos:definition xml:lang="en">A pole figure is a map depicting a 2D stereographic projection which represents crystallographic orientations of grains in a polycrystalline material in respect to the sample&apos;s reference frame.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000888 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000888">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000000"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0010033"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002353"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0010033"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000116 xml:lang="en">Classified by morphology.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">polymer</rdfs:label>
        <skos:definition xml:lang="en">A polymer is a material that consists of many repeated subunits (monomers) to form long chains. The atoms within a polymer chain are bonded together by covalent bonds. The intermolecular forces between polymer chains are typically represented by van der waals forces and hydrogen bonds.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000889 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000889">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000635"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Porenwachstum</rdfs:label>
        <rdfs:label xml:lang="en">pore growth</rdfs:label>
        <skos:definition xml:lang="en">Pore growth is an evolution of damage describing the process by which voids or pores in a material increase in size, often affecting its mechanical and physical properties.</skos:definition>
        <skos:definition xml:lang="de">Porenwachstum ist eine Schädigungsentwicklung, die den Prozess beschreibt, durch den Hohlräume oder Poren in einem Material an Größe zunehmen, was sich häufig auf dessen mechanische und physikalische Eigenschaften auswirkt.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000890 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000890">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <rdfs:label xml:lang="en">connected material entity aggregate</rdfs:label>
        <skos:definition xml:lang="en">An object aggregate that is a mereological sum of separate material entities, which adhere to one another through chemical bonds or physical junctions that go beyond gravity.</skos:definition>
        <skos:example xml:lang="en">the atoms of a molecule, the molecules forming the membrane of a cell, the epidermis in a human body</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000891 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000891">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000027"/>
        <rdfs:label xml:lang="en">disconnected material entity aggregate</rdfs:label>
        <skos:definition xml:lang="en">An object aggregate that is a mereological sum of scattered (i.e. spatially separated) material entities, which do not adhere to one another through chemical bonds or physical junctions but, instead, relate to one another merely on grounds of metric proximity. The material entities are separated from one another through space or through other material entities that do not belong to the group.</skos:definition>
        <skos:example xml:lang="en">a heap of stones, a colony of honeybees, a group of synapses, the trees of a forest, the canopy of a forest, the fish of a shoal, a group of commuters on the subway, the patients in a hospital</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000893 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000893">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000891"/>
        <rdfs:label xml:lang="en">powder</rdfs:label>
        <skos:definition xml:lang="en">A powder is a dry, solid disconnected material entity aggregate composed of many very fine particles. These particles can flow freely when shaken or tilted.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000896 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000896">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023043"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">The pressure is commonly measured in Pascals.</rdfs:comment>
        <rdfs:label xml:lang="de">Druck</rdfs:label>
        <rdfs:label xml:lang="en">pressure</rdfs:label>
        <skos:definition xml:lang="en">a quality describing the force exerted per unit area in or on a material.</skos:definition>
        <skos:definition xml:lang="de">eine intensive Qualität, die die Kraft beschreibt, die pro Flächeneinheit in oder auf ein Material ausgeübt wird.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000898 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000898">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000847"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Druckmessfunktion</rdfs:label>
        <rdfs:label xml:lang="en">pressure measuring function</rdfs:label>
        <skos:definition xml:lang="en">A measuring function performed to determine the pressure of gases or liquids.</skos:definition>
        <skos:definition xml:lang="de">Eine Messfunktion, um den Druck von Gasen oder Flüssigkeiten zu bestimmen.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000910 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000910">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000773"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Rückprallhärte</rdfs:label>
        <rdfs:label xml:lang="en">rebound hardness</rdfs:label>
        <skos:definition xml:lang="de">Die Rückprallhärte ist ein Maß für die Härte eines Materials und basiert auf der Rückprallhöhe eines Hammers, der auf das Material fällt.</skos:definition>
        <skos:definition xml:lang="en">The rebound hardness is representing a measure of a material&apos;s hardness based on the height of rebound of a hammer dropped on the material.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000911 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000911">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000877"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Reflexionsvermögen</rdfs:label>
        <rdfs:label xml:lang="en">reflectivity</rdfs:label>
        <skos:definition xml:lang="de">Das Reflexionsvermögen ist eine optische Eigenschaft, die den Anteil des einfallenden Lichts bzw. der Strahlung beschreibt, den ein Material reflektiert.</skos:definition>
        <skos:definition xml:lang="en">The reflectivity is an optical property that describes the proportion of incident light or radiation that a material reflects.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000924 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000924">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000773"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <obo:IAO_0000119>A measure of a material&apos;s resistance to deformation or scratching by a harder material.</obo:IAO_0000119>
        <rdfs:label xml:lang="de">Kratzhärte</rdfs:label>
        <rdfs:label xml:lang="en">scratch hardness</rdfs:label>
        <skos:definition xml:lang="de">Die Ritzhärte ist eine Härte, die ein Maß für den Widerstand eines Materials gegenüber Verformung oder Kratzern durch ein härteres Material darstellt.</skos:definition>
        <skos:definition xml:lang="en">The scratch hardness is a hardness representing a measure of a material&apos;s resistance to deformation or scratching by a harder material.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000927 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000927">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000833"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000592"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000833"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000055"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000592"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000119 xml:lang="en">Official definition can be found in: DIN 8580:2003-9 Fertigungsverfahren, Page 4, 3.1.3 Trennen - Definition</obo:IAO_0000119>
        <rdfs:label xml:lang="de">Trennen</rdfs:label>
        <rdfs:label xml:lang="en">separating</rdfs:label>
        <skos:definition xml:lang="en">A manufacturing process in which the bond between objects is broken, resulting in a partial or complete reduction in cohesion.</skos:definition>
        <skos:definition xml:lang="de">Ein Herstellungsprozess, bei dem die Bindung zwischen Objekten aufgehoben wird, was zu einer teilweisen oder vollständigen Verringerung der Kohäsion führt.</skos:definition>
        <skos:example xml:lang="en">Disassembling, Removal</skos:example>
        <PMD_0050117 xml:lang="en">Cutting</PMD_0050117>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000931 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/IAO_0000104"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">simulation method specification</rdfs:label>
        <skos:definition xml:lang="en">A plan specification that specifies the method of creating a computational or physical model to replicate the behavior of a material or system under specific conditions.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000939 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000939">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000812"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Lötfunktion</rdfs:label>
        <rdfs:label xml:lang="en">soldering function</rdfs:label>
        <skos:definition xml:lang="en">A soldering function is a joining function that is realized in connecting materials using solder.</skos:definition>
        <skos:definition xml:lang="de">Eine Unterfunktion des Verbindens, die durchgeführt wird, um Materialien durch Löttechniken zu verbinden.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000942 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000942">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000019"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000080"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000020"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000146"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">specific surface area</rdfs:label>
        <rdfs:label xml:lang="de">spezifische Oberfläche</rdfs:label>
        <skos:definition xml:lang="en">an intensive quality embodying the total surface area of a material per unit of mass or volume.</skos:definition>
        <skos:definition xml:lang="de">eine intensive Qualität, die die Gesamtoberfläche eines Materials pro Massen- oder Volumeneinheit verkörpert.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000946 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000946">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000501"/>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0000992"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">spectrum</rdfs:label>
        <skos:definition xml:lang="en">A spectrum is a 1-D information content entity that describes the range of wavelengths or frequencies of a physical property, often used in reference to light, sound, or electromagnetic radiation.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000947 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000947">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000506"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Schallgeschwindigkeit</rdfs:label>
        <rdfs:label xml:lang="en">speed of sound</rdfs:label>
        <skos:definition xml:lang="de">Die Schallgeschwindigkeit ist eine akustische Eigenschaft, die die Geschwindigkeit angibt, mit der sich Schallwellen durch ein Material ausbreiten, abhängig von seiner Dichte und seinen elastischen Eigenschaften.</skos:definition>
        <skos:definition xml:lang="en">The speed of sound is an acoustic property representing the rate at which sound waves travel through a material, dependent on its density and elastic properties.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000949 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000949">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020311"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020132"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020200"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <owl:disjointWith rdf:resource="https://w3id.org/pmd/co/PMD_0000952"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Steifigkeit</rdfs:label>
        <rdfs:label xml:lang="en">stiffness</rdfs:label>
        <skos:definition xml:lang="en">The stiffness is an object property describing the resistance of the object to deformation under an applied force.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000951 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000951">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000931"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">stochastic simulation</rdfs:label>
        <skos:definition xml:lang="en">A simulation method specification that incorporates random variables to model probabilistic systems or processes.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000952 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000952">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000015"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000117"/>
                                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020258"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000068"/>
                            </owl:Restriction>
                        </owl:unionOf>
                    </owl:Class>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000052"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000001"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020200"/>
                    </owl:Restriction>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002328"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0080019"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Festigkeit</rdfs:label>
        <rdfs:label xml:lang="en">strength</rdfs:label>
        <skos:definition xml:lang="en">is a material property describing the stress before a characteristic (failure-) event occurs.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000953 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000953">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000635"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">structural and chemical decay</rdfs:label>
        <rdfs:label xml:lang="de">struktureller und chemischer Zerfall</rdfs:label>
        <skos:definition xml:lang="de">Der strukturelle und chemische Zerfall ist eine Schädigungsentwicklung, die die Verschlechterung der Struktur und Zusammensetzung eines Materials im Laufe der Zeit aufgrund von Umwelt- oder Betriebsbedingungen beschreibt.</skos:definition>
        <skos:definition xml:lang="en">The structural and chemical decay is an evolution of damage describing the deterioration of a material&apos;s structure and composition over time due to environmental or operational conditions.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000955 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000955">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000654"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                        <owl:someValuesFrom>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                                        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000379"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:someValuesFrom>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000116 xml:lang="en">Classified by the role in a system.</obo:IAO_0000116>
        <rdfs:label xml:lang="en">structural material</rdfs:label>
        <skos:definition xml:lang="en">A structural material S is an functional material which has the function to be used for an object O (O consists of S) and O&apos;s function is primarily mechanical load carrying.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000957 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000957">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Struktur Eigenschaften Analyseverfahren</rdfs:label>
        <rdfs:label xml:lang="en">structural property analyzing process</rdfs:label>
        <skos:definition xml:lang="en">An assay that examines the external and internal structure and morphology of materials, including the arrangement of atoms, crystals, grains, and phases, often using techniques like microscopy and diffraction.</skos:definition>
        <skos:definition xml:lang="de">Eine Analyse, die die äußere und innere Struktur und Morphologie von Materialien untersucht, einschließlich der Anordnung von Atomen, Kristallen, Körnern und Phasen, oft unter Verwendung von Techniken wie Mikroskopie und Beugung.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000960 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000960">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000603"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Kalibrierungsgegenstandsrolle</rdfs:label>
        <rdfs:label xml:lang="en">subject of calibration role</rdfs:label>
        <skos:definition xml:lang="en">A device role that is being calibrated. The role is realized in a calibration process.</skos:definition>
        <skos:definition xml:lang="de">Rolle eines Gerätes (Kalibrierungsgegenstand), das kalibriert wird. Die Rolle wird ein einem Kalibrierungsprozess realisiert.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000961 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000961">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020164"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Sublimationspunkt</rdfs:label>
        <rdfs:label xml:lang="en">sublimation point</rdfs:label>
        <skos:definition xml:lang="de">Der Sublimationspunkt ist eine Zustandsgrenze der Materie, die durch den Übergang vom festen in den gasförmigen Zustand (oder umgekehrt) entsteht.</skos:definition>
        <skos:definition xml:lang="en">The sublimation point is a state of matter boundary realized by transition from the solid state to the gaseous state (or vice versa).</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000965 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000965">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000024"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000050"/>
                <owl:allValuesFrom>
                    <owl:Class>
                        <owl:unionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000027"/>
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                        </owl:unionOf>
                    </owl:Class>
                </owl:allValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Oberflächenschicht (Fiat-Objektteil)</rdfs:label>
        <rdfs:label xml:lang="en">surface layer (fiat object part)</rdfs:label>
        <skos:definition xml:lang="en">A surface layer (fiat object part) is a fiat object part that is part of only object. The surface layer is the three dimensional region defining the outermost layer of an object, where surface-interactions with other material entities occur. What is considered as the surface is thus defined by the interaction process.</skos:definition>
        <skos:definition xml:lang="de">Eine Oberflächenschicht (Fiat-Objektteil) ist ein Fiat-Objektteil, der nur Teil eines Objekts ist. Die Oberflächenschicht ist der dreidimensionale Bereich, der die äußerste Schicht eines Objekts definiert, wo Oberflächeninteraktionen mit anderen materiellen Einheiten stattfinden. Was als Oberfläche betrachtet wird, wird somit durch den Interaktionsprozess definiert.</skos:definition>
        <skos:example xml:lang="en">When considering optical properties of a surface layer (fiat object part) of a polished piece of metal we likely consider a different three dimensional spatial region than when considering the scratch hardness properties of the same polished piece of metal.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000967 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000967">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023043"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">The concept refers to an absolute temperature, not to be mistaken with temperature difference.</rdfs:comment>
        <rdfs:comment xml:lang="en">To express that an object has a temperature, the property &apos;intensive bearer of&apos; can be used. It implies a chain of: object consists of some portion of matter and portion of matter bearer of some temperature.</rdfs:comment>
        <rdfs:label xml:lang="de">Temperatur</rdfs:label>
        <rdfs:label xml:lang="en">temperature</rdfs:label>
        <skos:definition xml:lang="de">Die Temperatur ist eine grundlegende intensive Qualität, die die durchschnittliche atomare oder molekulare Bewegung oder Schwingung eines Teils der Materie darstellt.</skos:definition>
        <skos:definition xml:lang="en">The temperature is a fundamental intensive quality representing the average atomic or molcular movement or vibration of a portion of matter.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000968 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000968">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Temperaturänderungswerkzeug</rdfs:label>
        <rdfs:label xml:lang="en">temperature change device</rdfs:label>
        <skos:definition xml:lang="en">A device that is used for the alteration and adjustment of the temperature of a tangible object or the environment, e.g., a furnace and cooling media.</skos:definition>
        <skos:definition xml:lang="de">Diese Entität beschreibt allgemein jedes Werkzeug, das zur Änderung und Einstellung der Temperatur eines materiellen Objekts oder der Umgebung verwendet wird, z. B. einen Ofen und Kühlmittel.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000969 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000969">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020254"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000520"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000079"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000968"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Temperaturänderungsfunktion</rdfs:label>
        <rdfs:label xml:lang="en">temperature change function</rdfs:label>
        <skos:definition xml:lang="en">A function in heat treatment performed to induce changes in temperature to alter material properties.</skos:definition>
        <skos:definition xml:lang="de">Eine Unterfunktion der Wärmebehandlung, die durchgeführt wird, um Temperaturänderungen hervorzurufen, um die Materialeigenschaften zu verändern.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000971 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000971">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000847"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Temperaturmessfunktion</rdfs:label>
        <rdfs:label xml:lang="en">temperature measuring function</rdfs:label>
        <skos:definition xml:lang="en">A measuring function performed to determine the temperature of an object or environment.</skos:definition>
        <skos:definition xml:lang="de">Eine Messefunktion, die durchgeführt wird, um die Temperatur eines Objekts oder einer Umgebung zu bestimmen.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000972 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000972">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">temporal property</rdfs:label>
        <rdfs:label xml:lang="de">zeitliche Eigenschaft</rdfs:label>
        <skos:definition xml:lang="en">A temporal property is a material property that represents attributes related to the time-dependent behavior of a material or process.</skos:definition>
        <skos:definition xml:lang="de">Eine zeitliche Eigenschaft ist eine Materialeigenschaft, die Attribute darstellt, die sich auf das zeitabhängige Verhalten eines Materials oder Prozesses beziehen.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000976 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000976">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000034"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020255"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/OBI_0000070"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000079"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000602"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Testfunktion</rdfs:label>
        <rdfs:label xml:lang="en">testing function</rdfs:label>
        <skos:definition xml:lang="en">A function performed to assess or evaluate the properties, performance, or quality of materials or devices.</skos:definition>
        <skos:definition xml:lang="de">Eine Funktion, die durchgeführt wird, um die Eigenschaften, Leistung oder Qualität von Materialien oder Geräten zu bewerten.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000978 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000978">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Wärmeleitfähigkeit</rdfs:label>
        <rdfs:label xml:lang="en">thermal conductivity</rdfs:label>
        <skos:definition xml:lang="de">Die Wärmeleitfähigkeit ist eine thermische Eigenschaft, die die Fähigkeit eines Materials beschreibt, Wärme zu leiten.</skos:definition>
        <skos:definition xml:lang="en">The thermal conductivity is a thermal property describing the ability of a material to conduct heat.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000980 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000980">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000847"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Wärmeleitfähigkeitsmessfunktion</rdfs:label>
        <rdfs:label xml:lang="en">thermal conductivity measuring function</rdfs:label>
        <skos:definition xml:lang="en">A measuring function that inheres in devices used to measure the thermal conductivity of materials.</skos:definition>
        <skos:definition xml:lang="de">Eine Funktion, die in Geräten besteht, die zur Messung der Wärmeleitfähigkeit von Materialien verwendet werden.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000981 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000981">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000017"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020353"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000054"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000520"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">Necessary and sufficient conditions for &apos;thermal capability&apos; have not yet been formalized. The term is defined as a specific subtype of &apos;physical capability&apos;. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">thermal property</rdfs:label>
        <rdfs:label xml:lang="de">thermische Eigenschaft</rdfs:label>
        <skos:definition xml:lang="en">A thermal property is a material property representing attributes of a material that describe its behavior under temperature changes, such as thermal conductivity and expansion.</skos:definition>
        <skos:definition xml:lang="de">Eine thermische Eigenschaft ist eine Materialeigenschaft, die Attribute eines Materials darstellt, die sein Verhalten bei Temperaturänderungen beschreiben, wie z. B. Wärmeleitfähigkeit und Ausdehnung.</skos:definition>
        <skos:example xml:lang="en">Refractory bricks have a high thermal capability, withstanding furnace temperatures above 1600 C</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000992 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000992">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000501"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">time series</rdfs:label>
        <skos:definition xml:lang="en">A time series is a 1-D information content entity defined by a sequence of data points collected or recorded at successive time intervals, used for analyzing temporal properties or trends.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0000996 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0000996">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020164"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Tripelpunkt</rdfs:label>
        <rdfs:label xml:lang="en">triple point</rdfs:label>
        <skos:definition xml:lang="en">a state of matter boundary (point) realized by transition from the solid state to the liquid state or the the gaseous state (or vice versa).</skos:definition>
        <skos:definition xml:lang="de">eine Zustandsgrenze (Punkt) einer Materie, die durch den Übergang vom festen Zustand in den flüssigen Zustand oder den gasförmigen Zustand (oder umgekehrt) realisiert wird.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0001013 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0001013">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0000812"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Schweißfunktion</rdfs:label>
        <rdfs:label xml:lang="en">welding function</rdfs:label>
        <skos:definition xml:lang="en">A welding function is a joining function that is realized in fusing materials by welding.</skos:definition>
        <skos:definition xml:lang="de">Eine Unterfunktion des Verbindens, die durchgeführt wird, um Materialien durch Schweißtechniken zu verbinden.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0001998 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0001998">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0000602"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000085"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000592"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Joerg Waitelonis</obo:IAO_0000117>
        <rdfs:label xml:lang="en">cutting device</rdfs:label>
        <skos:definition xml:lang="en">A device designed to cut, slice, divide, or sever objects.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010020 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010020">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020140"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_33359"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020140"/>
        <rdfs:comment xml:lang="en">A Portion Of Matter that consists of only rhodium atoms.</rdfs:comment>
        <rdfs:label xml:lang="en">portion of rhodium</rdfs:label>
        <skos:definition xml:lang="en">A &apos;portion of rhodium&apos; is a &apos;portion of pure chemical element&apos; that &apos;consists of&apos; only chebi:rhodium atom.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010021 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010021">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020140"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/BFO_0000051"/>
                        <owl:allValuesFrom rdf:resource="http://purl.obolibrary.org/obo/CHEBI_30452"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020140"/>
        <rdfs:comment xml:lang="en">A Portion Of Matter that consists of only tellurium atoms.</rdfs:comment>
        <rdfs:label xml:lang="en">portion of tellurium</rdfs:label>
        <skos:definition xml:lang="en">A &apos;portion of tellurium&apos; is a &apos;portion of pure chemical element&apos; that &apos;consists of&apos; only chebi:tellurium atom.</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010033 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010033">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000015"/>
        <rdfs:label xml:lang="en">polymerization</rdfs:label>
        <skos:definition xml:lang="en">The chemical process of reacting monomers, oligomers, or reactive precursors together to form longer macromolecular chains or three-dimensional networks</skos:definition>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010100 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010100">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0090000"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                        <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                        <owl:onClass>
                            <owl:Class>
                                <owl:intersectionOf rdf:parseType="Collection">
                                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020140"/>
                                    <owl:Restriction>
                                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000091"/>
                                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0090001"/>
                                    </owl:Restriction>
                                </owl:intersectionOf>
                            </owl:Class>
                        </owl:onClass>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0090000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0020140"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000091"/>
                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0090001"/>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:qualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">1</owl:qualifiedCardinality>
                <owl:onClass rdf:resource="https://w3id.org/pmd/co/PMD_0020140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">elemental semiconductor</rdfs:label>
        <skos:comment>Primarily includes group 14 elements like Silicon, Carbon, Germanium, Tin but also Selenium (group 16) and Boron (group 13).</skos:comment>
        <skos:definition xml:lang="en">semiconductor that shows semiconductive behavior as a pure element</skos:definition>
        <skos:example>Silicon, Carbon, Germanium, alpha-Tin</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0010101 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0010101">
        <owl:equivalentClass>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="https://w3id.org/pmd/co/PMD_0090000"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                        <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                        <owl:onClass rdf:resource="https://w3id.org/pmd/co/PMD_0020140"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </owl:equivalentClass>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0090000"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0020140"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">compound semiconductor</rdfs:label>
        <skos:altLabel>alloy semiconductor</skos:altLabel>
        <skos:definition xml:lang="en">semiconductor which is composed of two or more pure elements</skos:definition>
        <skos:example>boron nitride (BN), gallium arsenide (GaAs), aluminium gallium arsenide (AlGaAs), indium gallium nitride (InGaN)</skos:example>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020000 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020000">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000040"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000053"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000553"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">phase (thermodynamic)</rdfs:label>
        <skos:definition xml:lang="en">A thermodynamic phase is a material entity that forms a homogeneous portion of matter within a thermodynamic system and is characterized by uniform thermodynamic properties.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020001 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020001">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0023004"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">filler role</rdfs:label>
        <skos:definition xml:lang="en">role of a &apos;PortionOfDisconnectedMatter&apos; that implies being hosted in a matrix.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020002 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020002">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020317"/>
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0020335"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000081"/>
                <owl:someValuesFrom>
                    <owl:Class>
                        <owl:intersectionOf rdf:parseType="Collection">
                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000030"/>
                            <owl:Restriction>
                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0001025"/>
                                <owl:someValuesFrom>
                                    <owl:Class>
                                        <owl:intersectionOf rdf:parseType="Collection">
                                            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/BFO_0000040"/>
                                            <owl:Restriction>
                                                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000087"/>
                                                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000845"/>
                                            </owl:Restriction>
                                        </owl:intersectionOf>
                                    </owl:Class>
                                </owl:someValuesFrom>
                            </owl:Restriction>
                        </owl:intersectionOf>
                    </owl:Class>
                </owl:someValuesFrom>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:label xml:lang="en">precipitate role</rdfs:label>
        <skos:definition xml:lang="en">Precipitate is the role of a portion of matter that implies being hosted in a matrix and the Precipitate derives from the matrix or the Precipitate derives from the thing that the matrix derives from.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020003 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020003">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/BFO_0000030"/>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0000086"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0000591"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">crystal</rdfs:label>
        <skos:definition xml:lang="en">A crystal is an object that has a quality &quot;crystal structure&quot;.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020004 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020004">
        <rdfs:subClassOf>
            <owl:Class>
                <owl:intersectionOf rdf:parseType="Collection">
                    <rdf:Description rdf:about="http://purl.obolibrary.org/obo/IAO_0000027"/>
                    <owl:Restriction>
                        <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000136"/>
                        <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0025001"/>
                    </owl:Restriction>
                </owl:intersectionOf>
            </owl:Class>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://purl.obolibrary.org/obo/RO_0002351"/>
                <owl:someValuesFrom rdf:resource="https://w3id.org/pmd/co/PMD_0025997"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000116 xml:lang="en">See editior note of composition to underatand the difference between composition and chemical composition data items.

To understand the difference between the composition and the composition data item, one has to understand the difference between SDCs and GDCs in BFO. A triple &quot;material entity has quality compsition&quot;, conveys the fact such quality exists without telling us what are fractions of compounds in this material entity. A triple &quot;compostion is subject of composition data item&quot; conveys that there&apos;s an information about values of these fractions. Think of comosition data item as a pdf where the composition is documented.</obo:IAO_0000116>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:comment xml:lang="en">These portions of other matters do not have to be portions of specific chemical elements, i.e., atomic composition, but rather portions of other substances, such as nitric acid and water.</rdfs:comment>
        <rdfs:label xml:lang="en">composition data item</rdfs:label>
        <skos:altLabel xml:lang="en">composition specification</skos:altLabel>
        <skos:definition xml:lang="de">Bei einem Zusammensetzungsdatenelement handelt es sich um eine Informationsinhaltseinheit, die sich mit der Zusammensetzung einer materiellen Einheit befasst. Es verfügt über Bruchwertspezifikationen für Mitglieder, die Werte von Anteilen von Verbindungen angeben, die Teile der materiellen Einheit sind.</skos:definition>
        <skos:definition xml:lang="en">Composition data entity is an information content entity that is about composition of a material enity. It has members fraction value specifications which specifiy values of propotions of compounds, which are parts of the material enity.</skos:definition>
        <skos:example xml:lang="en">Nitric acid solution has quality  composition, and  the composition data item is about this composition.The composition data item has members fraction specifications of nitric acid, e.g., 4 vol.%, and distilled water. These fraction specifications specify value of pure substances of nitric acid and distilled water, respectively. Furthermore, these fraction specifications specify values of relational qualities (volume) proportion of nitric acid and (volume) proportion of distilled water.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020023 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020023">
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="en">OBSOLETE metallic grain structures</rdfs:label>
        <rdfs:label xml:lang="de">metallische Kornstrukturen</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
        <skos:definition xml:lang="de">Bei der metallischen Kornstruktur handelt es sich um eine kategoriale Wertspezifikation, die den Wert der Qualität der metallischen Kornstruktur angibt. Es beschreibt die Morphologie polykristalliner metallischer Werkstoffe. Polykristalline metallische Materialien bilden ihre Kornstrukturen typischerweise als eine dieser Kategorien oder als Übergangs- oder Mischungszustand davon aus.</skos:definition>
        <skos:definition xml:lang="en">The metallic grain structures is a categorical value specification that specifies value of the  metallic grain structure quality. It describes the morphology of polycrystalline metallic materials. Polycrystalline metallic materials will typically form their grain structures as one of those categories or a transition or mixture state of those.</skos:definition>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


    <!-- https://w3id.org/pmd/co/PMD_0020024 -->

    <owl:Class rdf:about="https://w3id.org/pmd/co/PMD_0020024">
        <rdfs:subClassOf rdf:resource="https://w3id.org/pmd/co/PMD_0050000"/>
        <obo:IAO_0000114 rdf:resource="http://purl.obolibrary.org/obo/IAO_0000122"/>
        <obo:IAO_0000117>PERSON: Philipp von Hartrott</obo:IAO_0000117>
        <rdfs:label xml:lang="de">Wasserstoffbindung</rdfs:label>
        <rdfs:label xml:lang="en">hydrogen bond</rdfs:label>
        <skos:definition xml:lang="en">A hydrogen bond is a bond that binds one molecule’s hydrogen atom with the electronegative atoms of another molecule.</skos:definition>
        <skos:definition xml:lang="de">Eine Wasserstoffbindung ist eine Bindung, die das Wasserstoffatom eines Moleküls mit den elektronegativen Atomen eines anderen Moleküls verbindet.</skos:definition>
        <skos:example xml:lang="en">The bond that forms between liquid water molecules at one molecules hydrogen ends and the other molecules oxygen end.</skos:example>
        <PMD_0000060 rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</PMD_0000060>
    </owl:Class>
    


