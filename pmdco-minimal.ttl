###  https://w3id.org/pmd/co/PMD_0020098
co:PMD_0020098 rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000031 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
               rdfs:label "Naturkonstante"@de ,
                          "nature constant"@en ;
               skos:definition "A nature constant is a generically dependent continuant whose value, maginitude or configuration is determined by nature including physics and mathematics."@en ,
                               "Eine Naturkonstante ist ein generisch abhängiger Kontinuant, dessen Wert, Größe oder Konfiguration durch die Natur, einschließlich Physik und Mathematik, bestimmt wird."@de ;
               skos:example "Examples of nature constants are the speed of light, pi, etc."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0020099
co:PMD_0020099 rdf:type owl:Class ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
               rdfs:comment """TODO: possibly extend for 2D (Graphene etc)

More elaborate crystal descriptions may be found in http://emmo.info/domain-crystallography/crystallography or https://purls.helmholtz-metadaten.de/disos/cso"""@en ;
               rdfs:label "Bravais-Gitter (3D)"@de ,
                          "OBSOLETE bravais lattice (3D)"@en ;
               owl:deprecated "true"^^xsd:boolean ;
               skos:definition "Das Bravais-Gitter ist eine kategoriale Wertspezifikation, die den Wert der Kristallstrukturqualität angibt. Es beschreibt die mögliche geometrische Anordnung von Gitterpunkten in einem Kristall. Der vorliegende Deskriptor beschränkt sich auf die 14 möglichen dreidimensionalen Anordnungen."@de ,
                               "The bravais lattice is a categorical value specification that specifies value of the crystal structure quality. It describes the possible geometric arrangement of lattice points in a crystal. The present descriptor is limited to the 14 possible three-dimensional arrangements."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0020101
co:PMD_0020101 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0002328 ;
                                 owl:someValuesFrom obo:BFO_0000001
                               ] ;
               obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
               rdfs:label "Anteil"@de ,
                          "proportion"@en ;
               skos:definition "A proportion is a relational quality between two entities (the whole and the part) which quantifies the relation between the whole and its part."@en .


###  https://w3id.org/pmd/co/PMD_0020102
co:PMD_0020102 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080069 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'mass ratio' have not yet been formalized. The term is defined as a specific subtype of 'material composition'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
               rdfs:label "Massenverhältnis"@de ,
                          "mass ratio"@en ;
               skos:definition "Das Massenverhältnis bezeichnet eine relationale Qualität, die einen Massenwert im Verhältnis zu einem anderen ausdrückt und typischerweise eine dimensionslose Zahl ergibt"@de ,
                               "Mass ratio denotes a relational quality expressing one mass value relative to another, typically producing a dimensionless number"@en ;
               skos:example "A fiber-reinforced composite has a fiber-to-matrix mass ratio of 60:40"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0020103
co:PMD_0020103 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080069 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
               rdfs:label "Molverhältnis"@de ,
                          "molar ratio"@en ;
               skos:altLabel "molar proportion"@en ;
               skos:definition "Der Molanteil ist der Anteil, der die Anzahl der Einheiten des Teils im Verhältnis zur Anzahl der Einheiten des Ganzen quantifiziert."@de ,
                               "Molar proportion is the proportion which quantifies the entities count of the part in relation to the entities count of the whole."@en ;
               skos:example """The molar ratio of hydrogen gas H2 molecules to water H2O molecules is 1/1 in the oxyhydrogen reaction. The molar ratio of oxygen molecules O2 to water molecules is 2/1.
The molar ratio of carbon dioxide to average atmosphere air is 420 ppm as of 2022 AD."""@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0020104
co:PMD_0020104 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080069 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'volume ratio' have not yet been formalized. The term is defined as a specific subtype of 'material composition'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
               rdfs:label "Volumenverhältnis"@de ,
                          "volume ratio"@en ;
               skos:definition "Volume ratio represents a relational quality expressing one volume value relative to another, typically resulting in a dimensionless number"@en ,
                               "Volumenverhältnis stellt eine relationale Qualität dar, die einen Volumenwert im Verhältnis zu einem anderen ausdrückt, typischerweise resultierend in einer dimensionslosen Zahl"@de ;
               skos:example "A foam material has a pore-to-solid volume ratio of 4:1, indicating 80 % porosity"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0020106
co:PMD_0020106 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000890 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:BFO_0000051 ;
                                 owl:someValuesFrom co:PMD_0000663
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
               rdfs:label "polycrystal"@en ;
               skos:altLabel "Polycrystalline structure"@en ;
               skos:definition "A polycrystal is a connected material entity aggregate that consists of multiple crystal grains joined through crystallographic interfaces."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0020112
co:PMD_0020112 rdf:type owl:Class ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
               obo:IAO_0100001 obo:STATO_0000225 ;
               rdfs:label "Korngrößenverteilung"@de ,
                          "OBSOLETE grain size distribution"@en ;
               owl:deprecated "true"^^xsd:boolean ;
               skos:definition "An intensive quality describing the lower length scale object aggregate (grains) that is part of the material."@en ,
                               "Eine intensive Qualität, die das Objektaggregat (Körner) auf niedrigerer Längenskala beschreibt, das Teil des Materials ist."@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0020113
co:PMD_0020113 rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000030
                                                          [ rdf:type owl:Class ;
                                                            owl:unionOf ( co:PMD_0020289
                                                                          co:PMD_0020290
                                                                        )
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf obo:BFO_0000030 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
               rdfs:label "fluid (object)"@en ;
               skos:definition "Fluid (object) is an object that consists of some portion of matter which bears an aggregate state that concretizes a liquid or gaseous aggregate state."@en .


###  https://w3id.org/pmd/co/PMD_0020115
co:PMD_0020115 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000891 ;
               rdfs:label "aerosol"@en ;
               skos:definition """An aerosol is a disconnected material entity aggregate which:
1. consists of some portion of matter whose aggregate state quality concretizes gaseous and 
2. consists of some portion of matter whose aggregate state quality concretises solid or liquid (TODO: express that this portion is also a disconnected material entity aggregate)"""@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0020126
co:PMD_0020126 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000890 ;
               obo:IAO_0000119 """old defintion: A foam is a material entity aggregate that is also a composite material c. 
The parts of c that have the filler role are vacuum-filled or gas filled pores. 
The parts of c that have the matrix role consist of a material that is bearer of solid or liquid aggregate state. 
One pore with its surrounding matrix is called 'cell'. 
Depending on the interconnectedness of the pores the foam is open- or closed-cell.""" ;
               rdfs:label "foam"@en ;
               skos:definition "A foam is a connected material entity aggregate that consists of a solid or liquid matrix containing gas-filled or vacuum-filled pores forming cellular structures."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0020128
co:PMD_0020128 rdf:type owl:Class ;
               owl:equivalentClass [ owl:intersectionOf ( obo:BFO_0000040
                                                          [ rdf:type owl:Restriction ;
                                                            owl:onProperty obo:RO_0000053 ;
                                                            owl:someValuesFrom co:PMD_0020313
                                                          ]
                                                        ) ;
                                     rdf:type owl:Class
                                   ] ;
               rdfs:subClassOf obo:BFO_0000040 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0000053 ;
                                 owl:someValuesFrom co:PMD_0020313
                               ] ;
               rdfs:label "thermodynamic system"@en ;
               skos:definition "A thermodynamic system is a material entity whose parts are bearer of thermodynamic properties. A thermodynamic system environs a thermodynamic process by which the thermodynamic properties of the objects of the thermodynamic system change over time."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0020129
co:PMD_0020129 rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000015 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
               rdfs:label "reversible process"@en ,
                          "reversibler Prozess"@de ;
               skos:definition "A reversible process is a process whose participants form a thermodynamic system with an entropy S and S remains constant during the process."@en ,
                               "Ein reversibler Prozess ist ein Prozess, dessen Teilnehmer ein thermodynamisches System mit einer Entropie S bilden und S während des Prozesses konstant bleibt."@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0020132
co:PMD_0020132 rdf:type owl:Class ;
               rdfs:subClassOf [ owl:intersectionOf ( obo:BFO_0000019
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0000080 ;
                                                        owl:someValuesFrom [ rdf:type owl:Class ;
                                                                             owl:unionOf ( obo:BFO_0000024
                                                                                           obo:BFO_0000027
                                                                                           obo:BFO_0000029
                                                                                           obo:BFO_0000030
                                                                                           obo:BFO_0000140
                                                                                         )
                                                                           ]
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Philipp von Hartrott" ;
               rdfs:label "spatial extend"@en ;
               skos:definition "Dimension quality is a quality of a material entity that pertains to its measurable spatial extent, such as length, area, or volume"@en ;
               skos:example "the wall thickness of a steel pipe is a dimension quality functionally related to its pressure resistance"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0020133
co:PMD_0020133 rdf:type owl:Class ;
