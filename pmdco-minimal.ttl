               skos:altLabel "Dielektrische Festigkeit"@de ,
                             "E_ds"@en ;
               skos:definition "Dielectric strength is an electrical quality of an insulating material that specifies the maximum electric field intensity the material can sustain without undergoing electrical breakdown"@en ,
                               "Durchschlagsfestigkeit ist eine elektrische Qualität eines Isoliermaterials, die die maximale elektrische Feldstärke angibt, die das Material aushalten kann, ohne einen elektrischen Durchschlag zu erleiden"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080025
co:PMD_0080025 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'magnetic flux' have not yet been formalized. The term is defined as a specific subtype of 'magnetic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "magnetic flux"@en ,
                          "magnetischer Fluss"@de ;
               skos:altLabel "Magnetfeld"@de ,
                             "magnetic field"@en ,
                             "magnetic flux"@en ,
                             "magnetischer Fluss"@de ;
               skos:definition "Magnetischer Fluss ist die Gesamtanzahl der Magnetfeldlinien, die durch eine bestimmte Fläche verlaufen"@de ,
                               "magnetic quality that represents the total number of magnetic field lines passing through a given area"@en ;
               skos:example "A transformer core carries a magnetic flux of 1 mWb through its cross-section at rated voltage"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080026
co:PMD_0080026 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'magnetic permeability' have not yet been formalized. The term is defined as a specific subtype of 'magnetic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "magnetic permeability"@en ,
                          "magnetische Permeabilität"@de ;
               skos:altLabel "Permeabilität"@de ,
                             "permeability"@en ,
                             "μ"@en ;
               skos:definition "Magnetic permeability is a magnetic quality of a material that quantifies its ability to support the formation of a magnetic field within itself, expressed as the ratio of magnetic flux density to the applied magnetic field intensity"@en ,
                               "Magnetische Permeabilität ist eine magnetische Qualität eines Materials, die seine Fähigkeit quantifiziert, ein Magnetfeld in seinem Inneren zu unterstützen, ausgedrückt als Verhältnis der magnetischen Flussdichte zur aufgebrachten magnetischen Feldstärke"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080027
co:PMD_0080027 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'coercivity' have not yet been formalized. The term is defined as a specific subtype of 'magnetic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Koerzitivfeldstärke"@de ,
                          "coercivity"@en ;
               skos:altLabel "H_c"@en ,
                             "Koerzitivkraft"@de ,
                             "coercive field"@en ,
                             "coercive force"@en ;
               skos:definition "Coercivity is a magnetic quality of a ferromagnetic material that specifies the magnitude of the applied magnetic field required to reduce its magnetization to zero after it has been fully magnetised"@en ,
                               "Koerzitivfeldstärke ist eine magnetische Qualität eines ferromagnetischen Materials, die die Stärke des aufzubringenden Magnetfelds angibt, das erforderlich ist, um seine Magnetisierung nach vollständiger Magnetisierung auf null zu reduzieren"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080029
co:PMD_0080029 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020311 ,
                               co:PMD_0023004 ,
                               [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0000052 ;
                                                        owl:someValuesFrom co:PMD_0000001
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0002328 ;
                                                        owl:someValuesFrom co:PMD_0020132
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Dehnung"@de ,
                          "strain"@en ;
               skos:definition "Strain is defined as relative deformation, compared to a reference position configuration"@en ;
               skos:example "Under a tensile load, a polymer film exhibits a strain of 2 % before yielding"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080030
co:PMD_0080030 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080029 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'engineering strain' have not yet been formalized. The term is defined as a specific subtype of 'strain'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Strain_(mechanics)."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Strain_(mechanics)> ;
               rdfs:label "engineering strain"@en ,
                          "technische Dehnung"@de ;
               skos:altLabel "Cauchy strain"@en ,
                             "technical strain"@en ;
               skos:definition "Die technische Dehnung oder Cauchy-Dehnung drückt die Gesamtverformung relativ zur ursprünglichen Abmessung des Materials unter Last aus und spiegelt die Dehnung bei axialer Belastung wider"@de ,
                               "Engineering strain, or Cauchy strain, expresses total deformation relative to the initial dimension of the material under load, reflecting elongation in axial loading"@en ;
               skos:example "A tensile specimen elongates from 50 mm to 55 mm gauge length, giving an engineering strain of 10 %"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080032
co:PMD_0080032 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080029 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'true strain' have not yet been formalized. The term is defined as a specific subtype of 'strain'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Strain_(mechanics)."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Strain_(mechanics)> ;
               rdfs:label "true strain"@en ,
                          "wahre Dehnung"@de ;
               skos:altLabel "Hencky strain"@en ,
                             "logarithmic strain"@en ;
               skos:definition "True strain, or logarithmic strain, integrates incrementally over deformation; related to engineering strain as ε=ln(1+e)"@en ,
                               "Wahre Dehnung, auch als logarithmische Dehnung bekannt, integriert sich schrittweise über die Verformung; in Beziehung zum technischen Dehnungsmaß als ε=ln(1+e)"@de ;
               skos:example "At a cross-section reduction of 50 %, the true strain is ln(2) = 0.693"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080033
co:PMD_0080033 rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000017 ,
                               co:PMD_0020335 ,
                               co:PMD_0023004 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:BFO_0000054 ;
                                 owl:someValuesFrom co:PMD_0020339
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0000052 ;
                                 owl:someValuesFrom co:PMD_0000001
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "StrainAtBreak(x) ↔ Strain(x) ∧ ∃b∃p∃i(obo:BFO_0000040(b) ∧ MeasurementProcess(p) ∧ MeasurementInformationContentEntity(i) ∧ bearerOf(b, x) ∧ describes(i, x) ∧ isOutputOf(i, p) ∧ ∃t(TimeOfBreak(t) ∧ occupiesTemporalRegion(p, t)))"@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Bruchdehnung"@de ,
                          "strain at break"@en ;
               skos:altLabel "elongation at break"@en ;
               skos:definition "Bruchdehnung ist die Dehnung einer Probe im Moment des Bruchs, bestimmt unter Zugbelastung gemäß anwendbaren Prüfnormen"@de ,
                               "Strain at break is the strain of a specimen at the moment of fracture, determined under tensile load according to applicable test standards"@en ;
               skos:example "Strain at break of a thermoplastic polyurethane specimen measured as 450% under ISO 527 test conditions."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080034
co:PMD_0080034 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080029 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'elastic strain' have not yet been formalized. The term is defined as a specific subtype of 'strain'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Plasticity_(physics)."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Plasticity_(physics)> ;
               rdfs:label "elastic strain"@en ,
                          "elastische Deformation"@de ;
               skos:altLabel "elastic deformation"@en ,
                             "elastische Verformung"@de ;
               skos:definition "Bei der elastischen Dehnung handelt es sich um eine Dehnungsqualität eines Materialgebildes, die durch eine reversible Verformung gekennzeichnet ist, die bei Wegnahme der aufgebrachten Last verschwindet"@de ,
                               "Elastic strain is a strain quality of a material entity characterized by reversible deformation that disappears upon removal of the applied load"@en ;
               skos:example "Steel loaded to 200 MPa exhibits an elastic strain of about 0.001, fully recovered upon unloading"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080035
co:PMD_0080035 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080029 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'plastic strain' have not yet been formalized. The term is defined as a specific subtype of 'strain'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Plasticity_(physics)."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Plasticity_(physics)> ;
               rdfs:label "plastic strain"@en ,
                          "plastische Deformation"@de ;
               skos:altLabel "plastic deformation"@en ,
                             "plastische Verformung"@de ;
               skos:definition "Plastic strain describes permanent deformation occurring when a material is subjected to stress beyond its elastic limit"@en ,
                               "Plastische Deformation beschreibt die dauerhafte Verformung, die auftritt, wenn ein Material einer Belastung ausgesetzt wird, die über seine elastische Grenze hinausgeht"@de ;
               skos:example "After exceeding yield strength, a steel rod undergoes 5 % plastic strain that remains after unloading"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080036
co:PMD_0080036 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000008 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'luminous intensity' have not yet been formalized. The term is defined as a specific subtype of 'optical quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Lichtstärke in cd gemessen"@de ,
                          "luminous intensity"@en ;
               skos:altLabel "Leuchtintensität"@de ,
                             "Lichtintensität"@de ,
                             "luminous intensity"@en ;
               skos:definition "Lichtstärke ist die Menge des sichtbaren Lichts, das pro Einheitswinkel in eine bestimmte Richtung von einer Quelle abgestrahlt wird, gemessen in Candela (cd)"@de ,
                               "Luminous intensity quantifies the visible light emitted per unit solid angle in a particular direction from a source, measured in candela (cd)"@en ;
               skos:example "A standard LED lamp emits a luminous intensity of 800 cd in the forward direction"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080037
co:PMD_0080037 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000143 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'exposure' have not yet been formalized. The term is defined as a specific subtype of 'optical quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Exposure_(photography)."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Exposure_(photography)> ;
               rdfs:label "Belichtungszeit"@de ,
                          "light exposure"@en ;
               skos:definition "Exposure in photography refers to the amount of light per unit area reaching film or sensor, determined by shutter speed, lens F-number, and scene luminance"@en ,
                               "Unter Belichtung versteht man in der Fotografie die Lichtmenge pro Flächeneinheit, die den Film oder Sensor erreicht, bestimmt durch Verschlusszeit, Blendenzahl des Objektivs und Helligkeit der Szene"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080038
co:PMD_0080038 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'Curie temperature' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Curie temperature"@en ,
                          "Curie-Temperatur"@de ;
               skos:altLabel "Curie point"@en ,
                             "Curie-Punkt"@de ,
                             "T_C"@en ;
               skos:definition "Curie temperature is a thermodynamic quality of a ferromagnetic material that specifies the temperature above which it loses its permanent magnetic ordering and becomes paramagnetic"@en ,
                               "Curie-Temperatur ist eine thermodynamische Qualität eines ferromagnetischen Materials, die die Temperatur angibt, oberhalb derer das Material seine permanente magnetische Ordnung verliert und paramagnetisch wird"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080039
co:PMD_0080039 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020313 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'specific heat capacity' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "specific heat capacity"@en ,
                          "spezifische Wärmekapazität"@de ;
               skos:definition "Specific heat capacity is the heat capacity of a sample divided by its mass, representing the heat required to raise temperature by one unit"@en ,
                               "Spezifische Wärmekapazität ist die Wärmekapazität einer Probe geteilt durch ihre Masse und repräsentiert die erforderliche Wärme, um die Temperatur um eine Einheit zu erhöhen"@de ;
               skos:example "Water has a specific heat capacity of 4182 J/(kg·K), making it an effective coolant"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080040
co:PMD_0080040 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020164 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'eutectic point' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "eutectic point"@en ,
                          "eutektischer Punkt"@de ;
               skos:altLabel "eutectic temperature"@en ,
                             "eutektische Temperatur"@de ;
               skos:definition "Eutectic point is a thermodynamic quality of a multi-component material system that specifies the composition and temperature at which all components simultaneously solidify from a liquid mixture at the lowest possible melting temperature"@en ,
                               "Eutektischer Punkt ist eine thermodynamische Qualität eines Mehrkomponentenmaterialsystems, die die Zusammensetzung und Temperatur angibt, bei der alle Komponenten gleichzeitig aus einer flüssigen Mischung bei der niedrigstmöglichen Schmelztemperatur erstarren"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080041
co:PMD_0080041 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'critical pressure' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "critical pressure"@en ,
                          "kritischer Druck"@de ;
               skos:altLabel "p_c"@en ;
               skos:definition "Critical pressure is a thermodynamic quality of a pure substance that specifies the minimum pressure required to liquefy the substance at its critical temperature"@en ,
                               "Kritischer Druck ist eine thermodynamische Qualität einer reinen Substanz, die den Mindestdruck angibt, der erforderlich ist, um die Substanz bei ihrer kritischen Temperatur zu verflüssigen"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080042
co:PMD_0080042 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'critical temperature' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "critical temperature"@en ,
                          "kritische Temperatur"@de ;
               skos:altLabel "T_c"@en ;
               skos:definition "Critical temperature is a thermodynamic quality of a pure substance that specifies the temperature above which the substance cannot exist as a liquid regardless of applied pressure"@en ,
                               "Kritische Temperatur ist eine thermodynamische Qualität einer reinen Substanz, die die Temperatur angibt, oberhalb derer die Substanz unabhängig vom aufgebrachten Druck nicht als Flüssigkeit existieren kann"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080045
co:PMD_0080045 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'environmental temperature' have not yet been formalized. The term is defined as a specific subtype of 'temperature'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Umgebungstemperatur"@de ,
                          "environmental temperature"@en ;
               skos:definition "Environmental temperature describes the observed temperature surrounding a tangible object, including room temperature and temperatures measured in test chambers"@en ,
                               "Umgebungstemperatur ist die Eigenschaft, die die beobachtete Temperatur in der Umgebung eines betrachteten materiellen Objekts beschreibt. Dazu gehören Raumtemperatur und die in Prüfkammern gemessenen Temperaturen"@de ;
               skos:example "A circuit board operates at an environmental temperature of 85 C in a high-reliability application"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080046
co:PMD_0080046 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'vapor pressure' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Dampfdruck"@de ,
                          "vapor pressure"@en ;
               skos:altLabel "p*"@en ;
               skos:definition "Dampfdruck ist eine thermodynamische Qualität eines Stoffes, die den Druck angibt, den sein Dampf ausübt, wenn er sich bei einer gegebenen Temperatur im thermodynamischen Gleichgewicht mit seiner kondensierten Phase befindet"@de ,
                               "Vapor pressure is a thermodynamic quality of a substance that specifies the pressure exerted by its vapor when in thermodynamic equilibrium with its condensed phase at a given temperature"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080047
co:PMD_0080047 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'flash point' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Flammpunkt"@de ,
                          "flash point"@en ;
               skos:definition "Flammpunkt ist eine thermodynamische Qualität eines flüchtigen Materials, die die niedrigste Temperatur angibt, bei der sein Dampf an der Materialoberfläche ein zündfähiges Gemisch mit Luft bildet"@de ,
                               "Flash point is a thermodynamic quality of a volatile material that specifies the lowest temperature at which its vapour forms an ignitable mixture with air near the surface of the material"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080048
co:PMD_0080048 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'ductile-brittle transition temperature' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Duktil-Spröd-Übergangstemperatur"@de ,
                          "ductile-brittle transition temperature"@en ;
               skos:altLabel "Nullduktilitäts-Übergangstemperatur"@de ,
                             "T_DBTT"@en ,
                             "nil ductility transition temperature"@en ;
               skos:definition "Ductile-brittle transition temperature is a thermodynamic quality of a material that specifies the temperature below which the material exhibits brittle fracture behaviour rather than ductile deformation under impact loading"@en ,
                               "Duktil-Spröd-Übergangstemperatur ist eine thermodynamische Qualität eines Materials, die die Temperatur angibt, unterhalb derer das Material unter Schlagbelastung ein sprödes Bruchverhalten anstelle einer duktilen Verformung zeigt"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080049
co:PMD_0080049 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080048 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'glass transition temperature' have not yet been formalized. The term is defined as a specific subtype of 'ductile-brittle transition temperature' specific to amorphous and semi-crystalline materials. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Glass_transition."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Glass_transition> ;
               rdfs:label "Glasübergangstemperatur"@de ,
                          "glass transition temperature"@en ;
               skos:altLabel "Tg"@en ;
               skos:definition "Glass transition temperature is a ductile-brittle transition temperature of an amorphous or semi-crystalline material that specifies the temperature at which the material transitions from a hard, glassy state to a soft, rubbery state upon heating"@en ,
                               "Glasübergangstemperatur ist eine Duktil-Spröd-Übergangstemperatur eines amorphen oder teilkristallinen Materials, die die Temperatur beschreibt, bei der das Material beim Erwärmen von einem harten, glasartigen in einen weichen, gummiartigen Zustand übergeht"@de ;
               skos:example "Glass transition temperature of polycarbonate measured at approximately 147 °C, above which the material softens and loses rigidity, determined according to ISO 11357-2."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080050
co:PMD_0080050 rdf:type owl:Class ;
               rdfs:subClassOf [ owl:intersectionOf ( co:PMD_0020142
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0000080 ;
                                                        owl:someValuesFrom co:PMD_0020128
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
               obo:IAO_0000117 "Philipp von Hartrott" ;
               rdfs:comment """SI unit: joules per kelvin (J/K)

Statistical definition (Boltzmann):
S=k_B ln(W)
where k_B​ is the Boltzmann constant and W is the number of microstates."""@en ;
               rdfs:label "entropy"@en ;
               skos:definition "Entropy is a measure of the disorder or randomness of a system — more precisely, the number of microscopic arrangements (microstates) consistent with the system's macroscopic state."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080052
co:PMD_0080052 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020142 ,
                               [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0002328 ;
                                                        owl:someValuesFrom co:PMD_0000896
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0002328 ;
                                                        owl:someValuesFrom co:PMD_0020150
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0002328 ;
                                                        owl:someValuesFrom co:PMD_0020151
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
               rdfs:label "enthalpy"@en ;
               skos:definition "enthalpy H is the sum of internal energy and the product of pressure and volume"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080053
co:PMD_0080053 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080052 ;
               rdfs:label "melting enthalpy"@en ;
               skos:definition "the amount of energy required to convert an entity from solid to liquid aggregtate state at constant temperature and pressure"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080055
co:PMD_0080055 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'auto-ignition temperature' have not yet been formalized. The term is defined as a specific subtype of 'thermo dynamic quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Selbstzündungstemperatur"@de ,
                          "auto-ignition temperature"@en ;
               skos:altLabel "T_AIT"@en ,
                             "Zündtemperatur"@de ,
                             "spontaneous ignition temperature"@en ;
               skos:definition "Auto-ignition temperature is a thermodynamic quality of a substance that specifies the lowest temperature at which it spontaneously ignites in a normal atmosphere without an external ignition source"@en ,
                               "Selbstzündungstemperatur ist eine thermodynamische Qualität eines Stoffes, die die niedrigste Temperatur angibt, bei der er sich in normaler Atmosphäre ohne externe Zündquelle selbst entzündet"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080056
co:PMD_0080056 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020316 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Might be a process attribute of a viscous fluid flowing (in a channel)"@en ,
                               "Necessary and sufficient conditions for 'Reynolds number' have not yet been formalized. The term is defined as a specific subtype of 'FluidDynamicQuality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Reynolds_number."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Reynolds_number> ;
               rdfs:label "Reynolds number"@en ,
                          "Reynolds-Zahl"@de ;
               skos:definition "Reynolds number is a dimensionless quantity predicting fluid flow patterns, measuring the ratio between inertial and viscous forces"@en ,
                               "Reynolds-Zahl ist eine dimensionslose Größe zur Vorhersage von Strömungsmustern in Flüssigkeiten, die das Verhältnis zwischen Trägheits- und Viskosekräften misst"@de ;
               skos:example "Flow in a 25 mm pipe at 2 m/s has a Reynolds number of about 50000, indicating turbulent regime"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080057
co:PMD_0080057 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'odor' have not yet been formalized. The term is defined as a specific subtype of 'olfactoric quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000058."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 obo:PATO_0000058 ;
               rdfs:label "Geruch"@de ,
                          "odor"@en ;
               skos:definition "Geruch ist eine morphologische Eigenschaft, die einem Träger innewohnt, dessen Moleküle von einem Geruchsrezeptor verteilt und wahrgenommen werden"@de ,
                               "Odor is a morphologic quality inhering in a bearer whose molecules are dispersed and perceived by an odorant receptor"@en ;
               skos:example "The characteristic odor of acetic acid is detectable in dilute vinegar solutions"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080061
co:PMD_0080061 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0040001 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'radius' have not yet been formalized. The term is defined as a specific subtype of 'length'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0002390."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 obo:PATO_0002390 ;
               rdfs:label "Radius"@de ,
                          "radius"@en ;
               skos:definition "Radius is a length quality equal to the distance from the center of a circle to any endpoint on the circular boundary"@en ,
                               "Radius ist eine Längeneigenschaft, die gleich der Entfernung vom Mittelpunkt eines Kreises zu einem beliebigen Endpunkt auf der Kreisgrenze ist"@de ;
               skos:example "A cylindrical specimen has a radius of 5 mm, giving a cross-sectional area of 78.5 mm2"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080065
co:PMD_0080065 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000008 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'wavelength' have not yet been formalized. The term is defined as a specific subtype of 'length'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.oxfordreference.com/display/10.1093/oi/authority.20110803121421585."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://www.oxfordreference.com/display/10.1093/oi/authority.20110803121421585> ;
               rdfs:label "Wellenlänge"@de ,
                          "wavelength"@en ;
               skos:definition "Wavelength is the distance between successive peaks or troughs of a wave, equal to wave speed divided by frequency"@en ,
                               "Wellenlänge ist die Entfernung zwischen aufeinanderfolgenden Gipfeln oder Tälern einer Welle, gleich der Wellenbewegungsgeschwindigkeit geteilt durch die Frequenz"@de ;
               skos:example "A green laser pointer emits light at a wavelength of 532 nm"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080066
co:PMD_0080066 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0040001 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'height' have not yet been formalized. The term is defined as a specific subtype of 'length'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000119."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 obo:PATO_0000119 ;
               rdfs:label "Höhe"@de ,
                          "height"@en ;
               skos:definition "Die Höhe ist eine eindimensionale Ausdehnungsqualität, die die vertikale Abmessung eines Objekts oder Raums beschreibt, gemessen von der Basis bis zur Spitze"@de ,
                               "Height is a 1-D extent quality describing the vertical dimension of an object or space, measured from the base to the top"@en ;
               skos:example "A steel column has a height of 3.6 m between floor and ceiling connections"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080067
co:PMD_0080067 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0040001 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'perimeter' have not yet been formalized. The term is defined as a specific subtype of 'length'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0001711."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 obo:PATO_0001711 ;
               rdfs:label "Umfang"@de ,
                          "perimeter"@en ;
               skos:definition "Der Umfang misst eine eindimensionale Ausdehnung, die einem zweidimensionalen Träger innewohnt und die Entfernung um ihn herum darstellt"@de ,
                               "Perimeter measures a 1-D extent inhering in a two-dimensional bearer, representing the distance around it"@en ;
               skos:example "The perimeter of a square cross-section beam of 50 mm side length is 200 mm"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080068
co:PMD_0080068 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080067 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'circumference' have not yet been formalized. The term is defined as a specific subtype of 'perimeter'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0001648."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 obo:PATO_0001648 ;
               rdfs:label "Kreisumfang"@de ,
                          "circumference"@en ;
               skos:definition "Circumference characterizes a 1-D extent equal to the length of the closed curve of a circle"@en ,
                               "Der Umfang charakterisiert eine eindimensionale Ausdehnung, die der Länge der geschlossenen Kurve eines Kreises entspricht"@de ;
               skos:example "A wire of 2 mm diameter has a circumference of 6.28 mm"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080069
co:PMD_0080069 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'physical relational quality' have not yet been formalized. The term is defined as a specific subtype of 'BFO_0000145'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "physical relational quality"@en ,
                          "physisch relative Qualität"@de ;
               skos:definition "Die physische Beziehungsqualität bezieht sich auf Eigenschaften oder Merkmale einer Entität, die von ihrer Beziehung zu anderen Entitäten abhängig sind"@de ,
                               "Physical relational quality pertains to properties or characteristics of an entity dependent on its relation to other entities"@en ;
               skos:example "The coefficient of friction between two surfaces is a physical relational quality inhering in both contacting materials"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080070
co:PMD_0080070 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080069 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'physical rate quality' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ,
                               "Rate =(def.) a measure, quantity, or frequency, typically one measured against some other quantity or measure"@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "physical rate quality"@en ,
                          "physische Geschwindigkeitsqualität"@de ;
               skos:definition "Die physikalische Geschwindigkeitsqualität bezeichnet den Quotienten zweier physikalischer Größen in unterschiedlichen Einheiten, der die Änderungsrate einer Größe im Verhältnis zu einer anderen darstellt"@de ,
                               "Physical rate quality denotes the quotient of two physical quantities in different units, representing one quantity's rate of change in relation to another"@en ;
               skos:example "The rate of thermal expansion of a metal rod during quenching is a physical rate quality"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080071
co:PMD_0080071 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'emissivity' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Emissionsgrad"@de ,
                          "emissivity"@en ;
               skos:altLabel "Emissivität"@de ,
                             "ε"@en ;
               skos:definition "Emissionsgrad ist eine physikalische Ratenqualität einer Materialoberfläche, die das Verhältnis der von der Oberfläche emittierten Wärmestrahlung zu der eines idealen schwarzen Körpers bei gleicher Temperatur ausdrückt"@de ,
                               "Emissivity is a physical rate quality of a material surface that expresses the ratio of thermal radiation emitted by the surface to that emitted by a perfect blackbody at the same temperature"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080072
co:PMD_0080072 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'relative isotopic mass' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Atomic_mass."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Atomic_mass> ;
               rdfs:label "relative Isotopenmasse"@de ,
                          "relative isotopic mass"@en ;
               skos:definition "Relative Isotopenmasse bezieht sich auf die Masse eines einzelnen Isotops im Vergleich zu 1/12 der Masse eines Kohlenstoff-12-Atoms"@de ,
                               "Relative isotopic mass refers to the mass of a single isotope compared to 1/12 of the mass of a carbon-12 atom"@en ;
               skos:example "The relative isotopic mass of carbon-13 is 13.003 u, slightly heavier than carbon-12"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080073
co:PMD_0080073 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'luminous efficacy' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Luminous_efficacy."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Luminous_efficacy> ;
               rdfs:label "Lichtausbeute"@de ,
                          "luminous efficacy"@en ;
               skos:definition "Die Lichtausbeute misst, wie gut eine Lichtquelle sichtbares Licht erzeugt, berechnet als Lichtstrom geteilt durch Leistung, ausgedrückt in Lumen pro Watt"@de ,
                               "Luminous efficacy measures how well a light source produces visible light, calculated as luminous flux divided by power, expressed in lumens per watt"@en ;
               skos:example "A modern LED achieves a luminous efficacy of 200 lm/W, far exceeding incandescent bulbs"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080074
co:PMD_0080074 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'optical absorptance' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "optical absorptance"@en ,
                          "optische Absorption"@de ;
               skos:definition "Die optische Absorption definiert das Verhältnis der absorbierten Strahlungsleistung zur einfallenden Strahlungsleistung und gibt Aufschluss über die Absorptionsfähigkeit eines Mediums"@de ,
                               "Optical absorptance defines the ratio of absorbed radiant power to incident radiant power, indicating a medium's absorption capability"@en ;
               skos:example "A solar absorber coating has an optical absorptance of 0.96, converting most sunlight to heat"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080075
co:PMD_0080075 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'optical transmittance' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "optical transmittance"@en ,
                          "optische Transmittance"@de ;
               skos:definition "Die optische Durchlässigkeit wird durch das Verhältnis der übertragenen Strahlungsleistung zur einfallenden Strahlungsleistung definiert und dient der Beurteilung der Übertragungseffizienz"@de ,
                               "Optical transmittance is defined by the ratio of transmitted radiant power to incident radiant power, assessing transmission efficiency"@en ;
               skos:example "A 3 mm thick soda-lime glass pane has an optical transmittance of 90 % in the visible range"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080076
co:PMD_0080076 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'mass diffusivity' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Massendiffusivität"@de ,
                          "mass diffusivity"@en ;
               skos:altLabel "D"@en ,
                             "Diffusionskoeffizient"@de ,
                             "diffusion coefficient"@en ;
               skos:definition "Mass diffusivity is a physical rate quality of a material that quantifies the rate at which a diffusing substance moves through it per unit concentration gradient, as described by Fick's first law"@en ,
                               "Massendiffusivität ist eine physikalische Ratenqualität eines Materials, die die Geschwindigkeit beschreibt, mit der eine diffundierende Substanz pro Konzentrationsgradienten durch das Material transportiert wird, gemäß dem ersten Fickschen Gesetz"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080077
co:PMD_0080077 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'optical reflectance' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "optical reflectance"@en ,
                          "optische Reflexion"@de ;
               skos:definition "Der optische Reflexionsgrad wird durch das Verhältnis der reflektierten Strahlungsleistung zur einfallenden Strahlungsleistung definiert und bewertet die Reflexionsfähigkeit"@de ,
                               "Optical reflectance is defined by the ratio of reflected radiant power to incident radiant power, assessing reflective capacity"@en ;
               skos:example "A silver mirror has an optical reflectance of 98 % at 600 nm wavelength"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080078
co:PMD_0080078 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'electromotive force' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Electromotive_force."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Electromotive_force> ;
               rdfs:label "Quellenspannung"@de ,
                          "electromotive force"@en ;
               skos:altLabel "EMP"@en ;
               skos:definition "Electromotive force refers to energy transferred to an electric circuit per unit charge, measured in volts, produced by transducers converting forms of energy to electrical energy"@en ,
                               "Unter elektromotorischer Kraft versteht man die Energie, die pro Ladungseinheit auf einen Stromkreis übertragen wird. Sie wird in Volt gemessen und von Wandlern erzeugt, die Energieformen in elektrische Energie umwandeln"@de ;
               skos:example "A standard zinc-copper galvanic cell produces an electromotive force of 1.1 V"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080079
co:PMD_0080079 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'humidity' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Feuchtigkeit"@de ,
                          "humidity"@en ;
               skos:definition "Die Luftfeuchtigkeit charakterisiert den Partialdruck der Luft, der durch den Wasserdampfgehalt entsteht, definiert als das Verhältnis von Wassermasse zu Volumen des Medium-Wasser-Gemisches"@de ,
                               "Humidity characterizes air's partial pressure exerted by water vapor content, defined as the mass of water to volume of the medium-water mixture"@en ;
               skos:example "A drying oven maintains relative humidity below 5 % to prevent moisture absorption in polymer samples"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080080
co:PMD_0080080 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'thermal diffusivity' have not yet been formalized. Although thermal diffusivity is defined as a ratio of thermal conductivity to the product of density and specific heat capacity, a co-inherence axiom cannot uniquely identify this quality among all rate qualities of the same bearer. The term is defined as a specific subtype of 'physical rate quality'."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Temperaturleitfähigkeit"@de ,
                          "thermal diffusivity"@en ;
               skos:altLabel "Thermische Diffusivität"@de ,
                             "α"@en ;
               skos:definition "Temperaturleitfähigkeit ist eine physikalische Ratenqualität eines Materials, die die Geschwindigkeit beschreibt, mit der Wärmeenergie im Verhältnis zur Wärmespeicherkapazität geleitet wird, ausgedrückt als Verhältnis der Wärmeleitfähigkeit zum Produkt aus Dichte und spezifischer Wärmekapazität"@de ,
                               "Thermal diffusivity is a physical rate quality of a material that quantifies the rate at which thermal energy is conducted relative to its capacity to store heat, expressed as the ratio of thermal conductivity to the product of density and specific heat capacity"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080081
co:PMD_0080081 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'work hardening coefficient' have not yet been formalized. The term is defined as a specific subtype of 'physical rate quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Verfestigungsexponent"@de ,
                          "work hardening coefficient"@en ;
               skos:altLabel "Kaltverfestigungsexponent"@de ,
                             "n"@en ,
                             "strain hardening exponent"@en ;
               skos:definition "Verfestigungsexponent ist eine physikalische Ratenqualität eines Materials, die die Geschwindigkeit beschreibt, mit der die Fließspannung bei plastischer Verformung während der Kaltumformung zunimmt, ausgedrückt als Exponent n in der Hollomon-Potenzgesetzbeziehung"@de ,
                               "Work hardening coefficient is a physical rate quality of a material that quantifies the rate at which flow stress increases with plastic strain during cold working, expressed as the exponent n in the Hollomon power-law relation"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080082
co:PMD_0080082 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020309 ,
                               co:PMD_0020311 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0000052 ;
                                 owl:someValuesFrom [ owl:intersectionOf ( obo:BFO_0000146
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:RO_0002000 ;
                                                                             owl:someValuesFrom co:PMD_0020293
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ]
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'coefficient of friction' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Reibungskoeffizient"@de ,
                          "coefficient of friction"@en ;
               skos:altLabel "Reibwert"@de ,
                             "friction coefficient"@en ,
                             "μ"@en ;
               skos:definition "Coefficient of friction is a dimensionless scalar quality of a pair of surfaces in contact that expresses the ratio of the friction force between them to the normal force pressing them together"@en ,
                               "Der Reibungskoeffizient ist eine dimensionslose skalare Qualität eines Paars in Kontakt stehender Oberflächen, die das Verhältnis der Reibungskraft zwischen ihnen zur Normalkraft ausdrückt, die sie zusammendrückt"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080083
co:PMD_0080083 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'inductance' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Inductance."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Inductance> ;
               rdfs:label "Induktion"@de ,
                          "inductance"@en ;
               skos:definition "Inductance is the tendency of an electrical conductor to oppose a change in electric current through electromagnetic induction, creating back electromotive force"@en ,
                               "Induktivität ist die Tendenz eines elektrischen Leiters, einer Änderung des elektrischen Stroms durch elektromagnetische Induktion entgegenzuwirken und so eine elektromotorische Gegenkraft zu erzeugen"@de ;
               skos:example "A solenoid coil of 100 turns has an inductance of 1 mH, opposing rapid current changes"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080087
co:PMD_0080087 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'thrust' have not yet been formalized. The term is defined as a specific subtype of 'force'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Thrust."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Thrust> ;
               rdfs:label "Schubkraft"@de ,
                          "thrust"@en ;
               skos:definition "Schubkraft ist eine von Newtons drittem Gesetz beschriebene Kraft, bei der Massenbeschleunigung in eine Richtung eine gleich große Kraft in die entgegengesetzte Richtung verursacht"@de ,
                               "Thrust is a force described by Newton's third law, where mass expulsion in one direction causes an equal force in the opposite direction"@en ;
               skos:example "A jet engine produces 150 kN of thrust at takeoff conditions"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080088
co:PMD_0080088 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'dose equivalent' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.nrc.gov/reading-rm/basic-ref/glossary/dose-equivalent.html."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://www.nrc.gov/reading-rm/basic-ref/glossary/dose-equivalent.html> ;
               rdfs:label "dose equivalent"@en ,
                          "Äquivalentdosis"@de ;
               skos:definition "Das Dosisäquivalent misst die biologische Schädigung lebenden Gewebes durch Strahlenexposition, berechnet als absorbierte Dosis multipliziert mit einem Qualitätsfaktor und ausgedrückt in Rems oder Sievert"@de ,
                               "Dose equivalent measures biological damage to living tissue from radiation exposure, calculated as absorbed dose multiplied by a quality factor, and expressed in rems or sieverts"@en ;
               skos:example "A radiation worker receives a dose equivalent of 2 mSv per year from occupational exposure"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080089
co:PMD_0080089 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'radiant energy density' have not yet been formalized. The term is defined as a specific subtype of 'density'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Radiant_energy."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Radiant_energy> ;
               rdfs:label "Strahlungsenergiedichte"@de ,
                          "radiant energy density"@en ;
               skos:definition "Radiant energy density quantifies radiant energy per unit volume"@en ,
                               "Strahlungsenergiedichte misst die Strahlungsenergie pro Volumeneinheit"@de ;
               skos:example "The radiant energy density at the focal spot of a laser is 1 GJ/m3 during material processing"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080091
co:PMD_0080091 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'pixel density' have not yet been formalized. The term is defined as a specific subtype of 'number density'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Pixeldichte"@de ,
                          "pixel density"@en ;
               skos:definition "Pixel density describes the relationship between the number of pixels and the area they occupy on a related entity"@en ,
                               "Pixeldichte beschreibt das Verhältnis zwischen der Anzahl der Pixel und der Fläche, die sie auf einer verwandten Entität einnehmen"@de ;
               skos:example "A 4K display panel has a pixel density of 210 ppi, providing sharp text rendering"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080092
co:PMD_0080092 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'electric flux density' have not yet been formalized. The term is defined as a specific subtype of 'density'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.britannica.com/science/electric-flux."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://www.britannica.com/science/electric-flux> ;
               rdfs:label "electric flux density"@en ,
                          "elektrische Flussdichte"@de ;
               skos:definition "Die elektrische Flussdichte misst die Gesamtzahl der elektrischen Kraftlinien, die ein bestimmtes Gebiet schneiden, von positiven Ladungen ausgehen und bei negativen Ladungen enden"@de ,
                               "Electric flux density measures the total number of electric lines of force intersecting a given area, originating on positive charges and terminating on negative charges"@en ;
               skos:example "Near a charged plate, the electric flux density is 8.85e-12 C/m2 per V/m of field strength"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080093
co:PMD_0080093 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'birefringence' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Doppelbrechung"@de ,
                          "birefringence"@en ;
               skos:altLabel "Zweistrahl-Brechung"@de ,
                             "double refraction"@en ,
                             "Δn"@en ;
               skos:definition "Birefringence is a physical relational quality of an optically anisotropic material that specifies the difference in refractive indices along two principal optical axes, causing incident light to split into two rays with different velocities"@en ,
                               "Doppelbrechung ist eine physikalische relationale Qualität eines optisch anisotropen Materials, die die Differenz der Brechungsindizes entlang zweier optischer Hauptachsen angibt und bewirkt, dass einfallendes Licht in zwei Strahlen mit unterschiedlichen Geschwindigkeiten aufgespalten wird"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080094
co:PMD_0080094 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ,
                               co:PMD_0023004 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0000052 ;
                                 owl:someValuesFrom [ owl:intersectionOf ( co:PMD_0000000
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:RO_0000056 ;
