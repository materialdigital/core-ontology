               obo:IAO_0000119 obo:PATO_0001323 ;
               rdfs:label "Fläche"@de ,
                          "area"@en ;
               skos:definition "Area signifies a 2-D extent quality inhering by virtue of the bearer's two-dimensional extent"@en ,
                               "Fläche bedeutet eine zweidimensionale Ausdehnungsqualität, die aufgrund der zweidimensionalen Ausdehnung des Trägers inhärent ist"@de ;
               skos:example "The cross-sectional area of a tensile specimen at the gauge section is 50 mm2"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


