               rdfs:label "acoustic property"@en ,
                          "akustische Eigenschaft"@de ;
               skos:definition "Eine akustische Eigenschaft ist eine Materialeigenschaft, die Eigenschaften eines Materials darstellt, die seine Wechselwirkung mit Schallwellen bestimmen, wie z. B. Absorption, Reflexion und Transmission."@de ,
                               "a property that is commonly associated with the domain of acoustics"@en ;
               skos:example "A piezoelectric transducer has the acoustic capability to emit ultrasound at frequencies up to 10 MHz"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


