               skos:definition "A simulation method specification where changes in a system are modeled continuously over time."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0000587
co:PMD_0000587 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000635 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
               rdfs:label "Risswachstum"@de ,
                          "crack growth"@en ;
               skos:definition "Das Risswachstum ist eine Schadensentwicklung, die die fortschreitende Ausdehnung eines Risses in einem Material unter Spannung beschreibt."@de ,
                               "The crack growth is an evolution of damage describing the progressive extension of a crack in a material under stress."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0000591
co:PMD_0000591 rdf:type owl:Class ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "will move to CryO" ;
               obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
               obo:IAO_0100001 "Obsolete by Kamilla: replaced with defines crystal lattices with fancy axioms an SWRL rules in CryO https://github.com/materialdigital/crystallography-subdomain-ontology"@en ;
               rdfs:comment "The finite set of periodic geometric arrangements is described e.g. by the 14 possible Bravais Lattices in three-dimensional space."@en ;
               rdfs:label "Kristallstruktur"@de ,
                          "OBSOLETE crystal structure"@en ;
               owl:deprecated "true"^^xsd:boolean ;
               skos:definition "an intensive quality of a crystal that embodies the periodic geometric arrangement of entities in a crystal lattice."@en ,
                               "eine intensive Kristallqualität, die die periodische geometrische Anordnung von Einheiten in einem Kristallgitter verkörpert."@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


