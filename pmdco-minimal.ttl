                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:RO_0001025 ;
                                                                             owl:someValuesFrom [ owl:intersectionOf ( obo:BFO_0000040
                                                                                                                       [ rdf:type owl:Restriction ;
                                                                                                                         owl:onProperty obo:RO_0000087 ;
                                                                                                                         owl:someValuesFrom co:PMD_0000845
                                                                                                                       ]
