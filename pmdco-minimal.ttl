                                                        owl:someValuesFrom co:PMD_0080034
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Schubmodul"@de ,
                          "shear modulus"@en ;
               skos:definition "Shear modulus is a measure of elastic shear stiffness, defined as the ratio of shear stress to shear strain"@en ;
               skos:example "The shear modulus of aluminum is 26 GPa, governing torsional deformation of shafts"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080167
co:PMD_0080167 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020311 ,
                               [ owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0002328 ;
                                                        owl:someValuesFrom co:PMD_0000618
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0002328 ;
                                                        owl:someValuesFrom co:PMD_0023002
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0002328 ;
                                 owl:someValuesFrom co:PMD_0000618
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'specific elastic modulus' have not yet been formalized. Although specific elastic modulus is defined as a ratio of elastic modulus to density, a co-inherence axiom cannot uniquely identify this quality among all stiffness qualities of the same bearer. The term is defined as a specific subtype of 'stiffness'."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "specific elastic modulus"@en ,
                          "spezifischer Elastizitätsmodul"@de ;
               skos:altLabel "specific modulus"@en ,
                             "specific stiffness"@en ,
                             "spezifische Steifigkeit"@de ,
                             "spezifischer Modul"@de ;
               skos:definition "Specific elastic modulus is a stiffness quality of a material expressed as the ratio of its elastic modulus to its density, representing the material's elastic stiffness per unit mass"@en ,
                               "Spezifischer Elastizitätsmodul ist eine Steifigkeitsqualität eines Materials, ausgedrückt als Verhältnis seines Elastizitätsmoduls zu seiner Dichte und repräsentiert die elastische Steifigkeit des Materials je Masseneinheit"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080170
co:PMD_0080170 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'plasticity' have not yet been formalized. The term is defined as a specific subtype of 'strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Plastizität"@de ,
                          "plasticity"@en ;
               skos:altLabel "Plastizität"@de ,
                             "plasticity"@en ;
               skos:definition "Plasticity signifies a material's ability to undergo permanent deformation without breaking or cracking"@en ,
                               "Plastizität bezeichnet die Fähigkeit eines Materials, dauerhafte Verformungen ohne Bruch oder Riss zu erleiden"@de ;
               skos:example "Low-carbon steel exhibits high plasticity, allowing deep drawing without cracking"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080171
co:PMD_0080171 rdf:type owl:Class ;
               rdfs:subClassOf [ owl:intersectionOf ( co:PMD_0000952
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0000052 ;
                                                        owl:someValuesFrom [ owl:intersectionOf ( co:PMD_0000068
                                                                                                  [ rdf:type owl:Restriction ;
                                                                                                    owl:onProperty obo:RO_0000053 ;
                                                                                                    owl:someValuesFrom co:PMD_0080035
                                                                                                  ]
                                                                                                ) ;
                                                                             rdf:type owl:Class
                                                                           ]
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
               rdfs:comment "The amount of plastic strain typically gives more information about the yield stress. E.g. Rp02 has 0.2% plastic strain."@en ;
               rdfs:label "Fließgrenze"@de ,
                          "yield stress"@en ;
               skos:altLabel "yield strength"@en ;
               skos:definition "is the stress at which the material has a non-zero plastic strain."@en ;
               skos:example "The yield strength of mild steel is approximately 250 MPa, beyond which permanent deformation begins"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080172
co:PMD_0080172 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080171 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'lower yield strength' have not yet been formalized. The term is defined as a specific subtype of 'yield strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Yield_(engineering)."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Yield_(engineering)> ;
               rdfs:label "lower yield strength"@en ,
                          "untere Streckgrenze"@de ;
               skos:altLabel "lower yield stress"@en ,
                             "untere Fließspannung"@de ;
               skos:definition "Lower yield strength defines the stress at which a material exhibits plastic behavior after initial yielding"@en ,
                               "Untere Streckgrenze beschreibt die Spannung, bei der ein Material nach dem anfänglichen Fließen plastisches Verhalten zeigt"@de ;
               skos:example "The lower yield strength of mild steel is approximately 235 MPa, defining the onset of stable plastic flow"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080173
co:PMD_0080173 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080171 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'upper yield strength' have not yet been formalized. The term is defined as a specific subtype of 'yield strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Yield_(engineering)."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Yield_(engineering)> ;
               rdfs:label "obere Streckgrenze"@de ,
                          "upper yield strength"@en ;
               skos:altLabel "obere Fließspannung"@de ,
                             "upper yield stress"@en ;
               skos:definition "Obere Streckgrenze charakterisiert die maximale Spannung, die vor dem plastischen Fließen eines Materials angewendet werden kann"@de ,
                               "Upper yield strength characterizes the maximum stress that can be applied before a material begins to yield plastically"@en ;
               skos:example "Mild steel exhibits an upper yield strength of about 300 MPa, followed by a yield drop to the lower yield point"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080174
co:PMD_0080174 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020316 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'viscosity' have not yet been formalized. The term is defined as a specific subtype of 'plasticity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Viskosität"@de ,
                          "viscosity"@en ;
               skos:altLabel "Viskosität"@de ,
                             "viscosity"@en ;
               skos:definition "Viscosity measures a fluid's resistance to flow"@en ,
                               "Viskosität misst den Widerstand eines Fluids gegen den Fluss"@de ;
               skos:example "Honey at 25 C has a viscosity of about 10 Pa·s, flowing slowly under gravity"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080175
co:PMD_0080175 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080174 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'extentional viscosity' have not yet been formalized. The term is defined as a specific subtype of 'viscosity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Dehnviskosität"@de ,
                          "extentional viscosity"@en ;
               skos:definition "Die Dehnviskosität ist die Messung des Widerstands einer Flüssigkeit gegen den Fluss bei Dehnspannung"@de ,
                               "Extentional viscosity measures a fluid's resistance to tension flow"@en ;
               skos:example "A polymer melt shows an extensional viscosity three times its shear viscosity at low strain rates"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080176
co:PMD_0080176 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080174 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'shear viscosity' have not yet been formalized. The term is defined as a specific subtype of 'viscosity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Scherviskosität"@de ,
                          "shear viscosity"@en ;
               skos:altLabel "Scherviskosität"@de ,
                             "shear viscosity"@en ;
               skos:definition "Scherviskosität misst den Widerstand eines Fluids gegen Scherfluss"@de ,
                               "Shear viscosity measures a fluid's resistance to shear flow"@en ;
               skos:example "The shear viscosity of glycerol at 25 C is about 1.5 Pa·s, much higher than water"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080177
co:PMD_0080177 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080174 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'kinematic viscosity' have not yet been formalized. The term is defined as a specific subtype of 'viscosity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "kinematic viscosity"@en ,
                          "kinematische Viskosität"@de ;
               skos:altLabel "kinematic viscosity"@en ,
                             "kinematische Viskosität"@de ,
                             "kinetic viscosity"@en ,
                             "kinetische Viskosität"@de ;
               skos:definition "Die kinematische Viskosität ist das Verhältnis der dynamischen Viskosität zur Dichte"@de ,
                               "Kinematic viscosity is the ratio of dynamic viscosity to density"@en ;
               skos:example "The kinematic viscosity of water at 20 C is about 1e-6 m2/s, used in pipe flow calculations"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080178
co:PMD_0080178 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080174 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'dynamic viscosity' have not yet been formalized. The term is defined as a specific subtype of 'viscosity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "dynamic viscosity"@en ,
                          "dynamische Viskosität"@de ;
               skos:altLabel "dynamic viscosity"@en ,
                             "dynamische Viskosität"@de ;
               skos:definition "Die dynamische Viskosität ist ein Maß für den Widerstand eines Fluids gegen eine allmähliche Verformung durch Scher- oder Zugspannung. Es ist ein Maß für den inneren Widerstand des Fluids gegen den Fluss und kann als Maß für die Flüssigkeitsreibung betrachtet werden"@de ,
                               "Dynamic viscosity measures a fluid's resistance to gradual deformation by shear stress or tensile stress, indicative of the fluid's internal friction"@en ;
               skos:example "Motor oil at 40 C has a dynamic viscosity of about 100 mPa·s, resisting flow under shear"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080179
co:PMD_0080179 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080174 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'volume viscosity' have not yet been formalized. The term is defined as a specific subtype of 'viscosity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Volumenviskosität"@de ,
                          "volume viscosity"@en ;
               skos:definition "Volume viscosity measures a fluid's resistance to volumetric stress"@en ,
                               "Volumenviskosität misst den Widerstand eines Fluids gegenüber volumetrischer Belastung"@de ;
               skos:example "Water has a volume viscosity of about 3 mPa·s at 25 C, relevant in acoustic wave propagation"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080180
co:PMD_0080180 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'brittleness' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Sprödigkeit"@de ,
                          "brittleness"@en ;
               skos:altLabel "Sprödigkeit"@de ,
                             "Zerbrechlichkeit"@de ,
                             "brittleness"@en ,
                             "fragility"@en ;
               skos:definition "Opposite to toughness, brittleness is the property of being easily broken or damaged"@en ,
                               "Sprödigkeit ist die Eigenschaft, leicht zu brechen oder zu beschädigen"@de ;
               skos:example "Cast iron has high brittleness, fracturing without measurable plastic deformation under tensile loading"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080181
co:PMD_0080181 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'ductility' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Duktilität"@de ,
                          "ductility"@en ;
               skos:altLabel "Biegsamkeit"@de ,
                             "Duktilität"@de ,
                             "ductility"@en ,
                             "flexibility"@en ;
               skos:definition "Ductility is the ability of a material to deform plastically without breaking"@en ,
                               "Duktilität ist die Fähigkeit eines Materials, plastisch zu verformen, ohne zu brechen"@de ;
               skos:example "Low-carbon steel has high ductility, with elongation at break exceeding 30 %"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080182
co:PMD_0080182 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080181 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'malleability' have not yet been formalized. The term is defined as a specific subtype of 'ductility'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Formbarkeit"@de ,
                          "malleability"@en ;
               skos:altLabel "Formbarkeit"@de ,
                             "Malleability"@en ,
                             "Malleable"@en ,
                             "formbar"@de ;
               skos:definition "Formbarkeit beschreibt Materialien, die durch Hammern oder Walzen bearbeitet werden können und sich von Duktilität unterscheiden"@de ,
                               "Malleability refers to a material's amenability to forming by hammering or rolling, distinct from ductility"@en ;
               skos:example "Gold has high malleability, allowing it to be hammered into sheets less than 100 nm thick"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080184
co:PMD_0080184 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'resilience' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Resilienz"@de ,
                          "resilience"@en ;
               skos:altLabel "Resilienzmodul"@de ,
                             "modulus of resilience"@en ;
               skos:definition "Elastizität ist die mechanische Fähigkeit eines Materials, bei elastischer Verformung Energie zu absorbieren und diese Energie bei Entlastung ohne bleibende Verformung abzugeben"@de ,
                               "Resilience is a mechanical capability of a material to absorb energy when elastically deformed and release that energy upon unloading without permanent deformation"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080186
co:PMD_0080186 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000877 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'radiation reflection capability' have not yet been formalized. The term is defined as a specific subtype of 'optical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Strahlungsreflexionsfähigkeiten"@de ,
                          "radiation reflection capability"@en ;
               skos:definition "Radiation reflection capability characterizes an entity's ability to reflect electromagnetic radiation"@en ,
                               "Strahlungsreflexionsfähigkeit beschreibt die Fähigkeit einer Entität, elektromagnetische Strahlung zu reflektieren"@de ;
               skos:example "Polished aluminum foil has high radiation reflection capability, reflecting 90 % of infrared radiation"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080187
co:PMD_0080187 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000877 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'radiation absorption capability' have not yet been formalized. The term is defined as a specific subtype of 'optical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Strahlungsabsorptionsfähigkeit"@de ,
                          "radiation absorption capability"@en ;
               skos:definition "Radiation absorption capability characterizes an entity's ability to absorb electromagnetic radiation"@en ,
                               "Strahlungsabsorptionsfähigkeit beschreibt die Fähigkeit einer Entität, elektromagnetische Strahlung zu absorbieren"@de ;
               skos:example "Carbon black pigment has high radiation absorption capability, absorbing over 99 % of incident visible light"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080188
co:PMD_0080188 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000877 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'radiation emission capability' have not yet been formalized. The term is defined as a specific subtype of 'optical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Strahlungsemitter"@de ,
                          "radiation emitter"@en ;
               skos:definition "Radiation emission capability refers to an entity's ability to emit light of a defined spectrum and intensity"@en ,
                               "Strahlungsemitter beschreibt die Fähigkeit einer Entität, Licht eines definierten Spektrums und Intensität zu emittieren"@de ;
               skos:example "A cobalt-60 source is a radiation emitter used in industrial gamma-ray testing of welds"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080189
co:PMD_0080189 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000877 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'radiation transmission capability' have not yet been formalized. The term is defined as a specific subtype of 'optical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Strahlungsübertragungsfähigkeit"@de ,
                          "radiation transmission capability"@en ;
               skos:definition "Radiation transmission capability describes an entity's ability to transmit electromagnetic radiation"@en ,
                               "Strahlungsübertragungsfähigkeit beschreibt die Fähigkeit einer Entität, elektromagnetische Strahlung zu übertragen"@de ;
               skos:example "A thin beryllium window has high radiation transmission capability for soft X-rays, passing over 90 % of flux"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080191
co:PMD_0080191 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'thermal capacity' have not yet been formalized. The term is defined as a specific subtype of 'thermal capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Heat_capacity."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Heat_capacity> ;
               rdfs:label "thermal capacity"@en ,
                          "thermische Kapazität"@de ;
               skos:altLabel "Wärmekapazität"@de ,
                             "heat capacity"@en ;
               skos:definition "Thermal capacity, or heat capacity, is defined as the amount of heat required to produce a unit change in temperature of an object"@en ,
                               "Wärmekapazität, auch als thermische Kapazität bekannt, ist die Menge an Wärme, die erforderlich ist, um eine Änderung der Temperatur eines Objekts um eine Einheit zu erzeugen"@de ;
               skos:example "A steel block of 1 kg has a thermal capacity of 500 J/K, absorbing heat with moderate temperature rise"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080192
co:PMD_0080192 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'flammability' have not yet been formalized. The term is defined as a specific subtype of 'thermal capability'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Entflammbarkeit"@de ,
                          "flammability"@en ;
               skos:altLabel "Brennbarkeit"@de ,
                             "combustibility"@en ;
               skos:definition "Entflammbarkeit ist eine thermische Fähigkeit eines Materials, die seine Fähigkeit beschreibt, bei Exposition gegenüber einer Flamme oder Wärmequelle unter festgelegten Bedingungen zu entzünden und die Verbrennung aufrechtzuerhalten"@de ,
                               "Flammability is a thermal capability of a material that characterises its ability to ignite and sustain combustion when exposed to a flame or heat source under specified conditions"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080194
co:PMD_0080194 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'thermal insulation' have not yet been formalized. The term is defined as a specific subtype of 'thermal capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Thermal_insulation."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Thermal_insulation> ;
               rdfs:label "thermal insulation"@en ,
                          "thermische Isolierung"@de ;
               skos:definition "Thermal insulation reduces heat transfer between objects in thermal contact or radiative influence, achieved with engineered methods or material properties"@en ,
                               "Thermische Isolierung verringert den Wärmeaustausch zwischen Objekten, die in thermischem Kontakt oder Strahlungseinfluss stehen, realisiert durch spezielle Konstruktionsmethoden oder Materialien"@de ;
               skos:example "Glass wool with a thermal conductivity of 0.04 W/(m·K) provides effective thermal insulation in building walls"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080195
co:PMD_0080195 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020142 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'radiant energy' have not yet been formalized. The term is defined as a specific subtype of 'thermal capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Radiant_energy."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Radiant_energy> ;
               rdfs:label "Strahlungsenergie"@de ,
                          "radiant energy"@en ;
               skos:definition "Radiant energy refers to the energy of electromagnetic radiation, calculated by integrating radiant flux over time"@en ,
                               "Strahlungsenergie bezieht sich auf die Energie elektromagnetischer Strahlung, die durch Integration des Strahlungsflusses über die Zeit berechnet wird"@de ;
               skos:example "A pulsed laser delivers 1 mJ of radiant energy per pulse to the workpiece surface"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080196
co:PMD_0080196 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'thermal expansion coefficient' have not yet been formalized. The term is defined as a specific subtype of 'thermal capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "thermal expansion coefficient"@en ,
                          "thermischer Ausdehnungkoeffizient"@de ;
               skos:definition "Thermal expansion coefficient quantifies the degree to which a material expands upon heating, representing fractional change per degree temperature increase"@en ,
                               "Thermischer Ausdehnungkoeffizient quantifiziert den Grad, in dem ein Material beim Erhitzen expandiert, und stellt die proportionale Änderung pro Temperaturanstieg dar"@de ;
               skos:example "The thermal expansion coefficient of borosilicate glass is 3.3e-6 per K, enabling thermal shock resistance"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080197
co:PMD_0080197 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080196 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'volumetric thermal expansion coefficient' have not yet been formalized. The term is defined as a specific subtype of 'thermal expansion coefficient'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "thermischer Volumenausdehnungskoeffizient"@de ,
                          "volumetric thermal expansion coefficient"@en ;
               skos:definition "Der volumetrische Wärmeausdehnungskoeffizient quantifiziert den Grad, um den sich ein Material beim gleichzeitigen Erhitzen in alle drei axialen Richtungen ausdehnt"@de ,
                               "Volumetric thermal expansion coefficient quantifies the degree to which a material expands upon heating into all three axial directions simultaneously"@en ;
               skos:example "Liquid water near 4 C has a near-zero volumetric thermal expansion coefficient, giving maximum density"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080198
co:PMD_0080198 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080196 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'linear thermal expansion coefficient' have not yet been formalized. The term is defined as a specific subtype of 'thermal expansion coefficient'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "linear thermal expansion coefficient"@en ,
                          "linearer thermischer Ausdehnungkoeffizient"@de ;
               skos:definition "Der lineare Wärmeausdehnungskoeffizient quantifiziert den Grad, um den sich ein Material beim Erhitzen in eine bestimmte axiale Richtung ausdehnt"@de ,
                               "Linear thermal expansion coefficient quantifies the degree to which a material expands upon heating into a specific axial direction"@en ;
               skos:example "Aluminum has a linear thermal expansion coefficient of 23.1e-6 per K, causing notable dimensional changes during heating"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080200
co:PMD_0080200 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'flame resistance' have not yet been formalized. The term is defined as a specific subtype of 'thermal capability', disjoint from 'flammability' as the inverse capability. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Flammbeständigkeit"@de ,
                          "flame resistance"@en ;
               skos:altLabel "Brandbeständigkeit"@de ,
                             "fire resistance"@en ;
               skos:definition "Flame resistance is a thermal capability of a material that characterises its ability to resist ignition and inhibit the spread of combustion when exposed to a flame or heat source"@en ,
                               "Flammbeständigkeit ist eine thermische Fähigkeit eines Materials, die seine Fähigkeit beschreibt, einer Entzündung zu widerstehen und die Ausbreitung der Verbrennung bei Exposition gegenüber einer Flamme oder Wärmequelle zu verhindern"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080201
co:PMD_0080201 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'thermal conductance' have not yet been formalized. The term is defined as a specific subtype of 'thermal capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "thermal conductance"@en ,
                          "thermische Leitfähigkeit"@de ;
               skos:definition "Thermal conduction refers to the process by which heat is transferred from the hotter end to the colder end of an object, characterized by conductance"@en ,
                               "Thermische Leitung beschreibt den Prozess, bei dem Wärme vom heißeren zum kälteren Ende eines Objekts übertragen wird, gekennzeichnet durch Leitfähigkeit"@de ;
               skos:example "A copper heat spreader of 2 mm thickness has a high thermal conductance, efficiently dissipating chip heat"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080202
co:PMD_0080202 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'thermal shock resistance' have not yet been formalized. The term is defined as a specific subtype of 'thermal capability'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Thermoschockbeständigkeit"@de ,
                          "thermal shock resistance"@en ;
               skos:altLabel "Temperaturwechselbeständigkeit"@de ;
               skos:definition "Thermal shock resistance is a thermal capability of a material that characterises its ability to withstand rapid and large changes in temperature without cracking, spalling, or loss of mechanical integrity"@en ,
                               "Thermoschockbeständigkeit ist eine thermische Fähigkeit eines Materials, die seine Fähigkeit beschreibt, schnelle und große Temperaturänderungen ohne Rissbildung, Abplatzungen oder Verlust der mechanischen Integrität zu überstehen"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080203
co:PMD_0080203 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080007 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'radiation emission capability' have not yet been formalized. The term is defined as a specific subtype of 'physical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Strahlungsemissionsfähigkeit"@de ,
                          "radiation emission capability"@en ;
               skos:definition "Die Strahlungsemissionsfähigkeit ist die physikalische Fähigkeit eines materiellen Wesens, elektromagnetische Strahlung auszusenden, die in Prozessen realisiert wird, bei denen der Träger Energie in Form elektromagnetischer Wellen ausstrahlt"@de ,
                               "Radiation emission capability is a physical capability of a material entity to emit electromagnetic radiation, realized in processes where the bearer radiates energy in the form of electromagnetic waves"@en ;
               skos:example "A tungsten filament at 2800 K has significant radiation emission capability, producing visible white light"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080204
co:PMD_0080204 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'water absorption' have not yet been formalized. The term is defined as a specific subtype of 'physical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Wasseraufnahme"@de ,
                          "water absorption"@en ;
               skos:definition "Wasseraufnahme ist eine physische Fähigkeit eines Materials, Wasser aufzunehmen, quantifiziert als Massenzunahme einer Probe im Verhältnis zur anfänglichen Trockenmasse"@de ,
                               "Water absorption is a physical capability of a material to take up water, quantified as the increase in mass of a specimen relative to its initial dry mass"@en ;
               skos:example "Water absorption of a nylon 6 specimen immersed for 24 hours expressed as 2.5% of its dry mass, measured according to ISO 62."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0090000
co:PMD_0090000 rdf:type owl:Class ;
               owl:equivalentClass [ rdf:type owl:Restriction ;
                                     owl:onProperty obo:RO_0000091 ;
                                     owl:someValuesFrom co:PMD_0090001
                                   ] ;
               rdfs:subClassOf co:PMD_0000000 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0000086 ;
                                 owl:someValuesFrom co:PMD_0090002
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0000091 ;
                                 owl:someValuesFrom co:PMD_0090001
                               ] ;
               rdfs:label "semiconductor"@en ;
               skos:definition "A semiconductor is a material representing a class of materials characterized by an electrical conductivity between that of a conductor and an insulator. This is a result of a range of inexistent energy states in ther electron configuration between the valence and conduction band (bandgap)."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0090001
co:PMD_0090001 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000620 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: thnlrd" ;
               rdfs:label "Halbleitfähigkeit"@de ,
                          "semiconductivity"@en ;
               skos:definition "Semiconductivity is the disposition of a material to conduct electricity only when a certain level of excitation (via temperature, impurities, photonic excitation, electric field) elevates electrons from the valence band into the conduction band."@en ,
                               "Unter Halbleiterfähigkeit versteht man die Eigenschaft eines Materials, Elektrizität nur dann zu leiten, wenn ein bestimmtes Maß an Anregung (durch Temperatur, Verunreinigungen, photonische Anregung, elektrisches Feld) Elektronen aus dem Valenzband in das Leitungsband hebt."@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0090002
co:PMD_0090002 rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000019 ,
                               co:PMD_0020312 ,
                               co:PMD_0023004 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0000080 ;
                                 owl:someValuesFrom co:PMD_0020293
                               ] ;
               obo:IAO_0000117 "PERSON: thnlrd" ;
               rdfs:label "Bandlücke"@de ,
                          "band gap"@en ;
               rdfs:seeAlso "https://en.wikipedia.org/wiki/Valence_and_conduction_bands"^^xsd:anyURI ;
               skos:definition "the energy difference between the valence band and the conduction band"@en .


