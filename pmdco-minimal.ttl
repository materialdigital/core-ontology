                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:RO_0000086 ;
                                                                             owl:someValuesFrom co:PMD_0080108
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ]
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'stress relaxation' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Spannungsrelaxation"@de ,
                          "stress relaxation"@en ;
               skos:altLabel "Relaxationsgrad"@de ,
                             "relaxation ratio"@en ;
               skos:definition "Stress relaxation is a physical relational quality of a material that expresses the ratio of residual stress to initial applied stress after a defined time interval under constant strain, quantifying the material's tendency to internally redistribute stress over time"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080095
co:PMD_0080095 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020309 ,
                               co:PMD_0020335 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty co:PMD_0025999 ;
                                 owl:someValuesFrom [ owl:intersectionOf ( obo:BFO_0000146
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:RO_0002000 ;
                                                                             owl:someValuesFrom co:PMD_0020290
                                                                           ]
                                                                           [ rdf:type owl:Restriction ;
                                                                             owl:onProperty obo:RO_0002000 ;
                                                                             owl:someValuesFrom co:PMD_0020293
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ]
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'contact angle' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Kontaktwinkel"@de ,
                          "contact angle"@en ;
               skos:altLabel "Benetzungswinkel"@de ,
                             "wetting angle"@en ,
                             "θ"@en ;
               skos:definition "Contact angle is a physical relational quality of a solid surface that quantifies the angle formed at the three-phase contact line between a liquid droplet, the solid surface, and the surrounding gas phase, characterizing the wettability of the surface by the liquid"@en ,
                               "Kontaktwinkel ist eine physikalische relationale Qualität einer festen Oberfläche, die den Winkel an der Dreiphasengrenzlinie zwischen einem Flüssigkeitstropfen, der festen Oberfläche und der umgebenden Gasphase beschreibt und die Benetzbarkeit der Oberfläche durch die Flüssigkeit charakterisiert"@de ;
               skos:example "A hydrophobic polymer coating shows a water contact angle of 110 degrees, indicating poor wettability"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080098
co:PMD_0080098 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020102 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'mass mix ratio' have not yet been formalized. The term is defined as a specific subtype of 'mass ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Massenverh%C3%A4ltnis."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://de.wikipedia.org/wiki/Massenverh%C3%A4ltnis> ;
               rdfs:label "Massenmischungsverhältnis"@de ,
                          "mass mix ratio"@en ;
               skos:definition "Das Massenmischungsverhältnis stellt das Verhältnis der Massen zweier Mischungskomponenten dar und liefert eine quantitative Beschreibung der Zusammensetzung"@de ,
                               "mass ratio that represents the ratio of masses of two mixture components, providing a quantitative composition description"@en ;
               skos:example "A concrete mix uses a mass mix ratio of cement to aggregate of 1:4 for standard structural applications"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080099
co:PMD_0080099 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'dry mass' have not yet been formalized. The term is defined as a specific subtype of 'mass ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Trockenmasse"@de ,
                          "dry mass"@en ;
               skos:definition "Trockenmasse bezeichnet die Masse, nachdem einem Objekt die gesamte Feuchtigkeit entzogen wurde, typischerweise durch geeignete Erhitzungsmethoden in einem Ofen"@de ,
                               "mass ratio that represents the mass after removing all humidity from an object, typically using qualified heating methods in an oven"@en ;
               skos:example "A fiber composite sample has a dry mass of 48.5 g after 24 hours in a drying oven at 80 C"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080100
co:PMD_0080100 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020102 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'mass fraction' have not yet been formalized. The term is defined as a specific subtype of 'mass ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Massenanteil."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://de.wikipedia.org/wiki/Massenanteil> ;
               rdfs:label "Massenanteil"@de ,
                          "mass fraction"@en ;
               skos:definition "Der Massenanteil beschreibt den relativen Anteil einer Masse an der Gesamtmasse einer Mischung, ein gängiges quantitatives Maß"@de ,
                               "mass ratio that describes the relative proportion of a mass to the total mass of a mixture, a common quantitative measure"@en ;
               skos:example "A binary Al-4 wt% Cu alloy has a copper mass fraction of 0.04"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080101
co:PMD_0080101 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080069 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'mass concentration' have not yet been formalized. The term is defined as a specific subtype of 'material composition'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Massenkonzentration."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://de.wikipedia.org/wiki/Massenkonzentration> ;
               rdfs:label "Massenkonzentration"@de ,
                          "mass concentration"@en ;
               skos:definition "Die Massenkonzentration verknüpft die Masse einer Mischungskomponente mit dem Gesamtvolumen in einer quantitativen Beschreibung, die häufig in Lösungen verwendet wird"@de ,
                               "Mass concentration links mass of a mixture component to the total volume in quantitative description, frequently used in solutions"@en ;
               skos:example "A saline infusion solution has a NaCl mass concentration of 9 g/L"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080103
co:PMD_0080103 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020104 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'volume concentration' have not yet been formalized. The term is defined as a specific subtype of 'volume ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Volumenkonzentration."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://de.wikipedia.org/wiki/Volumenkonzentration> ;
               rdfs:label "Volumenkonzentration"@de ,
                          "volume concentration"@en ;
               skos:definition "Volume concentration links the volume of a mixture component to the total volume, crucial for quantitative composition description"@en ,
                               "Volumenkonzentration verbindet das Volumen eines Mischbestandteils mit dem Gesamtvolumen, entscheidend für die quantitative Zusammensetzungsbeschreibung"@de ;
               skos:example "A paint pigment dispersion has a TiO2 volume concentration of 20 %"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080104
co:PMD_0080104 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020104 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'volume fraction' have not yet been formalized. The term is defined as a specific subtype of 'volume ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Volumenkonzentration."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://de.wikipedia.org/wiki/Volumenkonzentration> ;
               rdfs:label "Volumenanteil"@de ,
                          "volume fraction"@en ;
               skos:definition "Volume fraction describes the volume of a mixture component relative to the sum of all components' volumes"@en ,
                               "Volumenanteil beschreibt das Volumen eines Mischbestandteils im Verhältnis zur Summe der Volumina aller Bestandteile"@de ;
               skos:example "A dual-phase steel contains a martensite volume fraction of 20 %, controlling its strength-ductility balance"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080105
co:PMD_0080105 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020104 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'volume mix ratio' have not yet been formalized. The term is defined as a specific subtype of 'volume ratio'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://de.wikipedia.org/wiki/Volumenverh%C3%A4ltnis."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://de.wikipedia.org/wiki/Volumenverh%C3%A4ltnis> ;
               rdfs:label "Mischengehaltverhältnis"@de ,
                          "volume mix ratio"@en ;
               skos:definition "Mischengehaltverhältnis definiert das Verhältnis der Volumina von zwei Mischbestandteilen zueinander"@de ,
                               "Volume mix ratio defines the ratio of volumes of two mixture components to each other"@en ;
               skos:example "An epoxy adhesive is mixed in a volume mix ratio of 2:1 resin to hardener"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080106
co:PMD_0080106 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'piezoelectric coefficient' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "piezoelectric coefficient"@en ,
                          "piezoelektrischer Koeffizient"@de ;
               skos:altLabel "d"@en ,
                             "piezoelectric constant"@en ,
                             "piezoelektrische Konstante"@de ;
               skos:definition "Piezoelectric coefficient is a physical relational quality of a material that quantifies the coupling between mechanical stress and electric polarization, expressed as the ratio of electric displacement to applied mechanical stress or the ratio of strain to applied electric field"@en ,
                               "Piezoelektrischer Koeffizient ist eine physikalische relationale Qualität eines Materials, die die Kopplung zwischen mechanischer Spannung und elektrischer Polarisation quantifiziert, ausgedrückt als Verhältnis der elektrischen Verschiebung zur angelegten mechanischen Spannung oder des Dehnungsanteils zum angelegten elektrischen Feld"@de ;
               skos:example "The d33 piezoelectric coefficient of PZT ceramics is about 400 pC/N, enabling sensitive force sensing"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080107
co:PMD_0080107 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'clamping pressure' have not yet been formalized. The term is defined as a specific subtype of 'pressure'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Klemmdruck"@de ,
                          "clamping pressure"@en ;
               skos:definition "Clamping pressure describes the force per area used during the mounting process of a sample, typically involving grips or similar tools"@en ,
                               "Klemmdruck ist die Eigenschaft, die als quantitativer Wert die Kraft pro Fläche beschreibt, die beim Einbau einer Probe, eines Prüfkörpers oder eines Prüfstücks aufgebracht wird, typischerweise verbunden mit einer Art von Klemm- oder Spannzubehör"@de ;
               skos:example "A hydraulic fixture applies a clamping pressure of 5 MPa to hold a workpiece during machining"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080108
co:PMD_0080108 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020311 ,
                               co:PMD_0023004 ,
                               _:genid1139 ,
                               _:genid1145 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0000052 ;
                                 owl:someValuesFrom co:PMD_0000001
                               ] ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Spannung"@de ,
                          "stress"@en ;
               skos:definition "Stress is the internal force per unit area a material experiences under external load, commonly described in tensile, compressive, or shear forms"@en ;
               skos:example "A cross-section of a loaded steel column bears a compressive stress of 150 MPa"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .

_:genid1139 owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0002328 ;
                                    owl:someValuesFrom co:PMD_0020200
                                  ]
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0002328 ;
                                    owl:someValuesFrom co:PMD_0080019
                                  ]
                                ) ;
             rdf:type owl:Class .

_:genid1145 owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0002328 ;
                                    owl:someValuesFrom co:PMD_0020352
                                  ]
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0002328 ;
                                    owl:someValuesFrom co:PMD_0020380
                                  ]
                                ) ;
             rdf:type owl:Class .

[ rdf:type owl:Axiom ;
   owl:annotatedSource co:PMD_0080108 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid1139 ;
   rdfs:comment "Mechanical view on stress"@en
 ] .

[ rdf:type owl:Axiom ;
   owl:annotatedSource co:PMD_0080108 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid1145 ;
   rdfs:comment "Thermodynamic view on stress"@en
 ] .


###  https://w3id.org/pmd/co/PMD_0080109
co:PMD_0080109 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080108 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'engineering stress' have not yet been formalized. The term is defined as a specific subtype of 'stress'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "engineering stress"@en ,
                          "technische Spannung"@de ;
               skos:definition "Engineering stress quantifies the internal force per unit area a material experiences under load, assuming the area remains constant"@en ,
                               "Technische Spannung beschreibt die innere Kraft pro Fläche, die ein Material unter Last erfährt, unter der Annahme, dass die Fläche konstant bleibt"@de ;
               skos:example "At yield, a steel specimen with 50 mm2 cross-section under 12.5 kN shows engineering stress of 250 MPa"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .

[ rdf:type owl:Axiom ;
   owl:annotatedSource co:PMD_0080109 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget co:PMD_0080108 ;
   rdfs:comment "Express that force and area are properties of the anchor/independent of \"TQC of the deformation process\""@en
 ] .


###  https://w3id.org/pmd/co/PMD_0080110
co:PMD_0080110 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080108 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'true stress' have not yet been formalized. The term is defined as a specific subtype of 'stress'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "true stress"@en ,
                          "wahre Spannung"@de ;
               skos:definition "True stress is defined using the cauchy stress tensor, relating stress to the current surface size of a volume element"@en ,
                               "Wahre Spannung wird unter Verwendung des Cauchy-Spannungstensors definiert und bezieht die Spannung auf die aktuelle Oberflächengröße eines Volumenelements"@de ;
               skos:example "At 10 % engineering strain in a tensile test, the true stress exceeds the engineering stress by the same factor"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .

[ rdf:type owl:Axiom ;
   owl:annotatedSource co:PMD_0080110 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget co:PMD_0080108 ;
   rdfs:comment "Express that force and area are properties dependent of \"TQC of the deformation process\""@en
 ] .


###  https://w3id.org/pmd/co/PMD_0080112
co:PMD_0080112 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'adhesion' have not yet been formalized. The term is defined as a specific subtype of 'pressure'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Adhäsion"@de ,
                          "adhesion"@en ;
               skos:definition "Adhesion describes the ability of substances to bind to each other, involving attractive force between two bodies of different substances in contact and influencing material performance in scientific and industrial contexts"@en ,
                               "Adhäsion beschreibt die Fähigkeit von Substanzen, sich aneinander zu binden. Dabei handelt es sich um eine Anziehungskraft zwischen zwei in Kontakt stehenden Körpern unterschiedlicher Substanzen, die die Materialleistung in wissenschaftlichen und industriellen Kontexten beeinflusst"@de ;
               skos:example "The adhesion between a paint film and a steel substrate determines its resistance to delamination"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080113
co:PMD_0080113 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0023045 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'surface tension' have not yet been formalized. The term is defined as a specific subtype of 'adhesion'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Oberflächenspannung"@de ,
                          "surface tension"@en ;
               skos:altLabel "Oberflächenspannung"@de ,
                             "surface stress"@en ,
                             "surface tension"@en ;
               skos:definition "Oberflächenspannung bezeichnet den Effekt innerhalb der Oberflächenschicht einer Flüssigkeit, der durch Wechselwirkungskräfte zwischen ihren Molekülen verursacht wird"@de ,
                               "Surface tension refers to the effect within the surface layer of a liquid/gas interface, caused by intermolecular forces between its molecules"@en ;
               skos:example "Water has a surface tension of 72.8 mN/m at 20 C, enabling capillary rise in fine tubes"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080114
co:PMD_0080114 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:BFO_0000051 ;
                                 owl:someValuesFrom co:PMD_0080115
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'refractive index' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Refractive_index#Complex_index_of_refraction_and_absorption."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Refractive_index#Complex_index_of_refraction_and_absorption> ;
               rdfs:label "Brechzahl"@de ,
                          "refractive index"@en ;
               skos:definition "Brechzahl gibt die Lichtbrechungsfähigkeit eines optischen Mediums an; umfasst einen realen und einen imaginären Teil, der als Extinktionskoeffizient bekannt ist"@de ,
                               "Refractive index indicates an optical medium's light bending ability; encompassing a real and imaginary part known as the extinction coefficient"@en ;
               skos:example "Optical glass BK7 has a refractive index of 1.52 at 589 nm, bending light in lenses"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080115
co:PMD_0080115 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'extinction coefficient' have not yet been formalized. The term is defined as a specific subtype of 'refractive index'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Refractive_index#Complex_index_of_refraction_and_absorption."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Refractive_index#Complex_index_of_refraction_and_absorption> ;
               rdfs:label "Extinktionskoeffizient"@de ,
                          "extinction coefficient"@en ;
               skos:definition "Der Extinktionskoeffizient, die imaginäre Komponente des komplexen Brechungsindex, gibt die Dämpfung elektromagnetischer Wellen durch ein Material an"@de ,
                               "Extinction coefficient, the imaginary component of the complex refractive index, indicates attenuation of electromagnetic waves through a material"@en ;
               skos:example "The extinction coefficient of gold at 500 nm wavelength is 1.87, characterizing strong optical absorption"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080116
co:PMD_0080116 rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000019 ,
                               _:genid1155 ;
               obo:IAO_0000117 "Philipp von Hartrott" ;
               rdfs:comment "Every potential in physics is the same mathematical object — a partial derivative of energy with respect to its conjugate extensive quantity. The differences are only in which extensive quality you're considering."@en ;
               rdfs:label "potential"@en ;
               skos:definition "a partial derivative of energy with respect to its conjugate extensive quantity"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .

_:genid1155 owl:intersectionOf ( [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0002328 ;
                                    owl:someValuesFrom co:PMD_0020142
                                  ]
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0002328 ;
                                    owl:someValuesFrom co:PMD_0020319
                                  ]
                                ) ;
             rdf:type owl:Class .

[ rdf:type owl:Axiom ;
   owl:annotatedSource co:PMD_0080116 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid1155 ;
   rdfs:comment """In field theories (e.g., gravity, electrostatics), the potential becomes a field ϕ(r⃗), and the force is recovered via:
F=−∇ϕ(r⃗)F
This is the spatial analogue: instead of asking \"how does energy change per unit carrier added?\", you ask \"how does energy change per unit carrier moved in space?\""""@en
 ] .


###  https://w3id.org/pmd/co/PMD_0080119
co:PMD_0080119 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020309 ,
                               co:PMD_0020313 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty co:PMD_0025999 ;
                                 owl:someValuesFrom obo:BFO_0000146
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'heat transfer coefficient' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Heat_transfer_coefficient."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Heat_transfer_coefficient> ;
               rdfs:label "Wärmeübergangskoeffizient"@de ,
                          "heat transfer coefficient"@en ;
               skos:definition "Der Wärmeübertragungskoeffizient stellt die Proportionalitätskonstante zwischen dem Wärmefluss und der thermodynamischen Antriebskraft für den Wärmefluss dar und wird zur Berechnung der Wärmeübertragung, typischerweise durch Konvektion, verwendet"@de ,
                               "Heat transfer coefficient represents the proportionality constant between heat flux and the thermodynamic driving force for heat flow, used in calculating heat transfer, typically by convection"@en ;
               skos:example "A forced convection air-cooled heat sink has a heat transfer coefficient of 100 W/(m2·K)"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080120
co:PMD_0080120 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'magnetic susceptibility' have not yet been formalized. Although χ = M/H is a well-defined ratio, a formal equivalence axiom would incorrectly classify any dimensionless relational quality of a magnetic bearer as magnetic susceptibility. Defined as a primitive subtype of 'physical relational quality'."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "magnetic susceptibility"@en ,
                          "magnetische Suszeptibilität"@de ;
               skos:altLabel "χ"@en ;
               skos:definition "Magnetic susceptibility is a physical relational quality of a material that quantifies the degree to which it becomes magnetized in response to an applied magnetic field, expressed as the dimensionless ratio of magnetization to applied field intensity"@en ,
                               "Magnetische Suszeptibilität ist eine physikalische relationale Qualität eines Materials, die den Grad angibt, in dem es sich als Reaktion auf ein angelegtes Magnetfeld magnetisiert, ausgedrückt als dimensionsloses Verhältnis der Magnetisierung zur angelegten Feldstärke"@de ;
               skos:example "Paramagnetic oxygen gas has a positive magnetic susceptibility of 3.73e-6 m3/mol at 20 C"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080121
co:PMD_0080121 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'fluid permeability' have not yet been formalized. The term is defined as a specific subtype of 'physical relational quality'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Fluiddurchlässigkeit"@de ,
                          "fluid permeability"@en ;
               skos:altLabel "Darcy permeability"@en ,
                             "Durchlässigkeit"@de ,
                             "hydraulic permeability"@en ,
                             "k"@en ;
               skos:definition "Fluid permeability is a physical relational quality of a porous material that quantifies its capacity to allow fluid flow through its pore network under an applied pressure gradient, defined by Darcy's law as the ratio of fluid flux to the pressure gradient normalized by fluid viscosity"@en ,
                               "Fluiddurchlässigkeit ist eine physikalische relationale Qualität eines porösen Materials, die seine Fähigkeit quantifiziert, Fluidfluss durch sein Porennetzwerk unter einem angelegten Druckgradienten zu ermöglichen, definiert durch das Darcy-Gesetz als Verhältnis des Fluidflusses zum Druckgradienten normiert durch die Viskosität des Fluids"@de ;
               skos:example "Sandstone with a Darcy permeability of 100 mD allows significant fluid flow under pressure gradients"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080122
co:PMD_0080122 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080011 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'phase velocity' have not yet been formalized. The term is defined as a specific subtype of 'speed'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Phasengeschwindigkeit"@de ,
                          "phase velocity"@en ;
               skos:definition "Die Phasengeschwindigkeit bezieht sich auf die Geschwindigkeit, mit der sich die Phase einer Welle ausbreitet, definiert als Wellenlänge geteilt durch die Zeitperiode"@de ,
                               "Phase velocity refers to the rate at which the phase of a wave propagates, defined as wavelength divided by time period"@en ;
               skos:example "The phase velocity of a longitudinal ultrasonic wave in steel is approximately 5900 m/s"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080123
co:PMD_0080123 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080011 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'deformation speed' have not yet been formalized. The term is defined as a specific subtype of 'speed'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Strain_rate."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Strain_rate> ;
               rdfs:label "Deformationsgeschwindigkeit"@de ,
                          "deformation speed"@en ;
               skos:altLabel "Dehnrate"@de ,
                             "strain rate"@en ;
               skos:definition "Deformation speed measures the rate at which distances of adjacent material parcels change with time near a specific point, including expansion and shear rates"@en ,
                               "Die Verformungsgeschwindigkeit misst die Geschwindigkeit, mit der sich die Abstände benachbarter Materialpakete in der Nähe eines bestimmten Punktes im Laufe der Zeit ändern, einschließlich Expansions- und Schergeschwindigkeiten"@de ;
               skos:example "During high-rate forming, the deformation speed of the punch reaches 10 m/s"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080125
co:PMD_0080125 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020317 ,
                               [ owl:intersectionOf ( co:PMD_0000506
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0000052 ;
                                                        owl:someValuesFrom obo:BFO_0000030
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'sound insulation index' have not yet been formalized. The term is defined as a specific subtype of 'acoustic capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Schalldämmmaß"@de ,
                          "sound insulation index"@en ;
               skos:definition "Schalldämmmaß quantifiziert die Fähigkeit eines Materials, die Schallübertragung zu reduzieren"@de ,
                               "Sound insulation index quantifies the ability of a material to reduce sound transmission"@en ;
               skos:example "A 200 mm concrete wall achieves a sound insulation index of 52 dB, blocking most airborne noise"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080127
co:PMD_0080127 rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000019 ,
                               co:PMD_0020312 ,
                               co:PMD_0020317 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0000080 ;
                                 owl:someValuesFrom obo:BFO_0000030
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'electrical capacitance' have not yet been formalized. The term is defined as a specific subtype of 'electrical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "electrical capacitance"@en ,
                          "elektrische Kapazität"@de ;
               skos:altLabel "electrical capacitance"@en ,
                             "electrical capacity"@en ,
                             "elektrische Kapazität"@de ;
               skos:definition "Die elektrische Kapazität bezieht sich auf die Fähigkeit eines Wesens, elektrische Ladung zu speichern, ausgedrückt als die Menge an elektrischer Ladung, die pro gegebenem elektrischem Potenzial gespeichert wird"@de ,
                               "Electrical capacitance refers to an entity's ability to store electric charge, expressed as the amount of electric charge stored per given electric potential"@en ;
               skos:example "A ceramic capacitor has an electrical capacitance of 100 nF, storing charge in an electronic circuit"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080128
co:PMD_0080128 rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000019 ,
                               co:PMD_0020312 ,
                               co:PMD_0020317 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0000080 ;
                                 owl:someValuesFrom obo:BFO_0000030
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'electrical resistance' have not yet been formalized. The term is defined as a specific subtype of 'electrical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://www.britannica.com/technology/resistance-electronics."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://www.britannica.com/technology/resistance-electronics> ;
               rdfs:label "electrical resistance"@en ,
                          "elektrischer Widerstand"@de ;
               skos:definition "Der elektrische Widerstand bezieht sich auf die Fähigkeit eines Stromkreises, elektrische Energie in Wärmeenergie umzuwandeln, indem er elektrischem Strom durch Teilchenkollisionen entgegenwirkt, die für Widerstände, Lampen und Drähte charakteristisch sind"@de ,
                               "Electrical resistance pertains to a circuit's capability to transform electric energy into heat energy, opposing electric current through particle collisions, characteristic of resistors, lamps, and wires"@en ;
               skos:example "A nichrome heating element has an electrical resistance of 10 Ω at room temperature"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080129
co:PMD_0080129 rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000019 ,
                               co:PMD_0020312 ,
                               co:PMD_0020317 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0000080 ;
                                 owl:someValuesFrom obo:BFO_0000030
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'electrical conductance' have not yet been formalized. The term is defined as a specific subtype of 'electrical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "electrical conductance"@en ,
                          "elektrischer Leitwert"@de ;
               skos:altLabel "Stromleitwert"@de ,
                             "electrical conductance"@en ,
                             "elektrischer Leitwert"@de ;
               skos:definition "Der elektrische Leitwert stellt den Kehrwert des elektrischen Widerstands eines Leiters dar und misst seine Fähigkeit, elektrischen Strom zu leiten, angegeben in Siemens (S)."@de ,
                               "Electrical conductance represents the reciprocal of a conductor's electrical resistance, measuring its ability to conduct an electric current, denoted in siemens (S)"@en ;
               skos:example "A copper wire of 1 m length and 1 mm2 cross-section has an electrical conductance of about 59 S"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080131
co:PMD_0080131 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020312 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'saturation magnetization' have not yet been formalized. The term is defined as a specific subtype of 'magnetic capability'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Sättigungsmagnetisierung"@de ,
                          "saturation magnetization"@en ;
               skos:altLabel "M_s"@en ,
                             "magnetic saturation"@en ,
                             "magnetische Sättigung"@de ;
               skos:definition "Saturation magnetization is a magnetic capability of a material that specifies the maximum magnetic moment per unit volume achieved when all magnetic domains are aligned with an applied external field"@en ,
                               "Sättigungsmagnetisierung ist eine magnetische Fähigkeit eines Materials, die das maximale magnetische Moment pro Volumeneinheit angibt, das erreicht wird, wenn alle magnetischen Domänen mit einem angelegten äußeren Feld ausgerichtet sind"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080133
co:PMD_0080133 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'durability' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Dauerhaftigkeit"@de ,
                          "durability"@en ;
               skos:altLabel "Dauerhaftigkeit"@de ,
                             "Langlebigkeit"@de ,
                             "durability"@en ,
                             "longevity"@en ;
               skos:definition "Die Dauerhaftigkeit ist die Fähigkeit eines Materials, Abnutzung, Rissbildung und andere Arten von Schäden im Laufe der Zeit zu widerstehen"@de ,
                               "Durability is the ability of a material to resist wear, tear, and other types of damage over time"@en ;
               skos:example "Galvanized steel shows high durability in outdoor environments, resisting corrosion for over 50 years"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080134
co:PMD_0080134 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080133 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'wear resistance' have not yet been formalized. The term is defined as a specific subtype of 'durability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Verschleißfestigkeit"@de ,
                          "wear resistance"@en ;
               skos:altLabel "Verschleißfestigkeit"@de ,
                             "resistance to wear"@en ,
                             "wear resistance"@en ,
                             "widerstand gegen Verschleiß"@de ;
               skos:definition "Verschleißfestigkeit ist die Fähigkeit eines Materials, mechanischen Aktionen wie Reiben, Kratzen oder Erosion zu widerstehen, die dazu tendieren, Material allmählich von seiner Oberfläche zu entfernen."@de ,
                               "Wear resistance is the ability of a material to resist mechanical actions such as rubbing, scraping or erosion that tend to progressively remove material from its surface."@en ;
               skos:example "Hardened tool steel has high wear resistance, maintaining a cutting edge through thousands of machining cycles"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080135
co:PMD_0080135 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080133 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'creep resistance' have not yet been formalized. The term is defined as a specific subtype of 'durability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Kriechfestigkeit"@de ,
                          "creep resistance"@en ;
               skos:altLabel "Creep Resistance"@en ,
                             "Creep Resistant"@en ,
                             "Kriechfestig"@de ,
                             "Kriechfestigkeit"@de ;
               skos:definition "Creep resistance is the ability of a material to resist deformation under load over time"@en ,
                               "Die Kriechfestigkeit ist die Fähigkeit eines Materials, unter Last über einen bestimmten Zeitraum eine Deformation zu widerstehen"@de ;
               skos:example "Nickel superalloys have high creep resistance, maintaining shape under stress at 1000 C in turbine blades"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080136
co:PMD_0080136 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'poisson effect' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Poisson%27s_ratio."@en ,
                               "Was a subclass of 'Mechanical Quality'" ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Poisson%27s_ratio> ;
               rdfs:label "Querkontraktion"@de ,
                          "poisson effect"@en ;
               skos:definition "Poisson effect describes deformation perpendicular to the direction of loading, named after Siméon Poisson"@en ,
                               "Querkontraktion beschreibt die Deformation senkrecht zur Belastungsrichtung, benannt nach Siméon Poisson"@de ;
               skos:example "A rubber cylinder loaded axially expands radially due to the Poisson effect, with a ratio of about 0.5"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080137
co:PMD_0080137 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0023004 ,
                               _:genid1169 ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Poissonzahl"@de ,
                          "poisson's ratio"@en ;
               skos:definition "a classical mechanics property defining the strain in one direction, given the strain in a perpendicular direction."@en ;
               skos:example "Rubber has a Poisson's ratio close to 0.5, indicating nearly incompressible behavior under loading"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .

_:genid1169 owl:intersectionOf ( co:PMD_0020311
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0000052 ;
                                    owl:someValuesFrom co:PMD_0000000
                                  ]
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty obo:RO_0002328 ;
                                    owl:someValuesFrom co:PMD_0080029
                                  ]
                                ) ;
             rdf:type owl:Class .

[ rdf:type owl:Axiom ;
   owl:annotatedSource co:PMD_0080137 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget _:genid1169 ;
   rdfs:comment "The two strains should be perpendicular to each other"@en
 ] .


###  https://w3id.org/pmd/co/PMD_0080138
co:PMD_0080138 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'aterial fatigue' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Materialermüdung"@de ,
                          "material fatigue"@en ;
               skos:altLabel "Ermüdung des Materials"@de ,
                             "Materialermüdung"@de ,
                             "fatigue of material"@en ,
                             "material fatigue"@en ;
               skos:definition "Material fatigue is the failure of a material caused by repeated or sustained loading below its ultimate strength."@en ,
                               "Materialermüdung ist das Versagen von Werkstoffen infolge wiederholter oder dauernder Belastung unterhalb der Probenfestigkeit"@de ;
               skos:example "Repeated cyclic loading at 400 MPa induces material fatigue in a steel shaft, leading to crack initiation"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080139
co:PMD_0080139 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'impact energy' have not yet been formalized. The term is defined as a specific subtype of 'mechanical capability'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Schlagenergie"@de ,
                          "impact energy"@en ;
               skos:altLabel "Charpy impact energy"@en ,
                             "KV"@en ,
                             "Kerbschlagenergie"@de ;
               skos:definition "Impact energy is a mechanical capability of a material that characterises the total energy absorbed by a standardised notched specimen during fracture under a single impact blow, as measured in a Charpy or Izod test"@en ,
                               "Schlagenergie ist eine mechanische Fähigkeit eines Materials, die die gesamte Energie beschreibt, die eine standardisierte gekerbte Probe beim Bruch unter einem einzigen Schlagimpuls absorbiert, gemessen im Charpy- oder Izod-Versuch"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080143
co:PMD_0080143 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'viscoelasticity' have not yet been formalized. The term is defined as a specific subtype of 'strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Viscoelastizität"@de ,
                          "viscoelasticity"@en ;
               skos:altLabel "Viscoelastizität"@de ,
                             "Viskoelastizität"@de ,
                             "elasticity of viscosity"@en ,
                             "viscoelasticity"@en ;
               skos:definition "Viscoelasticity describes materials exhibiting both viscous and elastic characteristics during deformation"@en ,
                               "Viscoelastizität beschreibt Materialien, die sowohl viskose als auch elastische Eigenschaften während der Verformung zeigen"@de ;
               skos:example "Polymers exhibit viscoelasticity, showing both elastic recovery and creep under constant load"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080144
co:PMD_0080144 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'creep modulus' have not yet been formalized. The term is defined as a specific subtype of 'viscoelasticity'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Kriechmodul"@de ,
                          "creep modulus"@en ;
               skos:altLabel "Kriechmodul"@de ,
                             "creep modulus"@en ;
               skos:definition "Creep modulus measures a material's viscoelasticity, indicating its ability to deform under stress over time"@en ,
                               "Der Kriechmodul ist ein Maß für die Viskoelastizität eines Materials, das seine Fähigkeit zur Verformung unter Belastung im Laufe der Zeit beschreibt"@de ;
               skos:example "The creep modulus of polyethylene at 50 C and 1 MPa after 1000 hours is 200 MPa"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080145
co:PMD_0080145 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'complex modulus' have not yet been formalized. The term is defined as a specific subtype of 'viscoelasticity'. Distinguishing criteria are domain-specific and depend on measurement conventions not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Komplexmodul"@de ,
                          "complex modulus"@en ;
               skos:altLabel "E*"@en ;
               skos:definition "Complex modulus is a viscoelastic quality of a material that represents the total stiffness response under oscillatory loading as a complex number, comprising the storage modulus as the real part and the loss modulus as the imaginary part"@en ,
                               "Komplexmodul ist eine viskoelastische Qualität eines Materials, die die gesamte Steifigkeitsantwort unter schwingender Belastung als komplexe Zahl darstellt, bestehend aus dem Speichermodul als Realteil und dem Verlustmodul als Imaginärteil"@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080146
co:PMD_0080146 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080145 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'loss modulus' have not yet been formalized. The term is defined as a specific subtype of 'complex modulus'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Dynamic_modulus."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Dynamic_modulus> ;
               rdfs:label "Verlustmodul"@de ,
                          "loss modulus"@en ;
               skos:altLabel "E''"@en ;
               skos:definition "Loss modulus is the imaginary part of the complex modulus that measures the viscous portion of energy dissipated as heat per cycle in a viscoelastic material under oscillatory loading"@en ,
                               "Verlustmodul ist der Imaginärteil des Komplexmoduls und misst den viskosen Anteil der pro Zyklus als Wärme dissipierten Energie in einem viskoelastischen Material unter schwingender Belastung"@de ;
               skos:example "The loss modulus of a viscoelastic polymer at 1 Hz is 0.3 MPa, representing energy dissipation per cycle"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080147
co:PMD_0080147 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080145 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'dynamic modulus' have not yet been formalized. The term is defined as a specific subtype of 'complex modulus'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Dynamic_modulus."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Dynamic_modulus> ;
               rdfs:label "dynamic modulus"@en ,
                          "dynamischer Modul"@de ;
               skos:altLabel "complex shear modulus"@en ;
               skos:definition "Dynamic modulus is the ratio of stress to strain under vibratory conditions, typically measured in shear, compression, or elongation tests, and characterizes viscoelastic materials"@en ,
                               "Dynamischer Modul ist das Verhältnis von Spannung zu Dehnung unter schwingenden Bedingungen, typischerweise gemessen in Scher-, Druck- oder Dehnungstests, und charakterisiert viskoelastische Materialien"@de ;
               skos:example "The dynamic modulus of a rubber compound at 10 Hz is 15 MPa, relevant for vibration isolation design"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080148
co:PMD_0080148 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080147 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'loss tangent' have not yet been formalized. The term is defined as a specific subtype of 'dynamic modulus'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Dynamic_modulus."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Dynamic_modulus> ;
               rdfs:label "Verlustwinkel"@de ,
                          "loss tangent"@en ;
               skos:definition "Der Verlustfaktor, dargestellt als tan δ, ist das Verhältnis des Verlustmoduls zum Speichermodul in viskoelastischen Materialien und liefert ein Maß für die Dämpfung"@de ,
                               "Loss tangent, represented as tan δ, is the ratio of the loss modulus to storage modulus in viscoelastic materials, providing a measure of damping"@en ;
               skos:example "A PTFE cable insulator has a loss tangent of 0.0002 at 1 GHz, minimizing signal attenuation"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080149
co:PMD_0080149 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080145 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'storage modulus' have not yet been formalized. The term is defined as a specific subtype of 'complex modulus'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Dynamic_modulus."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Dynamic_modulus> ;
               rdfs:label "Speichermodul"@de ,
                          "storage modulus"@en ;
               skos:altLabel "E'"@en ;
               skos:definition "Speichermodul ist der Realteil des Komplexmoduls und misst den elastischen Anteil der gespeicherten und zurückgewonnenen Energie pro Zyklus in einem viskoelastischen Material unter schwingender Belastung"@de ,
                               "Storage modulus is the real part of the complex modulus that measures the elastic portion of energy stored and recovered per cycle in a viscoelastic material under oscillatory loading"@en ;
               skos:example "The storage modulus of a polyurethane foam at 1 Hz and 25 C is 0.5 MPa, reflecting its elastic stiffness"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080150
co:PMD_0080150 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020335 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'toughness' have not yet been formalized. The term is defined as a specific subtype of 'strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Zähigkeit"@de ,
                          "toughness"@en ;
               skos:altLabel "Zähigkeit"@de ,
                             "toughness"@en ;
               skos:definition "Toughness describes the resistance of a material to fracture or crack propagation, determined by its ability to absorb mechanical energy during deformation"@en ,
                               "Zähigkeit beschreibt die Widerstandsfähigkeit eines Werkstoffs gegen Bruch oder Rissausbreitung, bestimmt durch die Fähigkeit zur Absorption von mechanischer Energie bei Verformung"@de ;
               skos:example "High-toughness tool steel absorbs 80 J before fracture in a Charpy V-notch test at room temperature"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080151
co:PMD_0080151 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080150 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'fracture toughness' have not yet been formalized. The term is defined as a specific subtype of 'toughness'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Bruchzähigkeit"@de ,
                          "fracture toughness"@en ;
               skos:altLabel "K_Ic"@en ,
                             "critical stress intensity factor"@en ;
               skos:definition "Bruchzähigkeit ist eine Zähigkeitsqualität eines Materials, die die kritische Spannungsintensität beschreibt, bei der ein vorhandener Riss zu wachsen beginnt"@de ,
                               "Fracture toughness is a toughness quality of a material that specifies the critical stress intensity at which a pre-existing crack begins to propagate, expressed as the stress intensity factor at the onset of fracture"@en ;
               skos:example "Fracture toughness of a high-strength steel measured as 50 MPa·√m according to ISO 17281 test conditions."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080152
co:PMD_0080152 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0080150 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'impact strength' have not yet been formalized. The term is defined as a specific subtype of 'toughness'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Schlagzähigkeit"@de ,
                          "impact strength"@en ;
               skos:altLabel "Schlagfestigkeit"@de ,
                             "Schlagzähigkeit"@de ,
                             "impact strength"@en ,
                             "mpact strength"@en ;
               skos:definition "Impact strength is the ability of a material to absorb energy and plastically deform without fracturing under dynamic load"@en ,
                               "Schlagzähigkeit bezeichnet die Fähigkeit eines Materials, Energie zu absorbieren und bei Anwendung einer dynamischen Last plastisch zu verformen, ohne dass es bricht"@de ;
               skos:example "A Charpy impact test on notched steel gives an impact strength of 120 J, indicating good toughness"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080154
co:PMD_0080154 rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000017 ,
                               [ owl:intersectionOf ( co:PMD_0000952
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:BFO_0000054 ;
                                                        owl:someValuesFrom co:PMD_0020339
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0002328 ;
                                                        owl:someValuesFrom co:PMD_0020336
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Zugfestigkeit"@de ,
                          "ultimate tensile strength"@en ;
               skos:definition "the maximum (normal) stress a material can withstand before rupturing"@en ;
               skos:example "A high-strength bolt grade 10.9 has a tensile strength of at least 1040 MPa"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080155
co:PMD_0080155 rdf:type owl:Class ;
               rdfs:subClassOf [ owl:intersectionOf ( co:PMD_0000952
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0002328 ;
                                                        owl:someValuesFrom co:PMD_0020337
                                                      ]
                                                    ) ;
                                 rdf:type owl:Class
                               ] ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Druckfestigkeit"@de ,
                          "ultimate compressive strength"@en ;
               skos:definition "Compressive strength is the maximum stress a material can withstand under uniaxial compressive loading before failure"@en ;
               skos:example "Compressive strength of a concrete specimen measured as 30 MPa according to ISO 4012 test conditions."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080159
co:PMD_0080159 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020335 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'weathering resistance' have not yet been formalized. The term is defined as a specific subtype of 'operational strength'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ,
                               "Was a subclass of 'Operational Strength';  But 'Operational Strength' does not appear to be Quality."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Witterungsbeständigkeit"@de ,
                          "weathering resistance"@en ;
               skos:altLabel "Witterungsbeständigkeit"@de ,
                             "weather resistant"@en ,
                             "weathering resistance"@en ,
                             "wetterbeständig"@de ;
               skos:definition "Ability of a material to resist the effects of weathering, such as wind, rain, and sunlight."@en ,
                               "Fähigkeit eines Materials, den Auswirkungen von Witterungseinflüssen wie Wind, Regen und Sonnenlicht standzuhalten."@de ;
               skos:example "HDPE pipes show high weathering resistance, retaining mechanical properties after years of UV exposure"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080164
co:PMD_0080164 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020311 ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Elastizität"@de ,
                          "elasticity"@en ;
               skos:definition "Elasticity is the disposition of a material to resume its initial shape after deformation"@en ;
               skos:example "Rubber exhibits high elasticity, recovering its original shape after 300 % elongation"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .

[ rdf:type owl:Axiom ;
   owl:annotatedSource co:PMD_0080164 ;
   owl:annotatedProperty rdfs:subClassOf ;
   owl:annotatedTarget co:PMD_0020311 ;
   rdfs:comment "Should comprise reversibility/non-dissipative aspect in process"@en
 ] .


###  https://w3id.org/pmd/co/PMD_0080166
co:PMD_0080166 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0023004 ,
                               [ owl:intersectionOf ( co:PMD_0020311
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0000052 ;
                                                        owl:someValuesFrom co:PMD_0000000
                                                      ]
                                                      [ rdf:type owl:Restriction ;
                                                        owl:onProperty obo:RO_0002328 ;
                                                        owl:someValuesFrom co:PMD_0020334
                                                      ]
                                                      [ rdf:type owl:Restriction ;
