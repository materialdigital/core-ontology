                                                                                                                         owl:someValuesFrom obo:BFO_0000040
                                                                                                                       ]
                                                                                                                     ) ;
                                                                                                  rdf:type owl:Class
                                                                                                ]
                                                                           ]
                                                                         ) ;
                                                      rdf:type owl:Class
                                                    ]
                               ] ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty obo:RO_0002350 ;
                                 owl:allValuesFrom co:PMD_0020004
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Kamilla Zaripova" ;
               rdfs:label "Angabe des Bruchwerts"@de ,
                          "fraction value specification"@en ;
               skos:definition "Bei der Bruchwertspezifikation handelt es sich um eine Wertspezifikation, die Informationen über den quantitativen Anteil eines Teils im Verhältnis zu einem angegebenen Ganzen enthält."@de ,
                               "Fraction value specification is a value specification that contains information about quantitative share of a part relative to a specified whole."@en ;
               skos:example "2.05 wt.% of carbon in steel, 4 vol.% of nitric acid in a solution"@en .


###  https://w3id.org/pmd/co/PMD_0040001
co:PMD_0040001 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020132 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'length' have not yet been formalized. The term is defined as a specific subtype of 'DimensionQuality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: http://purl.obolibrary.org/obo/PATO_0000122."@en ;
               obo:IAO_0000117 "PERSON: Lars Vogt" ;
               rdfs:comment "Length is a size that describes the spatial extent of its bearer in one dimension."@en ;
               rdfs:label "Länge"@de ,
                          "length"@en ;
               skos:altLabel "dimension"@en ;
               skos:definition "Die Länge ist eine eindimensionale Größe."@de ,
                               "Length is a one dimensional size."@en ;
               skos:example "A steel rod measures 250 mm in length between its two end faces"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0050000
co:PMD_0050000 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ,
                               [ rdf:type owl:Restriction ;
                                 owl:onProperty co:PMD_0025999 ;
                                 owl:someValuesFrom obo:CHEBI_33250
                               ] ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Markus Schilling" ;
               rdfs:label "Bindung"@de ,
                          "atomic bond"@en ;
               skos:definition "A bond is a relational quality describing the force interaction between atoms."@en ,
                               "Eine Bindung ist eine relationale Qualität, die die Kraftwechselwirkung zwischen Atomen beschreibt."@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0050001
co:PMD_0050001 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0050000 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Markus Schilling" ;
               obo:IAO_0000119 <https://sciencenotes.org/types-of-chemical-bonds/> ;
               rdfs:label "covalent bond"@en ,
                          "kovalente Bindung"@de ;
               skos:definition "A covalent bond is a bond that forms when nonmetal atoms share electrons to achieve a stable electron configuration."@en ,
                               "Eine kovalente Bindung ist eine Bindung, die entsteht, wenn Nichtmetallatome Elektronen teilen, um eine stabile Elektronenkonfiguration zu erreichen."@de ;
               skos:example "In a water molecule (H₂O), the hydrogen and oxygen atoms share electrons."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0050002
co:PMD_0050002 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0050000 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Markus Schilling" ;
               obo:IAO_0000119 <https://www.thoughtco.com/metallic-bond-definition-properties-and-examples-4117948> ;
               rdfs:label "metallic bond"@en ,
                          "metallische Bindung"@de ;
               skos:definition "A metallic bond is a bond that forms between metal atoms, where electrons are shared in a \"sea\" of electrons that move freely around the metal ions. This type of bonding gives metals their characteristic properties such as conductivity and malleability."@en ,
                               "Eine Metallbindung ist eine Bindung, die zwischen Metallatomen entsteht, wobei Elektronen in einem „Meer“ von Elektronen geteilt werden, die sich frei um die Metallionen bewegen. Diese Art der Bindung verleiht Metallen ihre charakteristischen Eigenschaften wie Leitfähigkeit und Formbarkeit."@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0050003
co:PMD_0050003 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0050000 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Markus Schilling" ;
               obo:IAO_0000119 <https://sciencenotes.org/types-of-chemical-bonds/> ;
               rdfs:label "Ionenbindung"@de ,
                          "ionic bond"@en ;
               skos:definition "An ionic bond is a bond that occurs when one atom donates an electron to another atom, resulting in oppositely charged ions that attract each other."@en ,
                               "Eine Ionenbindung ist eine Bindung, die entsteht, wenn ein Atom ein Elektron an ein anderes Atom abgibt, wodurch entgegengesetzt geladene Ionen entstehen, die sich gegenseitig anziehen."@de ;
               skos:example "An example is the interaction between the atoms of sodium chloride (NaCl), where the sodium atom donates an electron to a chlorine atom."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


