###  https://w3id.org/pmd/co/PMD_0000853
co:PMD_0000853 rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000019 ,
                               co:PMD_0020335 ,
                               co:PMD_0023004 ,
                               co:PMD_0023007 ,
