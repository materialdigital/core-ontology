               obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
               rdfs:label "Tripelpunkt"@de ,
                          "triple point"@en ;
               skos:definition "a state of matter boundary (point) realized by transition from the solid state to the liquid state or the the gaseous state (or vice versa)."@en ,
                               "eine Zustandsgrenze (Punkt) einer Materie, die durch den Übergang vom festen Zustand in den flüssigen Zustand oder den gasförmigen Zustand (oder umgekehrt) realisiert wird."@de ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0001013
co:PMD_0001013 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000812 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Joerg Waitelonis" ;
