###  https://w3id.org/pmd/co/PMD_0060007
co:PMD_0060007 rdf:type owl:Class ;
               rdfs:subClassOf obo:IAO_0000033 ;
               rdfs:label "material specification"@en ;
               skos:definition "A directive information entity that defines the composition, properties, performance criteria, and acceptable standards for a material, guiding its selection, processing, and application in a specific context."@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0060009
co:PMD_0060009 rdf:type owl:Class ;
               rdfs:subClassOf obo:IAO_0000033 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000117 "PERSON: Hossein Beygi Nasrabadi" ;
               rdfs:comment "The intent of the specification datum is to express the \"Sollwert\" of some qualitiy or behavioral material property. Then, the specification datum can be further specified by  some value specification."@en ;
               rdfs:label "specification datum"@en ;
               skos:definition "A directive information entity that provides information of a setpoint of some value, i.e., it is an intended value."@en ;
               skos:example "The setpoint value of a ultimate tensile strength of some steel material"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080007
co:PMD_0080007 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0020353 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'radiologic quality' have not yet been formalized. The term is defined as a specific subtype of 'physical quality'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "radiologic disposition"@en ,
                          "radiologische Eigenschaft"@de ;
               skos:definition "Radiologic disposition pertains to properties or characteristics related to an entity's interaction with radiant energy"@en ,
                               "Radiologische Qualität bezieht sich auf die Eigenschaften oder Merkmale im Zusammenhang mit der Wechselwirkung einer Entität mit Strahlungsenergie"@de ;
               skos:example "The dose equivalent a patient receives from a chest X-ray is a radiologic quality of the examination"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080010
co:PMD_0080010 rdf:type owl:Class ;
               rdfs:subClassOf obo:BFO_0000145 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'spatial relational quality' have not yet been formalized. The term is defined as a specific subtype of 'BFO_0000145'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "räumliche Relationsqualität"@de ,
                          "spatial relational quality"@en ;
               skos:definition "Räumliche Beziehungsqualität ist eine Qualität, die einer materiellen Entität aufgrund ihrer räumlichen Beziehung zu einer oder mehreren anderen Entitäten, wie z. B. Position, Ausrichtung oder Entfernung, innewohnt"@de ,
                               "Spatial relational quality is a quality that inheres in a material entity by virtue of its spatial relationship to one or more other entities, such as position, orientation, or distance"@en ;
               skos:example "the distance between a bolt and the nearest edge of a steel plate is a spatial relational quality of the bolt"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080011
co:PMD_0080011 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000008 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'speed' have not yet been formalized. The term is defined as a specific subtype of 'physical process characteristic'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://simple.wikipedia.org/wiki/Speed."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://simple.wikipedia.org/wiki/Speed> ;
               rdfs:label "Geschwindigkeit"@de ,
                          "speed"@en ;
               skos:definition "Geschwindigkeit beschreibt die Entfernung, die ein Objekt in einer bestimmten Zeit zurücklegt, immer positiv"@de ,
                               "process attribute that describes the distance an object moves in a given amount of time, always positive"@en ;
               skos:example "If a train takes 1 hour to travel 100 kilometers, it has a speed of 100 kilometers per hour (62 mph)"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080012
co:PMD_0080012 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000008 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'electric current' have not yet been formalized. The term is defined as a specific subtype of 'physical process characteristic'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "electric current"@en ,
                          "elektrischer Strom"@de ;
               skos:altLabel "electric current"@en ;
               skos:definition "Elektrischer Strom ist der Fluss elektrischer Ladung pro Zeiteinheit"@de ,
                               "process attribute that represents the flow of electric charge per unit time"@en ;
               skos:example "A 100 W incandescent bulb draws an electric current of about 0.43 A at 230 V"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080013
co:PMD_0080013 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000008 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'force rate' have not yet been formalized. The term is defined as a specific subtype of 'physical process characteristic'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Kraftrate"@de ,
                          "force rate"@en ;
               skos:altLabel "Ruck"@de ,
                             "yank"@en ;
               skos:definition "In der Physik wird der Begriff \"Ruck\" manchmal verwendet, um die Ableitung der Kraft in Bezug auf die Zeit oder die mit dem Ruck multiplizierte Masse zu bezeichnen. In der relativistischen Physik wird dieser Begriff als die zweite Ableitung des Impulses in Bezug auf die Zeit ausgedrückt, da die Masse geschwindigkeitsabhängig ist. Obwohl nicht allgemein als offizieller Begriff für diese Größe anerkannt, wird der Begriff \"Ruck\" häufig von Physikbegeisterten verwendet"@de ,
                               "In physics, yank is sometimes used to denote the derivative of force with respect to time or mass multiplied by jerk. In relativistic physics, it is expressed as the second derivative of momentum with respect to time, because the mass is velocity-dependent. Though not universally accepted as an official term for this quantity, the term \"yank\" is commonly used among physics enthusiasts"@en ;
               skos:example "During impact testing, the force rate on the specimen rises to 10 kN/ms within the first microsecond"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080014
co:PMD_0080014 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000008 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'mass flow rate' have not yet been formalized. The term is defined as a specific subtype of 'physical process characteristic'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Mass_flow_rate."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Mass_flow_rate> ;
               rdfs:label "Massendurchsatz"@de ,
                          "mass flow rate"@en ;
               skos:definition "Der Massendurchfluss quantifiziert die pro Zeiteinheit fließende Masse und wird üblicherweise in Kilogramm pro Sekunde oder Pfund pro Sekunde gemessen"@de ,
                               "process attribute that quantifies the mass passing per unit time, commonly measured in kilograms per second or pounds per second"@en ;
               skos:example "A coolant pump delivers a mass flow rate of 2 kg/s of water through a heat exchanger"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080015
co:PMD_0080015 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000008 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'mechanical impulse' have not yet been formalized. The term is defined as a specific subtype of 'physical process characteristic'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Impulse_(physics)."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Impulse_(physics)> ;
               rdfs:label "mechanical impulse"@en ,
                          "mechanischer Impuls"@de ;
               skos:definition "Unter mechanischem Impuls versteht man die Änderung des Impulses eines Objekts, wenn es im Laufe der Zeit einer Kraft ausgesetzt wird"@de ,
                               "process attribute that signifies the change in momentum of an object when subjected to a force over time"@en ;
               skos:example "A drop weight imparts a mechanical impulse of 50 N·s to the Charpy specimen during impact"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080016
co:PMD_0080016 rdf:type owl:Class ;
               rdfs:subClassOf co:PMD_0000008 ;
               obo:IAO_0000114 obo:IAO_0000122 ;
               obo:IAO_0000116 "Necessary and sufficient conditions for 'radiant energy flux' have not yet been formalized. The term is defined as a specific subtype of 'physical process characteristic'. Distinguishing criteria are domain-specific and depend on measurement conventions or source terminology not yet expressed as OWL restrictions. The definition is adapted from: https://en.wikipedia.org/wiki/Radiant_energy."@en ;
               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               obo:IAO_0000119 <https://en.wikipedia.org/wiki/Radiant_energy> ;
               rdfs:label "Strahlungsfluss"@de ,
                          "radiant energy flux"@en ;
               skos:definition "Strahlungsfluss beschreibt die Strahlungsenergie, die pro Zeiteinheit emittiert, reflektiert, übertragen oder empfangen wird"@de ,
                               "process attribute that represents the radiant energy emitted, reflected, transmitted, or received per unit time"@en ;
               skos:example "A solar panel receives a radiant energy flux of 1000 W/m2 under standard test conditions"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080017
co:PMD_0080017 rdf:type owl:Class ;
