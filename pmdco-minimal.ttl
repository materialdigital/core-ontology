               obo:IAO_0000117 "PERSON: Thomas Hanke" ;
               rdfs:label "Temperaturprofil"@de ,
                          "temperature profile"@en ;
               skos:definition "Temperatur Profil beschreibt Änderungen der Temperatur eines materiellen Wesens oder Raums über die Zeit"@de ,
                               "process attribute that describes changes in the temperature of a material entity or space over time"@en ;
               skos:example "The temperature profile along a quenched steel bar varies from 850 C at the surface to 200 C at the core"@en ;
               co:PMD_0000060 "true"^^xsd:boolean .


###  https://w3id.org/pmd/co/PMD_0080019
co:PMD_0080019 rdf:type owl:Class ;
